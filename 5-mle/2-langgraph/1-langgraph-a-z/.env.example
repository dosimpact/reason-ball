# Copy to .env; this file contains no usable credentials.
OPENAI_API_KEY=
MODEL_PROVIDER=openai
OPENAI_MODEL=luna

# Pattern examples can select a local Ollama provider.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

VITE_LANGGRAPH_API_URL=http://127.0.0.1:2941
VITE_COPILOTKIT_RUNTIME_URL=/api/copilotkit
LANGGRAPH_URL=http://127.0.0.1:2941
COPILOTKIT_RUNTIME_HOST=127.0.0.1
COPILOTKIT_RUNTIME_PORT=2942

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-a-z
TAVILY_API_KEY=

# Advanced examples: supply only the services needed by the selected example.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
DATABASE_URL=postgresql://langgraph:langgraph@localhost:5432/langgraph
QDRANT_URL=http://localhost:6333

# Deep Agents uses scripted mode unless live is explicitly selected.
DEEP_AGENTS_MODE=scripted

OPENAI_MODEL_LUNA=gpt-6-luna
OPENAI_MODEL_TERRA=gpt-6.1-terra
