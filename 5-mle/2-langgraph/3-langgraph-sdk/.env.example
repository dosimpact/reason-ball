OPENAI_API_KEY=

# Optional model aliases used by common.llm.create_llm().
OPENAI_MODEL=default
OPENAI_MODEL_DEFAULT=gpt-6-luna
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_NORMAL=gpt-6-luna
OPENAI_MODEL_SMART=gpt-6-sol
OPENAI_MODEL_REASONING=gpt-6-sol

# Model lineup. Prices are per 1M text tokens.
# gpt-6-luna    / Input $0.10 Output $0.50 / FAST, DEFAULT
# gpt-6.1-sol   / Input $2.00 Output $10.00 / NORMAL, SMART
# gpt-6-astra   / Input $10.00 Output $50.00 / REASONING

# Optional embedding model used by graph-advanced examples.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

# Optional CopilotKit runtime endpoint used by example 35.
VITE_COPILOTKIT_RUNTIME_URL=/api/copilotkit
COPILOTKIT_RUNTIME_HOST=0.0.0.0
COPILOTKIT_RUNTIME_PORT=2932
LANGGRAPH_URL=http://localhost:2931

# Optional LangSmith tracing.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-openai-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

TAVILY_API_KEY=tvly-xx
