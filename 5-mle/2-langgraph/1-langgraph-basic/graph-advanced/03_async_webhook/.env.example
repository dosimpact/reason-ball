OPENAI_API_KEY=
OPENAI_MODEL=default
OPENAI_MODEL_DEFAULT=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_NORMAL=gpt-5-nano
OPENAI_MODEL_SMART=gpt-5-mini
OPENAI_MODEL_REASONING=o4-mini

# Postgres checkpointer
DATABASE_URL=postgresql://langgraph:langgraph@localhost:5432/langgraph

# 외부 mock 서비스 → 우리 서버 webhook 으로 callback 할 때 사용하는 base URL
SERVER_BASE_URL=http://localhost:8000
# mock_external 자체가 띄울 포트
MOCK_EXTERNAL_PORT=9000
