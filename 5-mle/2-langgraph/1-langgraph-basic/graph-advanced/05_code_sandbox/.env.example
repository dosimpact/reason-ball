# 격리 컨테이너 이미지 이름 (sandbox/Dockerfile 로 build)
SANDBOX_IMAGE=sandbox-python
SANDBOX_TIMEOUT_SEC=10
SANDBOX_OUTPUT_LIMIT=8192
