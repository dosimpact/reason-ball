{
  "name": "reason-ball",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "turbo run build --filter=!@10k/workspace",
    "dev": "turbo run dev",
    "infra-up:reason-hwang": "turbo run infra:up --filter='./20-portfolio/1-reason-hwang/infra/*'",
    "infra-down:reason-hwang": "turbo run infra:down --filter='./20-portfolio/1-reason-hwang/infra/*'",
    "infra-ps:reason-hwang": "turbo run infra:ps --filter='./20-portfolio/1-reason-hwang/infra/*'",
    "dev:reason-hwang": "turbo run dev --filter='./20-portfolio/1-reason-hwang/**'",
    "build:reason-hwang": "turbo run build --filter='./20-portfolio/1-reason-hwang/**'",
    "start:reason-hwang": "turbo run start --filter=reason-hwang-fe-host --filter=@reason-hwang/bff-apps",
    "test:e2e:reason-hwang": "turbo run test:e2e --filter=reason-hwang-fe-host",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@usebruno/cli": "^2.15.1",
    "turbo": "^2.9.18"
  }
}
