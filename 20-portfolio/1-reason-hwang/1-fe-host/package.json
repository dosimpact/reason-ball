{
  "name": "reason-hwang-fe-host",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 2800",
    "build": "next build --no-lint",
    "start": "next start --port 2800",
    "lint": "eslint . && pnpm lint:fsd",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:calculation": "playwright test --project=calculation",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "a2ui:generate": "tsx scripts/a2ui-contract.ts",
    "a2ui:check": "tsx scripts/a2ui-contract.ts --check",
    "test:a2ui": "vitest run --project a2ui",
    "test:a2ui:views": "vitest run --project storybook --maxWorkers=1 --no-file-parallelism src/_pages/a2ui-demo/lib/*.stories.tsx",
    "test:push-ui": "node --import tsx --test tests/push-ui-message/*.test.ts",
    "test:push-ui:views": "vitest run --project storybook --maxWorkers=1 --no-file-parallelism src/_pages/examples-push-ui-message/ui/TurnView.stories.tsx",
    "test:sec-chat:views": "vitest run --project storybook --maxWorkers=1 --no-file-parallelism src/_pages/sec-chat/ui/*.stories.tsx",
    "test:sec-chat:live": "playwright test --project sec-live --workers 2",
    "sec-ui:generate": "openui generate src/shared/ui/intelligent-ui/library.ts --out src/shared/config/openui/system-prompt.txt && node scripts/sync-sec-ui.mjs",
    "lint:fsd": "steiger src --fail-on-warnings",
    "test:sec-api-agent:views": "vitest run --project storybook --maxWorkers=1 --no-file-parallelism src/_pages/sec-api-agent/ui/*.stories.tsx"
  },
  "dependencies": {
    "@a2ui/web_core": "0.10.4",
    "@ag-ui/a2ui-middleware": "0.0.10",
    "@ag-ui/client": "0.0.59",
    "@base-ui/react": "^1.6.0",
    "@copilotkit/a2ui-renderer": "1.73.0",
    "@copilotkit/react-core": "1.73.0",
    "@copilotkit/runtime": "1.73.0",
    "@langchain/langgraph-sdk": "^1.9.25",
    "@module-federation/runtime": "^0.10.0",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "^0.18.1",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.4",
    "ajv": "8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^6.15.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.25.1",
    "zod3": "npm:zod@3.25.76"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^9.17.0",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@next/eslint-plugin-next": "^15.1.3",
    "@openuidev/cli": "0.6.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "^8.57.1",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "1.64.1",
    "postcss": "^8.4.49",
    "steiger": "^0.8.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.2",
    "tsx": "4.20.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "latest",
    "vitest": "latest"
  }
}
