{
  "name": "reason-hwang-fe-host",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 2800",
    "build": "next build --no-lint",
    "start": "next start --port 2800",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:calculation": "playwright test --project=calculation",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "a2ui:generate": "tsx scripts/a2ui-contract.ts",
    "a2ui:check": "tsx scripts/a2ui-contract.ts --check",
    "test:a2ui": "vitest run --project a2ui",
    "test:a2ui:views": "vitest run --project storybook --maxWorkers=1 --no-file-parallelism src/lib/a2ui/*.stories.tsx",
    "test:e2e:sec-agent": "SEC_AGENT_LIVE_TESTS=1 PLAYWRIGHT_BASE_URL=http://localhost:2820 playwright test sec-agent.spec.ts --project=chromium --workers=1",
    "test:e2e:sec-financial": "SEC_AGENT_LIVE_TESTS=1 PLAYWRIGHT_BASE_URL=http://localhost:2820 playwright test sec-financial.spec.ts --project=chromium --workers=1"
  },
