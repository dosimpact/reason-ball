meta {
  name: wiki-live
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/wiki?title=Golden_Gate_Bridge
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("GALLERY-MEDIA-001 wiki-live", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().photos).to.be.an("array");
  });
}
