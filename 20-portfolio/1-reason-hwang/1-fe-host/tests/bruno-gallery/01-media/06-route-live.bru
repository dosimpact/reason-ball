meta {
  name: route-live
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/street-route?coords=-122.48,37.81;-122.42,37.80
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("GALLERY-MEDIA-001 route-live", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().points.length).to.be.greaterThan(1);
  });
}
