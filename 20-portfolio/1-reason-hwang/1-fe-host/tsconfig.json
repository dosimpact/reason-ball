{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-chat-activity-validation/types/**/*.ts",
    ".next-native-tools-validation/types/**/*.ts",
    ".next-openui-build/types/**/*.ts",
    ".next-openui-migration/types/**/*.ts",
    ".next-sec-api-testing-validation/types/**/*.ts",
    ".next-sec-collector-validation/types/**/*.ts",
    ".next-ta-canvas-validation/types/**/*.ts",
    ".next-ta-refresh-validation/types/**/*.ts",
    ".next-ta-split-validation/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-ta-starters/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
