{
  "name": "@reason-hwang/codex-oauth-proxy",
  "private": true,
  "scripts": {
    "oauth": "uv run python -m core.oauth_login --manual-callback",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "infra:ps": "docker-compose ps",
    "build": "docker build -t codex-oauth-proxy .",
    "dev": "uv run python proxy-server/main.py --serve",
    "start": "uv run python proxy-server/main.py --serve",
    "lint": "python3 -m compileall core proxy-server examples",
    "test:sdk": "OPENAI_BASE_URL=http://127.0.0.1:18741/v1 OPENAI_API_KEY=chatgpt-oauth-placeholder uv run python examples/sdk.py",
    "test:langgraph": "OPENAI_BASE_URL=http://127.0.0.1:18741/v1 OPENAI_API_KEY=chatgpt-oauth-placeholder uv run python examples/langgraph.py",
    "typecheck": "python3 -m compileall core proxy-server examples",
    "clean": "rm -rf .venv .pytest_cache .mypy_cache .ruff_cache htmlcov .coverage core/__pycache__ proxy-server/__pycache__ examples/__pycache__"
  }
}
