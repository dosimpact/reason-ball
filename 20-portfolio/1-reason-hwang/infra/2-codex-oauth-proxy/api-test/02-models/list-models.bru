meta {
  name: List supported models
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/models
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.object: eq list
  res.body.data: isArray
  res.body.data[0].object: eq model
}

tests {
  test("returns the verified Codex model list", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    const modelIds = body.data.map((model) => model.id);
    expect(modelIds).to.include("gpt-5.6-sol");
    expect(modelIds).to.include("gpt-5.6-terra");
    expect(modelIds).to.include("gpt-5.6-luna");
    expect(modelIds).to.include("gpt-5.5");
    expect(modelIds).to.include("gpt-5.3-codex-spark");
  });
}
