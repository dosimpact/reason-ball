meta {
  name: Complete text content block
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: none
}

body:json {
  {
    "model": "{{model}}",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Reply with exactly: API test passed"
          }
        ]
      }
    ],
    "stream": false
  }
}

assert {
  res.status: eq 200
  res.body.object: eq chat.completion
  res.body.choices[0].message.role: eq assistant
  res.body.choices[0].message.content: isString
}

tests {
  test("returns an OpenAI-compatible chat completion", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.object).to.equal("chat.completion");
    expect(body.choices[0].message.content).to.be.a("string").and.not.empty;
  });
}
