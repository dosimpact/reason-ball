headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer chatgpt-oauth-placeholder
}

script:post-response {
  const method = req.getMethod();
  const url = req.getUrl();
  const status = res.getStatus();
  const elapsedMs = res.getResponseTime();

  console.log(`[${method}] ${url} -> ${status} (${elapsedMs}ms)`);
  console.log(`Response body:\n${JSON.stringify(res.getBody(), null, 2)}`);
}
