meta {
  name: 원본 연결이 포함된 수정본 조회
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/filings?page=1&pageSize={{filingListLimit}}&includeContent=false&formType=10-K/A&includeAmendments=true&status=downloaded&cik={{sampleCik}}&since={{sinceDate}}
  body: none
  auth: none
}

params:query {
  page: 1
  pageSize: {{filingListLimit}}
  includeContent: false
  formType: 10-K/A
  includeAmendments: true
  status: downloaded
  cik: {{sampleCik}}
  since: {{sinceDate}}
}

assert {
  res.status: eq 200
  res.body.filters.pageSize: eq {{filingListLimit}}
  res.body.filters.status: eq "downloaded"
  res.body.filters.cik: eq "{{sampleCik}}"
  res.body.pagination.totalItems: isNumber
  res.body.items: isArray
}

tests {
  test("returns filings matching the normalized filters", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.filters.status).to.equal("downloaded");
    expect(body.items).to.be.an("array");
    body.items.forEach(item => { expect(item.amendments).to.be.an("array"); expect(item).to.have.property("original"); });
  });
}

docs {
  Scenario: SEC-FILINGS-LIST-001
  Lists downloaded filings with pagination and original/amendment links. Content is excluded by default.
}
