meta {
  name: Update Filing Parser Status
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/filings/parser-status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-request-id: {{requestId}}-parser-status
}

body:json {
  {
    "accessionNo": "{{sampleAccessionNo}}",
    "cik": "{{sampleCik}}",
    "parserStatus": "{{parserStatusValue}}"
  }
}

assert {
  res.status: eq 201
  res.body.job: eq "filings:parser-status-updated"
  res.body.correlationId: eq "{{requestId}}-parser-status"
  res.body.accessionNo: eq "{{sampleAccessionNo}}"
  res.body.cik: eq "{{sampleCik}}"
  res.body.parserStatus: eq "{{parserStatusValue}}"
}

tests {
  test("updates parser status for the selected filing", function() {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.job).to.equal("filings:parser-status-updated");
    expect(body.parserStatus).to.equal(bru.getEnvVar("parserStatusValue"));
  });
}

docs {
  Scenario: SEC-FILINGS-PARSER-STATUS-001
  Updates parser_status for an existing filing identified by CIK and accession number.
  This request changes database state and requires sampleAccessionNo to exist.
}
