meta {
  name: Retry Failed Filings
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/filing-retry-jobs
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-request-id: {{requestId}}-filing-retry
}

body:json {
  {
    "limit": {{retryLimit}},
    "cik": "{{sampleCik}}",
    "since": "{{sinceDate}}"
  }
}

assert {
  res.status: eq 201
  res.body.job: eq "filings:retry-failed"
  res.body.correlationId: eq "{{requestId}}-filing-retry"
  res.body.options.limit: eq {{retryLimit}}
  res.body.resetCount: isNumber
}

tests {
  test("moves matching failed filings back to pending", function() {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.job).to.equal("filings:retry-failed");
    expect(body.resetCount).to.be.a("number");
  });
}

docs {
  Scenario: SEC-FILINGS-RETRY-001
  Resets a bounded set of failed filing rows to pending for another download attempt.
  This request changes database state.
}
