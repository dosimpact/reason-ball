meta {
  name: Download Pending Filings
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/filing-download-jobs
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-request-id: {{requestId}}-filing-download
}

body:json {
  {
    "maxFiles": {{downloadMaxFiles}},
    "since": "{{sinceDate}}",
    "ciks": ["{{sampleCik}}"],
    "tickers": ["{{sampleTicker}}"]
  }
}

assert {
  res.status: eq 201
  res.body.job: eq "filings:download"
  res.body.correlationId: eq "{{requestId}}-filing-download"
  res.body.queued: isNumber
  res.body.downloaded: isNumber
  res.body.failed: isNumber
}

tests {
  test("downloads a bounded set of pending filings", function() {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.job).to.equal("filings:download");
    expect(body.queued).to.be.a("number");
    expect(body.downloaded + body.failed).to.equal(body.queued);
  });
}

docs {
  Scenario: SEC-FILINGS-DOWNLOAD-001
  Downloads pending filing documents and updates their pipeline status.
  This request performs external I/O, writes files, and changes database state.
}
