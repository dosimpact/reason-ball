meta {
  name: SEC-MODELING durable run history
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/modeling/runs?limit=10
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("run history envelope", function () {
    expect(res.getBody().items).to.be.an('array');
    expect(res.getBody().total).to.be.a('number');
  });
}
