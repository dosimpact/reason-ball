meta {
  name: SEC-MODELING completion one
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/modeling/filings?completedStages=1&limit=1
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("one",function(){const b=res.getBody();expect(res.getStatus()).to.equal(200);expect(b.total).to.equal(1);expect(b.items[0].stages["1"].readiness).to.equal("ready");});
}
