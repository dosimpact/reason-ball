meta {
  name: SEC-MODELING-ADMIN-002 overview
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/modeling/overview
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("overview",function(){const b=res.getBody();expect(b.scope).to.equal("filtered");expect(b.totalFilings).to.equal(6);expect(b.sourceCollected).to.equal(5);expect(b.sourceMissing).to.equal(1);for(const s of Object.values(b.stages)){expect(s.supported).to.equal(5);expect(s.unsupported).to.equal(1);expect(Object.values(s.latestRuns).reduce((a,n)=>a+n,0)).to.equal(5);}expect(b.stages["1"].latestRuns.SUCCEEDED).to.equal(2);expect(b.stages["1"].latestRuns.FAILED).to.equal(1);expect(b.stages["1"].latestRuns.QUEUED).to.equal(1);expect(b.stages["1"].latestRuns.unprocessed).to.equal(1);});
}
