tests {
  test("company-filter",function(){const b=res.getBody();expect(b.totalFilings).to.equal(2);expect(b.stages["1"].supported).to.equal(1);expect(b.stages["1"].unsupported).to.equal(1);expect(b.sourceCollected).to.equal(2);});
}
