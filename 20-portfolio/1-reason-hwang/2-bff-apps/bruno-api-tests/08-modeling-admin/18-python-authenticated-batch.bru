tests {
  test("python-authenticated-batch",function(){const b=res.getBody();expect(b.items).to.have.lengthOf(2);expect(b.items[0].stages["1"].generationId).to.equal("fixture-generation");expect(b.items[1].stages).to.deep.equal({});});
}
