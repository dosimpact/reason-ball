meta {
  name: SEC-MODELING-ADMIN-002 service-failure-visible
  type: http
  seq: 15
}
get {
  url: {{baseUrl}}/modeling/filings?limit=2
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("service-failure-visible",function(){const b=res.getBody();expect(b.total).to.equal(6);expect(b.items).to.have.lengthOf(2);expect(b.items[0].serviceError).to.be.a("string");expect(b.items[0].stages["1"].status).to.equal("unavailable");expect(b.items[1].stages["1"].status).to.equal("unsupported");});
}
