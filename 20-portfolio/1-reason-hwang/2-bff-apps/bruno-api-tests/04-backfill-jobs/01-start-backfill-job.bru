meta {
  name: 티커가 있는 전체 기업 공시 일괄 수집
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/all-company-filing-sync-jobs
  body: json
  auth: none
}

headers {
  Accept: text/event-stream
  Content-Type: application/json
}

body:json {
  {
    "years": {{backfillYears}},
    "downloadDocuments": true,
    "refreshArchive": {{backfillRefreshArchive}}
  }
}

assert {
  res.status: eq 200
}

tests {
  test("backfill SSE completes", function() {
    expect(res.getStatus()).to.equal(200);
    const events = String(res.getBody()).split('\n\n').filter(x => x.startsWith('event:')).map(x => ({event: x.split('\n')[0].slice(7), data: JSON.parse(x.split('\ndata: ')[1])}));
    expect(events[0].event).to.equal('started');
    const last = events[events.length - 1];
    expect(last.event).to.equal('completed');
    expect(last.data.failed).to.equal(0);
    expect(last.data.tickerOnly).to.equal(true);
  });
}

docs {
  SEC-TICKER-SCOPE-001: 실행 시작 시 DB ticker가 비어 있지 않은 회사만 수집한다. 회사 동기화를 먼저 실행한다.
  BFF-DIR-001: POST returns SSE, metadata first, optional documents second.
  Set downloadDocuments=false to skip documents. HTTP 200 alone does not imply success; inspect completed/error event.
  Native EventSource only supports GET; use streaming fetch or curl -N for live POST progress.
}
