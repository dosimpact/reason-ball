meta {
  name: 전체 기업 공시 일괄 수집
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/all-company-filing-sync-jobs
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "years": {{backfillYears}},
    "refreshArchive": {{backfillRefreshArchive}}
  }
}

script:post-response {
  if (res.getStatus() === 202 && res.getBody().runId) {
    bru.setVar("backfillRunId", res.getBody().runId);
  }
}

assert {
  res.status: eq 202
}

tests {
  test("start filing backfill response contract", function() {
    expect(res.getStatus()).to.equal(202);
    const body = res.getBody();
    expect(body.runId).to.be.a("string").and.not.empty;
    expect(["queued", "downloading", "running", "completed", "failed"]).to.include(body.status);
    expect(body.cutoffDate).to.match(/^\d{4}-\d{2}-\d{2}$/);
    expect(body.targetForms).to.be.an("array").that.includes("10-K");
    expect(Number.isNaN(Date.parse(body.requestedAt))).to.equal(false);
    ["archiveBytes", "processedEntries", "companiesUpserted", "filingsSeen", "filingsUpserted"].forEach(function(key) {
      expect(body[key], key).to.match(/^\d+$/);
    });
  });
}

docs {
  Scenario: SEC-BACKFILL-001
  Starts an asynchronous bulk archive import and saves backfillRunId for subsequent requests.
  Calls SEC and mutates PostgreSQL. years limits retained history, not archive download size.
  HTTP 202 means accepted, not completed. An already active run returns HTTP 409.
}
