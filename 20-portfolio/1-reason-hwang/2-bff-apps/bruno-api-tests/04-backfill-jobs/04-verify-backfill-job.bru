meta {
  name: 전체 기업 공시 수집 완전성 검증
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/all-company-filing-sync-jobs/{{backfillRunId}}/verification
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("backfillRunId")) {
    throw new Error("Start a backfill, fetch the latest run, or set backfillRunId before this request.");
  }
}

assert {
  res.status: eq 200
}

tests {
  test("verify filing backfill response contract", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.runId).to.be.a("string").and.not.empty;
    expect(body.runId).to.equal(bru.getVar("backfillRunId"));
    expect(["queued", "downloading", "running", "completed", "failed"]).to.include(body.runStatus);
    expect(body.cutoffDate).to.match(/^\d{4}-\d{2}-\d{2}$/);
    expect(body.targetForms).to.be.an("array").that.includes("10-K");
    expect(body.metadataComplete).to.be.a("boolean");
    expect(body.documentsComplete).to.be.a("boolean");
    expect(body.formCounts).to.be.an("array");
    body.formCounts.forEach(function(row) {
      expect(row.formType).to.be.a("string");
      expect(row.count).to.match(/^\d+$/);
    });
    ["totalFilings", "distinctCompanies", "outOfScopeForms", "beforeCutoff", "missingCompanyRows", "missingFilingUrls", "documentsStored", "documentsPending", "declaredDocumentBytes"].forEach(function(key) {
      expect(body[key], key).to.match(/^\d+$/);
    });
  });
}

docs {
  Scenario: SEC-BACKFILL-004
  Requires backfillRunId. Checks the verification response contract.
  Completeness flags may be false while processing or when documents remain pending.
  Verification aggregates current filings within the run cutoff and target forms.
}
