meta {
  name: List Companies With Filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/companies
  body: none
  auth: none
}

params:query {
  limit: {{companyLimit}}
  cik: {{sampleCik}}
  ticker: {{sampleTicker}}
  q: {{sampleQuery}}
}

assert {
  res.status: eq 200
  res.body.filters.limit: eq {{companyLimit}}
  res.body.pagination.page: eq 1
  res.body.pagination.pageSize: eq {{companyLimit}}
  res.body.pagination.totalItems: isNumber
  res.body.pagination.totalPages: isNumber
  res.body.pagination.hasNextPage: isBoolean
  res.body.items: isArray
}

tests {
  test("returns normalized company filters and an item array", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.pagination.totalPages).to.equal(Math.ceil(body.pagination.totalItems / body.pagination.pageSize));
    expect(body.items.length).to.be.at.most(body.pagination.pageSize);
    expect(body.items).to.be.an("array");
  });
}

docs {
  Scenario: SEC-COMPANIES-LIST-001
  Lists companies with pagination. limit is a pageSize alias; page defaults to 1.
  Use page=2&pageSize=20 for the next page. Optional filters are disabled by default.
}
