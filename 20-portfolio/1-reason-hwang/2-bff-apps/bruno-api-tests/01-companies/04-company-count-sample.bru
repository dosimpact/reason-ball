meta {
  name: SEC-COMPANY-FILING-COUNTS-001 sample company
  type: http
  seq: 4
}
get {
  url: {{baseUrl}}/companies?ticker={{sampleTicker}}&pageSize=1
  body: none
  auth: none
}
assert {
  res.status: eq 200
  res.body.items: isArray
}
tests {
  test("sample company has consistent metadata counts", function() {
    const body = res.getBody();
    expect(body.items.length).to.equal(1);
    const counts = body.items[0].filingCounts;
    expect(counts.total).to.be.greaterThan(0);
    expect(counts.byFormType.reduce((sum, row) => sum + row.count, 0)).to.equal(counts.total);
    bru.setVar("companyFilingsCount", counts.total);
  });
}
