# APP_ENV: local (console), stage/prod (JSON files). If omitted, follows NODE_ENV.
# APP_ENV=local
LOG_DIR=./data/logs
# LOG_LEVEL=info

PORT=2980
SWAGGER_ENABLED=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sec_collector

SEC_USER_AGENT=reason-hwang-bff/0.1 (your-email@example.com)
SEC_RATE_LIMIT_RPS=4
SEC_RETRY_COUNT=3
SEC_BACKFILL_BATCH_SIZE=500
SEC_BULK_SUBMISSIONS_URL=https://www.sec.gov/Archives/edgar/daily-index/bulkdata/submissions.zip
STATIC_CACHE_DIR=./data
SEC_DOCUMENT_MAX_BYTES=33554432
REMOTE_TEMPLATE_URL=http://127.0.0.1:2984
REMOTE_TODO_URL=http://127.0.0.1:2985

# SEC modeling internal FastAPI service; same private key on both services.
SEC_MODELING_URL=http://127.0.0.1:2981
SEC_MODELING_KEY=
SEC_MODELING_WORKER_ENABLED=true
