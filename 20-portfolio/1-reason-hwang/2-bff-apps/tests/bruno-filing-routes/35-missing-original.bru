meta {
  name: missing-original
  type: http
  seq: 35
}
get {
  url: {{baseUrl}}/filings?cik=8
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("SEC-AMEND-001 missing-original", function() {
    const body = res.getBody(); const item = body.items[0];
    expect(item.original).to.equal(null); expect(item.amendmentLinkStatus).to.equal('missing-original');
  });
}
