meta {
  name: ambiguous-original
  type: http
  seq: 36
}
get {
  url: {{baseUrl}}/filings?cik=9&formType=8-K%2FA
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("SEC-AMEND-001 ambiguous-original", function() {
    const body = res.getBody(); const item = body.items[0];
    expect(item.original).to.equal(null); expect(item.amendmentLinkStatus).to.equal('ambiguous-original');
  });
}
