meta {
  name: historical-content
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/filings?cik=1&page=2&pageSize=1&includeContent=true
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("BFF-DIR-001 historical-content", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().items[0].filingDate).to.equal('2020-01-01'); expect(res.getBody().items[0].content).to.equal('<html>Fixture report</html>'); bru.setVar('savedChecksum',res.getBody().items[0].checksum);
  });
}
