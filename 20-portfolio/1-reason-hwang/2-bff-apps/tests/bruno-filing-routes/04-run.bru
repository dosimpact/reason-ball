meta {
  name: run
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/all-company-filing-sync-jobs/{{runId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("SEC-API-NAME-001 run", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().runId).to.equal(bru.getVar("runId"));
  });
}
