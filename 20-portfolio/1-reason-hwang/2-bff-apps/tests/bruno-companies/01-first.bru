meta {
  name: first
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/companies?page=1&pageSize=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("SEC-COMPANIES-PAGE-001 first", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pagination).to.deep.equal({"page": 1, "pageSize": 2, "totalItems": 5, "totalPages": 3, "hasNextPage": true});
    expect(res.getBody().items.map(item => item.cik)).to.deep.equal(["0000000001", "0000000002"]);
    expect(res.getBody().filters.limit).to.equal(2);
  });
}
