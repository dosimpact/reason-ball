meta {
  name: second
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/companies?page=2&pageSize=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("SEC-COMPANIES-PAGE-001 second", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pagination).to.deep.equal({"page": 2, "pageSize": 2, "totalItems": 5, "totalPages": 3, "hasNextPage": true});
    expect(res.getBody().items.map(item => item.cik)).to.deep.equal(["0000000003", "0000000004"]);
    expect(res.getBody().filters.limit).to.equal(2);
  });
}
