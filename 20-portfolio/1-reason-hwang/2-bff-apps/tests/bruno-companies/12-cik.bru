meta {
  name: cik
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/companies?cik=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("SEC-COMPANIES-PAGE-001 cik", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pagination).to.deep.equal({"page": 1, "pageSize": 50, "totalItems": 1, "totalPages": 1, "hasNextPage": false});
    expect(res.getBody().items.map(item => item.cik)).to.deep.equal(["0000000002"]);
    expect(res.getBody().filters.limit).to.equal(50);
  });
}
