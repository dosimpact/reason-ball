meta {
  name: last
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/companies?page=3&pageSize=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("SEC-COMPANIES-PAGE-001 last", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pagination).to.deep.equal({"page": 3, "pageSize": 2, "totalItems": 5, "totalPages": 3, "hasNextPage": false});
    expect(res.getBody().items.map(item => item.cik)).to.deep.equal(["0000000005"]);
    expect(res.getBody().filters.limit).to.equal(2);
  });
}
