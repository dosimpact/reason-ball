meta {
  name: cap
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/companies?pageSize=100001
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("SEC-COMPANIES-PAGE-001 cap", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pagination).to.deep.equal({"page": 1, "pageSize": 100000, "totalItems": 5, "totalPages": 1, "hasNextPage": false});
    expect(res.getBody().items.map(item => item.cik)).to.deep.equal(["0000000001", "0000000002", "0000000003", "0000000004", "0000000005"]);
    expect(res.getBody().pagination.pageSize).to.equal(100000);
    expect(res.getBody()).to.have.all.keys("pagination", "items");
  });
}
