meta {
  name: empty
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/companies?q=missing&pageSize=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("SEC-COMPANIES-PAGE-001 empty", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pagination).to.deep.equal({"page": 1, "pageSize": 2, "totalItems": 0, "totalPages": 0, "hasNextPage": false});
    expect(res.getBody().items.map(item => item.cik)).to.deep.equal([]);
    expect(res.getBody().filters.limit).to.equal(2);
  });
}
