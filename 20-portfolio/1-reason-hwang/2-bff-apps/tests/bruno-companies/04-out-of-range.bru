meta {
  name: out-of-range
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/companies?page=4&pageSize=2
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("SEC-COMPANIES-PAGE-001 out-of-range", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().pagination).to.deep.equal({"page": 4, "pageSize": 2, "totalItems": 5, "totalPages": 3, "hasNextPage": false});
    expect(res.getBody().items.map(item => item.cik)).to.deep.equal([]);
    expect(res.getBody().filters.limit).to.equal(2);
  });
}
