meta {
  name: SEC-PREPARE-DEFAULT-001 explicit-refresh
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/sec-chat/prepare
  body: json
  auth: none
}
body:json {
  {"cik": "0000320193", "refresh": true}
}
assert {
  res.status: eq 200
}
tests {
  test("Actual prepare route forwards true refresh", function() {
    const body = res.getBody();
    expect(body.fixtureRefresh).to.equal(true);
    expect(body.threadId).to.match(/^[a-f0-9]{32}$/);
    expect(body.items).to.deep.equal(["Item 1"]);
  });
}
