meta {
  name: SEC-PREPARE-DEFAULT-001 default-saved
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/api/sec-chat/prepare
  body: json
  auth: none
}
body:json {
  {"cik": "0000320193"}
}
assert {
  res.status: eq 200
}
tests {
  test("Actual prepare route forwards false refresh", function() {
    const body = res.getBody();
    expect(body.fixtureRefresh).to.equal(false);
    expect(body.threadId).to.match(/^[a-f0-9]{32}$/);
    expect(body.items).to.deep.equal(["Item 1"]);
  });
}
