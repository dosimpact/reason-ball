tests {
 test("server owned verified answer",function(){const text=res.getBody(); expect(text).include("RUN_FINISHED"); expect(text).not.include("RUN_ERROR"); expect(text).include("80675000000"); expect(text).include("1.70"); expect(text).not.include("80111000000"); const lines=text.split("\n").filter(x=>x.startsWith("data:")); const events=lines.map(x=>JSON.parse(x.slice(5))); const p=events.find(x=>x.type==="TEXT_MESSAGE_CONTENT").delta; expect(p).match(/^root = Markdown\(/); bru.setVar("financialProgramJson",JSON.stringify(p));});
}
