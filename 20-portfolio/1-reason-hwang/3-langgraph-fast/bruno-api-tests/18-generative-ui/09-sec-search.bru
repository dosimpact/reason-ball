meta {
  name: sec-search
  type: http
  seq: 9
}
post {
  url: {{baseUrl}}/api/generative-ui/sec
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  const thread = "bru-sec-" + Date.now();
  bru.setVar("secThread", thread);
  req.setBody({thread_id: thread, message: "AAPL"});
}
assert {
  res.status: eq 200
}
tests {
  const events = String(res.getBody()).split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
  test("OPENUI-MIG-001 completed output", () => {
    expect(events.some(e => e.type === "RUN_ERROR")).to.equal(false);
    expect(events.some(e => e.type === "RUN_FINISHED")).to.equal(true);
  });
  const output = events.find(e => e.name === "ui.output")?.value;
  test("Actual company search", () => expect(output.controls).to.include("Apple"));
  bru.setVar("secRevision", output.revision);
}
