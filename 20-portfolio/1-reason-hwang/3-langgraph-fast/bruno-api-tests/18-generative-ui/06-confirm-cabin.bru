meta {
  name: confirm-cabin
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/api/generative-ui/fixed
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  req.setBody({thread_id: bru.getVar("cabinThread"), action: {name: "confirm_cabin", revision: bru.getVar("cabinRevision"), context: {flightId: "demo-icn-nrt", meal: "vegetarian", seat: "14C"}}});
}
assert {
  res.status: eq 200
}
tests {
  const events = String(res.getBody()).split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
  test("OPENUI-MIG-001 completed output", () => {
    expect(events.some(e => e.type === "RUN_ERROR")).to.equal(false);
    expect(events.some(e => e.type === "RUN_FINISHED")).to.equal(true);
  });
  const output = events.find(e => e.name === "ui.output")?.value;
  test("Exact confirmed choices", () => { expect(output.controls).to.include("채식"); expect(output.controls).to.include("14C"); expect(output.controls).not.to.include("@BusinessAction"); });
}
