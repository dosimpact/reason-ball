meta {
  name: query-sales
  type: http
  seq: 8
}
post {
  url: {{baseUrl}}/api/generative-ui/dynamic
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  req.setBody({thread_id: bru.getVar("dynamicThread"), action: {name: "search_sales", revision: bru.getVar("dynamicRevision"), context: {region: "seoul"}}});
}
assert {
  res.status: eq 200
}
tests {
  const events = String(res.getBody()).split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
  test("OPENUI-MIG-001 completed output", () => {
    expect(events.some(e => e.type === "RUN_ERROR")).to.equal(false);
    expect(events.some(e => e.type === "RUN_FINISHED")).to.equal(true);
  });
  const output = events.find(e => e.name === "ui.output")?.value;
  test("Server recomputes Seoul", () => expect(output.controls).to.include("$360,000"));
}
