meta {
  name: fixed-flight
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/generative-ui/fixed
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  const thread = "bru-fixed-" + Date.now();
  bru.setVar("fixedThread", thread);
  req.setBody({thread_id: thread, message: "인천에서 도쿄로 가는 가상 항공편 보여줘"});
}
assert {
  res.status: eq 200
}
tests {
  const events = String(res.getBody()).split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
  test("OPENUI-MIG-001 completed output", () => {
    expect(events.some(e => e.type === "RUN_ERROR")).to.equal(false);
    expect(events.some(e => e.type === "RUN_FINISHED")).to.equal(true);
  });
  const output = events.find(e => e.name === "ui.output")?.value;
  test("Requested direction", () => expect(output.controls).to.include("ICN → NRT"));
  bru.setVar("fixedRevision", output.revision);
}
