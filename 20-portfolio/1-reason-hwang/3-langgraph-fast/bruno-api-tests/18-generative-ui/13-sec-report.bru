meta {
  name: sec-report
  type: http
  seq: 13
}
post {
  url: {{baseUrl}}/api/generative-ui/sec
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  req.setBody({thread_id: bru.getVar("secThread"), action: {name: "sec_report", revision: bru.getVar("secRevision"), context: {request: "사업의 핵심만 두 항목으로 요약해줘"}}});
}
assert {
  res.status: eq 200
}
tests {
  const events = String(res.getBody()).split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
  test("OPENUI-MIG-001 completed output", () => {
    expect(events.some(e => e.type === "RUN_ERROR")).to.equal(false);
    expect(events.some(e => e.type === "RUN_FINISHED")).to.equal(true);
  });
  const output = events.find(e => e.name === "ui.output")?.value;
  test("sec-report", () => { expect(output.program.length).to.be.greaterThan(10); expect(output.controls).to.include("SHA-256"); expect(output.controls).to.include("[E"); });
  bru.setVar("secRevision", output.revision);
}
