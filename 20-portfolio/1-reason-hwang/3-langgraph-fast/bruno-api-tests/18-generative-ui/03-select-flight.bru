meta {
  name: select-flight
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/api/generative-ui/fixed
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  req.setBody({thread_id: bru.getVar("fixedThread"), action: {name: "select_flight", revision: bru.getVar("fixedRevision"), context: {flightId: "demo-icn-nrt"}}});
}
assert {
  res.status: eq 200
}
tests {
  const events = String(res.getBody()).split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
  test("OPENUI-MIG-001 completed output", () => {
    expect(events.some(e => e.type === "RUN_ERROR")).to.equal(false);
    expect(events.some(e => e.type === "RUN_FINISHED")).to.equal(true);
  });
  const output = events.find(e => e.name === "ui.output")?.value;
  test("Selection is not booking", () => expect(output.controls).to.include("선택 완료 · 실제 예약 아님"));
}
