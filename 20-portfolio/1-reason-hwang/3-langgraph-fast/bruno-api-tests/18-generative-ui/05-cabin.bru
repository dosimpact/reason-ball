meta {
  name: cabin
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/generative-ui/fixed
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  const thread = "bru-cabin-" + Date.now();
  bru.setVar("cabinThread", thread);
  req.setBody({thread_id: thread, message: "인천 도쿄 항공편의 기내식과 좌석 모두 선택하고 싶어"});
}
assert {
  res.status: eq 200
}
tests {
  const events = String(res.getBody()).split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
  test("OPENUI-MIG-001 completed output", () => {
    expect(events.some(e => e.type === "RUN_ERROR")).to.equal(false);
    expect(events.some(e => e.type === "RUN_FINISHED")).to.equal(true);
  });
  const output = events.find(e => e.name === "ui.output")?.value;
  test("Both cabin selectors", () => { expect(output.controls).to.include("기내식"); expect(output.controls).to.include("좌석"); });
  bru.setVar("cabinRevision", output.revision);
}
