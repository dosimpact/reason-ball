meta {
  name: Reject action from a different thread
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/ag-ui/a2ui/fixed
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  const manifest = bru.getVar("a2uiManifest");
  const mode = "fixed";
  const contract = {protocolVersion: manifest.protocolVersion, ...manifest.catalogs[mode]};
  const body = {threadId: "a2ui-" + Date.now() + "-" + Math.random(), runId: "run-" + Date.now(), state: {}, messages: [], tools: [], context: [], forwardedProps: {a2uiContract: contract}};
  body.threadId = bru.getVar("a2uiFixedThread");
  body.forwardedProps.a2uiAction = {userAction: {name: "select_flight", surfaceId: bru.getVar("a2uiFixedSurface"), sourceComponentId: "select", context: {flightId: "demo-icn-nrt"}}};
  body.threadId = "other-" + Date.now();
  req.setBody(body);
}
assert {
  res.status: eq 422
}
tests {
  test("STATE-01: cross-thread action is rejected", function () {
    expect(res.getBody().detail).to.include("does not belong");
  });
}
