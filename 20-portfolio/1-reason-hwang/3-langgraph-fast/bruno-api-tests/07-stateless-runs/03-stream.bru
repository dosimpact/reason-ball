meta {
  name: Stateless Stream Run
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/runs/stream
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {"assistant_id": "main_graph", "input": {"message": "stream"}, "stream_mode": "values"}
}

assert {
  res.status: eq 200
}

tests {
  test("BRUNO-RUN-03: streams a stateless result", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
