tests {
  test("composition contract", () => {
  const b=res.getBody();expect(b.results.rsi.status).to.equal("success");expect(b.followUpsStatus).to.equal("ready");expect(b.presentation.program).to.be.a("string");bru.setVar("compositionProgramJson",JSON.stringify(b.presentation.program));
  });
