meta {
  name: Cancel Thread Run
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/threads/{{threadId}}/runs/{{runId}}/cancel?action=interrupt
  body: none
}

assert {
  res.status: eq 200
}

tests {
  test("BRUNO-RUN-01: interrupts the held run", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
