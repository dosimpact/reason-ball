meta {
  name: SEC-PREPARE-001 json-prepare
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/api/sec-chat/prepare
  body: json
  auth: none
}
body:json {
  {"cik":"0000000001","refresh":false}
}
assert {
  res.status: eq 200
}
tests {
  test("json-prepare", function () {
    const b = res.getBody();
    expect(b.filing.cik).to.equal("0000000001");
    expect(b.checkedAt).to.equal(null);
    expect(b.toolCalls).to.deep.equal(["list_sec_filings", "get_sec_filing_content"]);
    expect(b.items).to.include("8");
    bru.setVar("prepareJson", b.threadId);
  });
}
