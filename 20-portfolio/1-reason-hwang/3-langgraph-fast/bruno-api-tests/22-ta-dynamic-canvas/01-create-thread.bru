meta {
  name: TA-CANVAS-API-01 Create owned validation thread
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/threads
  body: json
  auth: none
}
body:json {
  {"metadata":{"validation":"ta-dynamic-canvas-api","source":"api-validation"}}
}
assert {
  res.status: eq 200
}
tests {
  test("Owned thread created", function () {
    expect(res.getBody().thread_id).to.be.a("string");
    bru.setVar("canvasThread",res.getBody().thread_id);
  });
}
