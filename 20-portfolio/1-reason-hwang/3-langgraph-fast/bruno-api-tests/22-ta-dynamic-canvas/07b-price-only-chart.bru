meta {
  name: TA-CANVAS-API-07B Price-only v2 chart
  type: http
  seq: 11
}
get {
  url: {{baseUrl}}/technical-analysis/chart?ticker=TEST&interval=1d&count=60&schema_version=2&instances=%5B%5D
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("An explicit empty instance list returns price bars without indicator panels", function () {
    const data = res.getBody();
    expect(data.schemaVersion).to.equal(2);
    expect(data.bars).to.have.lengthOf(60);
    expect(data.indicators).to.have.lengthOf(0);
    expect(data.as_of).to.equal(data.bars.at(-1).time);
  });
}
