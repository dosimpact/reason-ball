meta {
  name: TA-CANVAS-API-01 Indicator explanation does not create a report
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/threads/{{canvasThread}}/runs/stream
  body: json
  auth: none
}
body:json {
  {"assistant_id":"technical_analysis_canvas_agent","input":{"messages":[{"role":"user","content":"RSI가 무엇인지 두 문장으로만 설명해 주세요. 종목 조회나 분석은 하지 마세요."}],"canvas_context":null},"stream_mode":["values","custom"]}
}
assert {
  res.status: eq 200
}
tests {
  test("Explanation has no canvas report or open event", function () {
    const text = res.getBody();
    expect(text).to.be.a("string");
    const events = text.split(/\r?\n\r?\n/).flatMap(block => {
      const name = block.split(/\r?\n/).find(line => line.startsWith("event:"))?.slice(6).trim();
      const raw = block.split(/\r?\n/).filter(line => line.startsWith("data:")).map(line => line.slice(5).trim()).join("\n");
      try { return [{ name, data: JSON.parse(raw) }]; } catch { return []; }
    });
    expect(events.some(event => event.name === "error")).to.equal(false);
    const values = events.filter(event => event.name === "values").at(-1)?.data;
    expect(values).to.be.an("object");
    expect(Object.keys(values.canvas_reports || {})).to.have.lengthOf(0);
    expect(events.filter(event => event.name === "custom" && event.data.channel === "canvas" && event.data.type === "open")).to.have.lengthOf(0);
  });
}
