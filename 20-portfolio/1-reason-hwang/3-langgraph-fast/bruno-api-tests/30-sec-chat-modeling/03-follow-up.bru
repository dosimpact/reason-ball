meta {
 name: SEC-CHAT-MODELING-001 follow-up
 type: http
 seq: 3
}
post {
 url: {{baseUrl}}/api/sec-chat/chat
 body: json
 auth: none
}
body:json {
 {"threadId":"{{researchThread}}","message":"normal explain that revenue"}
}
assert {
 res.status: eq 200
}
tests {
 test("follow-up",function(){const events=res.getBody().split("\n").filter(x=>x.startsWith("data:")).map(x=>JSON.parse(x.slice(5)));expect(events.some(x=>x.type==="RUN_FINISHED")).eq(true);expect(events.some(x=>x.type==="RUN_ERROR")).eq(false);const meta=events.find(x=>x.name==="sec.evidence").value;const m=meta.modeling;expect(meta.findings[0].item).eq("8");expect(meta.findings[0].quote).include("Net sales");expect(m.status).eq("available");});
}
