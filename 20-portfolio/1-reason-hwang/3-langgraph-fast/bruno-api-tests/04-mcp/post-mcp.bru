meta {
  name: MCP Tools List
  type: http
  seq: 1
}

docs {
  Plan: BRUNO-MCP-01, BRUNO-MCP-02, BRUNO-MCP-03, BRUNO-MCP-04
}

post {
  url: {{baseUrl}}/mcp/
  body: json
  auth: none
}

headers {
  Accept: application/json, text/event-stream
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": "bruno-mcp-tools",
    "method": "tools/list",
    "params": {}
  }
}

assert {
  res.status: eq 200
  res.body.id: eq bruno-mcp-tools
  res.body.result.tools: isArray
}

tests {
  test("MCP exposes the three graph tools", function() {
    expect(res.getBody().jsonrpc).to.equal("2.0");
    const names = res.getBody().result.tools.map((tool) => tool.name);
    expect(names).to.include.members(["main_graph", "tenk_subgraph", "starter_graph"]);
    expect(res.getBody().result.tools.every((tool) => tool.inputSchema.type === "object")).to.equal(true);
  });
}
