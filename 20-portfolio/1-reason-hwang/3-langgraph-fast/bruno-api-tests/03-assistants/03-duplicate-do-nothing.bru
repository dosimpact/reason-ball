meta {
  name: Duplicate Assistant Do Nothing
  type: http
  seq: 3
}

docs {
  Plan scenario: BRUNO-ASST-02
}

post {
  url: {{baseUrl}}/assistants
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "assistant_id": "{{assistantId}}",
    "graph_id": "main_graph",
    "if_exists": "do_nothing",
    "name": "Must Not Replace Existing"
  }
}

assert {
  res.status: eq 200
  res.body.name: eq Bruno Contract Assistant
  res.body.version: eq 1
}

tests {
  test("BRUNO-ASST-02 do_nothing returns the unchanged assistant", function() {
    expect(res.getBody().assistant_id).to.equal(bru.getVar("assistantId"));
    expect(res.getBody().metadata.stage).to.equal("created");
  });
}
