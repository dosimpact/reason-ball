meta {
  name: Reject unavailable seat
  type: http
  seq: 4
}
post {
  url: {{baseUrl}}/ag-ui/a2ui/fixed
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  const manifest = bru.getVar("a2uiManifest");
  const mode = "fixed";
  const contract = {protocolVersion: manifest.protocolVersion, ...manifest.catalogs[mode]};
  const body = {threadId: "a2ui-" + Date.now() + "-" + Math.random(), runId: "run-" + Date.now(), state: {}, messages: [], tools: [], context: [], forwardedProps: {a2uiContract: contract}};
  body.threadId = bru.getVar("a2uiFixedThread");
  body.forwardedProps.a2uiAction = {userAction: {name: "confirm_cabin", surfaceId: bru.getVar("a2uiFixedSurface"), sourceComponentId: "confirm", context: {flightId: "demo-nrt-icn", meal: "vegetarian", seat: "99Z"}}};
  req.setBody(body);
}
assert {
  res.status: eq 422
}
tests {
  test("CABIN-02: altered confirmed selection is rejected", function () {
    expect(res.getStatus()).to.equal(422);
  });
}
