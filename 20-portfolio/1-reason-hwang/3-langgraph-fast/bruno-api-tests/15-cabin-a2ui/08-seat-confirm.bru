meta {
  name: seat selection confirms only visible field
  type: http
  seq: 8
}
post {
  url: {{baseUrl}}/ag-ui/a2ui/fixed
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  const manifest = bru.getVar("a2uiManifest");
  const mode = "fixed";
  const contract = {protocolVersion: manifest.protocolVersion, ...manifest.catalogs[mode]};
  const body = {threadId: "a2ui-" + Date.now() + "-" + Math.random(), runId: "run-" + Date.now(), state: {}, messages: [], tools: [], context: [], forwardedProps: {a2uiContract: contract}};
  body.threadId = bru.getVar("a2uiFixedThread");
  body.forwardedProps.a2uiAction = {userAction: {name: "confirm_cabin", surfaceId: bru.getVar("a2uiFixedSurface"), sourceComponentId: "confirm", context: {flightId: "demo-nrt-icn", seat: "14C"}}};
  req.setBody(body);
}
assert {
  res.status: eq 200
}
tests {
  const events = res.getBody().split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
  test("ACT-01: selection updates authoritative state", function () {
    expect(events.some(event => event.type === "RUN_ERROR")).to.equal(false);
    const snapshots = events.filter(event => event.type === "STATE_SNAPSHOT" && event.snapshot.surfaces);
    const surfaces = snapshots[snapshots.length - 1].snapshot.surfaces;
    expect(Object.keys(surfaces)).to.deep.equal([bru.getVar("a2uiFixedSurface")]);
    expect(surfaces[bru.getVar("a2uiFixedSurface")].data.confirmed).to.equal(true);
    expect(surfaces[bru.getVar("a2uiFixedSurface")].data.meal).to.equal(undefined);
    expect(surfaces[bru.getVar("a2uiFixedSurface")].data.seat).to.equal("14C");
  });
}
