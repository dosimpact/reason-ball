meta {
  name: SEC-A2UI-10 06-empty-search
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/ag-ui/a2ui/sec
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  const manifest = bru.getVar("agentManifest");
  const threadId = bru.getVar("agentThread");
  bru.setVar("agentThread", threadId);
  req.setBody({threadId, runId: "run-" + Date.now(), state: {}, tools: [], context: [],
    messages: [{id: "user-" + Date.now(), role: "user", content: "NO_MATCH_SEC_AGENT_20260922 라는 회사명으로 정확히 한 번만 검색해줘"}],
    forwardedProps: {a2uiContract: {protocolVersion: manifest.protocolVersion, ...manifest.catalogs.sec}}});
}
assert {
  res.status: eq 200
}
tests {
  const events = res.getBody().split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
  test("SEC-A2UI-10 06-empty-search", function () {
    expect(events.some(e => e.type === "RUN_ERROR")).to.equal(false);
    expect(events.some(e => e.type === "RUN_FINISHED")).to.equal(true);
    const names = events.filter(e => e.type === "TOOL_CALL_START").map(e => e.toolCallName);
    const snapshots = events.filter(e => e.type === "STATE_SNAPSHOT");
    const snapshot = snapshots[snapshots.length - 1].snapshot;
    expect(names).to.include("search_companies");
    expect(names).to.include("render_fixed_ui");
    expect(snapshot.sec.companies.items).to.have.length(0);
    expect(snapshot.sec.company).to.equal(undefined);
    const tree = Object.values(snapshot.surfaces)[0].components;
    expect(tree["companies-empty"]).not.to.equal(undefined);
    expect(tree["company-table"]).to.equal(undefined);
    bru.setVar("agentSnapshot", snapshot);
    console.log("Agent tools:", names.join(" -> ") || "text only");
  });
}
