meta {
  name: SEC-CHART quarterly-financials
  type: http
  seq: 7
}
post {
  url: {{baseUrl}}/ag-ui/a2ui/sec
  body: json
  auth: none
}
headers {
  Content-Type: application/json
  Accept: text/event-stream
}
body:json {
  {}
}
script:pre-request {
  const manifest = bru.getVar("uxManifest");
  const body = {threadId: bru.getVar("financialThread"), runId: "financial-" + Date.now(), messages: [{id: "request-" + Date.now(), role: "user", content: "CPNG 회사의 2026-08-04 제출 10-Q를 선택하고, 해당 보고서의 2026년과 2025년 6월30일 종료 3개월 연결 매출과 영업이익(6개월 누적 제외)을 그룹 막대 차트 하나로 비교해줘."}], state: {}, tools: [], context: [], forwardedProps: {a2uiOutputTarget: "inline", a2uiContract: {protocolVersion: manifest.protocolVersion, ...manifest.catalogs.sec}}};
  body.threadId = "financial-" + Date.now(); bru.setVar("financialThread", body.threadId);
  req.setBody(body);
}
assert {
  res.status: eq 200
}
tests {
  test("SEC-CHART quarterly-financials", function () {
    const events = res.getBody().split("\n").filter(line => line.startsWith("data: ")).map(line => JSON.parse(line.slice(6)));
    expect(events.some(e => e.type === "RUN_ERROR")).to.equal(false);
    expect(events.some(e => e.type === "RUN_FINISHED")).to.equal(true);
    const names = events.filter(e => e.type === "TOOL_CALL_START").map(e => e.toolCallName);
    console.log("Tool calls", JSON.stringify(names));
    for (const e of events.filter(e => e.type === "TOOL_CALL_RESULT")) { try { const v=JSON.parse(e.content); if(v.error) console.log("Tool error", v); } catch {} }
    expect(names).to.include("render_financial_charts");
    const snapshot = events.filter(e => e.type === "STATE_SNAPSHOT").slice(-1)[0].snapshot;
    const dataset = snapshot.sec.financial_dataset;
    expect(dataset.filing.accessionNo).to.equal("0001834584-26-000073");
    expect(dataset.coverage.unreadTableCount).to.be.greaterThan(0);
    const charts = Object.values(snapshot.surfaces).flatMap(s => Object.values(s.components)).filter(c => c.component === "FinancialChart");
    expect(charts.length).to.be.greaterThan(0);
    expect(names).to.include("extract_financial_data");
    expect(names.indexOf("extract_financial_data")).to.be.lessThan(names.indexOf("render_financial_charts"));
    expect(dataset.observations.some(o => o.exactValue === "8856000000")).to.equal(true);
    expect(dataset.observations.some(o => o.exactValue === "-556000000")).to.equal(true);
    expect(dataset.periods.length).to.equal(2);
    expect(dataset.periods.every(p => p.duration_class === "quarter")).to.equal(true);
  });
}
