meta {
  name: Create Thread
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/threads
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "metadata": {"suite": "bruno-threads"},
    "if_exists": "raise"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("threadId", res.getBody().thread_id);
}

tests {
  test("BRUNO-THREAD-01: creates a thread and stores threadId", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
