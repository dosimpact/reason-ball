meta {
  name: OPENUI-CATALOG-001 real Canvas graph via production manager
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/threads/{{catalogThread}}/runs/stream
  body: json
  auth: none
}
body:json {
  {"assistant_id":"technical_analysis_canvas_agent","input":{"messages":[{"role":"human","content":"선택 지표의 검증된 결과를 설명해 주세요."}],"canvas_context":{"request":{"ticker":"TEST","interval":"1d","count":60,"indicators":[{"name":"SMA","parameters":{"timeperiod":5}},{"name":"EMA","parameters":{"timeperiod":20}},{"name":"CMF","parameters":{"timeperiod":14}}]}}},"stream_mode":["values","custom"]}
}
assert {
  res.status: eq 200
}
tests {
  test("Model-generated Canvas items and parser-validated output",function(){
    const events=res.getBody().split(/\r?\n\r?\n/).flatMap(block=>{const lines=block.split(/\r?\n/);const name=lines.find(l=>l.startsWith("event:"))?.slice(6).trim();try{return[{name,data:JSON.parse(lines.filter(l=>l.startsWith("data:")).map(l=>l.slice(5).trim()).join("\n"))}];}catch{return[];}});
    expect(events.some(e=>e.name==="error")).to.equal(false);
    const state=events.filter(e=>e.name==="values").at(-1).data;const report=state.canvas_reports[state.canvas_report_id];expect(report.status).to.equal("ready");
    expect(report.program).to.include('CanvasItem(');expect(report.program).to.include('FinancialChart(');expect(report.program).to.include('technical_analysis_chart');
    expect(Object.keys(report.elements)).to.have.lengthOf(4);
    bru.setVar("catalogProgramJson",JSON.stringify(report.program));
  });
}
