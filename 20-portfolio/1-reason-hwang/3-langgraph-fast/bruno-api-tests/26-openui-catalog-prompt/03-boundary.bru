meta {
  name: OPENUI-CATALOG-001 captured model boundary
  type: http
  seq: 3
}
get {
  url: {{baseUrl}}/qa/catalog-probe
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("Latest full catalog precedes restrictive per-call scope",function(){const b=res.getBody();expect(b.calls).to.equal(1);for(const [key,value] of Object.entries(b)){if(key!=="calls")expect(value,key).to.equal(true);}});
}
