    },
    "options": [
      {
        "value": "12A",
        "label": "12A · 창가"
      },
      {
        "value": "12B",
        "label": "12B · 가운데"
      },
      {
        "value": "12C",
        "label": "12C · 통로"
      },
      {
        "value": "14A",
        "label": "14A · 창가"
      },
      {
        "value": "14C",
        "label": "14C · 통로"
      }
    ],
    "disabled": {
      "path": "/confirmed"
    }
  },
  {
    "id": "summary",
    "component": "Text",
