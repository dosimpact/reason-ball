{
  "name": "reason-hwang-langgraph-fast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bruno": "open -a Bruno bruno-api-tests",
    "dev": "uv run python -m uvicorn server.server:app --env-file .env --reload",
    "dev:langgraph": "uv run langgraph dev --no-browser",
    "start": "uv run python -m uvicorn server.server:app --env-file .env",
    "build": "uv build",
    "test": "uv run pytest",
    "test:api": "pnpm exec bru run bruno-api-tests --env local",
    "lint": "uv run --with ruff ruff check .",
    "typecheck": "uv run --with pyright pyright",
    "sync": "uv sync",
    "clean": "rm -rf dist build .pytest_cache .ruff_cache .pyright .coverage coverage htmlcov",
    "test:push-ui:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 16-push-ui-message --env local",
    "test:sec-chat": "uv run pytest tests/test_sec_intelligent_ui.py",
    "test:sec-chat:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 17-sec-intelligent-ui --env local",
    "test:sec-tools": "uv run pytest tests/test_sec_tools.py tests/test_sec_intelligent_ui.py tests/test_sec_admin_chat.py",
    "test:generative-ui:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 18-generative-ui --env openui-validation",
    "test:technical-analysis": "uv run pytest tests/test_technical_analysis_agent.py tests/graph/subgraph/price_agent tests/infrastructure/technical_analysis tests/graph/shared/cache",
    "test:technical-analysis:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 19-technical-analysis --env local"
  },
  "devDependencies": {
    "@usebruno/cli": "^2.13.0"
  }
}
