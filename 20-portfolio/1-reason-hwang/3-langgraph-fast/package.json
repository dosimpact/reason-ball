{
  "name": "@reason-hwang/langgraph-fast-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bruno": "open -a Bruno bruno-api-tests",
    "dev": "uv run --env-file .env sh -c 'exec python -m uvicorn server.server:app --env-file .env --port \"${SERVER_PORT:-2981}\" --reload \"$@\"' --",
    "dev:langgraph": "uv run --env-file .env sh -c 'exec langgraph dev --no-browser --port \"${LANGGRAPH_PORT:-2982}\" \"$@\"' --",
    "start": "uv run --env-file .env sh -c 'exec python -m uvicorn server.server:app --env-file .env --port \"${SERVER_PORT:-2981}\" \"$@\"' --",
    "build": "uv build",
    "test": "uv run pytest",
    "test:api": "pnpm exec bru run bruno-api-tests --env local",
    "lint": "uv run --with ruff ruff check .",
    "typecheck": "uv run --with pyright pyright",
    "sync": "uv sync",
    "clean": "rm -rf dist build .pytest_cache .ruff_cache .pyright .coverage coverage htmlcov",
    "test:push-ui:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 16-push-ui-message --env local",
    "test:sec-chat": "uv run pytest tests/test_sec_intelligent_ui.py",
    "test:sec-chat:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 17-sec-intelligent-ui --env local",
    "test:sec-tools": "uv run pytest tests/test_sec_tools.py tests/test_sec_intelligent_ui.py tests/test_sec_admin_chat.py",
    "test:generative-ui:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 18-generative-ui --env openui-validation",
    "test:technical-analysis": "uv run pytest tests/test_technical_analysis_agent.py tests/graph/subgraph/price_agent tests/infrastructure/technical_analysis tests/graph/shared/cache",
    "test:technical-analysis:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 19-technical-analysis --env local",
    "model1:sample": "uv run --env-file .env python scripts/tenk_model1_sample.py",
    "test:model1": "uv run pytest tests/test_document_structure.py",
    "test:sec-modeling": "uv run pytest tests/test_sec_modeling.py tests/test_sec_evidence_chain.py tests/test_sec_edgar_transforms.py tests/test_document_structure.py tests/test_sec_structural_chunking.py tests/test_sec_modeling_tools.py tests/test_sec_retrieval_validation.py tests/test_sec_fact_unit_filter.py",
    "test:sec-modeling:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 20-sec-modeling",
    "validate:sec-retrieval": "uv run --env-file .env python scripts/validate_sec_retrieval.py",
    "validate:sec-model2": "uv run --env-file .env python scripts/validate_sec_model2_live.py",
    "model3:sample": "uv run --env-file .env python scripts/model3_three_samples.py",
    "model3:reset": "uv run --env-file .env python scripts/reset_sec_model3.py",
    "test:model3:samples": "uv run pytest tests/test_model3_three_samples.py",
    "test:model3:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 21-sec-model3-samples --env local",
    "test:sec-modeling-agent": "uv run pytest tests/test_sec_modeling_agent.py",
    "validate:sec-modeling-agent": "uv run --env-file .env python scripts/validate_sec_modeling_agent.py",
    "test:sec-modeling-agent:api": "cd bruno-api-tests && ../node_modules/.bin/bru run 22-sec-modeling-agent --env-var bffBaseUrl=http://127.0.0.1:2980"
  },
  "devDependencies": {
    "@usebruno/cli": "^2.13.0"
  }
}
