{
  "name": "reason-hwang-langgraph-fast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn server.server:app --reload",
    "studio": "npx kill-port 2024 && uv run langgraph dev --host 0.0.0.0 --port 2024 --tunnel",
    "langgraph:validate": "uv run langgraph validate",
    "langgraph:build": "uv run langgraph build -t reason-hwang-langgraph-fast-api",
    "langgraph:up": "uv run langgraph up --image reason-hwang-langgraph-fast-api --port 8123 --wait",
    "studio:dev": "npx kill-port 2810 && uv run langgraph dev --host 0.0.0.0 --port 2810",
    "start": "uv run uvicorn server.server:app",
    "build": "uv build",
    "test": "uv run pytest",
    "test:tenk": "uv run pytest tests/domains/tenk tests/graph/subgraph/tenk tests/server/test_tenk_*.py -q",
    "test:tenk:domain": "uv run pytest tests/domains/tenk -q",
    "test:tenk:api": "uv run pytest tests/server/test_tenk_*.py -q",
    "test:tenk:graph": "uv run pytest tests/graph/subgraph/tenk -q",
    "tenk:fetch": "uv run python scripts/tenk_fetch_report.py --ticker AAPL --form 10-K --output .tmp/tenk/latest-10k.txt --metadata-output .tmp/tenk/latest-10k.json",
    "tenk:parse:dry-run": "uv run python scripts/tenk_parse_dry_run.py --input .tmp/tenk/latest-10k.txt --metadata .tmp/tenk/latest-10k.json --pretty",
    "tenk:init-neo4j": "uv run python scripts/tenk_init_neo4j.py --pretty",
    "tenk:graph:write": "uv run python scripts/tenk_graph_write.py --input .tmp/tenk/latest-10k.txt --metadata .tmp/tenk/latest-10k.json --pretty",
    "tenk:query": "uv run python scripts/tenk_query.py --query \"What are the main risks?\" --metadata .tmp/tenk/latest-10k.json --pretty",
    "tenk:smoke": "pnpm run tenk:fetch && pnpm run tenk:parse:dry-run && pnpm run tenk:init-neo4j && pnpm run tenk:graph:write && pnpm run tenk:query",
    "smoke:tenk:http": "uv run python scripts/smoke_tenk_api.py --input .tmp/tenk/latest-10k.txt --metadata .tmp/tenk/latest-10k.json",
    "test:neo4j": "RUN_NEO4J_TESTS=1 uv run pytest -m neo4j tests/integration -q",
    "lint": "uv run --with ruff ruff check .",
    "typecheck": "uv run --with pyright pyright",
    "docker:build": "docker build -f Dockerfile.langgraph -t reason-hwang-langgraph-fast-api .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "sync": "uv sync",
    "clean": "rm -rf dist build .pytest_cache .ruff_cache .pyright .coverage coverage htmlcov"
  }
}