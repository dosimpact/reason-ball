ENV_PROFILE=local

OPENAI_BASE_URL=http://127.0.0.1:18741/v1
OPENAI_API_KEY=chatgpt-oauth-placeholder
OPENAI_MODEL=gpt-5.6-luna
# A2UI uses a separate streaming model; defaults to the OPENAI settings above.
A2UI_MODEL_PROVIDER=oauth-proxy
A2UI_SEC_BFF_URL=http://127.0.0.1:2801
# A2UI_MODEL=gpt-5.6-luna
# A2UI_MODEL_BASE_URL=http://127.0.0.1:18741/v1
# For api-key mode, set a real key locally (never commit it).
# A2UI_MODEL_API_KEY=
MAX_CONCURRENT_RUNS=10
MAX_QUEUED_RUNS=10
LANGGRAPH_STANDARD_OPENAPI=/absolute/path/to/.apb-workspace/docs/01-plan/langgraph-standard.json

POSTGRES_PORT=your
POSTGRES_HOST=your
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your
POSTGRES_DB=your
POSTGRES_SCHEMA=langgraph
