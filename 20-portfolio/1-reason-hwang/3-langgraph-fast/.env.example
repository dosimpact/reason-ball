ENV_PROFILE=local

OPENAI_BASE_URL=http://127.0.0.1:2890/v1
OPENAI_API_KEY=chatgpt-oauth-placeholder
OPENAI_MODEL=gpt-5.6-luna
# OpenUI uses a separate streaming model; defaults to the OPENAI settings above.
OPENUI_MODEL_PROVIDER=oauth-proxy
OPENUI_SEC_BFF_URL=http://127.0.0.1:2801
# OPENUI_MODEL=gpt-5.6-luna
# OPENUI_MODEL_BASE_URL=http://127.0.0.1:2890/v1
# For api-key mode, set a real key locally (never commit it).
# OPENUI_MODEL_API_KEY=
MAX_CONCURRENT_RUNS=10
MAX_QUEUED_RUNS=10
LANGGRAPH_STANDARD_OPENAPI=/absolute/path/to/.apb-workspace/docs/01-plan/langgraph-standard.json

POSTGRES_PORT=your
POSTGRES_HOST=your
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your
POSTGRES_DB=your
POSTGRES_SCHEMA=langgraph

# SEC Intelligent UI: shares the OpenUI output subgraph; defaults to OPENAI_* model settings.
SEC_CHAT_BFF_URL=http://127.0.0.1:2801
# SEC_CHAT_MODEL=gpt-5.6-luna
# SEC_CHAT_MODEL_BASE_URL=http://127.0.0.1:2890/v1
# SEC_CHAT_API_KEY=

# OpenUI parser validation service (frontend)
SEC_CHAT_UI_VALIDATOR_URL=http://127.0.0.1:2800/api/sec-ui/validate
