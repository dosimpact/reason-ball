# FastAPI server port
SERVER_PORT=2981

# LangGraph development server port
LANGGRAPH_PORT=2982

ENV_PROFILE=local

# One switch for every chat agent and OpenUI output: oauth-proxy (default) | openai
CHAT_LLM_PROVIDER=oauth-proxy
CHAT_LLM_OAUTH_BASE_URL=http://127.0.0.1:2890/v1
CHAT_LLM_OAUTH_MODEL=gpt-5.6-luna
CHAT_LLM_OAUTH_API_KEY=chatgpt-oauth-placeholder
CHAT_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_LLM_OPENAI_MODEL=gpt-4.1-mini
CHAT_LLM_OPENAI_API_KEY=
# Legacy OPENAI_* remain available to non-chat API clients (e.g. Decisions).
# Do not point OPENAI_API_KEY at an OAuth placeholder if another direct API needs it.
OPENUI_SEC_BFF_URL=http://127.0.0.1:2980
MAX_CONCURRENT_RUNS=10
MAX_QUEUED_RUNS=10
LANGGRAPH_STANDARD_OPENAPI=/absolute/path/to/.apb-workspace/docs/01-plan/langgraph-standard.json

POSTGRES_PORT=your
POSTGRES_HOST=your
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your
POSTGRES_DB=your
POSTGRES_SCHEMA=langgraph

# SEC Intelligent UI uses the shared CHAT_LLM_* settings.
SEC_CHAT_BFF_URL=http://127.0.0.1:2980

# OpenUI parser validation service (frontend)
SEC_CHAT_UI_VALIDATOR_URL=http://127.0.0.1:2983/api/sec-ui/validate

# SEC modeling service-to-service key; shared with BFF SEC_MODELING_KEY.
SEC_MODELING_KEY=
SEC_EXTRACTION_BASE_URL=http://127.0.0.1:2890/v1
SEC_EXTRACTION_API_KEY=oauth
# Separate from the OAuth proxy; embeddings use the public OpenAI endpoint.
SEC_EMBEDDING_BASE_URL=https://api.openai.com/v1
SEC_EMBEDDING_API_KEY=

# Model 3 calls the public OpenAI Decisions API directly (gpt-6-luna).
# Optional dedicated public API key; otherwise uses OPENAI_API_KEY. Never uses OPENAI_BASE_URL.
SEC_DECISIONS_API_KEY=

# PostgreSQL multi-worker graph runtime (deploy migration first; no memory fallback).
LANGGRAPH_RUNTIME_MODE=memory
LANGGRAPH_RUNTIME_NAMESPACE=fastapi
# Optional immutable deployment label; omit to hash packaged graph/source/lock artifacts.
# LANGGRAPH_EXECUTION_VERSION=release-2026-11-16
LANGGRAPH_MAX_ACTIVE=10
LANGGRAPH_MAX_QUEUED=10
LANGGRAPH_WORKER_MAX_ACTIVE=10
LANGGRAPH_LEASE_SECONDS=30
LANGGRAPH_HEARTBEAT_SECONDS=5
LANGGRAPH_POLL_SECONDS=1
LANGGRAPH_RUNTIME_LISTEN=true
LANGGRAPH_DRAIN_SECONDS=10
LANGGRAPH_CANCEL_WAIT_SECONDS=10
LANGGRAPH_DB_POOL_MIN=1
LANGGRAPH_DB_POOL_MAX=8
LANGGRAPH_DB_POOL_TIMEOUT=5
LANGGRAPH_MAX_RESULT_BYTES=67108864
