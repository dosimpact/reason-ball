{
  "name": "reason-hwang",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start --filter=@reason-hwang/fe-host --filter=@reason-hwang/bff-apps --filter=@reason-hwang/langgraph-fast-api",
    "start:fe-host": "turbo run start --filter=@reason-hwang/fe-host",
    "start:bff-apps": "turbo run start --filter=@reason-hwang/bff-apps",
    "start:langgraph-fast-api": "turbo run start --filter=@reason-hwang/langgraph-fast-api",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@reason-hwang/fe-host",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "infra:up": "turbo run infra:up --filter='./infra/*'",
    "infra:down": "turbo run infra:down --filter='./infra/*'",
    "infra:ps": "turbo run infra:ps --filter='./infra/*'",
    "test:dev": "node --test scripts/dev-ports.test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  }
}
