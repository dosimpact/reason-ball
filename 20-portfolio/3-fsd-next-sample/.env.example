# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_RUNTIME_MODE=development
NEXT_PUBLIC_DATA_PROVIDER=supabase
# Only Playwright/dev fixtures may set this to `mock`; production fails closed.
NEXT_PUBLIC_APP_RUNTIME_MODE=development

# Supabase (use local values from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Enable only after Supabase CAPTCHA is configured for anonymous auth.
AUTH_REQUIRE_CAPTCHA=false
# Private reward links are clamped to 60-600 seconds by the server.
REWARD_SIGNED_URL_TTL_SECONDS=300

# AI SDK provider. Development routes through the infrastructure OAuth proxy.
AI_PROVIDER=oauth-proxy
AI_API_MODE=responses
# OpenAI-compatible base URL. Keep the /v1 suffix for this proxy.
CHATGPT_OAUTH_PROXY_URL=http://127.0.0.1:18741/v1
CHATGPT_OAUTH_PROXY_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_ALLOWED_CHAT_MODELS=gpt-5.6-terra,gpt-5-mini
# Verified deployment capabilities keyed by allowed model ID. Never infer from names.
# Missing flags are unknown: text works, but files/tools require explicit true.
# Replace {} after verifying the configured provider/API mode. Example shape:
# {"your-model":{"vision":true,"documents":false,"tools":true,"reasoning":null}}
AI_CHAT_MODEL_CAPABILITIES={}
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts

# Deterministic browser tests
E2E_USE_MOCKS=true
MOCK_AI_SEED=character-english-ai-e2e
