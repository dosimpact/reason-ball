{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission catalog index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogs"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["categoryId", "file"],
        "properties": {
          "categoryId": { "enum": ["daily", "travel", "social", "work"] },
          "file": { "type": "string", "pattern": "^(daily|travel|social|work)/catalog\\.json$" }
        }
      }
    }
  }
}
