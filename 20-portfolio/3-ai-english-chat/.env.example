# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Exact additional browser origins (scheme, host and port) allowed for API writes.
APP_ALLOWED_ORIGINS=http://192.168.0.45:3000,http://dodonet.iptime.org:13000
APP_RUNTIME_MODE=development
NEXT_PUBLIC_DATA_PROVIDER=supabase
# Only Playwright/dev fixtures may set this to `mock`; production fails closed.
NEXT_PUBLIC_APP_RUNTIME_MODE=development

# Supabase (use the remote project URL and keys from the dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://oaewaygmejlmzclckygk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Enable only after Supabase CAPTCHA is configured for anonymous auth.
AUTH_REQUIRE_CAPTCHA=false
# Private reward links are clamped to 60-600 seconds by the server.
REWARD_SIGNED_URL_TTL_SECONDS=300

# AI SDK provider. Development routes through the infrastructure OAuth proxy.
AI_PROVIDER=oauth-proxy
# Optional operation routing. Empty inherits AI_PROVIDER; chat/draft/evaluation stay unchanged.
# Google media uses GOOGLE_GENERATIVE_AI_API_KEY; openai uses OPENAI_API_KEY.
# Missing credentials or unsupported endpoints fail; there is no automatic mock fallback.
# Explicit APP_RUNTIME_MODE=mock or AI_PROVIDER=mock keeps all operations mocked.
AI_IMAGE_PROVIDER=google
AI_SPEECH_PROVIDER=google
AI_API_MODE=responses
# OpenAI-compatible base URL. Keep the /v1 suffix for this proxy.
CHATGPT_OAUTH_PROXY_URL=http://127.0.0.1:18741/v1
CHATGPT_OAUTH_PROXY_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_ALLOWED_CHAT_MODELS=gpt-5.6-terra,gpt-5-mini
# Verified deployment capabilities keyed by allowed model ID. Never infer from names.
# Missing flags are unknown: text works, but files/tools require explicit true.
# Replace {} after verifying the configured provider/API mode. Example shape:
# {"your-model":{"vision":true,"documents":false,"tools":true,"reasoning":null}}
AI_CHAT_MODEL_CAPABILITIES={}
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts

# Deterministic browser tests
E2E_USE_MOCKS=true
MOCK_AI_SEED=character-english-ai-e2e

# Google Gemini media (server only). Enable billing for Veo; never use NEXT_PUBLIC_ keys.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional Cloud Text-to-Speech credential: not interchangeable with the Gemini key.
GOOGLE_TTS_API_KEY=
# To use Cloud TTS Chirp 3 HD instead: AI_SPEECH_PROVIDER=google-cloud-tts,
# AI_SPEECH_MODEL=chirp-3-hd. No automatic provider fallback occurs.
AI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Google defaults: AI_IMAGE_MODEL=gemini-3.1-flash-image, AI_SPEECH_MODEL=gemini-3.8-flash-tts
