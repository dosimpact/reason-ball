meta {
  name: Get Thread Snapshot
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/langgraph/threads/{{runtimeThreadId}}/snapshot
  body: none
}

docs {
  Reads the persisted runtime thread state after a stream run.
  Verifies that messages, selected_filing, and evidence_bundle are saved.
}

assert {
  res.status: eq 200
  res.body.threadId: eq {{runtimeThreadId}}
}

tests {
  test("snapshot should persist messages", function() {
    const state = res.getBody().state;
    expect(state.messages).to.be.an("array");
    expect(state.messages.length).to.be.greaterThan(1);
  });

  test("snapshot should persist evidence bundle", function() {
    const state = res.getBody().state;
    expect(state.evidence_bundle).to.be.an("array");
    expect(state.evidence_bundle.length).to.be.greaterThan(0);
  });
}
