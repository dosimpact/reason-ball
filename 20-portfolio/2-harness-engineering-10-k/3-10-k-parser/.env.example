# Neo4j (matches 1-infra-graph-rag default ports/credentials)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=test1234
NEO4J_DATABASE=neo4j

# Collector API (future integration)
# Supports either http://localhost:3305 or http://localhost:3305/api
COLLECTOR_API_BASE_URL=http://localhost:3305
COLLECTOR_API_TOKEN=

# API server
APP_HOST=0.0.0.0
APP_PORT=3406
PARSER_BACKEND_BASE_URL=http://localhost:3406

# LLM
LLM_PROVIDER=codex-cli
LLM_API_KEY=
LLM_MODEL=gpt-5
CODEX_CLI_PATH=codex
CODEX_PROFILE=
CODEX_SANDBOX=read-only
CODEX_EXEC_TIMEOUT_SEC=45

# Parser runtime
LOG_LEVEL=INFO
PARSER_MAX_WORKERS=4
PARSER_CHUNK_MAX_CHARS=6000
PARSER_CHUNK_OVERLAP=400
PARSER_JOB_STORE_MAX_JOBS=1000
PARSER_JOB_STORE_TTL_SECONDS=86400
RUNTIME_DB_PATH=./data/runtime.db
RUNTIME_STORE_MAX_THREADS=500
RUNTIME_STORE_RETENTION_DAYS=30

# Local mock input for development
MOCK_DOCUMENTS_PATH=./examples/mock_documents.json
