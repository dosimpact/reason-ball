{
  "info": {
    "name": "10-k-collector API Tests",
    "_postman_id": "f12677a0-fb63-4c3f-954a-10k-collector-bruno-converted",
    "description": "SEC 10-K collector API test collection.\n  Recommended flow:\n  1. Run Company Sync Job to refresh the companies table.\n  2. Run Filing Sync Job to queue filing metadata as pending.\n  3. Run Filing Download Job to download pending filing documents.\n  4. Use the filings queries and status summary endpoints to inspect current state.\n  5. Use Filing Retry Job to move failed downloads back to pending.\n  Filing query filter note:\n  - parserStatus is an exact-match filter for filings.parser_status.\n  - To request rows whose parser_status is the empty string, the HTTP query must be parserStatus=\n  - Do not send parserStatus='' because that means the literal two-character string ''.\n  - Some tools may omit empty query parameters automatically; verify the final requested URL when testing this case.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "health",
      "item": [
        {
          "name": "Health - List Filings Default",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/filings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "filings"
              ],
              "query": []
            },
            "description": "Basic health check for the filings listing endpoint.\n  No query params are provided, so the API applies its defaults.\n  Expected behavior:\n  - status 200\n  - response contains filters and items fields\n  This is useful as a lightweight smoke test before running narrower filing queries."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is success\", function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "// Original Bruno tests preserved below for manual adaptation if needed.",
                  "// test(\"default filings endpoint should respond\", function() {",
                  "//     expect(res.getStatus()).to.equal(200);",
                  "//     const body = res.getBody();",
                  "//     expect(body).to.have.property(\"filters\");",
                  "//     expect(body).to.have.property(\"items\");",
                  "//   });"
                ]
