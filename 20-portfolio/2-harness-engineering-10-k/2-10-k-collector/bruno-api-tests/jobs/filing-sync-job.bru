meta {
  name: Filing Sync Job
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/filing-sync-jobs
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "page": {{filingSyncPage}},
    "pageSize": {{filingSyncPageSize}},
    "since": "{{sinceDate}}"
  }
}

docs {
  Syncs filing metadata from SEC submissions into the filings table.
  This stages rows with status pending and does not download documents yet.
  Request body:
  - page: 1-based page index for the companies batch
  - pageSize: max number of companies to scan in this batch
  - since: optional YYYY-MM-DD lower bound for filing_date
  Response:
  - job: filings:sync
  - requestedAt: ISO timestamp
  - options: normalized request options
  - pagination: page metadata including totalCompanies, totalPages, hasNextPage
  - companiesProcessed: number of companies scanned
  - filingsSynced: number of filing metadata rows inserted or updated
}

assert {
  res.status: eq 201
  res.body.job: eq "filings:sync"
  res.body.options.page: eq {{filingSyncPage}}
  res.body.options.pageSize: eq {{filingSyncPageSize}}
  res.body.pagination.page: eq {{filingSyncPage}}
  res.body.pagination.pageSize: eq {{filingSyncPageSize}}
  res.body.pagination.totalCompanies: isNumber
  res.body.pagination.totalPages: isNumber
  res.body.pagination.hasNextPage: isBoolean
  res.body.companiesProcessed: isNumber
  res.body.filingsSynced: isNumber
}
