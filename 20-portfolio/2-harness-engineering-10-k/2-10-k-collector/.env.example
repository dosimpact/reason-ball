# Preferred connection style
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/sec_collector

# API server
APP_HOST=0.0.0.0
APP_PORT=3305

# Optional split config (used when DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sec_collector

# SEC policy
SEC_USER_AGENT=sec-filings-collector/0.1 (your-email@example.com)
SEC_RATE_LIMIT_RPS=4
SEC_RETRY_COUNT=3

# Paths
DATA_DIR=./nest-static-data
