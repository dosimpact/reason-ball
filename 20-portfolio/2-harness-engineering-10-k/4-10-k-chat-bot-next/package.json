{
  "name": "@10k/chatbot",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "sh ./scripts/preserve-next-env.sh sh -c 'PORT=${PORT:-3003}; next dev --webpack --port \"$PORT\"'",
    "build": "sh ./scripts/preserve-next-env.sh next build --webpack",
    "start": "sh -c 'PORT=${PORT:-3003}; next start -p \"$PORT\"'",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "test": "export PLAYWRIGHT=True && pnpm exec playwright test",
    "test:unit": "pnpm exec tsx scripts/investment-assistant-runtime-state-smoke.ts && pnpm exec tsx scripts/sec-api-response-smoke.ts && sh ./scripts/preserve-next-env.sh sh -c 'rm -rf .next/types .next/dev/types && pnpm exec next typegen && pnpm exec tsc --noEmit'",
    "test:e2e": "sh -c 'if [ \"${1:-}\" = \"--\" ]; then shift; fi; export PORT=${PORT:-3003}; export CHATBOT_BASE_URL=\"${CHATBOT_BASE_URL:-http://127.0.0.1:${PORT}/}\"; export PLAYWRIGHT_SKIP_WEBSERVER=${PLAYWRIGHT_SKIP_WEBSERVER:-true}; export PLAYWRIGHT=True; pnpm exec playwright test tests/e2e/investment-assistant-inline-panels.test.ts tests/e2e/sec-api-contract.test.ts tests/e2e/sec-playground.test.ts --project=e2e --workers=1 \"$@\"' --",
    "clean": "rm -rf .next playwright-report test-results"
  },
