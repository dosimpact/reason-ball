{
  "name": "@reason-ball/codebase-memory-todo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5174",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.json",
    "codebase-memory:proxy": "node scripts/codebase-memory-proxy.mjs",
    "start": "node dist/server/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0 --port 5174"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^20.17.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
