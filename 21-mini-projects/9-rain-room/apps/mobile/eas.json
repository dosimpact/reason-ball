{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      },
      "node": "24.13.1",
      "corepack": true,
      "pnpm": "12.4.1",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview"
      },
      "node": "24.13.1",
      "corepack": true,
      "pnpm": "12.4.1",
      "environment": "preview"
    },
    "production": {
      "env": {
        "APP_ENV": "production"
      },
      "node": "24.13.1",
      "corepack": true,
      "pnpm": "12.4.1",
      "environment": "production"
    }
  }
}
