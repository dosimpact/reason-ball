{
  "name": "@rain-room/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client --tunnel --port 8081",
    "start": "expo start --dev-client --tunnel --port 8081",
    "tunnel": "expo start --dev-client --tunnel --port 8081",
    "expo-go": "expo start --go --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "APP_ENV=development expo export --platform ios --platform android --output-dir dist --max-workers 2",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dev:tunnel": "expo start --dev-client --tunnel --port 8081",
    "build:production": "APP_ENV=production expo export --platform ios --platform android --output-dir dist --max-workers 2",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "i18next": "^27.1.0",
    "expo": "~58.0.23",
    "expo-dev-client": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1",
    "expo-constants": "~58.0.15",
    "expo-splash-screen": "~58.0.13"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
