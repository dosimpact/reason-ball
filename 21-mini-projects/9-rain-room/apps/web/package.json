{
  "name": "@rain-room/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "pnpm run validate:music && pnpm run validate:scenes && pnpm run validate:pixi && pnpm run validate:drinks && pnpm run validate:ambience && pnpm run validate:world && pnpm run validate:interactions && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node tests/browser-check.mjs",
    "preview:backgrounds": "node tests/render-backgrounds.mjs",
    "archive:drink-photos": "node scripts/prepare-drink-assets.mjs",
    "validate:drinks": "node --test tests/drink-assets.test.ts",
    "validate:music": "node scripts/validate-music.ts",
    "lint:fsd": "node scripts/lint-fsd.mjs",
    "validate:scenes": "node scripts/export-scene-effects.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:fsd",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "export:pixi": "node scripts/export-pixi-scenes.mjs",
    "validate:pixi": "node --test tests/pixi-assets.test.ts",
    "test:pixi-browser": "node tests/pixi-browser.mjs",
    "export:ambience": "node scripts/export-scene-ambience.ts",
    "validate:ambience": "node scripts/export-scene-ambience.ts --check",
    "validate:world": "node --test tests/scene-world-art.test.ts",
    "validate:interactions": "node --test tests/scene-interactive-catalog.test.ts",
    "preview:framing": "node scripts/capture-scene-framing.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "^27.1.0",
    "motion": "^14.12.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "steiger": "^0.10.0",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
