meta {
  name: stale-revision
  type: http
  seq: 5
}
patch {
  url: {{baseUrl}}/api/documents/{{cwDocument}}/codeweave/cw
  body: json
  auth: none
}
body:json {
  {
    "expectedRevision": 1,
    "expectedSource": "[App]\n  -> FLOW: 시작\n    -> (+) Custom: 처리 // 설명",
    "nodeId": "line:3",
    "patch": {
      "text": "수정",
      "inlineComment": "변경 설명"
    }
  }
}
assert {
  res.status: eq 409
}
tests {
  test("stale-revision", function() { expect(res.getBody().error).to.include('revision'); });
}
