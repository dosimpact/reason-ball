{
  "name": "planner-mcp-2",
  "version": "1.0.0",
  "private": true,
  "description": "Structured planning, implementation and verification workspace",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:codeweave && next dev --hostname 0.0.0.0 --port 4000",
    "build": "pnpm build:codeweave && next build",
    "start": "next start --hostname 0.0.0.0 --port 4000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "storybook": "storybook dev --host 127.0.0.1 --port 6106 --ci",
    "build-storybook": "storybook build",
    "test:api": "node scripts/e2e.mjs api",
    "build:codeweave": "tsc -p src/modules/codeweave/tsconfig.build.json",
    "test:codeweave": "vitest run tests/codeweave",
    "check:codeweave": "pnpm build:codeweave && node scripts/check-codeweave.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "mermaid": "^11.12.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.13.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@usebruno/cli": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.0.0"
  }
