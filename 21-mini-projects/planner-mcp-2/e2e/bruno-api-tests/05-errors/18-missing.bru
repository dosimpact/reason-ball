meta {
  name: 05-errors-missing
  type: http
  seq: 18
}
get {
  url: {{baseUrl}}/api/documents/absent
  body: none
  auth: none
}

assert {
  res.status: eq 404
}
tests {
  test("missing", function() {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.include('not found');
  });
}
