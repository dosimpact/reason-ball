meta {
  name: 03-documents-catalog
  type: http
  seq: 5
}
get {
  url: {{baseUrl}}/api/documents/{{indexId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}
tests {
  test("catalog", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().children.some(c=>c.id===bru.getVar('documentId') && c.href)).to.equal(true);
  });
}
