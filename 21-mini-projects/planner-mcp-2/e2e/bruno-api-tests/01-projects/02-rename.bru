meta {
  name: 01-projects-rename
  type: http
  seq: 2
}
patch {
  url: {{baseUrl}}/api/projects/{{projectId}}
  body: json
  auth: none
}

body:json {
  {
    "title": "Renamed Bruno"
  }
}

assert {
  res.status: eq 200
}
tests {
  test("rename", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().title).to.equal('Renamed Bruno');
  });
}
