meta {
  name: move-node
  type: http
  seq: 3
}
patch {
  url: {{baseUrl}}/api/projects/{{projectId}}/nodes/{{nodeId}}
  body: json
  auth: none
}
body:json {
  { "label": "Moved design", "phase": "design", "documentId": "{{indexId}}", "position": 0, "coordinates": {"x": 275.5, "y": -40} }
}
assert {
  res.status: eq 200
}
tests {
  test("move-node", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().coordinates).to.deep.equal({x:275.5,y:-40});
  });
}
