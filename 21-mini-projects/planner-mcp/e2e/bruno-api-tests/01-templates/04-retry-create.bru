meta {
  name: TPL-API retry-create
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/templates
  body: json
  auth: none
}

body:json {
  {
    "requestId": "bruno-create",
    "template": {
      "name": "bruno-api-design",
      "title": "API 설계",
      "description": "Bruno fixture",
      "format": "markdown",
      "body": "# {{title}}",
      "example": "# 조회 API",
      "prompt": "근거를 확인하고 작성하세요."
    }
  }
}

assert {
  res.status: eq 201
}

tests {
  test("TPL-001/002/004/005 retry-create", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().result.revision).to.equal(1);
  });
}
