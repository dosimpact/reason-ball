# Browser-visible addresses
APP_BASE_URL=http://localhost:3000
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Server-to-server addresses. Use localhost when apps run outside Docker.
KEYCLOAK_INTERNAL_URL=http://localhost:8180
RESOURCE_SERVER_URL=http://localhost:4000

OIDC_REALM=oauth-lab
OIDC_CLIENT_ID=oauth-lab-bff
OIDC_CLIENT_SECRET=oauth-lab-secret-local-only
OIDC_RESOURCE_AUDIENCE=oauth-lab-resource
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
