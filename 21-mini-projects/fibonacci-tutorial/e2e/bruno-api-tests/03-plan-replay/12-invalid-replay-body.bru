meta {
  name: Reject invalid replay body
  type: http
  seq: 18
}
post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/replay
  body: json
  auth: none
}

body:json {
  {
    "expectedCursor": "8"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("Reject invalid replay body", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.code).to.equal('VALIDATION_ERROR');
  });
}
