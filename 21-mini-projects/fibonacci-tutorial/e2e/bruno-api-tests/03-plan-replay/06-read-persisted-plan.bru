meta {
  name: Read unchanged persisted plan
  type: http
  seq: 12
}
get {
  url: {{baseUrl}}/api/sessions/{{sessionId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("Read unchanged persisted plan", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.plan).to.deep.equal(JSON.parse(bru.getVar('planSnapshot')));
    expect(body.cursor).to.equal(7);
    expect(body.visibleCandles).to.have.length(8);
  });
}
