meta {
  name: Unknown plan session
  type: http
  seq: 16
}
post {
  url: {{baseUrl}}/api/sessions/00000000-0000-4000-8000-000000000000/plan
  body: json
  auth: none
}

body:json {
  {
    "waveIndices": [
      0,
      3,
      6
    ],
    "entry": 114,
