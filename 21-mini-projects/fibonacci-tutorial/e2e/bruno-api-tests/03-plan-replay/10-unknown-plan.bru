    "target": 142.36,
    "rationale": "Unknown session"
  }
}

assert {
  res.status: eq 404
}

tests {
  test("Unknown plan session", function() {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error.code).to.equal('NOT_FOUND');
  });
}
