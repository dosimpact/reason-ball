meta {
  name: Reject invalid plan body
  type: http
  seq: 9
}
post {
  url: {{baseUrl}}/api/sessions/{{sessionId}}/plan
  body: json
  auth: none
}

body:json {
  {
    "waveIndices": [
      0,
      3,
      6
    ],
    "entry": 114,
    "stopLoss": 99,
    "rationale": "Missing target"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("Reject invalid plan body", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.code).to.equal('VALIDATION_ERROR');
  });
}
