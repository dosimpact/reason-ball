meta {
  name: all-curriculum
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/api/catalog
  body: none
  auth: none
}

assert {
  res.status: eq 200
}
tests {
  test("all-curriculum", function() {
    const data = res.getBody();
    expect(data.chapters).to.have.length(10); const units=data.chapters.flatMap(c=>c.units); expect(units).to.have.length(44); expect(units.filter(u=>u.mode==='theory')).to.have.length(16); expect(new Set(units.map(u=>u.id)).size).to.equal(44);
  });
}
