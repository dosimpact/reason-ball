meta {
  name: advanced-review-prev
  type: http
  seq: 10
}
post {
  url: {{baseUrl}}/api/sessions/{{advancedTheoryId}}/advance
  body: json
  auth: none
}

body:json {
  {
    "expectedStep": 4,
    "direction": "prev"
  }
}

assert {
  res.status: eq 200
}
tests {
  test("advanced-review-prev", function() {
    const data = res.getBody();
    expect(data.theoryStep).to.equal(3); expect(data.visibleCandles).to.have.length(48); expect(data.complete).to.equal(false);
  });
}
