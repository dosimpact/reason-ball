meta {
  name: Create session for early replay
  type: http
  seq: 4
}
post {
  url: {{baseUrl}}/api/sessions
  body: json
  auth: none
}

body:json {
  {
    "unitId": "wave-three"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Create session for early replay", function() {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    bru.setVar('earlySessionId', body.id);
    expect(body.cursor).to.equal(7);
    expect(body.visibleCandles).to.have.length(8);
    expect(body.plan).to.equal(null);
  });
}
