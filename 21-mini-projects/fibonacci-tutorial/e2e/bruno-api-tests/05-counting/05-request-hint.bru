meta {
  name: request-hint
  type: http
  seq: 6
}
post {
  url: {{baseUrl}}/api/sessions/{{countId}}/hint
  body: json
  auth: none
}

body:json {
  {
    "kind": "hint"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("request-hint", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.hint).to.be.a('string').that.is.not.empty;
  });
}
