meta {
  name: confirm-market-plan
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/sessions/{{marketId}}/plan
  body: json
  auth: none
}

body:json {
  {{marketPlanBody}}
}

assert {
  res.status: eq 200
}

tests {
  test("confirm-market-plan", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.plan.source).to.equal('binance');
    bru.setVar('marketPlanSnapshot',JSON.stringify(data.plan));
  });
}
