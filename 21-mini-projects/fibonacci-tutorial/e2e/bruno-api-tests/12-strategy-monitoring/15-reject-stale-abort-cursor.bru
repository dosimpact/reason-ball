meta {
  name: reject-stale-abort-cursor
  type: http
  seq: 15
}
post {
  url: {{baseUrl}}/api/sessions/{{manualMonitorId}}/monitoring/abort
  body: json
  auth: none
}
body:json {
  {
    "expectedPlanId": "{{manualMonitorPlanId}}",
    "expectedCursor": 7,
    "reason": "stale"
  }
}
assert {
  res.status: eq 409
}
tests {
  test("reject-stale-abort-cursor", function() {
    const data=res.getBody();
    expect(data.error).to.exist;
  });
}
