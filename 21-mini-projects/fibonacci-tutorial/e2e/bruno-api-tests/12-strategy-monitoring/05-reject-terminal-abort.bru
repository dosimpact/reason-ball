meta {
  name: reject-terminal-abort
  type: http
  seq: 5
}
post {
  url: {{baseUrl}}/api/sessions/{{monitorId}}/monitoring/abort
  body: json
  auth: none
}
body:json {
  {
    "expectedPlanId": "{{monitorPlanId}}",
    "expectedCursor": 8,
    "reason": "이미 종료된 실행"
  }
}
assert {
  res.status: eq 409
}
tests {
  test("reject-terminal-abort", function() {
    const data=res.getBody();
    expect(data.error).to.exist;
  });
}
