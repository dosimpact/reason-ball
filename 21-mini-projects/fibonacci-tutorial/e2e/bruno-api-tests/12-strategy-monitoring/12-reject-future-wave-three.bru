meta {
  name: reject-future-wave-three
  type: http
  seq: 12
}
post {
  url: {{baseUrl}}/api/sessions/{{manualMonitorId}}/plan
  body: json
  auth: none
}
body:json {
  {
    "waveIndices": [
      0,
      3,
      6
    ],
    "entry": 114,
    "stopLoss": 99,
    "target": 150,
    "rationale": "확정봉의 파동 전제와 가격 경계를 기록한다.",
    "monitoring": {
      "policy": "auto-abort",
      "rule": {
        "kind": "wave4-overlap",
        "wave3Index": 100
      }
    }
  }
}
assert {
  res.status: eq 400
}
tests {
  test("reject-future-wave-three", function() {
    const data=res.getBody();
    expect(data.error).to.exist;
  });
}
