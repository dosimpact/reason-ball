meta {
  name: freeze-monitor-rule
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/sessions/{{monitorId}}/plan
  body: json
  auth: none
}
body:json {
  {
    "waveIndices": [
      0,
      3,
      6
    ],
    "entry": 112,
    "stopLoss": 99,
    "target": 150,
    "rationale": "확정봉의 파동 전제와 가격 경계를 기록한다.",
    "monitoring": {
      "policy": "auto-abort",
      "rule": {
        "kind": "price-level",
        "level": 111.5
      }
    }
  }
}
assert {
  res.status: eq 200
}
tests {
  test("freeze-monitor-rule", function() {
    const data=res.getBody();
    expect(data.plan.monitoringConfig.rule.level).to.equal(111.5); expect(data.monitoring.status).to.equal('PENDING'); expect(data.monitoring.events).to.have.length(1); bru.setVar('monitorPlanId',data.plan.id);
  });
}
