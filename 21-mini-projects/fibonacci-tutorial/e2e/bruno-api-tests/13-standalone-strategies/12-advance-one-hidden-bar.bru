meta {
  name: advance-one-hidden-bar
  type: http
  seq: 12
}
post {
  url: {{baseUrl}}/api/strategies/{{strategyId}}/runs/{{stepRunId}}/step
  body: json
  auth: none
}
body:json {
  {"expectedVersion":4}
}
assert {
  res.status: eq 200
}
tests {
  test("advance-one-hidden-bar", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.version).to.equal(5); const run=data.runs.find(r=>r.id===bru.getVar('stepRunId')); expect(run.observedCount).to.equal(1); expect(run.cursor).to.equal(8); expect(run.monitoring.status).to.equal('OPEN'); expect(data.visibleCandles).to.have.length(9);
  });
}
