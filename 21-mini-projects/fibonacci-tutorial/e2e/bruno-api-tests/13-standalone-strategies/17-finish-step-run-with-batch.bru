meta {
  name: finish-step-run-with-batch
  type: http
  seq: 17
}
post {
  url: {{baseUrl}}/api/strategies/{{strategyId}}/runs/{{stepRunId}}/batch
  body: json
  auth: none
}
body:json {
  {"expectedVersion":8}
}
assert {
  res.status: eq 200
}
tests {
  test("finish-step-run-with-batch", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.version).to.equal(9); const run=data.runs.find(r=>r.id===bru.getVar('stepRunId')); expect(run.controlStatus).to.equal('COMPLETED'); expect(run.monitoring.status).to.equal('CLOSED_TP'); expect(run.evaluation.realizedPnl).to.equal(21); const sig={status:run.evaluation.status,entry:run.evaluation.entryPrice,exit:run.evaluation.exitPrice,r:run.evaluation.realizedR,events:run.monitoring.events.map(e=>[e.kind,e.candleTime,e.price])}; bru.setVar('stepRunSignature',JSON.stringify(sig)); bru.setVar('stepRunSnapshot',JSON.stringify(run));
  });
}
