meta {
  name: resume-forward-after-pause
  type: http
  seq: 31
}
post {
  url: {{baseUrl}}/api/strategies/{{forwardId}}/runs/{{forwardRunId}}/resume
  body: json
  auth: none
}
body:json {
  {"expectedVersion":5}
}
assert {
  res.status: eq 200
}
tests {
  test("resume-forward-after-pause", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.version).to.equal(6); expect(data.runs[0].controlStatus).to.equal('RUNNING'); expect(data.runs[0].monitoring.status).to.equal('OPEN');
  });
}
