meta {
  name: restore-revision-draft
  type: http
  seq: 22
}
get {
  url: {{baseUrl}}/api/strategies/{{strategyId}}
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("restore-revision-draft", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.status).to.equal('DRAFT'); expect(data.plan).to.equal(null); expect(data.plans[0]).to.deep.equal(JSON.parse(bru.getVar('planSnapshot'))); expect(data.runs).to.have.length(2); expect(data.visibleCandles.every(c=>c.time<=data.asOf)).to.equal(true);
  });
}
