meta {
  name: get-draft-without-future
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/api/strategies/{{strategyId}}
  body: none
  auth: none
}
assert {
  res.status: eq 200
}
tests {
  test("get-draft-without-future", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.visibleCandles).to.have.length(8); expect(data.visibleCandles.every(c=>c.time<=data.asOf)).to.equal(true); expect(data).not.to.have.property('candles'); expect(data.snapshotId).to.equal(bru.getVar('strategySnapshot'));
  });
}
