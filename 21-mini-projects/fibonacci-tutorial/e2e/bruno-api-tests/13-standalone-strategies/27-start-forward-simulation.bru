meta {
  name: start-forward-simulation
  type: http
  seq: 27
}
post {
  url: {{baseUrl}}/api/strategies/{{forwardId}}/runs
  body: json
  auth: none
}
body:json {
  {"expectedVersion":2,"mode":"FORWARD"}
}
assert {
  res.status: eq 201
}
tests {
  test("start-forward-simulation", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    expect(data.version).to.equal(3); const run=data.runs[0]; expect(run.mode).to.equal('FORWARD'); expect(run.observedCount).to.equal(0); expect(run.dataRange).to.deep.equal({startTime:data.asOf,endTime:data.asOf}); bru.setVar('forwardRunId',run.id);
  });
}
