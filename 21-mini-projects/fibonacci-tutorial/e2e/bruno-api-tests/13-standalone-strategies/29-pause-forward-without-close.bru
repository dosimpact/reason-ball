meta {
  name: pause-forward-without-close
  type: http
  seq: 29
}
post {
  url: {{baseUrl}}/api/strategies/{{forwardId}}/runs/{{forwardRunId}}/pause
  body: json
  auth: none
}
body:json {
  {"expectedVersion":4}
}
assert {
  res.status: eq 200
}
tests {
  test("pause-forward-without-close", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.version).to.equal(5); const run=data.runs[0]; expect(run.controlStatus).to.equal('PAUSED'); expect(run.monitoring.status).to.equal('OPEN'); expect(run.monitoring.exitPrice).to.equal(null);
  });
}
