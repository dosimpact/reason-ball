data: {"channel":"canvas","type":"ready","report":{"id":"4c146152-d728-464d-af65-ad777e2424d5","title":"공급업체1 성과 리포트","vendor":"공급업체1","source_file":"supplier-01_analysis_20261001_20261014_ko.md","report_mode":"pdf","program":"root = Col([report])\nsourceKpis = [{\"label\": \"광고 매출\", \"w1Text\": \"8,000,000원\", \"w2Text\": \"9,000,000원\", \"claim\": \"+800,000원 (+10.1%)\", \"w1\": 8000000.0, \"w2\": 9000000.0, \"delta\": 1000000.0, \"percent\": 12.5}, {\"label\": \"광고수익률\", \"w1Text\": \"169%\", \"w2Text\": \"177%\", \"claim\": \"+8%p (+4.7%)\", \"w1\": 169.0, \"w2\": 177.0, \"delta\": 8.0, \"percent\": 4.73}, {\"label\": \"광고비\", \"w1Text\": \"5,000,000원\", \"w2Text\": \"5,000,000원\", \"claim\": \"+200,000원 (+5.1%)\", \"w1\": 5000000.0, \"w2\": 5000000.0, \"delta\": 0.0, \"percent\": 0.0}, {\"label\": \"노출수\", \"w1Text\": \"900,000\", \"w2Text\": \"1,000,000\", \"claim\": \"+100,000 (+19.4%)\", \"w1\": 900000.0, \"w2\": 1000000.0, \"delta\": 100000.0, \"percent\": 11.11}, {\"label\": \"클릭률\", \"w1Text\": \"0.6%\", \"w2Text\": \"0.8%\", \"claim\": \"+0.2%p (+47.9%)\", \"w1\": 0.6, \"w2\": 0.8, \"delta\": 0.2, \"percent\": 33.33}, {\"label\": \"전환율\", \"w1Text\": \"5.2%\", \"w2Text\": \"3.5%\", \"claim\": \"−2.0%p (−32.4%)\", \"w1\": 5.2, \"w2\": 3.5, \"delta\": -1.7, \"percent\": -32.69}, {\"label\": \"평균 주문 금액\", \"w1Text\": \"30,000원\", \"w2Text\": \"20,000원\", \"claim\": \"−2,000원 (−7.8%)\", \"w1\": 30000.0, \"w2\": 20000.0, \"delta\": -10000.0, \"percent\": -33.33}, {\"label\": \"캠페인 수\", \"w1Text\": \"6\", \"w2Text\": \"6\", \"claim\": \"0\", \"w1\": 6.0, \"w2\": 6.0, \"delta\": 0.0, \"percent\": 0.0}, {\"label\": \"예산 소진 캠페인 수\", \"w1Text\": \"2\", \"w2Text\": \"1\", \"claim\": \"−1\", \"w1\": 2.0, \"w2\": 1.0, \"delta\": -1.0, \"percent\": -50.0}]\nsourceCampaigns = [{\"label\": \"치간칫솔\", \"id\": \"CAMP_004\", \"kind\": \"MPS\", \"w1\": 1000000.0, \"w2\": 2000000.0, \"claim\": \"+1,000,000원\", \"contribution\": 98.7, \"spend\": 2000000.0, \"roas\": 200.0, \"target\": 254.0, \"attainment\": 78.6}, {\"label\": \"치약코팅칫솔\", \"id\": \"CAMP_003\", \"kind\": \"MPS\", \"w1\": 2000000.0, \"w2\": 2000000.0, \"claim\": \"+300,000원\", \"contribution\": 35.2, \"spend\": 1000000.0, \"roas\": 383.0, \"target\": 294.0, \"attainment\": 130.0}, {\"label\": \"치약\", \"id\": \"CAMP_010\", \"kind\": \"MPS\", \"w1\": 0.0, \"w2\": 90000.0, \"claim\": \"+90,000원\", \"contribution\": 9.0, \"spend\": 60000.0, \"roas\": 165.0, \"target\": 300.0, \"attainment\": 54.9}]\nsourceRisks = [{\"id\": \"VID_0018\", \"label\": \"공급업체1 기능성 칫솔 이중초미세모, 12개입\", \"revenue\": 4000000.0, \"share\": 20.6, \"issue\": \"품절: 47h\", \"period\": \"최근 2주간 47h\", \"hours\": 47.0, \"campaign\": \"104444587 — 공급업체1 기능성 칫솔 (MPS) | CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS)\", \"risk\": 500000.0, \"riskText\": \"500,000원\", \"action\": \"광고주 광고 매출의 20.6%를 차지하는 VID에서 품절 시간이 감지됨. 광고 매출 위험이 지속되지 않도록 신속히 재고를 보충하세요.\"}, {\"id\": \"VID_0019\", \"label\": \"공급업체1 기능성 칫솔 이중초미세모, 6개입\", \"revenue\": 3000000.0, \"share\": 17.4, \"issue\": \"품절: 137h\", \"period\": \"최근 2주간 137h\", \"hours\": 137.0, \"campaign\": \"104444587 — 공급업체1 기능성 칫솔 (MPS) | CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS)\", \"risk\": 2000000.0, \"riskText\": \"2,000,000원\", \"action\": \"포트폴리오 내 가장 심각한 품절(137h). 2주간 추정 광고 매출 위험 2,000,000원. 긴급 재고 보충이 필요합니다.\"}, {\"id\": \"VID_0022\", \"label\": \"공급업체1 치약코팅칫솔, 50개입, 1박스\", \"revenue\": 3000000.0, \"share\": 13.8, \"issue\": \"품절: 115h\", \"period\": \"최근 2주간 115h\", \"hours\": 115.0, \"campaign\": \"CAMP_003 — 치약코팅칫솔 (MPS)\", \"risk\": 1000000.0, \"riskText\": \"1,000,000원\", \"action\": \"광고주 광고 매출의 13.8%를 기여하는 VID에서 품절 115h 발생; 추정 위험 1,000,000원. 캠페인 정상 게재 및 광고수익률 기여도 회복을 위해 재고를 보충하세요.\"}, {\"id\": \"VID_0013\", \"label\": \"공급업체1 치간칫솔 I형 SSS 핑크, 100개입\", \"revenue\": 3000000.0, \"share\": 13.3, \"issue\": \"품절: 92h\", \"period\": \"최근 2주간 92h\", \"hours\": 92.0, \"campaign\": \"CAMP_004 — 치간칫솔 (MPS)\", \"risk\": 500000.0, \"riskText\": \"500,000원\", \"action\": \"광고주 광고 매출의 13.3%를 기여하는 VID에서 품절 92h 발생; 추정 위험 500,000원. W2에서 관찰된 매출 회복 흐름을 유지하기 위해 재고를 보충하세요.\"}, {\"id\": \"VID_0021\", \"label\": \"공급업체1 치약코팅칫솔, 10개입, 1개\", \"revenue\": 2000000.0, \"share\": 9.9, \"issue\": \"품절: 35시간\", \"period\": \"최근 2주간 35시간 품절\", \"hours\": 35.0, \"campaign\": \"CAMP_003 — 치약코팅칫솔 (MPS)\", \"risk\": 200000.0, \"riskText\": \"200,000원\", \"action\": \"품절 35시간; 예상 손실 200,000원. 이 상품은 품절 해소 이후 치약코팅칫솔 캠페인의 광고 매출 상승을 이끌었으며, 이 성과를 유지하기 위해서는 지속적인 재고 관리가 중요합니다.\"}]\nsourceActions = [{\"rank\": \"1\", \"source\": \"Section 4 — OOB, 예산 조치 가능\", \"action\": \"**치약코팅칫솔 (CAMP_003):** 일예산을 100,000원에서 100,000원으로 증액\", \"impact\": \"미정량화 (출처 기반 추천 제공됨)\", \"evidence\": \"W2 기간 7일 전일 OOB 발생 (8시간 상한 도달; 활용률 98.8%). 광고수익률(ROAS) 410% vs. 목표 광고수익률(T.ROAS) 294% — 효율이 우수하며 예산이 핵심 제약 요인입니다. Sales Engine 추천 일자: 2026-10-15.\"}, {\"rank\": \"2\", \"source\": \"Section 5 — 낮은 활용률, 지원 추천 없음\", \"action\": \"**261001 공급업체1 기능성 칫솔 (CAMP_047):** 캠페인이 의도적으로 낮은 게재량을 보이는지 검토\", \"impact\": \"정량화 불가\", \"evidence\": \"일예산 500,000원; 최근 7일 활용률 2.5%에 불과. 현재 판매자가 직접 조치할 수 있는 추천이 없습니다. 예산 또는 입찰가 조치를 검토하기 전, AE는 낮은 게재량이 적격성 제약으로 인한 것인지 확인해야 합니다 (참고: VID VID_0018 및 VID_0019에 활성 품절(OOS) 시간이 존재).\"}, {\"rank\": \"3\", \"source\": \"Section 5 — 낮은 활용률, 지원 추천 없음\", \"action\": \"**공급업체1 기존 칫솔 (CAMP_009):** 활용률 추세 모니터링\", \"impact\": \"정량화 불가\", \"evidence\": \"일예산 100,000원; 활용률 45.5% — 보통 수준이나 완전 게재에는 미치지 못함. 현재 판매자가 직접 조치할 수 있는 추천이 없습니다.\"}]\n// GENERATED VIEW\nreport = Col([header, conclusionSection, kpiSection, discrepancySection, campaignSection, riskSection, actionSection, sourceSection])\n\nheader = Col([title, subtitle, intro])\ntitle = Title(\"공급업체1 광고·재고 통합 분석 보고서\", \"xl\")\nsubtitle = Text(\"분석 기간 2026-10-01 ~ 2026-10-14 · W1 10-01~10-07 / W2 10-08~10-14\", \"md\", \"muted\")\nintro = Text(\"본 보고서는 제공된 원문 수치와 직접 계산 가능한 W1·W2 값만을 사용해 공급업체1의 광고 성과와 재고 리스크를 검토한 결과입니다. 해석은 원문 주장과 계산 결과를 분리해 제시하며, 수치 불일치가 있는 항목은 별도 경고로 표시했습니다.\", \"sm\")\n\nconclusionSection = Col([Title(\"종합 결론\", \"lg\"), conclusionText])\nconclusionText = Text(\"W2의 광고 매출은 9,000,000원으로 W1 8,000,000원 대비 직접 계산상 1,000,000원, 12.5% 증가했다. 같은 기간 광고비는 5,000,000원으로 변함이 없어 효율 개선의 형식적 배경은 존재하지만, 전환율은 5.2%에서 3.5%로 하락했고 평균 주문 금액도 30,000원에서 20,000원으로 낮아져 성장의 질은 다소 약해졌다. 캠페인별로는 CAMP_004의 매출 증가폭이 가장 크고, CAMP_003은 현재 ROAS 383%로 목표 294%를 상회해 효율 측면의 기여가 뚜렷하다. 다만 재고 리스크는 집중되어 있으며 최근 2주 기준 상위 5개 위험 상품의 추정 매출 위험 합계가 4,200,000원에 달해, 다음 주의 우선순위는 예산 확대보다 재고 정상화와 원문 수치 검증에 두는 것이 타당하다.\", \"md\")\n\nkpiSection = Col([Title(\"핵심 지표 요약\", \"lg\"), kpiLead, kpiGrid])\nkpiLead = Text(\"먼저 W1과 W2의 핵심 KPI를 직접 비교하면, 외형 성장은 확인되지만 효율 해석에는 주의가 필요하다. 특히 광고 매출·광고비·노출수·클릭률·평균 주문 금액의 일부 원문 증감 문구가 실제 W1/W2 값과 다르므로, 아래 카드는 원문 표기와 함께 직접 계산 관점을 병기했다.\", \"sm\")\nkpiGrid = Grid([kpiRevenue, kpiRoas, kpiSpend, kpiCvr], 2, 260, 3)\n\nkpiRevenue = Card([Title(\"광고 매출\", \"md\"), Text(\"W1 \" + @Find(sourceKpis, \"label\", \"광고 매출\").w1Text + \" → W2 \" + @Find(sourceKpis, \"label\", \"광고 매출\").w2Text, \"sm\"), Text(\"직접 계산: +\" + @Format(@Find(sourceKpis, \"label\", \"광고 매출\").delta, \"currency\", 0, \"KRW\") + \" (\" + @Format(@Find(sourceKpis, \"label\", \"광고 매출\").percent, \"percent\", 1) + \")\", \"sm\", \"ink\", \"semibold\"), Caption(\"원문 주장: \" + @Find(sourceKpis, \"label\", \"광고 매출\").claim)], \"soft\", 3, 2)\nkpiRoas = Card([Title(\"광고수익률\", \"md\"), Text(\"W1 \" + @Find(sourceKpis, \"label\", \"광고수익률\").w1Text + \" → W2 \" + @Find(sourceKpis, \"label\", \"광고수익률\").w2Text, \"sm\"), Text(\"직접 계산: +\" + @Find(sourceKpis, \"label\", \"광고수익률\").delta + \"%p (\" + @Format(@Find(sourceKpis, \"label\", \"광고수익률\").percent, \"percent\", 2) + \")\", \"sm\", \"ink\", \"semibold\"), Caption(\"원문 주장: \" + @Find(sourceKpis, \"label\", \"광고수익률\").claim)], \"soft\", 3, 2)\nkpiSpend = Card([Title(\"광고비\", \"md\"), Text(\"W1 \" + @Find(sourceKpis, \"label\", \"광고비\").w1Text + \" → W2 \" + @Find(sourceKpis, \"label\", \"광고비\").w2Text, \"sm\"), Text(\"직접 계산: \" + @Format(@Find(sourceKpis, \"label\", \"광고비\").delta, \"currency\", 0, \"KRW\") + \" (\" + @Format(@Find(sourceKpis, \"label\", \"광고비\").percent, \"percent\", 1) + \")\", \"sm\", \"ink\", \"semibold\"), Caption(\"원문 주장: \" + @Find(sourceKpis, \"label\", \"광고비\").claim + \" · 원문 수치 확인 필요\")], \"soft\", 3, 2)\nkpiCvr = Card([Title(\"전환율\", \"md\"), Text(\"W1 \" + @Find(sourceKpis, \"label\", \"전환율\").w1Text + \" → W2 \" + @Find(sourceKpis, \"label\", \"전환율\").w2Text, \"sm\"), Text(\"직접 계산: \" + @Find(sourceKpis, \"label\", \"전환율\").delta + \"%p (\" + @Format(@Find(sourceKpis, \"label\", \"전환율\").percent, \"percent\", 2) + \")\", \"sm\", \"ink\", \"semibold\"), Caption(\"원문 주장: \" + @Find(sourceKpis, \"label\", \"전환율\").claim)], \"soft\", 3, 2)\n\ndiscrepancySection = Col([discrepancyCard, discrepancyTable, discrepancyText])\ndiscrepancyCard = Card([Row([Icon(\"alert-triangle\", \"md\", \"warning\"), Title(\"원문 수치 확인 필요\", \"md\")], 2), Text(\"원문 claims 가운데 일부는 W1·W2 원값에서 직접 계산한 차이와 일치하지 않는다. 본 보고서는 원문 주장과 계산 결과를 분리해 보여주며, 아래 항목은 해석·실행 이전에 원문 파일 또는 생성 로직을 재검증해야 한다.\", \"sm\")], \"outline\", 3, 3)\ndiscrepancyTable = Table([\"지표\", \"W1\", \"W2\", \"원문 주장\", \"직접 계산\"], discrepancyRows)\ndiscrepancyRows = @Each(discrepancyList, \"m\", [m.label, m.w1Text, m.w2Text, m.claim, discrepancyCalcText[m.label]])\ndiscrepancyText = Text(\"불일치의 성격은 두 가지다. 첫째, 광고 매출과 노출수처럼 증감률이 실제 기준값보다 크게 또는 작게 적힌 사례가 있어 추세 강도를 과대·과소평가할 수 있다. 둘째, 광고비와 평균 주문 금액은 절대 차이 자체가 맞지 않아 실행 권고의 방향까지 왜곡될 수 있다. 특히 광고비는 W1과 W2가 동일하므로 증가라고 서술할 수 없고, 평균 주문 금액은 원문상 −2,000원보다 직접 계산상 −10,000원이므로 수익성 해석에서 더 보수적인 판단이 필요하다.\", \"sm\")\n\ndiscrepancyList = @Concat(@Concat(@Concat(@Filter(sourceKpis, \"label\", \"==\", \"광고 매출\"), @Filter(sourceKpis, \"label\", \"==\", \"광고비\")), @Concat(@Filter(sourceKpis, \"label\", \"==\", \"노출수\"), @Filter(sourceKpis, \"label\", \"==\", \"클릭률\"))), @Concat(@Filter(sourceKpis, \"label\", \"==\", \"전환율\"), @Filter(sourceKpis, \"label\", \"==\", \"평균 주문 금액\")))\ndiscrepancyCalcText = {\"광고 매출\": \"+\" + @Format(@Find(sourceKpis, \"label\", \"광고 매출\").delta, \"currency\", 0, \"KRW\") + \" (\" + @Format(@Find(sourceKpis, \"label\", \"광고 매출\").percent, \"percent\", 1) + \")\", \"광고비\": @Format(@Find(sourceKpis, \"label\", \"광고비\").delta, \"currency\", 0, \"KRW\") + \" (\" + @Format(@Find(sourceKpis, \"label\", \"광고비\").percent, \"percent\", 1) + \")\", \"노출수\": \"+\" + @Format(@Find(sourceKpis, \"label\", \"노출수\").delta, \"number\", 0) + \" (\" + @Format(@Find(sourceKpis, \"label\", \"노출수\").percent, \"percent\", 2) + \")\", \"클릭률\": \"+\" + @Find(sourceKpis, \"label\", \"클릭률\").delta + \"%p (\" + @Format(@Find(sourceKpis, \"label\", \"클릭률\").percent, \"percent\", 2) + \")\", \"전환율\": @Find(sourceKpis, \"label\", \"전환율\").delta + \"%p (\" + @Format(@Find(sourceKpis, \"label\", \"전환율\").percent, \"percent\", 2) + \")\", \"평균 주문 금액\": @Format(@Find(sourceKpis, \"label\", \"평균 주문 금액\").delta, \"currency\", 0, \"KRW\") + \" (\" + @Format(@Find(sourceKpis, \"label\", \"평균 주문 금액\").percent, \"percent\", 2) + \")\"}\n\ncampaignSection = Col([Title(\"성과 해석과 캠페인 근거\", \"lg\"), campaignLead, campaignRevenueCard, campaignRevenueText, campaignRoasCard, campaignRoasText, campaignTable, campaignTableText])\ncampaignLead = Text(\"수치 검증을 전제로 하더라도, 실제 성과의 중심은 소수 캠페인에 집중되어 있다. 아래 시각화는 매출 규모와 효율을 분리해 보여주며, 어떤 캠페인이 성장에 기여했고 어떤 캠페인이 목표 대비 성과가 약한지 한눈에 확인하도록 구성했다.\", \"sm\")\n\ncampaignRevenueCard = Card([Title(\"캠페인별 광고 매출 W1/W2\", \"md\"), Chart(\"bar\", sourceCampaigns, \"label\", [\"w1\", \"w2\"], \"currency\", \"KRW\")], \"outline\", 3, 3)\ncampaignRevenueText = Text(\"매출 측면에서 가장 큰 변화는 CAMP_004 치간칫솔이다. W1 1,000,000원에서 W2 2,000,000원으로 늘어 직접 계산상 1,000,000원 증가했으며, 제공 데이터 범위 안에서는 전체 상승분을 가장 강하게 설명한다. 반면 CAMP_003 치약코팅칫솔은 W1과 W2가 모두 2,000,000원으로 표의 claim인 +300,000원과 충돌하므로, 해당 캠페인은 효율 개선 신호는 인정하되 매출 순증 규모 자체는 원문 검증 전까지 보수적으로 다루는 것이 안전하다. CAMP_010 치약은 W2 90,000원으로 신규 기여가 있으나 절대 규모가 작고 이전 기간 0원이라 추세 해석은 제한적이다.\", \"sm\")\n\ncampaignRoasCard = Card([Title(\"캠페인별 ROAS·목표 ROAS\", \"md\"), Chart(\"bar\", sourceCampaigns, \"label\", [\"roas\", \"target\"], \"percent\", null)], \"outline\", 3, 3)\ncampaignRoasText = Text(\"효율 관점에서는 CAMP_003의 현재 ROAS 383%가 목표 294%를 상회해 가장 안정적이다. 반대로 CAMP_004는 ROAS 200%로 목표 254%에 미달하고 달성률도 78.6%에 그쳐, 매출 확대가 곧바로 건전한 수익성으로 이어졌다고 보기 어렵다. CAMP_010은 ROAS 165%, 목표 300%로 아직 목표와 거리가 크며, 신규 캠페인 특성상 추가 학습기간이 필요하다. 따라서 이번 포트폴리오의 핵심 해석은 '성장은 존재하나, 성장의 질은 CAMP_003에 집중되고 CAMP_004는 재고·전환 품질 확인이 병행되어야 한다'로 요약된다.\", \"sm\")\n\ncampaignTable = Table([\"캠페인\", \"ID\", \"W1 매출\", \"W2 매출\", \"광고비\", \"ROAS\", \"목표\", \"달성률\"], campaignRows)\ncampaignRows = @Each(sourceCampaigns, \"c\", [c.label, c.id, @Format(c.w1, \"currency\", 0, \"KRW\"), @Format(c.w2, \"currency\", 0, \"KRW\"), @Format(c.spend, \"currency\", 0, \"KRW\"), c.roas + \"%\", c.target + \"%\", c.attainment + \"%\"])\ncampaignTableText = Text(\"표를 함께 보면 매출 규모, 광고비, 목표 대비 효율의 관계가 더 분명해진다. CAMP_003은 spend 1,000,000원으로 383% ROAS를 기록해 가장 높은 목표 초과 효율을 보인 반면, CAMP_004는 spend 2,000,000원에도 목표 미달 상태다. 이 차이는 단순한 예산 확대보다 상품 가용성, 전환 여건, 원문 집계 정확성 검증이 우선되어야 함을 시사한다.\", \"sm\")\n\nriskSection = Col([Title(\"재고 리스크와 매출 보호\", \"lg\"), riskLead, riskHoursCard, riskHoursText, riskValueCard, riskValueText, riskContributionCard, riskContributionText, riskList])\nriskLead = Text(\"앞선 성과 해석을 실제 실행 우선순위로 바꾸면, 가장 큰 변수는 재고다. 제공된 위험 데이터는 기간을 '최근 2주'로 명시하고 있으므로 이를 W2로 오인하지 않고, 최근 2주 누적 기준의 품절 시간과 추정 매출 위험으로 해석해야 한다.\", \"sm\")\n\nriskHoursCard = Card([Title(\"상품별 최근 2주 품절 시간\", \"md\"), Chart(\"bar\", sourceRisks, \"id\", [\"hours\"], \"number\", null)], \"outline\", 3, 3)\nriskHoursText = Text(\"품절 시간 기준 최상위 리스크는 VID_0019의 137시간이며, 이어 VID_0022 115시간, VID_0013 92시간 순이다. 이는 특정 단일 SKU 문제가 아니라 기능성 칫솔군과 치약코팅칫솔군 전반에 걸쳐 공급 안정성이 흔들리고 있음을 뜻한다. 품절 시간이 긴 항목일수록 광고 노출 회복이 지연될 가능성이 크므로, 재고 복구의 우선순위는 단순 매출 비중보다도 시간 누적과 연결 캠페인 파급효과를 함께 보아야 한다. 다만 이 차트는 원인 추정이 아니라 관측된 노출 제약의 크기만 보여주므로, 실제 공급 병목 지점은 별도 확인이 필요하다.\", \"sm\")\n\nriskValueCard = Card([Title(\"상품별 추정 광고 매출 위험\", \"md\"), Chart(\"bar\", sourceRisks, \"id\", [\"risk\"], \"currency\", \"KRW\")], \"outline\", 3, 3)\nriskValueText = Text(\"매출 위험액 기준으로는 VID_0019가 2,000,000원으로 압도적이며, VID_0022가 1,000,000원으로 뒤를 잇는다. 상위 5개 위험 상품의 추정 위험 합계는 \" + @Format(@Sum(sourceRisks.risk), \"currency\", 0, \"KRW\") + \"로, 이는 벤더 주간 광고 매출 규모와 비교해도 무시하기 어려운 수준이다. 특히 CAMP_003과 연동된 VID_0022는 효율 우수 캠페인의 성장 상단을 제한할 수 있고, CAMP_047 관련 VID_0018·VID_0019는 낮은 활용률 해석 이전에 재고 제약을 먼저 의심하게 만든다. 따라서 다음 주 개선 과제의 중심은 예산보다는 품절 해소를 통한 매출 방어라고 보는 편이 근거에 부합한다.\", \"sm\")\n\nriskContributionCard = Card([Title(\"상품별 광고 매출 기여도\", \"md\"), Chart(\"bar\", sourceRisks, \"id\", [\"share\"], \"percent\", null)], \"outline\", 3, 3)\nriskContributionText = Text(\"기여도 관점에서도 리스크는 핵심 SKU에 집중된다. VID_0018은 광고 매출의 20.6%, VID_0019는 17.4%, VID_0022는 13.8%를 차지해, 위험이 낮은 주변 SKU가 아니라 매출 중심 SKU에서 문제를 일으키고 있다. 즉 재고 이슈를 방치하면 단순한 일부 손실이 아니라 포트폴리오 전체 광고 생산성 저하로 번질 가능성이 높다. 다만 share는 기여 비중일 뿐 직접적인 인과를 뜻하지 않으므로, 실제 발주 우선순위는 운영팀의 리드타임과 재입고 가능 수량을 함께 검토해야 한다.\", \"sm\")\n\nriskList = List(riskItems, \"bullet\", false)\nriskItems = @Each(@Sort(sourceRisks, \"risk\", \"desc\"), \"r\", ListItem(r.id + \" · \" + r.label, r.period + \" · 위험 \" + r.riskText + \" · 연결 캠페인 \" + r.campaign, null, [Text(r.action, \"sm\")]))\n\nactionSection = Col([Title(\"우선순위 권고안\", \"lg\"), actionLead, rankedActionList, actionText])\nactionLead = Text(\"성과와 리스크를 종합하면, 실행 순서는 '재고 복구 → 원문 권고 검증 → 저활용 원인 확인'이 적절하다. 아래 권고는 제공된 sourceActions의 순위를 유지하되, 수치 모순 여부와 불확실성을 명시해 과잉 실행을 방지했다.\", \"sm\")\n\nrankedActionList = List(actionItems, \"number\", false)\nactionItems = @Each(sourceActions, \"a\", ListItem(\"우선순위 \" + a.rank + \" · \" + actionHeadline[a.rank], a.source + \" · \" + a.impact, null, [Text(a.evidence, \"sm\"), Text(actionNote[a.rank], \"sm\", \"muted\")]))\nactionHeadline = {\"1\": \"CAMP_003 예산 권고는 검증 후 커뮤니케이션\", \"2\": \"CAMP_047 저활용은 적격성·재고 제약부터 확인\", \"3\": \"CAMP_009는 즉시 조정보다 모니터링 유지\"}\nactionNote = {\"1\": \"원문은 '100,000원에서 100,000원으로 증액'이라고 서술하나 전후 값이 동일하다. 따라서 실제 예산 증가 제안이 아니라 '예산 상향 권고 문구의 원문 검증 필요'로 해석해야 하며, 0원 변화는 증가로 보고해서는 안 된다.\", \"2\": \"해당 캠페인은 최근 7일 활용률 2.5%로 낮지만, sourceRisks에 연결된 VID_0018·VID_0019의 품절 시간이 각각 47시간, 137시간 존재한다. 즉 저활용의 1차 설명은 수요 부족보다 재고 또는 적격성 제약일 가능성이 높으며, 원인 확인 전 입찰·예산 조정은 근거가 약하다.\", \"3\": \"활용률 45.5%는 낮지만 즉시 위험 신호로 단정하기 어렵다. 판매자 실행 가능한 추천이 없으므로, 성과 급락이 추가로 확인되기 전까지는 추세 감시가 합리적이다.\"}\nactionText = Text(\"권고안의 핵심은 숫자가 지지하는 범위 내에서만 행동하는 것이다. CAMP_003은 높은 ROAS 때문에 예산 확대 논리가 직관적으로 매력적이지만, 제공된 권고 문구가 실제로는 전후 예산이 동일해 실행 문안 자체의 검증이 선행되어야 한다. 반대로 CAMP_047은 활용률만 보면 축소 또는 방치 판단이 가능해 보이나, 연결 SKU의 장시간 품절이 확인되어 성과 저하 원인을 수요 측으로 돌리기 어렵다. 따라서 운영 우선순위는 재고 복구와 데이터 검증이며, 그 다음이 예산·입찰 재설정이다.\", \"sm\")\n\nsourceSection = Col([Title(\"원문 출처와 해석 범위\", \"lg\"), sourceText1, sourceText2, sourceBullets])\nsourceText1 = Text(\"본 보고서의 모든 수치와 해석은 제공된 sourceKpis, sourceCampaigns, sourceRisks, sourceActions 배열과 사용자 메시지에 포함된 원문 발췌만을 사용했다. 외부 시장 데이터, 경쟁사 정보, 추가 성과 로그, 이미지나 클릭 기반 탐색형 요소는 사용하지 않았다.\", \"sm\")\nsourceText2 = Text(\"특히 sourceCampaigns에는 w1/w2 매출, spend, roas, target, attainment만 존재하므로 캠페인별 CTR·CVR·AOV 시계열은 작성하지 않았다. sourceRisks의 hours와 risk는 모두 '최근 2주' period에 귀속된 값이므로 이를 W2 단독 값처럼 해석하지 않았으며, 원문에 없는 기간 추정도 추가하지 않았다.\", \"sm\")\nsourceBullets = List([ListItem(\"원문 기반 해석 원칙\", \"원문 claim은 사실 진술이 아니라 검증 대상 데이터로 취급했다.\"), ListItem(\"계산 원칙\", \"직접 계산 가능한 증감은 sourceKpis의 delta·percent와 W1·W2 원값을 기준으로 병기했다.\"), ListItem(\"불확실성 표기\", \"원문과 계산이 충돌하는 항목은 '원문 수치 확인 필요'로 표시하고, 조치 권고에도 그 불확실성을 반영했다.\")], \"bullet\", false)","status":"ready","published":false,"created_at":"2026-10-20T13:15:22.822575+00:00"}}

event: custom|report_subagent:6aaf8ec0-91db-d515-cd1c-0ec96a450025
data: {"channel":"chat","type":"message","content":"공급업체1 리포트를 Canvas에 만들었습니다. 내용을 선택해 질문하거나 PDF로 저장하고 공유할 수 있습니다."}

