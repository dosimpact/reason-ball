data: {"channel":"canvas","type":"ready","report":{"id":"58e2fbd4-5cf2-43bd-b532-83b1d76ce664","title":"공급업체1 성과 리포트","vendor":"공급업체1","source_file":"A00250060_vendor_level_analysis_20261001_20261014_ko.md","program":"root = Col([headline, kpiCards, campaignControl, perfCharts, sectionInsight, riskCharts, actionsSection, issueCard, vidSection])\n$campaign = \"전체\"\nheadline = Col([Title(\"공급업체1 벤더 성과 분석 요약 (V1)\", \"2xl\"), Text(\"기간: 2026년 10월 1일–14일 | 캠페인 선택 필터를 사용해 특정 캠페인별 성과를 확인하세요.\", \"md\", \"muted\")], 2)\nkpiCards = Grid([kpiRevenue, kpiRoas, kpiSpend, kpiImp, kpiClickrate, kpiConv], 3)\ncampaignControl = Row([SegmentedControl($campaign, [\"전체\", \"치간칫솔\", \"치약코팅칫솔\", \"치약\", \"261001 기능성칫솔\", \"기존 칫솔\"], true), Spacer()], 2, \"center\")\nperfCharts = Col([ Title(\"주요 실적 지표 추이\", \"lg\"), Row([Chart(\"bar\", filteredCampaigns, \"label\", [\"w1\", \"w2\"], \"currency\", \"KRW\", false, 180), Chart(\"line\", filteredCampaigns, \"label\", [\"roasW1\", \"roasW2\"], \"percent\", null, false, 180)], 4), Caption(\"W1: 10월 1일–7일 | W2: 8일–14일\") ])\nsectionInsight = Col([Title(\"경영진 요약 및 핵심 인사이트\", \"lg\"), Grid([Text([Icon(\"arrow-up-right\", \"md\", \"success\"), \"광고 매출이 전주 대비 +800,000원 (공급업체 전체, +10.1% 소스 기준) 상승. 치간칫솔·치약코팅칫솔 성장 주도. 전환율 급락(-32.4%)과 평균 주문 금액 감소(-7.8%)가 일부 상쇄효과. 광고비는 0원 변화/정체 (소스 주장: +200,000원 증가, 실제값과 불일치).\"], \"md\"), Text([Icon(\"target\", \"md\", \"purple\"), \"**핵심 성장 원인:** 치간칫솔은 상위 VID 품절 해소, 치약코팅칫솔은 품절 최소화 및 클릭률 +56.9%. 치약 캠페인은 신규 집행.\"], \"sm\"), Text([Icon(\"alert-circle\", \"md\", \"danger\"), \"재고 부족(특히 VID_0019, VID_0022 등)으로 광고수익률 하락 및 매출리스크 잠재. 재고조치가 직접 필요한 상태.\"], \"sm\")], 2) ])\nriskCharts = Col([ Row([Box([Title(\"캠페인별 광고수익률(ROAS)\", \"md\"), Chart(\"bar\", filteredCampaigns, \"label\", [\"roasW1\", \"roasW2\"], \"percent\", null, false, 160)]), Box([Title(\"노출수·클릭률 변화\", \"md\"), Chart(\"bar\", filteredCampaigns, \"label\", [\"impW1\", \"impW2\"], \"number\", null, false, 160), Chart(\"line\", filteredCampaigns, \"label\", [\"ctrW1\", \"ctrW2\"], \"percent\", null, false, 120)]), Box([Title(\"전환율 변화\", \"md\"), Chart(\"bar\", filteredCampaigns, \"label\", [\"cvrW1\", \"cvrW2\"], \"percent\", null, false, 110)]), Box([Title(\"평균 주문금액(AOV) 변화\", \"md\"), Chart(\"bar\", filteredCampaigns, \"label\", [\"aovW1\", \"aovW2\"], \"currency\", \"KRW\", false, 110)]) ], 4, \"start\") ])\nactionsSection = Col([ Title(\"실행 우선순위 및 핵심조치\", \"lg\"), Grid([ Card([Title(\"치약코팅칫솔 예산 증액 (CAMP_003)\", \"md\"), Text(\"W2 7일 전일 예산소진(OOB), 광고수익률 410% (목표 294%)로 매우 효율적입니다. 일예산 증액 권장(100,000원 → 100,000원). 현재 증액폭 없음 — 동일값 반복 추천임을 명시. 효과 미정량화, 근거: Sales Engine.\", \"sm\"), Badge(\"예산 상한 도달\", \"warning\"), Row([Caption(\"최근 예산\"), Spacer(), Text(\"100,000원\", \"sm\")]), Row([Caption(\"추천 예산\"), Spacer(), Text(\"100,000원 (증액 없음)\", \"sm\")]) ]), Card([ Title(\"기능성 칫솔 낮은 예산 활용률 (CAMP_047)\", \"md\"), Text(\"일예산 500,000원, 최근 7일 활용률 2.5%. 실행가능한 권장사항 없음. VID_0018·VID_0019 품절 영향점검 필요.\", \"sm\"), Badge(\"활용률 극저(2.5%)\", \"danger\") ]), Card([ Title(\"기존 칫솔 예산 모니터링 (CAMP_009)\", \"md\"), Text(\"일예산 100,000원, 최근 7일 활용률 45.5%. 적극조치보다는 추세관찰 권장.\", \"sm\"), Badge(\"활용률 45.5%\", \"info\") ]), Card([ Title(\"재고 소진 리스크\", \"md\"), Text(\"VID_0019(137h), VID_0022(115h), VID_0018(47h)에서 장시간 품절 발생. 광고 매출 및 ROAS 하락의 핵심 원인. 즉시 재고조치 권장.\", \"sm\"), Badge(\"재고 보충 필요\", \"danger\") ]) ], 2) ])\nissueCard = issueCardShowAny ? Card([Title(\"원문 수치 불일치 / 불확실성(감사 대상)\", \"md\", \"danger\"), List(@Each(inconsistencies, \"row\", ListItem(row.metric, \"원문: \" + row.source_claim + \" / 계산: \" + row.calculated_difference + (row.calculated_percent != null ? \" (\" + @Format(row.calculated_percent, \"percent\", 1, null) + \")\" : \"\"), \"⚠️\")), \"bullet\"), Text(\"지표별 증감/증가율이 출처 데이터와 산식 결과 불일치. 추후 원문 검증 필요. 보고서 내 모든 경제적 결정 및 비교는 이 불일치 상황을 감안하여 해석하십시오.\", \"sm\", \"warning\"), Badge(\"원문 수치 확인 필요\", \"danger\") ]) : null\nvidSection = Col([Title(\"주요 VID별 리스크 및 적격성\", \"lg\"), Grid([ Card([ Title(\"VID 재고/효율 리스크 Top 4\", \"md\"), List(@Each(vidRisks, \"v\", ListItem(v.label, v.summary + \" | 최근 품절 \" + v.oos + \"시간\" + (v.risk > 0 ? \" | 매출 위험 \" + @Format(v.risk, \"currency\", 0, \"KRW\") : \"\"), v.icon)), \"bullet\") ]), Card([ Title(\"VID별 광고수익률 기여(하락·회복)\", \"md\"), Table([\"VID\", \"W1 ROAS 기여\", \"W2 ROAS 기여\", \"변동기여\"], @Each(vidRoas, \"v\", [v.vid, v.w1roas + \"%\", v.w2roas + \"%\", v.delta > 0 ? \"+\" + v.delta + \"%\" : v.delta + \"%\"])) ]) ], 2) ])\n\n$campaign = \"전체\"\nfilteredCampaigns = $campaign == \"전체\" ? campaigns : @Filter(campaigns, \"label\", \"==\", $campaign)\n\nkpiRevenue = Card([Row([Title(\"광고 매출\", \"md\"), Spacer(), Badge(\"W2\", \"success\")]), Text(\"9,000,000원\", \"lg\", null, \"semibold\"), Caption(\"전주 대비 +800,000원 (+10.1%, 소스) / 계산값 +1,000,000원 (+12.5%)\")])\nkpiRoas = Card([Row([Title(\"광고수익률\", \"md\"), Spacer(), Badge(\"W2\", \"success\")]), Text(\"177%\", \"lg\", null, \"semibold\"), Caption(\"W1 169%→W2 177%, +8%p (+4.7%)\")])\nkpiSpend = Card([Row([Title(\"광고비\", \"md\"), Spacer(), Badge(\"W2\", \"info\")]), Text(\"5,000,000원\", \"lg\", null, \"semibold\"), Caption(\"W1 5,000,000원→W2 5,000,000원, 변화 0원 (산식 기준), 원문 증감 +200,000원(+5.1%)은 불일치\")])\nkpiImp = Card([Row([Title(\"노출수\", \"md\"), Spacer(), Badge(\"W2\", \"info\")]), Text(\"1,000,000\", \"lg\", null, \"semibold\"), Caption(\"전주 대비 +100,000개 (+19.4%, 소스) / 계산값 +100,000개 (+11.1%)\")])\nkpiClickrate = Card([Row([Title(\"클릭률\", \"md\"), Spacer(), Badge(\"W2\", \"purple\")]), Text(\"0.8%\", \"lg\", null, \"semibold\"), Caption(\"W1 0.6%→W2 0.8%, +0.2%p (+47.9%, 소스) / 계산값 +0.2%p (+33.3%)\")])\nkpiConv = Card([Row([Title(\"전환율\", \"md\"), Spacer(), Badge(\"W2\", \"danger\")]), Text(\"3.5%\", \"lg\", null, \"semibold\"), Caption(\"하락 −2.0%p (−32.4%, 소스) / 계산값 −1.7%p (−32.7%)\")])\n\nissueCardShowAny = @Count(inconsistencies) > 0\n\ncampaigns = [\n  { label: \"치간칫솔\", id: \"CAMP_004\", w1: 1000000, w2: 2000000, roasW1: 200, roasW2: 200, impW1: 200000, impW2: 380000, ctrW1: 0.55, ctrW2: 0.67, cvrW1: 5.1, cvrW2: 4.2, aovW1: 30000, aovW2: 28000 },\n  { label: \"치약코팅칫솔\", id: \"CAMP_003\", w1: 2000000, w2: 2300000, roasW1: 383, roasW2: 410, impW1: 300000, impW2: 320000, ctrW1: 0.53, ctrW2: 0.81, cvrW1: 6.4, cvrW2: 5.0, aovW1: 33000, aovW2: 31000 },\n  { label: \"치약\", id: \"CAMP_010\", w1: 0, w2: 90000, roasW1: null, roasW2: 165, impW1: 0, impW2: 28000, ctrW1: 0, ctrW2: 0.87, cvrW1: 0, cvrW2: 3.8, aovW1: 0, aovW2: 19600 },\n  { label: \"261001 기능성칫솔\", id: \"CAMP_047\", w1: 400000, w2: 400000, roasW1: 220, roasW2: 236, impW1: 80000, impW2: 98000, ctrW1: 0.65, ctrW2: 0.78, cvrW1: 5.4, cvrW2: 5.1, aovW1: 25000, aovW2: 26100 },\n  { label: \"기존 칫솔\", id: \"CAMP_009\", w1: 1000000, w2: 1000000, roasW1: 321, roasW2: 278, impW1: 290000, impW2: 272000, ctrW1: 0.61, ctrW2: 0.52, cvrW1: 7.3, cvrW2: 5.2, aovW1: 32000, aovW2: 29800 }\n]\n\ninconsistencies = [\n  { metric: \"광고 매출\", source_claim: \"+800,000원 (+10.1%)\", calculated_difference: 1000000, calculated_percent: 12.5 },\n  { metric: \"광고수익률\", source_claim: \"+8%p (+4.7%)\", calculated_difference: 8, calculated_percent: 4.73 },\n  { metric: \"광고비\", source_claim: \"+200,000원 (+5.1%)\", calculated_difference: 0, calculated_percent: 0 },\n  { metric: \"노출수\", source_claim: \"+100,000 (+19.4%)\", calculated_difference: 100000, calculated_percent: 11.11 },\n  { metric: \"클릭률\", source_claim: \"+0.2%p (+47.9%)\", calculated_difference: 0.2, calculated_percent: 33.33 },\n  { metric: \"전환율\", source_claim: \"−2.0%p (−32.4%)\", calculated_difference: -1.7, calculated_percent: -32.69 },\n  { metric: \"평균 주문 금액\", source_claim: \"−2,000원 (−7.8%)\", calculated_difference: -10000, calculated_percent: -33.33 }\n]\n\nvidRisks = [\n  { label: \"VID_0019 (기능성 칫솔 6개입)\", summary: \"가장 심각한 품절 - 2주간 137시간 소진\", oos: 137, risk: 2000000, icon: \"alert-triangle\" },\n  { label: \"VID_0022 (치약코팅칫솔 50입)\", summary: \"W2 기준 115시간 소진, 매출 위험 1백만원\", oos: 115, risk: 1000000, icon: \"alert-triangle\" },\n  { label: \"VID_0018 (기능성 칫솔 12개입)\", summary: \"47시간 품절, 매출 위험 50만원\", oos: 47, risk: 500000, icon: \"alert-triangle\" },\n  { label: \"VID_0013 (치간칫솔)\", summary: \"92시간 품절, 매출 위험 50만원\", oos: 92, risk: 500000, icon: \"info\" }\n]\n\nvidRoas = [\n  { vid: \"VID_0022\", w1roas: 103.2, w2roas: 49.8, delta: -53.4 },\n  { vid: \"VID_0016\", w1roas: 56.9, w2roas: 29.5, delta: -27.3 },\n  { vid: \"VID_0015\", w1roas: 44.4, w2roas: 27.8, delta: -16.6 },\n  { vid: \"VID_0018\", w1roas: 14.1, w2roas: 4.8, delta: -9.3 },\n  { vid: \"VID_0019\", w1roas: 4.6, w2roas: 1.2, delta: -3.5 }\n]","status":"ready","published":false,"created_at":"2026-10-20T09:23:45.029245+00:00"}}

event: custom|report_subagent:c34501a8-c3bf-50fa-7ab5-c6323a523d72
data: {"channel":"chat","type":"message","content":"공급업체1 리포트를 Canvas에 만들었습니다. 내용을 선택해 질문하거나 PDF로 저장하고 공유할 수 있습니다."}

