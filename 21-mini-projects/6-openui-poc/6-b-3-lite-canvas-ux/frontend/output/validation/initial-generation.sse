event: custom|report_subagent:10e5e6db-bef0-8f0b-326a-b695ffe74001
data: {"channel":"canvas","type":"ready","report":{"id":"20928635-1879-47ae-9086-85b98b45a07c","title":"공급업체1 성과 리포트","vendor":"공급업체1","source_file":"A00250060_vendor_level_analysis_20261001_20261014_ko.md","program":"root = Col([header, executiveSummary, kpisGrid, kpisNote, periodTrend, campaignPerformance, inventoryRisk, actionRanking, vidAnalysis, eligibilityCheck])\nheader = Col([Title(\"공급업체1 벤더 성과 분석 리포트\", \"2xl\"), Text(\"분석 기간: 2026년 10월 1일 – 10월 14일 (W1: 10월 1일–7일 / W2: 10월 8일–14일)\\n보고대상: 공급업체1 (V_공급업체1) 전체 V1 벤더 성과 및 리스크 진단\")], 2)\nexecutiveSummary = Card([Title(\"경영진 요약\", \"md\"), Text(\"광고 매출은 +800,000원(+10.1%) 증가하였으며, 주요 성장 동인은 치간칫솔(CAMP_004) 및 치약코팅칫솔(CAMP_003)입니다. 광고비 증가는 상대적으로 낮아 광고수익률(ROAS)이 8%p 개선(177%, +4.7%)되었습니다. 반면 전환율(CVR)은 32.4% 급감, 평균 주문금액도 7.8% 감소해 노출수/클릭률 성장의 효과를 일부 상쇄했습니다.\\n\\n치약 캠페인(CAMP_010)이 W2에 신규 활성화되었으나 충분한 진단 데이터는 축적되지 않았습니다. 예산소진 및 재고 품절이 다수 캠페인의 성과제약 요인으로 지속 확인되어, 추가 예산 조정(치약코팅칫솔) 및 주요 품목(기능성 칫솔, 치약코팅칫솔 등) 재고 보충이 긴급 필요합니다.\", \"sm\"), executiveSummaryFacts], null)\nexecutiveSummaryFacts = Row([Badge(\"광고 매출 +10.1%\"), Badge(\"ROAS 177%\", \"success\"), Badge(\"전환율 –32.4%\", \"danger\"), Badge(\"W2 신규 캠페인 활성화\", \"info\"), Badge(\"재고 품절 위험\", \"warning\")], 1, null, null, true)\nkpisGrid = Grid(@Each(kpis, \"k\", Card([Col([Caption(k.caption), Title(k.value, \"lg\"), Badge(k.w1Value, null, \"W1\"), Badge(k.w2Value, null, \"W2\")], 2), Text(k.comment, \"xs\", \"muted\")]), 1.4), 3, 230, 3)\nkpisNote = Text(\"단위: 원, %, 개\\n모든 KPI 변화율은 원문 근거(표 '주요 지표') 기준이며, 계산·근거 충돌 시 \\\"원문 수치 확인 필요\\\" 안내를 별도 표기합니다.\", \"xs\", \"muted\")\nperiodTrend = Card([Title(\"주요 지표 주간 변동\", \"md\"), Chart(\"bar\", periodTrendRows, \"지표\", [\"W1\", \"W2\"], null, \"KRW\", false, 240), Table([\"지표\", \"W1\", \"W2\", \"변화\"], @Each(kpis, \"k\", [k.caption, k.w1Value, k.w2Value, k.deltaLabel]))])\ncampaignPerformance = Card([Title(\"주요 캠페인 성과 및 구조 진단\", \"md\"), Chart(\"bar\", campaignRows, \"캠페인명\", [\"이전\", \"이후\"], null, \"KRW\"), Text(\"치간칫솔(004)은 상위 VID의 품절 해소 영향으로, 치약코팅칫솔(003)은 집중노출/효율 개선에 힘입어 성장하였습니다. 치약(010)은 W2 신규로 데이터 부족합니다.\", \"xs\", \"muted\"), Table([\"캠페인명\", \"ID\", \"이전매출\", \"이후매출\", \"증감\", \"기여도\", \"광고수익률\", \"목표\", \"달성률\"], @Each(campaignRows, \"c\", [c.캠페인명, c.캠페인ID, c.이전, c.이후, c.diff, c.기여도, c.roas, c.troas, c.달성률]))])\ninventoryRisk = Card([Title(\"주요 광고 품목 재고 위험 현황\", \"md\"), Chart(\"bar\", @Each(vidRiskRows, \"v\", {VID: v.vid, \"광고 매출 위험 추정액\": v.매출위험}), \"VID\", [\"광고 매출 위험 추정액\"], null, \"KRW\", false), Table([\"VID\",\"상품명\",\"재고소진(h)\",\"위험추정액\",\"광고 매출 점유율\"], @Each(vidRiskRows, \"v\", [v.vid, v.name, v.oos, v.매출위험, v.점유율]))])\nactionRanking = Card([Title(\"긴급 우선 조치 및 감독 대상\", \"md\"), Table([\"순위\", \"출처\", \"우선 조치\", \"예상 매출증가\", \"주요 근거\"], @Each(actionRows, \"a\", [a.순위, a.출처, a.조치, a.예상, a.근거]))])\nvidAnalysis = Card([Title(\"광고수익률 하락 기여 주요 VID 분석\", \"md\"), Table([\"순위\",\"VID\",\"연결 캠페인\",\"광고 매출 변화\",\"ROAS 기여도변화\",\"재고/이슈\",\"요약\"], @Each(vidFallRows, \"v\", [v.순위, v.vid, v.linked, v.매출변, v.roas변, v.oos, v.요약]))])\neligibilityCheck = Card([Title(\"광고 적격성 검토 주요 VID\", \"md\"), Table([\"VID\",\"상품명\",\"광고매출\",\"재고소진(h)\",\"위험추정액\",\"영향 점유율\",\"핵심 권장\"], @Each(vidEligibilityRows, \"v\", [v.vid, v.name, v.매출, v.oos, v.위험, v.점유율, v.포인트]))])\n\nkpis = [\n  {caption: \"광고 매출\", value: \"9,000,000원\", w1Value: \"8,000,000원\", w2Value: \"9,000,000원\", deltaLabel: \"+800,000원 (+10.1%)\", comment: \"주간 성장, 주요 성장동인: 치간칫솔/치약코팅칫솔\"},\n  {caption: \"광고수익률(ROAS)\", value: \"177%\", w1Value: \"169%\", w2Value: \"177%\", deltaLabel: \"+8%p (+4.7%)\", comment: \"지속적 효율 개선\"},\n  {caption: \"광고비\", value: \"5,000,000원\", w1Value: \"5,000,000원\", w2Value: \"5,000,000원\", deltaLabel: \"+200,000원 (+5.1%)\", comment: \"광고비 변화 미미, 효율성 중심\"},\n  {caption: \"노출수\", value: \"1,000,000\", w1Value: \"900,000\", w2Value: \"1,000,000\", deltaLabel: \"+100,000 (+19.4%)\", comment: \"노출 증가로 클릭 상승 견인\"},\n  {caption: \"클릭률(CTR)\", value: \"0.8%\", w1Value: \"0.6%\", w2Value: \"0.8%\", deltaLabel: \"+0.2%p (+47.9%)\", comment: \"트래픽 상승 + 클릭률 개선\"},\n  {caption: \"전환율(CVR)\", value: \"3.5%\", w1Value: \"5.2%\", w2Value: \"3.5%\", deltaLabel: \"−2.0%p (−32.4%)\", comment: \"트래픽 급증에 비해 주문전환 역량 한계\"},\n  {caption: \"평균 주문 금액\", value: \"20,000원\", w1Value: \"30,000원\", w2Value: \"20,000원\", deltaLabel: \"−2,000원 (−7.8%)\", comment: \"평균 주문 금액 하락\"},\n  {caption: \"캠페인 수\", value: \"6\", w1Value: \"6\", w2Value: \"6\", deltaLabel: \"0\", comment: \"캠페인 수 변화 없음\"},\n  {caption: \"예산 소진 캠페인 수\", value: \"1\", w1Value: \"2\", w2Value: \"1\", deltaLabel: \"−1\", comment: \"감소: 치약코팅칫솔 외 예산 소진 캠페인 미발생\"}\n]\n\nperiodTrendRows = [\n  {지표: \"광고 매출\", W1: 8000000, W2: 9000000},\n  {지표: \"광고수익률(ROAS)\", W1: 169, W2: 177},\n  {지표: \"광고비\", W1: 5000000, W2: 5000000},\n  {지표: \"노출수\", W1: 900000, W2: 1000000},\n  {지표: \"클릭률(CTR)\", W1: 0.6, W2: 0.8},\n  {지표: \"전환율(CVR)\", W1: 5.2, W2: 3.5},\n  {지표: \"평균 주문 금액\", W1: 30000, W2: 20000}\n]\n\ncampaignRows = [\n  {캠페인명: \"치간칫솔\", 캠페인ID: \"CAMP_004\", 이전: 1000000, 이후: 2000000, diff: \"+1,000,000원\", 기여도: \"98.7%\", roas: \"200%\", troas: \"254%\", 달성률: \"78.6%\"},\n  {캠페인명: \"치약코팅칫솔\", 캠페인ID: \"CAMP_003\", 이전: 2000000, 이후: 2300000, diff: \"+300,000원\", 기여도: \"35.2%\", roas: \"383%\", troas: \"294%\", 달성률: \"130.0%\"},\n  {캠페인명: \"치약\", 캠페인ID: \"CAMP_010\", 이전: 0, 이후: 90000, diff: \"+90,000원\", 기여도: \"9.0%\", roas: \"165%\", troas: \"300%\", 달성률: \"54.9%\"}\n]\n\nvidRiskRows = [\n  {vid: \"VID_0018\", name: \"공급업체1 기능성 칫솔 이중초미세모 12개입\", oos: 47, 매출위험: 500000, 점유율: \"20.6%\"},\n  {vid: \"VID_0019\", name: \"공급업체1 기능성 칫솔 이중초미세모 6개입\", oos: 137, 매출위험: 2000000, 점유율: \"17.4%\"},\n  {vid: \"VID_0022\", name: \"공급업체1 치약코팅칫솔 50개입 1박스\", oos: 115, 매출위험: 1000000, 점유율: \"13.8%\"},\n  {vid: \"VID_0013\", name: \"공급업체1 치간칫솔 I형 SSS 핑크 100개입\", oos: 92, 매출위험: 500000, 점유율: \"13.3%\"},\n  {vid: \"VID_0021\", name: \"공급업체1 치약코팅칫솔 10개입 1개\", oos: 35, 매출위험: 200000, 점유율: \"9.9%\"}\n]\n\nactionRows = [\n  {순위: 1, 출처: \"Section 4 — OOB, 예산 조치 가능\", 조치: \"치약코팅칫솔(CAMP_003): 일예산을 100,000원에서 100,000원으로 증액 권장\", 예상: \"미정량화 (추천만 있음)\", 근거: \"W2 7일 전일 예산소진(OOB, 8시간 상한). ROAS 410% vs 목표 294%. Sales Engine 기준.\"},\n  {순위: 2, 출처: \"Section 5 — 낮은 활용률, 지원 추천 없음\", 조치: \"261001 기능성 칫솔(CAMP_047): 낮은 게재량 원인 추가 진단\", 예상: \"정량화 불가\", 근거: \"일예산 50만원, 활용률 2.5%, 재고 부족·활성 품절 가능성 존재. 입찰/예산 조정 전 원인확인 필요.\"},\n  {순위: 3, 출처: \"Section 5 — 낮은 활용률, 지원 추천 없음\", 조치: \"공급업체1 기존 칫솔(CAMP_009): 활용률 추세 모니터링\", 예상: \"정량화 불가\", 근거: \"일예산 10만원, 활용률 45.5%. 판매자 실질조치 불가. 예산 조정 권장 없음.\"}\n]\n\nvidFallRows = [\n  {순위: 1, vid: \"VID_0022\", linked: \"CAMP_003\\n치약코팅칫솔\", 매출변: \"−600,000원\", roas변: \"−53.4%p\", oos: \"품절 115시간\", 요약: \"품절 시간 악화(88h→115h)가 광고수익률 하락의 주요 원인. 재고 보충 필수.\"},\n  {순위: 2, vid: \"VID_0016\", linked: \"CAMP_009\\n기존 칫솔\", 매출변: \"−200,000원\", roas변: \"−27.3%p\", oos: \"적격 이슈 없음\", 요약: \"적격 제약 없음. 자연수요 감소 혹은 경쟁 심화 영향. 모니터링 필요.\"},\n  {순위: 3, vid: \"VID_0015\", linked: \"CAMP_004\\n치간칫솔\", 매출변: \"−90,000원\", roas변: \"−16.6%p\", oos: \"적격 이슈 없음\", 요약: \"가격하락(8.1%)이 원인. 재고/적격 제약 없음.\"},\n  {순위: 4, vid: \"VID_0018\", linked: \"CAMP_047\\n기능성 칫솔\", 매출변: \"−100,000원\", roas변: \"−9.3%p\", oos: \"품절 47시간\", 요약: \"품절 시간 재고 부족 원인. 재고 보충 필요.\"},\n  {순위: 5, vid: \"VID_0019\", linked: \"CAMP_047\\n기능성 칫솔\", 매출변: \"−50,000원\", roas변: \"−3.5%p\", oos: \"품절 137시간\", 요약: \"포트폴리오 내 최장 품절. 긴급 재고 보충 요함.\"}\n]\n\nvidEligibilityRows = [\n  {vid: \"VID_0018\", name: \"기능성 칫솔 12개입\", 매출: 4000000, oos: 47, 위험: 500000, 점유율: \"20.6%\", 포인트: \"재고 보충 필수 (매출 점유율 20.6%; 품절 47h)\"},\n  {vid: \"VID_0019\", name: \"기능성 칫솔 6개입\", 매출: 3000000, oos: 137, 위험: 2000000, 점유율: \"17.4%\", 포인트: \"긴급 재고 보충 필수 (추정 매출 위험 200만원, 품절 137h)\"},\n  {vid: \"VID_0022\", name: \"치약코팅칫솔 50개입\", 매출: 3000000, oos: 115, 위험: 1000000, 점유율: \"13.8%\", 포인트: \"재고 부족 지속 (점유율 13.8%, 품절 115h, 추정 위험 100만원)\"},\n  {vid: \"VID_0013\", name: \"치간칫솔 SSS 100개입\", 매출: 3000000, oos: 92, 위험: 500000, 점유율: \"13.3%\", 포인트: \"W2부터 품절 해소 경향, 재고 관리 유의\"},\n  {vid: \"VID_0021\", name: \"치약코팅칫솔 10개입\", 매출: 2000000, oos: 35, 위험: 200000, 점유율: \"9.9%\", 포인트: \"품절 해소 이후 광고매출 상승, 재고관리 필요\"}\n]","status":"ready","published":false,"created_at":"2026-10-20T09:21:01.323693+00:00"}}

event: custom|report_subagent:10e5e6db-bef0-8f0b-326a-b695ffe74001
data: {"channel":"chat","type":"message","content":"공급업체1 리포트를 Canvas에 만들었습니다. 내용을 선택해 질문하거나 PDF로 저장하고 공유할 수 있습니다."}

