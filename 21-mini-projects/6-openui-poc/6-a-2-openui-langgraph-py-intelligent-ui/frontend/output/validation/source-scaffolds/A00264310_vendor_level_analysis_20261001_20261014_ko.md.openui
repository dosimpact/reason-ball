root = Col([heading, quality, navigation, body])
$section = "개요"
$campaign = "전체"
$done = []
$minHours = 0
$riskView = "품절 시간"
$evidence = "전체"
heading = Col([Title("공급업체2 (V_공급업체2)의 전체 V1 광고주 수준 분석 보고서 · 인터랙티브 보고서", "xl"), Text("2026년 10월 1일 – 10월 14일", "sm", "muted"), Row([Badge("원문 기반", "info"), Badge("W1 / W2 비교", "purple"), Badge("로컬 필터 · 상태 저장", "success")], 2)])
quality = Card([Title("원문 수치 확인 필요", "md"), Col(@Each(["광고비 (광고비): 10,000,000원 → 10,000,000원, 원문 변화 +3,000,000원 (+23.1%). 기간별 값과 변화량 확인 필요.","평균주문금액 (AOV): 80,000원 → 90,000원, 원문 변화 +7,000원 (+8.0%). 기간별 값과 변화량 확인 필요."], "w", Text(w, "sm", "warning")), 2), Caption("원문 기재 값 유지 · 다른 기간과 단위를 합산하지 않음")], "soft")
navigation = SegmentedControl($section, ["개요", "캠페인", "재고", "조치", "근거"], true)
body = $section == "개요" ? overview : $section == "캠페인" ? campaignView : $section == "재고" ? inventoryView : $section == "조치" ? actionView : evidenceView
metrics = [{"label":"광고 매출 (광고 매출)","w1":"40,000,000원","w2":"50,000,000원","delta":"+10,000,000원 (+37.0%)"},{"label":"광고수익률 (ROAS)","w1":"295%","w2":"328%","delta":"+33%p (+11.2%)"},{"label":"광고비 (광고비)","w1":"10,000,000원","w2":"10,000,000원","delta":"+3,000,000원 (+23.1%)"},{"label":"노출수","w1":"3,000,000","w2":"4,000,000","delta":"+600,000 (+17.6%)"},{"label":"클릭률 (CTR)","w1":"0.4%","w2":"0.4%","delta":"+0%p (+8.9%)"},{"label":"전환율 (CVR)","w1":"3.5%","w2":"3.4%","delta":"−0%p (−0.9%)"},{"label":"평균주문금액 (AOV)","w1":"80,000원","w2":"90,000원","delta":"+7,000원 (+8.0%)"},{"label":"캠페인 수","w1":"16","w2":"18","delta":"+2"},{"label":"예산 소진 (OOB) 캠페인 수","w1":"2","w2":"2","delta":"0"}]
periods = [{"period":"W1","revenue":40000000,"spend":10000000},{"period":"W2","revenue":50000000,"spend":10000000}]
ratios = [{"period":"W1","roas":295,"cvr":3.5},{"period":"W2","roas":328,"cvr":3.4}]
campaigns = [{"id":"CAMP_019","name":"오리지널 200","revenue":null,"roas":382,"target":250,"diagnosis":"광고 매출 급등 원인: 광고 매출이 +119.1% 급증(10,000,000원→30,000,000원)하였으며, 이는 주로 일예산 3회 인상(10월 6일, 12일, 14일 — 일예산이 300,000원에서 3,000,000원으로 3배 증가)에 따른 노출수 폭발적 증가(+200.3%)에 기인합니다. 증분 물량이 매출 성장의 주요 동인으로, GMV 기여도 +140.2%를 차지합니다. 클릭률(−13.5%), 전환율(−2.4%), 평균 주문금액(−13.6%)은 모두 하락하였는데, 이는 확대된 예산이 비검색 지면(non-search 노출수 +216% vs. 검색 +147%)에서 상대적으로 낮은 품질의 트래픽을 유입시켰기 때문입니다. 주문 비중은 평균 주문금액이 낮은 타겟 상품 쪽으로 크게 이동하였고(주문 비중 56%→79%, 평균 판매가 약 80,000원), 평균 주문금액이 높은 비타겟 상품은 주문당 약 100,000원에서 약 100,000원으로 하락하였습니다. 결과적으로 광고 매출은 크게 성장하였으나 광고수익률 달성률은 190.7%에서 140.2%로 하락하였습니다. 광고수익률 달성률은 90%를 크게 상회하는 수준을 유지하고 있습니다.","action":"예산 확대를 통해 강력한 광고 매출 성장을 성공적으로 이끌어냈습니다. 현재 달성률 140.2%는 기준치를 크게 상회하고 있어 목표 광고수익률 변경은 불필요합니다. 예산이 높은 수준으로 유지되는 동안 클릭당 과금(CPC) 추이와 비검색 지면 효율을 모니터링하세요. 광고수익률 달성률이 100%에 근접할 경우, 그 시점에 입찰가 또는 목표 광고수익률 설정을 재검토하시기 바랍니다. 현 단계에서는 추가 예산 인상을 권장하지 않으며, 재평가 전에 현재 게재 패턴이 안정화될 때까지 지켜보시기 바랍니다."},{"id":"CAMP_028","name":"크런치 500_판매자 배송","revenue":null,"roas":248,"target":230,"diagnosis":"광고 매출 급등 원인: 광고 매출이 +250.1% 급증(1,000,000원→4,000,000원)하였습니다. 주요 동인은 평균 주문금액 확대(+131.1%, 30,000원→80,000원)로, GMV 성장의 +66.8%를 기여하였습니다. 활성화된 상품 3개 모두 더 높은 가격대로 이동하였는데, VIID 87722961111의 평균 판매가는 +200%, VIID 95740906340은 +118% 상승하였으며, 신규 고가 상품(VIID 94836985786, 약 100,000원)이 2주차에 신규 진입하였습니다. 노출수도 +30.7% 증가한 반면 카테고리는 −6.7%, 주요 경쟁사는 −14.0% 감소하여 상대적인 점유율 확보가 이루어진 것으로 판단됩니다. 광고수익률 달성률은 70.0%에서 127.7%로 개선되었습니다.","action":"광고 매출 급등은 상품 믹스 및 가격 변화에 기인한 것으로, 건전한 구조적 변화입니다. 광고수익률 달성률이 100%를 상회하였습니다. 건전한 달성률을 감안하여 현재 목표 광고수익률(230%) 설정을 유지하세요. 고가 신규 상품(VIID 94836985786)이 2주차 광고 매출의 26.3%를 차지하고 있는 만큼, 이후 주차에도 해당 상품의 기여가 지속되는지 모니터링하시기 바랍니다. 현 시점에서는 예산 또는 목표 광고수익률 조정이 필요하지 않습니다."},{"id":"CAMP_002","name":"땅콩버터 나머지ai","revenue":null,"roas":271,"target":270,"diagnosis":"광고 매출 상승 이유: 광고 매출이 +88.7% 증가(1,000,000원→2,000,000원)하였으며, 이는 전적으로 평균 주문 금액(AOV)의 +183.0% 확대(30,000원→80,000원)에 의해 견인되었습니다 — GMV에 +163.9% 기여 — 캠페인 내 주요 상품(VIID 87020559414, GMV의 99.6% 기여)이 W2에서 더 높은 가격의 번들 또는 구성으로 전환된 결과입니다. 노출수는 −32.2% 감소하였고 전환율은 −29.4% 하락하여 AOV 상승 효과를 일부 상쇄하였으며, 이러한 물량 측면의 역풍이 더 큰 폭의 광고 매출 상승을 제한하였습니다. 광고수익률(ROAS) 달성률은 W2에서 100.2%로, W1의 부진한 58.2%에서 회복되었습니다.","action":"이 캠페인(APS 유형)에 대한 심층 진단은 제공되지 않습니다. 이용 가능한 퍼널 데이터를 기반으로: 노출수 및 전환율 하락은 지속적인 모니터링이 필요합니다. AOV 확대가 영구적인 상품 가격 재조정을 반영하는 경우, 노출수 회복 추이를 지켜보는 것 외에 별도 조치는 필요하지 않습니다. AOV 상승이 일시적인 경우(예: 프로모션 번들), 다음 기간의 광고 매출 반전 가능성에 대비하시기 바랍니다. 현재 광고주가 직접 취할 수 있는 권장 조치는 없습니다."},{"id":"CAMP_058","name":"전략 2주 캠페인(오리지널200*1)","revenue":null,"roas":45,"target":350,"diagnosis":"광고 매출 상승 이유: 캠페인이 W1에는 비활성 상태(광고 매출 0원, 광고비 0원)였으며, 첫 활성 주차인 W2에 80,000원의 광고 매출을 기록하였습니다. 광고수익률(ROAS) 달성률은 12.9%로 매우 낮은 수준이며(ROAS 45% vs. 목표 광고수익률(T.ROAS) 350%), 목표 광고수익률(T.ROAS) 목표가 실제 캠페인 성과 대비 지나치게 제한적임을 나타냅니다. W2 광고 매출에는 VIID 86556965936만 기여하였습니다. 캠페인의 활동 이력이 충분하지 않아 전체 구조적 진단이 어렵습니다.","action":"심층 진단을 제공할 수 없습니다(활동 부족: W1 광고 매출 0원, W2 주문수 기준 미달). 현재 목표 광고수익률(T.ROAS) 350%는 실제 집행 광고수익률(ROAS) 45%를 크게 상회합니다 — 이 목표 광고수익률(T.ROAS)이 의도적으로 보수적으로 설정된 런칭 파라미터인지, 아니면 잘못 설정된 목표인지 검토하시고, 캠페인 확장을 목표로 한다면 완화 여부를 고려해 보세요. 집행 효율이 개선되기 전까지는 예산을 늘리지 마시고, 우선 목표 광고수익률(T.ROAS) 제약 요인 파악에 집중하시기 바랍니다."}]
risks = [{"id":"VID_0004","name":"공급업체2 땅콩버터 100% 국산 땅콩 잼, 아몬드 크런치 200g×2","hours":2,"amount":20000000,"share":25.1,"issue":"Image/Suppression: 336h","summary":"이미지/노출 억제 이슈가 2주 분석 기간 내내 지속되었습니다. 이 VID는 광고주의 광고 매출 최상위 상품입니다. 연결된 캠페인 광고비를 확대하기 전에 카탈로그/광고 노출 억제 문제를 먼저 해결하세요 — 광고 적격성 이슈가 이 상품의 추가 광고 매출 성장을 가로막는 핵심 장애 요인입니다."},{"id":"VID_0002","name":"공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 200g×2","hours":2,"amount":10000000,"share":13.3,"issue":"이미지/노출 제한: 336시간","summary":"광고 매출 2위 상품(VID)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 최고 성과 캠페인(CAMP_019)과 연결되어 있으며, 노출 제한을 해소할 경우 예산 확대를 통해 이미 달성한 광고 매출 성장을 더욱 크게 확대할 수 있습니다. VID #1과 함께 우선적으로 조치하시기 바랍니다."},{"id":"VID_0025","name":"공급업체2 땅콩버터 크런치 무설탕 100% 국산 땅콩 버터 잼 500g×1","hours":2,"amount":null,"share":4.4,"issue":"품절: 336시간 | 구매 불가: 336시간","summary":"2주 전체 기간 동안 품절 및 구매 불가 상태로, 14일간 광고 게재가 완전히 불가능한 상태였습니다. 캠페인 CAMP_018의 예산 소진율 0.0%와 직접적으로 연결되어 있습니다. 캠페인 단위 조치에 앞서 재고 보충이 선행되어야 합니다."},{"id":"87722961111","name":"공급업체2 땅콩버터 크런치 무설탕 100% 국산 땅콩 버터 잼 500g×3","hours":2,"amount":4000000,"share":4,"issue":"이미지/노출 제한: 336시간","summary":"캠페인 CAMP_028의 최대 기여 상품(해당 캠페인 W2 광고 매출의 50.5%)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 노출 제한을 해소할 경우 크런치 500_판매자 배송에서 관찰된 평균 주문 금액(AOV) 기반의 광고 매출 성장을 더욱 확대할 수 있습니다."},{"id":"94836937078","name":"공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 500g×1","hours":2,"amount":7000000,"share":3.4,"issue":"품절: 232시간 | 구매 불가: 232시간","summary":"가능한 336시간 중 232시간(분석 기간의 69%) 동안 품절/구매 불가 상태였습니다. 매출최적화_오리지널 500_로켓그로스(CAMP_017, 예산 소진율 0.5%)와 연결되어 있습니다. 재고 해소가 최우선 조치이며, 위험에 처한 광고 매출 추정액은 7,000,000원으로, 수치화된 임팩트 기준으로 품절 VID 중 가장 높은 위험 수준입니다."}]
knownHourRisks = [{"id":"VID_0004","name":"공급업체2 땅콩버터 100% 국산 땅콩 잼, 아몬드 크런치 200g×2","hours":2,"amount":20000000,"share":25.1,"issue":"Image/Suppression: 336h","summary":"이미지/노출 억제 이슈가 2주 분석 기간 내내 지속되었습니다. 이 VID는 광고주의 광고 매출 최상위 상품입니다. 연결된 캠페인 광고비를 확대하기 전에 카탈로그/광고 노출 억제 문제를 먼저 해결하세요 — 광고 적격성 이슈가 이 상품의 추가 광고 매출 성장을 가로막는 핵심 장애 요인입니다."},{"id":"VID_0002","name":"공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 200g×2","hours":2,"amount":10000000,"share":13.3,"issue":"이미지/노출 제한: 336시간","summary":"광고 매출 2위 상품(VID)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 최고 성과 캠페인(CAMP_019)과 연결되어 있으며, 노출 제한을 해소할 경우 예산 확대를 통해 이미 달성한 광고 매출 성장을 더욱 크게 확대할 수 있습니다. VID #1과 함께 우선적으로 조치하시기 바랍니다."},{"id":"VID_0025","name":"공급업체2 땅콩버터 크런치 무설탕 100% 국산 땅콩 버터 잼 500g×1","hours":2,"amount":null,"share":4.4,"issue":"품절: 336시간 | 구매 불가: 336시간","summary":"2주 전체 기간 동안 품절 및 구매 불가 상태로, 14일간 광고 게재가 완전히 불가능한 상태였습니다. 캠페인 CAMP_018의 예산 소진율 0.0%와 직접적으로 연결되어 있습니다. 캠페인 단위 조치에 앞서 재고 보충이 선행되어야 합니다."},{"id":"87722961111","name":"공급업체2 땅콩버터 크런치 무설탕 100% 국산 땅콩 버터 잼 500g×3","hours":2,"amount":4000000,"share":4,"issue":"이미지/노출 제한: 336시간","summary":"캠페인 CAMP_028의 최대 기여 상품(해당 캠페인 W2 광고 매출의 50.5%)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 노출 제한을 해소할 경우 크런치 500_판매자 배송에서 관찰된 평균 주문 금액(AOV) 기반의 광고 매출 성장을 더욱 확대할 수 있습니다."},{"id":"94836937078","name":"공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 500g×1","hours":2,"amount":7000000,"share":3.4,"issue":"품절: 232시간 | 구매 불가: 232시간","summary":"가능한 336시간 중 232시간(분석 기간의 69%) 동안 품절/구매 불가 상태였습니다. 매출최적화_오리지널 500_로켓그로스(CAMP_017, 예산 소진율 0.5%)와 연결되어 있습니다. 재고 해소가 최우선 조치이며, 위험에 처한 광고 매출 추정액은 7,000,000원으로, 수치화된 임팩트 기준으로 품절 VID 중 가장 높은 위험 수준입니다."}]
knownAmountRisks = [{"id":"VID_0004","name":"공급업체2 땅콩버터 100% 국산 땅콩 잼, 아몬드 크런치 200g×2","hours":2,"amount":20000000,"share":25.1,"issue":"Image/Suppression: 336h","summary":"이미지/노출 억제 이슈가 2주 분석 기간 내내 지속되었습니다. 이 VID는 광고주의 광고 매출 최상위 상품입니다. 연결된 캠페인 광고비를 확대하기 전에 카탈로그/광고 노출 억제 문제를 먼저 해결하세요 — 광고 적격성 이슈가 이 상품의 추가 광고 매출 성장을 가로막는 핵심 장애 요인입니다."},{"id":"VID_0002","name":"공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 200g×2","hours":2,"amount":10000000,"share":13.3,"issue":"이미지/노출 제한: 336시간","summary":"광고 매출 2위 상품(VID)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 최고 성과 캠페인(CAMP_019)과 연결되어 있으며, 노출 제한을 해소할 경우 예산 확대를 통해 이미 달성한 광고 매출 성장을 더욱 크게 확대할 수 있습니다. VID #1과 함께 우선적으로 조치하시기 바랍니다."},{"id":"87722961111","name":"공급업체2 땅콩버터 크런치 무설탕 100% 국산 땅콩 버터 잼 500g×3","hours":2,"amount":4000000,"share":4,"issue":"이미지/노출 제한: 336시간","summary":"캠페인 CAMP_028의 최대 기여 상품(해당 캠페인 W2 광고 매출의 50.5%)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 노출 제한을 해소할 경우 크런치 500_판매자 배송에서 관찰된 평균 주문 금액(AOV) 기반의 광고 매출 성장을 더욱 확대할 수 있습니다."},{"id":"94836937078","name":"공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 500g×1","hours":2,"amount":7000000,"share":3.4,"issue":"품절: 232시간 | 구매 불가: 232시간","summary":"가능한 336시간 중 232시간(분석 기간의 69%) 동안 품절/구매 불가 상태였습니다. 매출최적화_오리지널 500_로켓그로스(CAMP_017, 예산 소진율 0.5%)와 연결되어 있습니다. 재고 해소가 최우선 조치이며, 위험에 처한 광고 매출 추정액은 7,000,000원으로, 수치화된 임팩트 기준으로 품절 VID 중 가장 높은 위험 수준입니다."}]
actions = [{"id":"action0","title":"아몬드 크런치_1개 (CAMP_016)","evidence":"일예산 1,000,000원 대비 예산 소진율이 8.3%에 불과하여, 목표 광고수익률(T.ROAS) 목표가 집행을 제한하고 있음을 나타냅니다. 300%로의 인하는 지원되는 권장 조치에 부합하며, 현재 낮은 소진율을 감안할 때 추가 광고 매출을 확보할 가능성이 가장 높습니다.","impact":"목표 광고수익률(T.ROAS) 제약 검토 및 완화: 350% → 300%"},{"id":"action1","title":"아몬드 크런치 2개 (CAMP_021)","evidence":"예산 소진율이 39.4%로 아직 완전 소진에 미치지 못하는 수준이며, 지원되는 목표 광고수익률(T.ROAS) 권장 조치가 존재합니다. 목표를 완화하면 캠페인이 더 많은 적격 트래픽을 흡수하여 광고 매출을 추가로 성장시킬 수 있습니다.","impact":"목표 광고수익률(T.ROAS) 제약 검토 및 완화: 350% → 300%"},{"id":"action2","title":"매출최적화_오리지널 500_로켓그로스 (CAMP_017)","evidence":"현재 광고주가 직접 취할 수 있는 조치는 없으나, 예산 소진율 0.5%는 시스템적 집행 억제를 시사합니다. AE는 상품 적격성 문제(Section 7B 참조: VIID 94836937078, 품절 232시간)가 집행 부진에 기여하고 있는지 확인하고, 우선적으로 재고 해소를 위한 조율을 진행해야 합니다.","impact":"AE 검토 플래그: 거의 0에 가까운 집행 (소진율 0.5%)"}]
evidence = [{"section":"섹션 1 — 벤더 핵심 / 주요 지표","columns":["지표","Week 1 (10월 1일–10월 7일)","Week 2 (10월 8일–10월 14일)","변화"],"rows":[["광고 매출 (광고 매출)","40,000,000원","50,000,000원","+10,000,000원 (+37.0%)"],["광고수익률 (ROAS)","295%","328%","+33%p (+11.2%)"],["광고비 (광고비)","10,000,000원","10,000,000원","+3,000,000원 (+23.1%)"],["노출수","3,000,000","4,000,000","+600,000 (+17.6%)"],["클릭률 (CTR)","0.4%","0.4%","+0%p (+8.9%)"],["전환율 (CVR)","3.5%","3.4%","−0%p (−0.9%)"],["평균주문금액 (AOV)","80,000원","90,000원","+7,000원 (+8.0%)"],["캠페인 수","16","18","+2"],["예산 소진 (OOB) 캠페인 수","2","2","0"]]},{"section":"섹션 2 — 경영진 요약","columns":["요약 영역","요약"],"rows":[["주요 VID 변동 및 광고 적격성 요약","- Section 7A: 광고 매출 하락 또는 광고수익률 하락에 기여한 VID 행 없음 — 광고주 광고 매출은 두 기간 모두 상승하였습니다. · - Section 7B 주요 노출 자격 위험: VID VID_0004 (아몬드 크런치 땅콩버터 200g×2) — 이미지/노출 제한 336시간; 최근 2주 광고 매출 위험 금액 20,000,000원; 연결 캠페인 CAMP_002, CAMP_016, CAMP_021. · - VID VID_0002 (오리지널 땅콩버터 200g×2) — 이미지/노출 제한 336시간; 광고 매출 위험 금액 10,000,000원; 연결 캠페인 CAMP_019, 105382877. · - VID VID_0025 및 94836937078 — 품절(OOS)/BBL 시간 감지됨; 합산 광고 매출 위험 금액 미산출 + 7,000,000원; 재고 보충 필요."],["광고 매출 하락/상승 진단 요약","광고주 광고 매출이 W1→W2 +10,000,000원 (+37.0%) 상승하였으며, 주요 기여 요인은 다음과 같습니다: · - 오리지널 200 (CAMP_019): +10,000,000원 (+119.1%) — 일예산이 3차례 증액(10월 6일/12일/14일)으로 3배 확대되어 노출수 +200.3% 급증, 광고 매출 상승을 주도함; 증분 트래픽이 전환율이 낮은 지면에서 유입되고 CPC가 +14.7% 상승하면서 광고수익률은 26.5% 하락하였으나, 광고수익률 달성률은 140.2%로 높은 수준을 유지함. · - 크런치 500_판매자 배송 (CAMP_028): +3,000,000원 (+250.1%) — 상품 구성이 고가 SKU로 이동하면서 평균주문금액이 거의 2배(30,000원→80,000원)로 상승; 활성 상품 3개 모두 더 높은 가격대로 이동하여 광고 매출 상승분의 131%를 기여; 카테고리가 축소되는 상황에서도 노출 점유율 증가. · - 땅콩버터 나머지ai (CAMP_002): +1,000,000원 (+88.7%) — 평균주문금액 +183% 확대(30,000원→80,000원)가 주요 광고 매출 동인; 노출수 −32.2% 감소 및 전환율 −29.4% 하락이 일부 상쇄; 심층 진단 불가(APS 캠페인 유형). · - 전략 2주 캠페인(오리지널200*1) (CAMP_058): +80,000원 (신규 캠페인, W1 광고 매출 0원) — 신규 활성 캠페인으로 광고수익률 달성률 12.9%에 불과; 전체 진단을 위한 활동 데이터 부족."],["광고 매출 성장을 위한 핵심 인사이트 및 조치 요약","- Section 4 (OOB): OOB 캠페인 3개 모두 참고용 행(일예산이 최근 이미 증액되었거나 추천 불가)에 해당하므로, 즉각적인 예산 증액 조치는 불필요합니다 — 재발 여부를 모니터링하세요. · - Section 5 (낮은 예산 소진율 — 목표 광고수익률 조치): 아몬드 크런치_1개 (CAMP_016, 소진율 8.3%; 목표 광고수익률 350%→300% 권장) 및 아몬드 크런치 2개 (CAMP_021, 소진율 39.4%; 목표 광고수익률 350%→300% 권장)의 목표 광고수익률 제약을 완화하여 추가 광고 매출 여력을 확보하세요. · - Section 5 (낮은 예산 소진율 — 모니터링 대상): 매출최적화_오리지널 500_로켓그로스 (CAMP_017, 소진율 0.5%) 및 매출최적화_크런치 500_로켓그로스 (CAMP_018, 소진율 0.0%)는 거의 미노출 상태입니다; 현재 판매자가 취할 수 있는 조치 없음 — 전략적으로 중요한 경우 AE 검토를 요청하세요."]]},{"section":"섹션 3A — 벤더 광고 매출 변동을 주도한 주요 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","1주차 광고 매출","2주차 광고 매출","매출 증감","기여도","광고비","광고수익률","목표 광고수익률","광고수익률 달성률"],"rows":[["오리지널 200","CAMP_019","MPS","10,000,000원","30,000,000원","+10,000,000원","118.8%","10,000,000원","382%","250%","152.9%"],["크런치 500_판매자 배송","CAMP_028","MPS","1,000,000원","4,000,000원","+3,000,000원","18.6%","2,000,000원","248%","230%","108.0%"],["땅콩버터 나머지ai","CAMP_002","APS","1,000,000원","2,000,000원","+1,000,000원","7.0%","1,000,000원","271%","270%","100.2%"],["전략 2주 캠페인(오리지널200*1)","CAMP_058","MPS","0원","80,000원","+80,000원","0.5%","100,000원","45%","350%","12.9%"]]},{"section":"섹션 3B — 섹션 3a 캠페인 진단 및 추천 사항","columns":["#","캠페인 ID","캠페인명","진단","추천 및 근거"],"rows":[["1","CAMP_019","오리지널 200","광고 매출 급등 원인: 광고 매출이 +119.1% 급증(10,000,000원→30,000,000원)하였으며, 이는 주로 일예산 3회 인상(10월 6일, 12일, 14일 — 일예산이 300,000원에서 3,000,000원으로 3배 증가)에 따른 노출수 폭발적 증가(+200.3%)에 기인합니다. 증분 물량이 매출 성장의 주요 동인으로, GMV 기여도 +140.2%를 차지합니다. 클릭률(−13.5%), 전환율(−2.4%), 평균 주문금액(−13.6%)은 모두 하락하였는데, 이는 확대된 예산이 비검색 지면(non-search 노출수 +216% vs. 검색 +147%)에서 상대적으로 낮은 품질의 트래픽을 유입시켰기 때문입니다. 주문 비중은 평균 주문금액이 낮은 타겟 상품 쪽으로 크게 이동하였고(주문 비중 56%→79%, 평균 판매가 약 80,000원), 평균 주문금액이 높은 비타겟 상품은 주문당 약 100,000원에서 약 100,000원으로 하락하였습니다. 결과적으로 광고 매출은 크게 성장하였으나 광고수익률 달성률은 190.7%에서 140.2%로 하락하였습니다. 광고수익률 달성률은 90%를 크게 상회하는 수준을 유지하고 있습니다.","예산 확대를 통해 강력한 광고 매출 성장을 성공적으로 이끌어냈습니다. 현재 달성률 140.2%는 기준치를 크게 상회하고 있어 목표 광고수익률 변경은 불필요합니다. 예산이 높은 수준으로 유지되는 동안 클릭당 과금(CPC) 추이와 비검색 지면 효율을 모니터링하세요. 광고수익률 달성률이 100%에 근접할 경우, 그 시점에 입찰가 또는 목표 광고수익률 설정을 재검토하시기 바랍니다. 현 단계에서는 추가 예산 인상을 권장하지 않으며, 재평가 전에 현재 게재 패턴이 안정화될 때까지 지켜보시기 바랍니다."],["2","CAMP_028","크런치 500_판매자 배송","광고 매출 급등 원인: 광고 매출이 +250.1% 급증(1,000,000원→4,000,000원)하였습니다. 주요 동인은 평균 주문금액 확대(+131.1%, 30,000원→80,000원)로, GMV 성장의 +66.8%를 기여하였습니다. 활성화된 상품 3개 모두 더 높은 가격대로 이동하였는데, VIID 87722961111의 평균 판매가는 +200%, VIID 95740906340은 +118% 상승하였으며, 신규 고가 상품(VIID 94836985786, 약 100,000원)이 2주차에 신규 진입하였습니다. 노출수도 +30.7% 증가한 반면 카테고리는 −6.7%, 주요 경쟁사는 −14.0% 감소하여 상대적인 점유율 확보가 이루어진 것으로 판단됩니다. 광고수익률 달성률은 70.0%에서 127.7%로 개선되었습니다.","광고 매출 급등은 상품 믹스 및 가격 변화에 기인한 것으로, 건전한 구조적 변화입니다. 광고수익률 달성률이 100%를 상회하였습니다. 건전한 달성률을 감안하여 현재 목표 광고수익률(230%) 설정을 유지하세요. 고가 신규 상품(VIID 94836985786)이 2주차 광고 매출의 26.3%를 차지하고 있는 만큼, 이후 주차에도 해당 상품의 기여가 지속되는지 모니터링하시기 바랍니다. 현 시점에서는 예산 또는 목표 광고수익률 조정이 필요하지 않습니다."],["3","CAMP_002","땅콩버터 나머지ai","광고 매출 상승 이유: 광고 매출이 +88.7% 증가(1,000,000원→2,000,000원)하였으며, 이는 전적으로 평균 주문 금액(AOV)의 +183.0% 확대(30,000원→80,000원)에 의해 견인되었습니다 — GMV에 +163.9% 기여 — 캠페인 내 주요 상품(VIID 87020559414, GMV의 99.6% 기여)이 W2에서 더 높은 가격의 번들 또는 구성으로 전환된 결과입니다. 노출수는 −32.2% 감소하였고 전환율은 −29.4% 하락하여 AOV 상승 효과를 일부 상쇄하였으며, 이러한 물량 측면의 역풍이 더 큰 폭의 광고 매출 상승을 제한하였습니다. 광고수익률(ROAS) 달성률은 W2에서 100.2%로, W1의 부진한 58.2%에서 회복되었습니다.","이 캠페인(APS 유형)에 대한 심층 진단은 제공되지 않습니다. 이용 가능한 퍼널 데이터를 기반으로: 노출수 및 전환율 하락은 지속적인 모니터링이 필요합니다. AOV 확대가 영구적인 상품 가격 재조정을 반영하는 경우, 노출수 회복 추이를 지켜보는 것 외에 별도 조치는 필요하지 않습니다. AOV 상승이 일시적인 경우(예: 프로모션 번들), 다음 기간의 광고 매출 반전 가능성에 대비하시기 바랍니다. 현재 광고주가 직접 취할 수 있는 권장 조치는 없습니다."],["4","CAMP_058","전략 2주 캠페인(오리지널200*1)","광고 매출 상승 이유: 캠페인이 W1에는 비활성 상태(광고 매출 0원, 광고비 0원)였으며, 첫 활성 주차인 W2에 80,000원의 광고 매출을 기록하였습니다. 광고수익률(ROAS) 달성률은 12.9%로 매우 낮은 수준이며(ROAS 45% vs. 목표 광고수익률(T.ROAS) 350%), 목표 광고수익률(T.ROAS) 목표가 실제 캠페인 성과 대비 지나치게 제한적임을 나타냅니다. W2 광고 매출에는 VIID 86556965936만 기여하였습니다. 캠페인의 활동 이력이 충분하지 않아 전체 구조적 진단이 어렵습니다.","심층 진단을 제공할 수 없습니다(활동 부족: W1 광고 매출 0원, W2 주문수 기준 미달). 현재 목표 광고수익률(T.ROAS) 350%는 실제 집행 광고수익률(ROAS) 45%를 크게 상회합니다 — 이 목표 광고수익률(T.ROAS)이 의도적으로 보수적으로 설정된 런칭 파라미터인지, 아니면 잘못 설정된 목표인지 검토하시고, 캠페인 확장을 목표로 한다면 완화 여부를 고려해 보세요. 집행 효율이 개선되기 전까지는 예산을 늘리지 마시고, 우선 목표 광고수익률(T.ROAS) 제약 요인 파악에 집중하시기 바랍니다."]]},{"section":"3페이지 — 광고 매출 극대화 방안 — 핵심 인사이트 및 추천 조치 요약","columns":["순위","출처","캠페인","우선 조치","근거"],"rows":[["1","Section 5 — 목표 광고수익률(T.ROAS) 권장 조치","아몬드 크런치_1개 (CAMP_016)","목표 광고수익률(T.ROAS) 제약 검토 및 완화: 350% → 300%","일예산 1,000,000원 대비 예산 소진율이 8.3%에 불과하여, 목표 광고수익률(T.ROAS) 목표가 집행을 제한하고 있음을 나타냅니다. 300%로의 인하는 지원되는 권장 조치에 부합하며, 현재 낮은 소진율을 감안할 때 추가 광고 매출을 확보할 가능성이 가장 높습니다."],["2","Section 5 — 목표 광고수익률(T.ROAS) 권장 조치","아몬드 크런치 2개 (CAMP_021)","목표 광고수익률(T.ROAS) 제약 검토 및 완화: 350% → 300%","예산 소진율이 39.4%로 아직 완전 소진에 미치지 못하는 수준이며, 지원되는 목표 광고수익률(T.ROAS) 권장 조치가 존재합니다. 목표를 완화하면 캠페인이 더 많은 적격 트래픽을 흡수하여 광고 매출을 추가로 성장시킬 수 있습니다."],["3","Section 5 — 모니터링 대상 (지원되는 권장 조치 없음)","매출최적화_오리지널 500_로켓그로스 (CAMP_017)","AE 검토 플래그: 거의 0에 가까운 집행 (소진율 0.5%)","현재 광고주가 직접 취할 수 있는 조치는 없으나, 예산 소진율 0.5%는 시스템적 집행 억제를 시사합니다. AE는 상품 적격성 문제(Section 7B 참조: VIID 94836937078, 품절 232시간)가 집행 부진에 기여하고 있는지 확인하고, 우선적으로 재고 해소를 위한 조율을 진행해야 합니다."]]},{"section":"섹션 4 — OOB 시간이 있는 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","광고 매출","광고비","광고수익률(ROAS)","목표 광고수익률(T.ROAS)","광고수익률(ROAS) 달성률","예산 초과(OOB) 시간","현재 일예산","권장 일예산","기대 매출 증가액","AE 조치 / 참고 사항"],"rows":[["오리지널 200","CAMP_019","MPS","30,000,000원","10,000,000원","382%","250%","152.9%","40","3,000,000원","—","—","과거 예산 소진 이력 — 예산이 최근 이미 증액되었습니다. 일예산이 3차례 증액을 통해 3배로 늘어났습니다 (10월 6일, 12일, 14일: 300,000원 → 3,000,000원). 예산 소진은 증액 이전의 제약 기간을 반영할 가능성이 높습니다. 현재 상향된 예산 하에서는 예산이 더 이상 주요 제약 요인이 아닐 수 있습니다. 현재 증액된 예산에서 예산 소진이 재발하지 않는 한, 추가 예산 증액을 먼저 제안하지 마세요."],["아몬드 크런치 2개","CAMP_021","MPS","8,000,000원","6,000,000원","305%","350%","87.2%","4","1,000,000원","—","—","과거 예산 소진 이력 — 예산 추천 정보 없음. 예산 소진 4시간이 확인되었으나, 현재 시스템 기반 예산 추천 또는 광고 매출 증대 추정치를 제공할 수 없습니다. 참고 용도로만 활용하세요. 뒷받침 데이터 없이 예산 증액을 과도하게 제안하지 마세요. 참고: 목표 광고수익률(ROAS) 달성률이 87.2%로 90% 미만입니다 — 목표 광고수익률(T.ROAS) 제약(350%)이 예산보다 먼저 작동하고 있을 수 있습니다. 목표 광고수익률(T.ROAS) 검토가 보다 적절한 우선 조치입니다 (Section 5 참조)."],["크런치 500_판매자 배송","CAMP_028","MPS","4,000,000원","2,000,000원","248%","230%","108.0%","3","500,000원","—","—","과거 예산 소진 이력 — 예산 추천 정보 없음. 예산 소진 3시간이 확인되었으나, 시스템 기반 예산 추천을 제공할 수 없습니다. 캠페인 광고수익률(ROAS) 달성률은 108.0%로 양호합니다. 참고 용도로만 활용하고, 뒷받침되는 추천 없이 예산 증액을 제안하지 마세요. 현재 광고비 집행 속도에서 예산 소진이 재발하는지 확인하기 위해 W3 게재 현황을 모니터링하세요."]]},{"section":"섹션 5 — 예산 사용률이 낮은 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","광고 매출","광고비","광고수익률(ROAS)","현재 일예산","최근 7일 예산 활용률","추천 가능 여부"],"rows":[["아몬드 크런치_1개","CAMP_016","MPS","5,000,000원","1,000,000원","322%","1,000,000원","8.3%","목표 광고수익률(T.ROAS) 추천 (350% → 300%)"],["매출최적화_오리지널 500_로켓그로스","CAMP_017","MPS","2,000,000원","1,000,000원","170%","1,000,000원","0.5%","—"],["매출최적화_크런치 500_로켓그로스","CAMP_018","MPS","0원","0원","—","1,000,000원","0.0%","—"],["아몬드 크런치 2개","CAMP_021","MPS","20,000,000원","6,000,000원","305%","1,000,000원","39.4%","목표 광고수익률(T.ROAS) 추천 (350% → 300%)"],["전략 2주 캠페인(오리지널200*1)","CAMP_058","MPS","80,000원","100,000원","45%","1,000,000원","18.1%","—"]]},{"section":"섹션 7B — 광고 적격성 검토가 필요한 주요 벤더 VID","columns":["순위","VID","상품명","광고 매출","광고 매출 기여율","광고 적격성 상태 / 이슈","이슈 근거 / 시간","연결된 매출 성장 캠페인","최근 2주 광고 매출 영향 / 위험","최근 2주 광고수익률(ROAS) 영향 / 위험","핵심 영향 요약 및 간략 추천"],"rows":[["1","VID_0004","공급업체2 땅콩버터 100% 국산 땅콩 잼, 아몬드 크런치 200g×2","30,000,000원","25.1%","Image/Suppression: 336h","최근 2주간 우선순위 이슈 336시간","CAMP_002 — 땅콩버터 나머지ai (APS) | CAMP_016 — 아몬드 크런치_1개 (MPS) | CAMP_021 — 아몬드 크런치 2개 (MPS)","20,000,000원","확인 불가","이미지/노출 억제 이슈가 2주 분석 기간 내내 지속되었습니다. 이 VID는 광고주의 광고 매출 최상위 상품입니다. 연결된 캠페인 광고비를 확대하기 전에 카탈로그/광고 노출 억제 문제를 먼저 해결하세요 — 광고 적격성 이슈가 이 상품의 추가 광고 매출 성장을 가로막는 핵심 장애 요인입니다."],["2","VID_0002","공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 200g×2","10,000,000원","13.3%","이미지/노출 제한: 336시간","최근 2주간 336 우선순위 이슈 시간","CAMP_019 — 오리지널 200 (MPS) | 105382877 — 전략 2주 캠페인(오리지널200*2) (MPS)","10,000,000원","확인 불가","광고 매출 2위 상품(VID)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 최고 성과 캠페인(CAMP_019)과 연결되어 있으며, 노출 제한을 해소할 경우 예산 확대를 통해 이미 달성한 광고 매출 성장을 더욱 크게 확대할 수 있습니다. VID #1과 함께 우선적으로 조치하시기 바랍니다."],["3","VID_0025","공급업체2 땅콩버터 크런치 무설탕 100% 국산 땅콩 버터 잼 500g×1","6,000,000원","4.4%","품절: 336시간 | 구매 불가: 336시간","최근 2주간 336 우선순위 이슈 시간","CAMP_002 — 땅콩버터 나머지ai (APS) | CAMP_018 — 매출최적화_크런치 500_로켓그로스 (MPS)","확인 불가","확인 불가","2주 전체 기간 동안 품절 및 구매 불가 상태로, 14일간 광고 게재가 완전히 불가능한 상태였습니다. 캠페인 CAMP_018의 예산 소진율 0.0%와 직접적으로 연결되어 있습니다. 캠페인 단위 조치에 앞서 재고 보충이 선행되어야 합니다."],["4","87722961111","공급업체2 땅콩버터 크런치 무설탕 100% 국산 땅콩 버터 잼 500g×3","5,000,000원","4.0%","이미지/노출 제한: 336시간","최근 2주간 336 우선순위 이슈 시간","CAMP_002 — 땅콩버터 나머지ai (APS) | CAMP_028 — 크런치 500_판매자 배송 (MPS)","4,000,000원","확인 불가","캠페인 CAMP_028의 최대 기여 상품(해당 캠페인 W2 광고 매출의 50.5%)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 노출 제한을 해소할 경우 크런치 500_판매자 배송에서 관찰된 평균 주문 금액(AOV) 기반의 광고 매출 성장을 더욱 확대할 수 있습니다."],["5","94836937078","공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 500g×1","5,000,000원","3.4%","품절: 232시간 | 구매 불가: 232시간","최근 2주간 232 우선순위 이슈 시간","CAMP_002 — 땅콩버터 나머지ai (APS) | CAMP_017 — 매출최적화_오리지널 500_로켓그로스 (MPS)","7,000,000원","확인 불가","가능한 336시간 중 232시간(분석 기간의 69%) 동안 품절/구매 불가 상태였습니다. 매출최적화_오리지널 500_로켓그로스(CAMP_017, 예산 소진율 0.5%)와 연결되어 있습니다. 재고 해소가 최우선 조치이며, 위험에 처한 광고 매출 추정액은 7,000,000원으로, 수치화된 임팩트 기준으로 품절 VID 중 가장 높은 위험 수준입니다."]]}]
kpis = Grid(@Each(metrics, "m", Card([Caption(m.label), Title(m.w2, "md"), Row([Badge("W1 " + m.w1), Badge("기재 변화 " + m.delta, "info")], 1, null, null, true)])), 3, 175, 3)
moneyChart = Card([Title("기간별 광고 매출 · 광고비", "md"), Chart("bar", periods, "period", ["revenue", "spend"], "currency", "KRW"), Caption("섹션 1의 기간별 원문 값 · 일별 추이 아님")])
efficiencyChart = Card([Title("광고수익률 비교", "md"), Chart("bar", ratios, "period", ["roas"], "percent"), Caption("섹션 1 · 단위 %")])
conversionChart = Card([Title("전환율 비교", "md"), Chart("bar", ratios, "period", ["cvr"], "percent"), Caption("섹션 1 · ROAS와 별도 축으로 비교")])
overview = Col([Text("주요 지표를 비교하고, 캠페인 진단과 재고 위험을 탐색한 뒤 실행할 조치를 확인하세요.", "sm", "muted"), kpis, moneyChart, Grid([efficiencyChart, conversionChart], 2, 280, 4), stockChart])
visible = $campaign == "전체" ? campaigns : @Filter(campaigns, "id", "==", $campaign)
campaignOptions = @Concat([{value: "전체", label: "전체 캠페인"}], @Each(campaigns, "c", {value: c.id, label: c.name + " · " + c.id}))
campaignView = Col([Title("캠페인 탐색", "lg"), Select($campaign, campaignOptions, "캠페인 선택"), Grid([Card([Title("광고 매출", "md"), Chart("bar", visible, "name", ["revenue"], "currency", "KRW"), Caption("섹션 3A · 이후 매출")]), Card([Title("실제 ROAS와 목표", "md"), Chart("bar", visible, "name", ["roas", "target"], "percent"), Caption("섹션 3A의 원문 값 · 다른 섹션 수치와 혼합하지 않음")])], 2, 280, 4), Col(@Each(visible, "c", Card([Row([Title(c.name, "md"), Badge(c.id, "info")], 2), Text(c.diagnosis, "sm"), Popover("추천 조치와 근거", [Text(c.action, "sm"), Caption("섹션 3B 원문")])])))])
filteredRisks = @Filter(knownHourRisks, "hours", ">=", $minHours)
filteredAmounts = @Filter(knownAmountRisks, "hours", ">=", $minHours)
stockChart = Card([Title("VID별 품절 시간", "md"), Chart("bar", knownHourRisks, "id", ["hours"]), Caption("섹션 7B · 시간 · 미기재 값은 0으로 보정하지 않음")])
inventoryView = Col([Title("재고 위험 탐색", "lg"), Slider($minHours, 0, 3, 1, "최소 품절 시간", "시간"), Caption(@Count(filteredRisks) + "개 VID 표시"), SegmentedControl($riskView, ["품절 시간", "매출 위험"]), $riskView == "품절 시간" ? Card([Chart("bar", filteredRisks, "id", ["hours"]), Caption("섹션 7B · 단위: 시간")]) : Card([Chart("bar", filteredAmounts, "id", ["amount"], "currency", "KRW"), Caption("섹션 7B의 추정 위험액 · 확정 손실이 아니며 중복 위험을 합산하지 않음")]), Grid(@Each(filteredRisks, "r", Card([Title(r.id, "md"), Text(r.name, "sm"), Badge(r.issue, "warning"), Text(r.summary, "sm")])), 2, 260, 3), Popover("재고 원문 전체", [Table(["VID", "시간 원문 여부", "근거"], @Each(risks, "r", [r.id, r.hours == null ? "확인 불가" : r.hours + "시간", r.summary]))])])
actionView = Col([Title("실행 체크리스트", "lg"), Text("원문 권고와 실행 가능 여부를 함께 확인하세요. 체크는 개인 진행 상태이며 실제 예산이나 재고를 변경하지 않습니다.", "sm", "muted"), Caption(@Count($done) + " / " + @Count(actions) + " 완료"), Col(@Each(actions, "a", Pressable([Row([Icon(@Includes($done, a.id) ? "check-circle" : "circle", "sm"), Title(a.title, "md")], 2), Text(a.evidence, "sm"), Badge("원문 예상 효과: " + a.impact, "info")], @Set($done, @Toggle($done, a.id)), @Includes($done, a.id), 4))), Button("조치 요약 복사", @CopyToClipboard(@Join(@Each(actions, "a", a.title + " · " + a.evidence), "\n")), "outline", null, "sm", "copy")])
evidenceOptions = @Concat([{value: "전체", label: "전체 섹션"}], @Each(evidence, "e", {value: e.section, label: e.section}))
visibleEvidence = $evidence == "전체" ? evidence : @Filter(evidence, "section", "==", $evidence)
evidenceView = Col([Title("원문 근거", "lg"), Select($evidence, evidenceOptions, "근거 섹션 선택"), Col(@Each(visibleEvidence, "e", Col([Title(e.section, "md"), Table(e.columns, e.rows)]))), Popover("전체 원문 보기", [Markdown("다음은 **공급업체2 (V_공급업체2)**의 전체 V1 광고주 수준 분석 보고서입니다. 분석 기간: **2026년 10월 1일 – 10월 14일** (W1: 10월 1일–7일 vs. W2: 10월 8일–14일).\n\n---\n\n## 1페이지 — 주요 지표 및 경영진 요약\n\n### 섹션 1 — 벤더 핵심 / 주요 지표\n\n| 지표 | Week 1 (10월 1일–10월 7일) | Week 2 (10월 8일–10월 14일) | 변화 |\n|---|---:|---:|---:|\n| 광고 매출 (광고 매출) | 40,000,000원 | 50,000,000원 | +10,000,000원 (+37.0%) |\n| 광고수익률 (ROAS) | 295% | 328% | +33%p (+11.2%) |\n| 광고비 (광고비) | 10,000,000원 | 10,000,000원 | +3,000,000원 (+23.1%) |\n| 노출수 | 3,000,000 | 4,000,000 | +600,000 (+17.6%) |\n| 클릭률 (CTR) | 0.4% | 0.4% | +0%p (+8.9%) |\n| 전환율 (CVR) | 3.5% | 3.4% | −0%p (−0.9%) |\n| 평균주문금액 (AOV) | 80,000원 | 90,000원 | +7,000원 (+8.0%) |\n| 캠페인 수 | 16 | 18 | +2 |\n| 예산 소진 (OOB) 캠페인 수 | 2 | 2 | 0 |\n\n**요약:** 광고주 광고 매출이 전주 대비 +10,000,000원 (+37.0%) 상승하였으며, 광고비는 +23.1% 증가하여 광고수익률이 +33%p 개선되었습니다. 분석 기간 전반에 걸쳐 광고 매출 상승 흐름이 이어지고 있습니다.\n\n---\n\n### 섹션 2 — 경영진 요약\n\n| 요약 영역 | 요약 |\n|---|---|\n| 주요 VID 변동 및 광고 적격성 요약 | - Section 7A: 광고 매출 하락 또는 광고수익률 하락에 기여한 VID 행 없음 — 광고주 광고 매출은 두 기간 모두 상승하였습니다.<br>- Section 7B 주요 노출 자격 위험: VID VID_0004 (아몬드 크런치 땅콩버터 200g×2) — 이미지/노출 제한 336시간; 최근 2주 광고 매출 위험 금액 20,000,000원; 연결 캠페인 CAMP_002, CAMP_016, CAMP_021.<br>- VID VID_0002 (오리지널 땅콩버터 200g×2) — 이미지/노출 제한 336시간; 광고 매출 위험 금액 10,000,000원; 연결 캠페인 CAMP_019, 105382877.<br>- VID VID_0025 및 94836937078 — 품절(OOS)/BBL 시간 감지됨; 합산 광고 매출 위험 금액 미산출 + 7,000,000원; 재고 보충 필요. |\n| 광고 매출 하락/상승 진단 요약 | 광고주 광고 매출이 W1→W2 +10,000,000원 (+37.0%) 상승하였으며, 주요 기여 요인은 다음과 같습니다:<br>- 오리지널 200 (CAMP_019): +10,000,000원 (+119.1%) — 일예산이 3차례 증액(10월 6일/12일/14일)으로 3배 확대되어 노출수 +200.3% 급증, 광고 매출 상승을 주도함; 증분 트래픽이 전환율이 낮은 지면에서 유입되고 CPC가 +14.7% 상승하면서 광고수익률은 26.5% 하락하였으나, 광고수익률 달성률은 140.2%로 높은 수준을 유지함.<br>- 크런치 500_판매자 배송 (CAMP_028): +3,000,000원 (+250.1%) — 상품 구성이 고가 SKU로 이동하면서 평균주문금액이 거의 2배(30,000원→80,000원)로 상승; 활성 상품 3개 모두 더 높은 가격대로 이동하여 광고 매출 상승분의 131%를 기여; 카테고리가 축소되는 상황에서도 노출 점유율 증가.<br>- 땅콩버터 나머지ai (CAMP_002): +1,000,000원 (+88.7%) — 평균주문금액 +183% 확대(30,000원→80,000원)가 주요 광고 매출 동인; 노출수 −32.2% 감소 및 전환율 −29.4% 하락이 일부 상쇄; 심층 진단 불가(APS 캠페인 유형).<br>- 전략 2주 캠페인(오리지널200*1) (CAMP_058): +80,000원 (신규 캠페인, W1 광고 매출 0원) — 신규 활성 캠페인으로 광고수익률 달성률 12.9%에 불과; 전체 진단을 위한 활동 데이터 부족. |\n| 광고 매출 성장을 위한 핵심 인사이트 및 조치 요약 | - **Section 4 (OOB):** OOB 캠페인 3개 모두 참고용 행(일예산이 최근 이미 증액되었거나 추천 불가)에 해당하므로, 즉각적인 예산 증액 조치는 불필요합니다 — 재발 여부를 모니터링하세요.<br>- **Section 5 (낮은 예산 소진율 — 목표 광고수익률 조치):** 아몬드 크런치_1개 (CAMP_016, 소진율 8.3%; 목표 광고수익률 350%→300% 권장) 및 아몬드 크런치 2개 (CAMP_021, 소진율 39.4%; 목표 광고수익률 350%→300% 권장)의 목표 광고수익률 제약을 완화하여 추가 광고 매출 여력을 확보하세요.<br>- **Section 5 (낮은 예산 소진율 — 모니터링 대상):** 매출최적화_오리지널 500_로켓그로스 (CAMP_017, 소진율 0.5%) 및 매출최적화_크런치 500_로켓그로스 (CAMP_018, 소진율 0.0%)는 거의 미노출 상태입니다; 현재 판매자가 취할 수 있는 조치 없음 — 전략적으로 중요한 경우 AE 검토를 요청하세요. |\n\n---\n\n## 2페이지 — 주요 지표 변동 진단 (광고 매출 하락 또는 상승)\n\n### 섹션 3A — 벤더 광고 매출 변동을 주도한 주요 캠페인\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 1주차 광고 매출 | 2주차 광고 매출 | 매출 증감 | 기여도 | 광고비 | 광고수익률 | 목표 광고수익률 | 광고수익률 달성률 |\n|---|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|\n| 오리지널 200 | CAMP_019 | MPS | 10,000,000원 | 30,000,000원 | +10,000,000원 | 118.8% | 10,000,000원 | 382% | 250% | 152.9% |\n| 크런치 500_판매자 배송 | CAMP_028 | MPS | 1,000,000원 | 4,000,000원 | +3,000,000원 | 18.6% | 2,000,000원 | 248% | 230% | 108.0% |\n| 땅콩버터 나머지ai | CAMP_002 | APS | 1,000,000원 | 2,000,000원 | +1,000,000원 | 7.0% | 1,000,000원 | 271% | 270% | 100.2% |\n| 전략 2주 캠페인(오리지널200*1) | CAMP_058 | MPS | 0원 | 80,000원 | +80,000원 | 0.5% | 100,000원 | 45% | 350% | 12.9% |\n\n---\n\n### 섹션 3B — 섹션 3a 캠페인 진단 및 추천 사항\n\n| # | 캠페인 ID | 캠페인명 | 진단 | 추천 및 근거 |\n|---:|---:|---|---|---|\n| 1 | CAMP_019 | 오리지널 200 | **광고 매출 급등 원인:** 광고 매출이 +119.1% 급증(10,000,000원→30,000,000원)하였으며, 이는 주로 일예산 3회 인상(10월 6일, 12일, 14일 — 일예산이 300,000원에서 3,000,000원으로 3배 증가)에 따른 노출수 폭발적 증가(+200.3%)에 기인합니다. 증분 물량이 매출 성장의 주요 동인으로, GMV 기여도 +140.2%를 차지합니다. 클릭률(−13.5%), 전환율(−2.4%), 평균 주문금액(−13.6%)은 모두 하락하였는데, 이는 확대된 예산이 비검색 지면(non-search 노출수 +216% vs. 검색 +147%)에서 상대적으로 낮은 품질의 트래픽을 유입시켰기 때문입니다. 주문 비중은 평균 주문금액이 낮은 타겟 상품 쪽으로 크게 이동하였고(주문 비중 56%→79%, 평균 판매가 약 80,000원), 평균 주문금액이 높은 비타겟 상품은 주문당 약 100,000원에서 약 100,000원으로 하락하였습니다. 결과적으로 광고 매출은 크게 성장하였으나 광고수익률 달성률은 190.7%에서 140.2%로 하락하였습니다. 광고수익률 달성률은 90%를 크게 상회하는 수준을 유지하고 있습니다. | 예산 확대를 통해 강력한 광고 매출 성장을 성공적으로 이끌어냈습니다. 현재 달성률 140.2%는 기준치를 크게 상회하고 있어 목표 광고수익률 변경은 불필요합니다. 예산이 높은 수준으로 유지되는 동안 클릭당 과금(CPC) 추이와 비검색 지면 효율을 모니터링하세요. 광고수익률 달성률이 100%에 근접할 경우, 그 시점에 입찰가 또는 목표 광고수익률 설정을 재검토하시기 바랍니다. 현 단계에서는 추가 예산 인상을 권장하지 않으며, 재평가 전에 현재 게재 패턴이 안정화될 때까지 지켜보시기 바랍니다. |\n| 2 | CAMP_028 | 크런치 500_판매자 배송 | **광고 매출 급등 원인:** 광고 매출이 +250.1% 급증(1,000,000원→4,000,000원)하였습니다. 주요 동인은 평균 주문금액 확대(+131.1%, 30,000원→80,000원)로, GMV 성장의 +66.8%를 기여하였습니다. 활성화된 상품 3개 모두 더 높은 가격대로 이동하였는데, VIID 87722961111의 평균 판매가는 +200%, VIID 95740906340은 +118% 상승하였으며, 신규 고가 상품(VIID 94836985786, 약 100,000원)이 2주차에 신규 진입하였습니다. 노출수도 +30.7% 증가한 반면 카테고리는 −6.7%, 주요 경쟁사는 −14.0% 감소하여 상대적인 점유율 확보가 이루어진 것으로 판단됩니다. 광고수익률 달성률은 70.0%에서 127.7%로 개선되었습니다. | 광고 매출 급등은 상품 믹스 및 가격 변화에 기인한 것으로, 건전한 구조적 변화입니다. 광고수익률 달성률이 100%를 상회하였습니다. 건전한 달성률을 감안하여 현재 목표 광고수익률(230%) 설정을 유지하세요. 고가 신규 상품(VIID 94836985786)이 2주차 광고 매출의 26.3%를 차지하고 있는 만큼, 이후 주차에도 해당 상품의 기여가 지속되는지 모니터링하시기 바랍니다. 현 시점에서는 예산 또는 목표 광고수익률 조정이 필요하지 않습니다. |\n| 3 | CAMP_002 | 땅콩버터 나머지ai | **광고 매출 상승 이유:** 광고 매출이 +88.7% 증가(1,000,000원→2,000,000원)하였으며, 이는 전적으로 평균 주문 금액(AOV)의 +183.0% 확대(30,000원→80,000원)에 의해 견인되었습니다 — GMV에 +163.9% 기여 — 캠페인 내 주요 상품(VIID 87020559414, GMV의 99.6% 기여)이 W2에서 더 높은 가격의 번들 또는 구성으로 전환된 결과입니다. 노출수는 −32.2% 감소하였고 전환율은 −29.4% 하락하여 AOV 상승 효과를 일부 상쇄하였으며, 이러한 물량 측면의 역풍이 더 큰 폭의 광고 매출 상승을 제한하였습니다. 광고수익률(ROAS) 달성률은 W2에서 100.2%로, W1의 부진한 58.2%에서 회복되었습니다. | 이 캠페인(APS 유형)에 대한 심층 진단은 제공되지 않습니다. 이용 가능한 퍼널 데이터를 기반으로: 노출수 및 전환율 하락은 지속적인 모니터링이 필요합니다. AOV 확대가 영구적인 상품 가격 재조정을 반영하는 경우, 노출수 회복 추이를 지켜보는 것 외에 별도 조치는 필요하지 않습니다. AOV 상승이 일시적인 경우(예: 프로모션 번들), 다음 기간의 광고 매출 반전 가능성에 대비하시기 바랍니다. 현재 광고주가 직접 취할 수 있는 권장 조치는 없습니다. |\n| 4 | CAMP_058 | 전략 2주 캠페인(오리지널200*1) | **광고 매출 상승 이유:** 캠페인이 W1에는 비활성 상태(광고 매출 0원, 광고비 0원)였으며, 첫 활성 주차인 W2에 80,000원의 광고 매출을 기록하였습니다. 광고수익률(ROAS) 달성률은 12.9%로 매우 낮은 수준이며(ROAS 45% vs. 목표 광고수익률(T.ROAS) 350%), 목표 광고수익률(T.ROAS) 목표가 실제 캠페인 성과 대비 지나치게 제한적임을 나타냅니다. W2 광고 매출에는 VIID 86556965936만 기여하였습니다. 캠페인의 활동 이력이 충분하지 않아 전체 구조적 진단이 어렵습니다. | 심층 진단을 제공할 수 없습니다(활동 부족: W1 광고 매출 0원, W2 주문수 기준 미달). 현재 목표 광고수익률(T.ROAS) 350%는 실제 집행 광고수익률(ROAS) 45%를 크게 상회합니다 — 이 목표 광고수익률(T.ROAS)이 의도적으로 보수적으로 설정된 런칭 파라미터인지, 아니면 잘못 설정된 목표인지 검토하시고, 캠페인 확장을 목표로 한다면 완화 여부를 고려해 보세요. 집행 효율이 개선되기 전까지는 예산을 늘리지 마시고, 우선 목표 광고수익률(T.ROAS) 제약 요인 파악에 집중하시기 바랍니다. |\n\n---\n\n## 3페이지 — 광고 매출 극대화 방안 — 핵심 인사이트 및 추천 조치 요약\n\n> **AE 다음 단계 — 우선 조치 목록** (최대 3개 조치; Section 4 참고용 예산 초과 행 제외)\n\n| 순위 | 출처 | 캠페인 | 우선 조치 | 근거 |\n|---:|---|---|---|---|\n| 1 | Section 5 — 목표 광고수익률(T.ROAS) 권장 조치 | 아몬드 크런치_1개 (CAMP_016) | 목표 광고수익률(T.ROAS) 제약 검토 및 완화: 350% → 300% | 일예산 1,000,000원 대비 예산 소진율이 8.3%에 불과하여, 목표 광고수익률(T.ROAS) 목표가 집행을 제한하고 있음을 나타냅니다. 300%로의 인하는 지원되는 권장 조치에 부합하며, 현재 낮은 소진율을 감안할 때 추가 광고 매출을 확보할 가능성이 가장 높습니다. |\n| 2 | Section 5 — 목표 광고수익률(T.ROAS) 권장 조치 | 아몬드 크런치 2개 (CAMP_021) | 목표 광고수익률(T.ROAS) 제약 검토 및 완화: 350% → 300% | 예산 소진율이 39.4%로 아직 완전 소진에 미치지 못하는 수준이며, 지원되는 목표 광고수익률(T.ROAS) 권장 조치가 존재합니다. 목표를 완화하면 캠페인이 더 많은 적격 트래픽을 흡수하여 광고 매출을 추가로 성장시킬 수 있습니다. |\n| 3 | Section 5 — 모니터링 대상 (지원되는 권장 조치 없음) | 매출최적화_오리지널 500_로켓그로스 (CAMP_017) | AE 검토 플래그: 거의 0에 가까운 집행 (소진율 0.5%) | 현재 광고주가 직접 취할 수 있는 조치는 없으나, 예산 소진율 0.5%는 시스템적 집행 억제를 시사합니다. AE는 상품 적격성 문제(Section 7B 참조: VIID 94836937078, 품절 232시간)가 집행 부진에 기여하고 있는지 확인하고, 우선적으로 재고 해소를 위한 조율을 진행해야 합니다. |\n\n---\n\n### 섹션 4 — OOB 시간이 있는 캠페인\n\n> 아래의 모든 행은 **참고용**입니다: 추가 예산 증액 조치는 권장되지 않습니다. 오리지널 200의 예산은 최근 이미 증액되었으며, 나머지 두 캠페인에 대해서는 실행 가능한 예산 권장 조치가 없습니다. AE는 이 행들을 과거 맥락 참고용으로만 활용하고, 예산 초과(OOB)가 재발하지 않는 한 추가 예산 증액을 권유하지 않도록 합니다.\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 광고 매출 | 광고비 | 광고수익률(ROAS) | 목표 광고수익률(T.ROAS) | 광고수익률(ROAS) 달성률 | 예산 초과(OOB) 시간 | 현재 일예산 | 권장 일예산 | 기대 매출 증가액 | AE 조치 / 참고 사항 |\n|---|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|\n| 오리지널 200 | CAMP_019 | MPS | 30,000,000원 | 10,000,000원 | 382% | 250% | 152.9% | 40 | 3,000,000원 | — | — | **과거 예산 소진 이력 — 예산이 최근 이미 증액되었습니다.** 일예산이 3차례 증액을 통해 3배로 늘어났습니다 (10월 6일, 12일, 14일: 300,000원 → 3,000,000원). 예산 소진은 증액 이전의 제약 기간을 반영할 가능성이 높습니다. 현재 상향된 예산 하에서는 예산이 더 이상 주요 제약 요인이 아닐 수 있습니다. 현재 증액된 예산에서 예산 소진이 재발하지 않는 한, 추가 예산 증액을 먼저 제안하지 **마세요**. |\n| 아몬드 크런치 2개 | CAMP_021 | MPS | 8,000,000원 | 6,000,000원 | 305% | 350% | 87.2% | 4 | 1,000,000원 | — | — | **과거 예산 소진 이력 — 예산 추천 정보 없음.** 예산 소진 4시간이 확인되었으나, 현재 시스템 기반 예산 추천 또는 광고 매출 증대 추정치를 제공할 수 없습니다. 참고 용도로만 활용하세요. 뒷받침 데이터 없이 예산 증액을 과도하게 제안하지 마세요. 참고: 목표 광고수익률(ROAS) 달성률이 87.2%로 90% 미만입니다 — 목표 광고수익률(T.ROAS) 제약(350%)이 예산보다 먼저 작동하고 있을 수 있습니다. 목표 광고수익률(T.ROAS) 검토가 보다 적절한 우선 조치입니다 (Section 5 참조). |\n| 크런치 500_판매자 배송 | CAMP_028 | MPS | 4,000,000원 | 2,000,000원 | 248% | 230% | 108.0% | 3 | 500,000원 | — | — | **과거 예산 소진 이력 — 예산 추천 정보 없음.** 예산 소진 3시간이 확인되었으나, 시스템 기반 예산 추천을 제공할 수 없습니다. 캠페인 광고수익률(ROAS) 달성률은 108.0%로 양호합니다. 참고 용도로만 활용하고, 뒷받침되는 추천 없이 예산 증액을 제안하지 마세요. 현재 광고비 집행 속도에서 예산 소진이 재발하는지 확인하기 위해 W3 게재 현황을 모니터링하세요. |\n\n---\n\n### 섹션 5 — 예산 사용률이 낮은 캠페인\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 광고 매출 | 광고비 | 광고수익률(ROAS) | 현재 일예산 | 최근 7일 예산 활용률 | 추천 가능 여부 |\n|---|---:|---|---:|---:|---:|---:|---:|---|\n| 아몬드 크런치_1개 | CAMP_016 | MPS | 5,000,000원 | 1,000,000원 | 322% | 1,000,000원 | 8.3% | 목표 광고수익률(T.ROAS) 추천 (350% → 300%) |\n| 매출최적화_오리지널 500_로켓그로스 | CAMP_017 | MPS | 2,000,000원 | 1,000,000원 | 170% | 1,000,000원 | 0.5% | — |\n| 매출최적화_크런치 500_로켓그로스 | CAMP_018 | MPS | 0원 | 0원 | — | 1,000,000원 | 0.0% | — |\n| 아몬드 크런치 2개 | CAMP_021 | MPS | 20,000,000원 | 6,000,000원 | 305% | 1,000,000원 | 39.4% | 목표 광고수익률(T.ROAS) 추천 (350% → 300%) |\n| 전략 2주 캠페인(오리지널200*1) | CAMP_058 | MPS | 80,000원 | 100,000원 | 45% | 1,000,000원 | 18.1% | — |\n\n---\n\n## 4페이지 — 주요 VID 변동 및 광고 적격성 검토\n\n### 섹션 7A — 벤더 광고 매출 또는 ROAS 하락에 기여한 주요 VID\n\n이 기간에 대한 VID 광고 매출 하락 또는 광고수익률(ROAS) 하락 기여 항목이 없습니다. 광고주의 광고 매출은 W1→W2 기간 동안 +37.0% 상승하였으며, 광고주 수준에서 광고수익률(ROAS)의 유의미한 악화는 없었습니다 (+11.2%). Section 7A는 이번 분석 기간에 해당 사항이 없습니다.\n\n---\n\n### 섹션 7B — 광고 적격성 검토가 필요한 주요 벤더 VID\n\n| 순위 | VID | 상품명 | 광고 매출 | 광고 매출 기여율 | 광고 적격성 상태 / 이슈 | 이슈 근거 / 시간 | 연결된 매출 성장 캠페인 | 최근 2주 광고 매출 영향 / 위험 | 최근 2주 광고수익률(ROAS) 영향 / 위험 | 핵심 영향 요약 및 간략 추천 |\n|---:|---:|---|---:|---:|---|---|---|---:|---|---|\n| 1 | VID_0004 | 공급업체2 땅콩버터 100% 국산 땅콩 잼, 아몬드 크런치 200g×2 | 30,000,000원 | 25.1% | Image/Suppression: 336h | 최근 2주간 우선순위 이슈 336시간 | CAMP_002 — 땅콩버터 나머지ai (APS) \\| CAMP_016 — 아몬드 크런치_1개 (MPS) \\| CAMP_021 — 아몬드 크런치 2개 (MPS) | 20,000,000원 | 확인 불가 | 이미지/노출 억제 이슈가 2주 분석 기간 내내 지속되었습니다. 이 VID는 광고주의 광고 매출 최상위 상품입니다. 연결된 캠페인 광고비를 확대하기 전에 카탈로그/광고 노출 억제 문제를 먼저 해결하세요 — 광고 적격성 이슈가 이 상품의 추가 광고 매출 성장을 가로막는 핵심 장애 요인입니다. |\n| 2 | VID_0002 | 공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 200g×2 | 10,000,000원 | 13.3% | 이미지/노출 제한: 336시간 | 최근 2주간 336 우선순위 이슈 시간 | CAMP_019 — 오리지널 200 (MPS) \\| 105382877 — 전략 2주 캠페인(오리지널200*2) (MPS) | 10,000,000원 | 확인 불가 | 광고 매출 2위 상품(VID)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 최고 성과 캠페인(CAMP_019)과 연결되어 있으며, 노출 제한을 해소할 경우 예산 확대를 통해 이미 달성한 광고 매출 성장을 더욱 크게 확대할 수 있습니다. VID #1과 함께 우선적으로 조치하시기 바랍니다. |\n| 3 | VID_0025 | 공급업체2 땅콩버터 크런치 무설탕 100% 국산 땅콩 버터 잼 500g×1 | 6,000,000원 | 4.4% | 품절: 336시간 \\| 구매 불가: 336시간 | 최근 2주간 336 우선순위 이슈 시간 | CAMP_002 — 땅콩버터 나머지ai (APS) \\| CAMP_018 — 매출최적화_크런치 500_로켓그로스 (MPS) | 확인 불가 | 확인 불가 | 2주 전체 기간 동안 품절 및 구매 불가 상태로, 14일간 광고 게재가 완전히 불가능한 상태였습니다. 캠페인 CAMP_018의 예산 소진율 0.0%와 직접적으로 연결되어 있습니다. 캠페인 단위 조치에 앞서 재고 보충이 선행되어야 합니다. |\n| 4 | 87722961111 | 공급업체2 땅콩버터 크런치 무설탕 100% 국산 땅콩 버터 잼 500g×3 | 5,000,000원 | 4.0% | 이미지/노출 제한: 336시간 | 최근 2주간 336 우선순위 이슈 시간 | CAMP_002 — 땅콩버터 나머지ai (APS) \\| CAMP_028 — 크런치 500_판매자 배송 (MPS) | 4,000,000원 | 확인 불가 | 캠페인 CAMP_028의 최대 기여 상품(해당 캠페인 W2 광고 매출의 50.5%)에서 2주 전체 기간 동안 이미지/노출 제한 이슈가 지속되었습니다. 노출 제한을 해소할 경우 크런치 500_판매자 배송에서 관찰된 평균 주문 금액(AOV) 기반의 광고 매출 성장을 더욱 확대할 수 있습니다. |\n| 5 | 94836937078 | 공급업체2 땅콩버터 무설탕 100% 국산 땅콩 버터 잼 오리지널 500g×1 | 5,000,000원 | 3.4% | 품절: 232시간 \\| 구매 불가: 232시간 | 최근 2주간 232 우선순위 이슈 시간 | CAMP_002 — 땅콩버터 나머지ai (APS) \\| CAMP_017 — 매출최적화_오리지널 500_로켓그로스 (MPS) | 7,000,000원 | 확인 불가 | 가능한 336시간 중 232시간(분석 기간의 69%) 동안 품절/구매 불가 상태였습니다. 매출최적화_오리지널 500_로켓그로스(CAMP_017, 예산 소진율 0.5%)와 연결되어 있습니다. 재고 해소가 최우선 조치이며, 위험에 처한 광고 매출 추정액은 7,000,000원으로, 수치화된 임팩트 기준으로 품절 VID 중 가장 높은 위험 수준입니다. |\n")])])