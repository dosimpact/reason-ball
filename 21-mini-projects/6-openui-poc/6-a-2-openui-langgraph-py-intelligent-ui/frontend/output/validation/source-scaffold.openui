root = Col([heading, quality, navigation, body])
$section = "개요"
$campaign = "전체"
$done = []
$minHours = 0
$riskView = "품절 시간"
$evidence = "전체"
heading = Col([Title("공급업체1 · 인터랙티브 보고서", "xl"), Text("2026년 10월 1일 – 10월 14일", "sm", "muted"), Row([Badge("원문 기반", "info"), Badge("W1 / W2 비교", "purple"), Badge("로컬 필터 · 상태 저장", "success")], 2)])
quality = Card([Title("원문 수치 확인 필요", "md"), Col(@Each(["광고 매출: 8,000,000원 → 9,000,000원, 원문 변화 +800,000원 (+10.1%). 기간별 값과 변화량 확인 필요.","광고비: 5,000,000원 → 5,000,000원, 원문 변화 +200,000원 (+5.1%). 기간별 값과 변화량 확인 필요.","평균 주문 금액: 30,000원 → 20,000원, 원문 변화 −2,000원 (−7.8%). 기간별 값과 변화량 확인 필요.","현재 예산과 추천 예산이 같은 행이 있습니다. 원문의 '증액' 권고는 실행 전 확인이 필요합니다."], "w", Text(w, "sm", "warning")), 2), Caption("원문 기재 값 유지 · 다른 기간과 단위를 합산하지 않음")], "soft")
navigation = SegmentedControl($section, ["개요", "캠페인", "재고", "조치", "근거"], true)
body = $section == "개요" ? overview : $section == "캠페인" ? campaignView : $section == "재고" ? inventoryView : $section == "조치" ? actionView : evidenceView
metrics = [{"label":"광고 매출","w1":"8,000,000원","w2":"9,000,000원","delta":"+800,000원 (+10.1%)"},{"label":"광고수익률","w1":"169%","w2":"177%","delta":"+8%p (+4.7%)"},{"label":"광고비","w1":"5,000,000원","w2":"5,000,000원","delta":"+200,000원 (+5.1%)"},{"label":"노출수","w1":"900,000","w2":"1,000,000","delta":"+100,000 (+19.4%)"},{"label":"클릭률","w1":"0.6%","w2":"0.8%","delta":"+0.2%p (+47.9%)"},{"label":"전환율","w1":"5.2%","w2":"3.5%","delta":"−2.0%p (−32.4%)"},{"label":"평균 주문 금액","w1":"30,000원","w2":"20,000원","delta":"−2,000원 (−7.8%)"},{"label":"캠페인 수","w1":"6","w2":"6","delta":"0"},{"label":"예산 소진 캠페인 수","w1":"2","w2":"1","delta":"−1"}]
periods = [{"period":"W1","revenue":8000000,"spend":5000000},{"period":"W2","revenue":9000000,"spend":5000000}]
ratios = [{"period":"W1","roas":169,"cvr":5.2},{"period":"W2","roas":177,"cvr":3.5}]
campaigns = [{"id":"CAMP_004","name":"치간칫솔","revenue":2000000,"roas":200,"target":254,"diagnosis":"광고 매출 증가 원인: 광고 매출이 +70.5% 상승했습니다 (1,000,000원→2,000,000원). 상위 상품 VID VID_0013가 10월 1일 품절(OOS) 제약을 해소하면서 활성 노출 시간이 2배로 늘어났고(76→168시간), 노출수가 +89.9% 급증하며 광고 매출 기여도가 +120.2% 증가했습니다. 클릭률(CTR)도 +22.9% 개선되어 기여도 +38.7%를 기록했습니다. 다만 트래픽 급증이 전환 역량을 초과하면서 전환율(CVR)이 22.5% 하락(기여도 −47.7%)했고, VID VID_0014(−15.8%) 및 VID_0015(−8.1%)의 가격 하락으로 평균 주문 금액(AOV)이 5.8% 감소(기여도 −11.2%)하며 일부 상쇄됐습니다. 광고수익률 달성률은 78.6%로 90% 기준치를 하회합니다. ·  · 1) 광고 매출 증가 원인: 상위 VID의 품절 해소로 노출수가 회복되고, 클릭률 상승이 성과를 뒷받침하며 노출 주도의 회복세를 보였습니다. · 2) 광고수익률 하락 원인: 갑작스러운 트래픽 급증이 주문 전환 역량을 초과하면서 전환율(CVR)이 22.5% 하락했고, 2개 보조 VID의 가격 하락으로 평균 주문 금액(AOV)이 5.8% 감소했습니다. 클릭당 비용(CPC)은 10.6% 하락하여 광고수익률 하락을 일부 완충했습니다.","action":"VID VID_0014 재입고를 권장합니다 (W2 품절 34시간, W1 22시간 대비 증가). 재고 부족으로 인한 전환율 희석을 방지하고 전체 노출 시간을 회복하기 위함입니다. 현재 광고수익률 부진은 입찰가나 예산 설정이 아닌 재고 문제에 기인한 전환율·평균 주문 금액 구조적 이슈이므로, 목표 광고수익률 또는 예산 조정은 권장하지 않습니다."},{"id":"CAMP_003","name":"치약코팅칫솔","revenue":2000000,"roas":383,"target":294,"diagnosis":"광고 매출 증가 원인: 광고 매출이 +15.6% 상승했습니다 (2,000,000원→2,000,000원). 주력 상품 VID VID_0021의 품절이 완전히 해소되어(35→0시간) 성과가 높은 상품에 노출이 집중됐고, 클릭률(CTR)이 +56.9% 급등하며 기여도 +310.2%를 기록했습니다. 클릭당 비용(CPC)은 22.3% 하락하여 광고수익률이 +15.7% 개선된 410.4%를 달성했습니다(광고수익률 달성률 130.0%, 90% 기준치를 크게 상회). 광고비는 보합세(−0%)를 유지했습니다. 보조 상품 VID VID_0022는 품절이 급격히 악화되어(27→88시간) 해당 VID의 광고 매출이 32.3% 감소하고 주문수가 55.2% 하락하면서 전체 캠페인 성장의 상단을 일부 제한했습니다. 캠페인은 W2 7일 내내 일예산 소진(OOB) 상태였으며(8시간 제한), 일예산 소진율은 98.8%로 일예산이 추가 성장의 핵심 제약 요인임을 나타냅니다.","action":"1. 일예산 증액을 권장합니다: 100,000원 → 100,000원 (Sales Engine 추천, 2026-10-15). 광고수익률이 294% 목표 대비 410%로 효율이 우수하며, 일예산이 유일한 제약 요인입니다. 기대 광고 매출 증가분은 아직 정량화되지 않았으나 근거 데이터가 뒷받침됩니다. · 2. VID VID_0022 재입고를 권장합니다 (W2 품절 88시간; 2주 기간 기준 광고 매출 위험 추정액 1,000,000원). 해당 VID의 재고를 회복하면 캠페인의 노출 기반이 넓어지고 광고 매출 회복세가 가속될 것입니다."},{"id":"CAMP_010","name":"치약","revenue":90000,"roas":165,"target":300,"diagnosis":"광고 매출 증가 원인: 캠페인이 W2에 신규 시작되었습니다 (0원→90,000원). W1 기준값이 없어 표준 전주 대비 퍼널 분해 분석은 적용되지 않습니다. W2 광고수익률은 300% 목표 광고수익률 대비 164.7%로 달성률은 54.9%입니다. 2개 VID가 기여했습니다: VID VID_0023 (80,000원, 82.9%) 및 VID VID_0028 (10,000원, 17.1%).","action":"충분한 진단 데이터가 없습니다 — 해당 캠페인은 최소 자격 기준을 충족하지 못합니다 (30일 내 광고 전환 주문수 30건 미만; 이전 기간 광고 매출 = 0원). 결론 도출 또는 입찰가·예산 조정 전에 충분한 데이터를 축적할 수 있도록 2~3주 더 모니터링하시기 바랍니다."}]
risks = [{"id":"VID_0018","name":"공급업체1 기능성 칫솔 이중초미세모, 12개입","hours":2,"amount":500000,"share":20.6,"issue":"품절: 47h","summary":"광고주 광고 매출의 20.6%를 차지하는 VID에서 품절 시간이 감지됨. 광고 매출 위험이 지속되지 않도록 신속히 재고를 보충하세요."},{"id":"VID_0019","name":"공급업체1 기능성 칫솔 이중초미세모, 6개입","hours":2,"amount":2000000,"share":17.4,"issue":"품절: 137h","summary":"포트폴리오 내 가장 심각한 품절(137h). 2주간 추정 광고 매출 위험 2,000,000원. 긴급 재고 보충이 필요합니다."},{"id":"VID_0022","name":"공급업체1 치약코팅칫솔, 50개입, 1박스","hours":2,"amount":1000000,"share":13.8,"issue":"품절: 115h","summary":"광고주 광고 매출의 13.8%를 기여하는 VID에서 품절 115h 발생; 추정 위험 1,000,000원. 캠페인 정상 게재 및 광고수익률 기여도 회복을 위해 재고를 보충하세요."},{"id":"VID_0013","name":"공급업체1 치간칫솔 I형 SSS 핑크, 100개입","hours":2,"amount":500000,"share":13.3,"issue":"품절: 92h","summary":"광고주 광고 매출의 13.3%를 기여하는 VID에서 품절 92h 발생; 추정 위험 500,000원. W2에서 관찰된 매출 회복 흐름을 유지하기 위해 재고를 보충하세요."},{"id":"VID_0021","name":"공급업체1 치약코팅칫솔, 10개입, 1개","hours":2,"amount":200000,"share":9.9,"issue":"품절: 35시간","summary":"품절 35시간; 예상 손실 200,000원. 이 상품은 품절 해소 이후 치약코팅칫솔 캠페인의 광고 매출 상승을 이끌었으며, 이 성과를 유지하기 위해서는 지속적인 재고 관리가 중요합니다."}]
