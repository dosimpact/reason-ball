knownAmountRisks = [{"id":"VID_0018","name":"공급업체1 기능성 칫솔 이중초미세모, 12개입","hours":2,"amount":500000,"share":20.6,"issue":"품절: 47h","summary":"광고주 광고 매출의 20.6%를 차지하는 VID에서 품절 시간이 감지됨. 광고 매출 위험이 지속되지 않도록 신속히 재고를 보충하세요."},{"id":"VID_0019","name":"공급업체1 기능성 칫솔 이중초미세모, 6개입","hours":2,"amount":2000000,"share":17.4,"issue":"품절: 137h","summary":"포트폴리오 내 가장 심각한 품절(137h). 2주간 추정 광고 매출 위험 2,000,000원. 긴급 재고 보충이 필요합니다."},{"id":"VID_0022","name":"공급업체1 치약코팅칫솔, 50개입, 1박스","hours":2,"amount":1000000,"share":13.8,"issue":"품절: 115h","summary":"광고주 광고 매출의 13.8%를 기여하는 VID에서 품절 115h 발생; 추정 위험 1,000,000원. 캠페인 정상 게재 및 광고수익률 기여도 회복을 위해 재고를 보충하세요."},{"id":"VID_0013","name":"공급업체1 치간칫솔 I형 SSS 핑크, 100개입","hours":2,"amount":500000,"share":13.3,"issue":"품절: 92h","summary":"광고주 광고 매출의 13.3%를 기여하는 VID에서 품절 92h 발생; 추정 위험 500,000원. W2에서 관찰된 매출 회복 흐름을 유지하기 위해 재고를 보충하세요."},{"id":"VID_0021","name":"공급업체1 치약코팅칫솔, 10개입, 1개","hours":2,"amount":200000,"share":9.9,"issue":"품절: 35시간","summary":"품절 35시간; 예상 손실 200,000원. 이 상품은 품절 해소 이후 치약코팅칫솔 캠페인의 광고 매출 상승을 이끌었으며, 이 성과를 유지하기 위해서는 지속적인 재고 관리가 중요합니다."}]
actions = [{"id":"action0","title":"치약코팅칫솔 (CAMP_003): 일예산을 100,000원에서 100,000원으로 증액","evidence":"W2 기간 7일 전일 OOB 발생 (8시간 상한 도달; 활용률 98.8%). 광고수익률(ROAS) 410% vs. 목표 광고수익률(T.ROAS) 294% — 효율이 우수하며 예산이 핵심 제약 요인입니다. Sales Engine 추천 일자: 2026-10-15.","impact":"미정량화 (출처 기반 추천 제공됨)"},{"id":"action1","title":"261001 공급업체1 기능성 칫솔 (CAMP_047): 캠페인이 의도적으로 낮은 게재량을 보이는지 검토","evidence":"일예산 500,000원; 최근 7일 활용률 2.5%에 불과. 현재 판매자가 직접 조치할 수 있는 추천이 없습니다. 예산 또는 입찰가 조치를 검토하기 전, AE는 낮은 게재량이 적격성 제약으로 인한 것인지 확인해야 합니다 (참고: VID VID_0018 및 VID_0019에 활성 품절(OOS) 시간이 존재).","impact":"정량화 불가"},{"id":"action2","title":"공급업체1 기존 칫솔 (CAMP_009): 활용률 추세 모니터링","evidence":"일예산 100,000원; 활용률 45.5% — 보통 수준이나 완전 게재에는 미치지 못함. 현재 판매자가 직접 조치할 수 있는 추천이 없습니다.","impact":"정량화 불가"}]
evidence = [{"section":"섹션 1 — 벤더 핵심 / 주요 지표","columns":["지표","W1 (10월 1일–7일)","W2 (10월 8일–14일)","변화"],"rows":[["광고 매출","8,000,000원","9,000,000원","+800,000원 (+10.1%)"],["광고수익률","169%","177%","+8%p (+4.7%)"],["광고비","5,000,000원","5,000,000원","+200,000원 (+5.1%)"],["노출수","900,000","1,000,000","+100,000 (+19.4%)"],["클릭률","0.6%","0.8%","+0.2%p (+47.9%)"],["전환율","5.2%","3.5%","−2.0%p (−32.4%)"],["평균 주문 금액","30,000원","20,000원","−2,000원 (−7.8%)"],["캠페인 수","6","6","0"],["예산 소진 캠페인 수","2","1","−1"]]},{"section":"섹션 2 — 경영진 요약","columns":["요약 영역","요약"],"rows":[["주요 VID 변동 및 광고 자격 요약","광고수익률 하락 VID 주요 원인 (섹션 7A): · - VID VID_0022 (공급업체1 치약코팅칫솔 50개입 1박스): 광고수익률 기여 −53.4%; 광고 매출 −600,000원; 재고 소진 115시간 · - VID VID_0016 (공급업체1 논슬립 그립 치과 칫솔 이중슬림모 12개입): 광고수익률 기여 −27.3%; 광고 매출 −200,000원; 소스 기반 광고 자격 이슈 없음 · - VID VID_0015 (공급업체1 치간칫솔 I형 SS 오렌지 100개입): 광고수익률 기여 −16.6%; 광고 매출 −90,000원; 소스 기반 광고 자격 이슈 없음 ·  · 광고 자격 검토 (섹션 7B): · - VID VID_0018 (공급업체1 기능성 칫솔 이중초미세모 12개입): 벤더 광고 매출의 20.6%; 재고 소진 47시간; 광고 매출 위험 추정액 500,000원 · - VID VID_0019 (공급업체1 기능성 칫솔 이중초미세모 6개입): 벤더 광고 매출의 17.4%; 재고 소진 137시간; 광고 매출 위험 추정액 2,000,000원 · - VID VID_0022 (공급업체1 치약코팅칫솔 50개입 1박스): 벤더 광고 매출의 13.8%; 재고 소진 115시간; 광고 매출 위험 추정액 1,000,000원"],["광고 매출 하락 또는 상승 진단 요약","벤더 광고 매출이 W1→W2 +800,000원 (+10.1%) 상승하였습니다. · - 치간칫솔 (CAMP_004): 광고 매출 +1,000,000원 상승 — 주력 상품(VID VID_0013)이 10월 1일 재고 소진 해소 후 활성 노출 시간이 2배(76→168시간)로 늘어나며 노출수가 +89.9% 급증; 트래픽 급증에 따른 전환율 하락(−22.5%) 및 보조 VID 2개의 가격 하락으로 인한 평균 주문 금액 감소(−5.8%)로 광고수익률은 18.3% 하락 · - 치약코팅칫솔 (CAMP_003): 광고 매출 +300,000원 상승 — 주력 상품(VID VID_0021)의 재고 소진 완전 해소(35→0시간)로 트래픽이 고성과 상품에 집중; 클릭률 +56.9% 급등; 클릭당 비용 감소(−22.3%)에 힘입어 광고수익률 +15.7% 개선; 보조 상품(VID VID_0022)은 재고 소진 악화(27→88시간)로 상승 폭 일부 제한 · - 치약 (CAMP_010): 광고 매출 +90,000원 상승 — W2에 캠페인 신규 활성화; 이전 기간 광고 매출 0원으로 전체 진단을 위한 이력 부족"],["광고 매출 성장을 위한 핵심 인사이트 및 조치 요약","섹션 4 — 예산 소진 예산 조치: · - 치약코팅칫솔 (CAMP_003): 현재 일예산 100,000원 → 권장 일예산 100,000원; 지난주 7일 전일 예산 소진(8시간 제한); 광고수익률 410% vs. 목표 광고수익률 294% — 예산이 핵심 제약 요인 ·  · 섹션 5 — 예산 저활용 모니터링 대상 (지원 가능한 권장 사항 없음): · - 261001 공급업체1 기능성 칫솔 (CAMP_047): 일예산 500,000원; 예산 활용률 2.5%; 판매자가 실행 가능한 권장 사항 없음 · - 공급업체1 기존 칫솔 (CAMP_009): 일예산 100,000원; 예산 활용률 45.5%; 판매자가 실행 가능한 권장 사항 없음 · - 치약 (CAMP_010): 일예산 100,000원; 예산 활용률 8.6%; 판매자가 실행 가능한 권장 사항 없음 ·  · 재고 (섹션 7A & 7B): 여러 캠페인의 다수 VID에서 재고 소진 시간이 발생하고 있습니다 — VID VID_0019 (재고 소진 137시간, 위험 추정액 2,000,000원), VID VID_0022 (재고 소진 115시간, 위험 추정액 1,000,000원), VID VID_0018 (재고 소진 47시간, 위험 추정액 500,000원) 재고 보충이 광고 매출 보호 및 성장을 위한 최우선 재고 조치입니다"]]},{"section":"섹션 3A — 벤더 광고 매출 변동을 주도한 주요 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","이전 광고 매출","이후 광고 매출","광고 매출 증감","기여도","광고비","광고수익률","목표 광고수익률","광고수익률 달성률"],"rows":[["치간칫솔","CAMP_004","MPS","1,000,000원","2,000,000원","+1,000,000원","98.7%","2,000,000원","200%","254%","78.6%"],["치약코팅칫솔","CAMP_003","MPS","2,000,000원","2,000,000원","+300,000원","35.2%","1,000,000원","383%","294%","130.0%"],["치약","CAMP_010","MPS","0원","90,000원","+90,000원","9.0%","60,000원","165%","300%","54.9%"]]},{"section":"섹션 3B — 섹션 3a 캠페인 진단 및 추천 사항","columns":["#","캠페인 ID","캠페인명","진단","추천 액션 및 근거"],"rows":[["1","CAMP_004","치간칫솔","광고 매출 증가 원인: 광고 매출이 +70.5% 상승했습니다 (1,000,000원→2,000,000원). 상위 상품 VID VID_0013가 10월 1일 품절(OOS) 제약을 해소하면서 활성 노출 시간이 2배로 늘어났고(76→168시간), 노출수가 +89.9% 급증하며 광고 매출 기여도가 +120.2% 증가했습니다. 클릭률(CTR)도 +22.9% 개선되어 기여도 +38.7%를 기록했습니다. 다만 트래픽 급증이 전환 역량을 초과하면서 전환율(CVR)이 22.5% 하락(기여도 −47.7%)했고, VID VID_0014(−15.8%) 및 VID_0015(−8.1%)의 가격 하락으로 평균 주문 금액(AOV)이 5.8% 감소(기여도 −11.2%)하며 일부 상쇄됐습니다. 광고수익률 달성률은 78.6%로 90% 기준치를 하회합니다. ·  · 1) 광고 매출 증가 원인: 상위 VID의 품절 해소로 노출수가 회복되고, 클릭률 상승이 성과를 뒷받침하며 노출 주도의 회복세를 보였습니다. · 2) 광고수익률 하락 원인: 갑작스러운 트래픽 급증이 주문 전환 역량을 초과하면서 전환율(CVR)이 22.5% 하락했고, 2개 보조 VID의 가격 하락으로 평균 주문 금액(AOV)이 5.8% 감소했습니다. 클릭당 비용(CPC)은 10.6% 하락하여 광고수익률 하락을 일부 완충했습니다.","VID VID_0014 재입고를 권장합니다 (W2 품절 34시간, W1 22시간 대비 증가). 재고 부족으로 인한 전환율 희석을 방지하고 전체 노출 시간을 회복하기 위함입니다. 현재 광고수익률 부진은 입찰가나 예산 설정이 아닌 재고 문제에 기인한 전환율·평균 주문 금액 구조적 이슈이므로, 목표 광고수익률 또는 예산 조정은 권장하지 않습니다."],["2","CAMP_003","치약코팅칫솔","광고 매출 증가 원인: 광고 매출이 +15.6% 상승했습니다 (2,000,000원→2,000,000원). 주력 상품 VID VID_0021의 품절이 완전히 해소되어(35→0시간) 성과가 높은 상품에 노출이 집중됐고, 클릭률(CTR)이 +56.9% 급등하며 기여도 +310.2%를 기록했습니다. 클릭당 비용(CPC)은 22.3% 하락하여 광고수익률이 +15.7% 개선된 410.4%를 달성했습니다(광고수익률 달성률 130.0%, 90% 기준치를 크게 상회). 광고비는 보합세(−0%)를 유지했습니다. 보조 상품 VID VID_0022는 품절이 급격히 악화되어(27→88시간) 해당 VID의 광고 매출이 32.3% 감소하고 주문수가 55.2% 하락하면서 전체 캠페인 성장의 상단을 일부 제한했습니다. 캠페인은 W2 7일 내내 일예산 소진(OOB) 상태였으며(8시간 제한), 일예산 소진율은 98.8%로 일예산이 추가 성장의 핵심 제약 요인임을 나타냅니다.","1. 일예산 증액을 권장합니다: 100,000원 → 100,000원 (Sales Engine 추천, 2026-10-15). 광고수익률이 294% 목표 대비 410%로 효율이 우수하며, 일예산이 유일한 제약 요인입니다. 기대 광고 매출 증가분은 아직 정량화되지 않았으나 근거 데이터가 뒷받침됩니다. · 2. VID VID_0022 재입고를 권장합니다 (W2 품절 88시간; 2주 기간 기준 광고 매출 위험 추정액 1,000,000원). 해당 VID의 재고를 회복하면 캠페인의 노출 기반이 넓어지고 광고 매출 회복세가 가속될 것입니다."],["3","CAMP_010","치약","광고 매출 증가 원인: 캠페인이 W2에 신규 시작되었습니다 (0원→90,000원). W1 기준값이 없어 표준 전주 대비 퍼널 분해 분석은 적용되지 않습니다. W2 광고수익률은 300% 목표 광고수익률 대비 164.7%로 달성률은 54.9%입니다. 2개 VID가 기여했습니다: VID VID_0023 (80,000원, 82.9%) 및 VID VID_0028 (10,000원, 17.1%).","충분한 진단 데이터가 없습니다 — 해당 캠페인은 최소 자격 기준을 충족하지 못합니다 (30일 내 광고 전환 주문수 30건 미만; 이전 기간 광고 매출 = 0원). 결론 도출 또는 입찰가·예산 조정 전에 충분한 데이터를 축적할 수 있도록 2~3주 더 모니터링하시기 바랍니다."]]},{"section":"3페이지 — 광고 매출 극대화 방안 — 핵심 인사이트 및 추천 조치 요약","columns":["순위","출처","우선 조치","예상 광고 매출 증가","근거"],"rows":[["1","Section 4 — OOB, 예산 조치 가능","치약코팅칫솔 (CAMP_003): 일예산을 100,000원에서 100,000원으로 증액","미정량화 (출처 기반 추천 제공됨)","W2 기간 7일 전일 OOB 발생 (8시간 상한 도달; 활용률 98.8%). 광고수익률(ROAS) 410% vs. 목표 광고수익률(T.ROAS) 294% — 효율이 우수하며 예산이 핵심 제약 요인입니다. Sales Engine 추천 일자: 2026-10-15."],["2","Section 5 — 낮은 활용률, 지원 추천 없음","261001 공급업체1 기능성 칫솔 (CAMP_047): 캠페인이 의도적으로 낮은 게재량을 보이는지 검토","정량화 불가","일예산 500,000원; 최근 7일 활용률 2.5%에 불과. 현재 판매자가 직접 조치할 수 있는 추천이 없습니다. 예산 또는 입찰가 조치를 검토하기 전, AE는 낮은 게재량이 적격성 제약으로 인한 것인지 확인해야 합니다 (참고: VID VID_0018 및 VID_0019에 활성 품절(OOS) 시간이 존재)."],["3","Section 5 — 낮은 활용률, 지원 추천 없음","공급업체1 기존 칫솔 (CAMP_009): 활용률 추세 모니터링","정량화 불가","일예산 100,000원; 활용률 45.5% — 보통 수준이나 완전 게재에는 미치지 못함. 현재 판매자가 직접 조치할 수 있는 추천이 없습니다."]]},{"section":"섹션 4 — OOB 시간이 있는 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","광고 매출","광고비","ROAS","T.ROAS","ROAS 달성률","OOB 시간","현재 예산","추천 예산","예상 GMV 증가분","AE 조치 / 맥락"],"rows":[["치약코팅칫솔","CAMP_003","MPS","5,000,000원","1,000,000원","383%","294%","130.0%","13","100,000원","100,000원","—","조치 필요. Sales Engine 예산 추천 제공됨 (100,000원 → 100,000원, 일자: 2026-10-15). W2 기간 7일 전일 OOB 발생 (8시간 상한 도달); 광고수익률(ROAS) 410% vs. 목표 광고수익률(T.ROAS) 294% — 예산이 핵심 제약 요인입니다. 광고주에게 예산 증액을 제안하시기 바랍니다."],["치간칫솔","CAMP_004","MPS","4,000,000원","2,000,000원","200%","254%","78.6%","7","—","—","—","맥락 참고 전용 — 예산 증액 불필요. OOB 시간은 W1(이전 기간)에 기록됨. 광고수익률(ROAS) 달성률 78.6%로 목표 광고수익률(T.ROAS) 미달. 광고 매출 급등의 주요 원인은 예산 가용성이 아닌 상위 VID의 품절(OOS) 해소입니다. 현재 Sales Engine에서 제공되는 예산 추천이 없습니다. AE는 예산 증액을 제안하지 않아야 하며, 제약 요인은 전환 효율 및 재고 문제입니다."]]},{"section":"섹션 5 — 예산 사용률이 낮은 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","광고 매출","광고비","ROAS","현재 일예산","최근 7일 예산 사용률","사용 가능한 추천"],"rows":[["261001 공급업체1 기능성 칫솔","CAMP_047","MPS","400,000원","100,000원","236%","500,000원","2.5%","—"],["공급업체1 기존 칫솔","CAMP_009","MPS","1,000,000원","600,000원","278%","100,000원","45.5%","—"],["치약","CAMP_010","MPS","90,000원","60,000원","165%","100,000원","8.6%","—"]]},{"section":"섹션 7A — 벤더 광고 매출 또는 ROAS 하락에 기여한 주요 VID","columns":["순위","VID","VID 옵션명","연결된 매출 성장 캠페인","선택된 하락 초점","W1 광고 매출","W2 광고 매출","광고 매출 변화","W1 광고수익률 기여도","W2 광고수익률 기여도","하락 기여도","변동 기여도","적격 상태 / 이슈","이슈 근거 / 시간","핵심 요약"],"rows":[["1","VID_0022","공급업체1 치약코팅칫솔, 50개입, 1박스","CAMP_003 — 치약코팅칫솔 (MPS)","광고수익률 하락","1,000,000원","1,000,000원","−600,000원","103.2%","49.8%","−53.4%","126.9%","품절: 115h","분석 기간 내 근거 있는 이슈 115시간","광고수익률 하락의 주요 원인. VID 광고수익률 기여도가 53.4%p 하락했으며, 품절 시간이 W1 27시간에서 W2 88시간으로 악화됨. 재고 보충이 광고수익률 기여도 회복을 위한 핵심 조치입니다."],["2","VID_0016","공급업체1 논슬립 그립 치과 칫솔 이중슬림모, 12개입","CAMP_009 — 공급업체1 기존 칫솔 (MPS)","광고수익률 하락","1,000,000원","700,000원","−200,000원","56.9%","29.5%","−27.3%","64.9%","근거 있는 적격 이슈 없음","0h","광고수익률 기여도가 27.3%p 하락했으나 식별된 적격 제약 없음. 자연 수요 약화 또는 경쟁 심화에 의한 가능성이 높음. 지속 여부를 모니터링하세요."],["3","VID_0015","공급업체1 치간칫솔 I형 SS 오렌지, 100개입","CAMP_004 — 치간칫솔 (MPS)","광고수익률 하락","800,000원","700,000원","−90,000원","44.4%","27.8%","−16.6%","39.4%","근거 있는 적격 이슈 없음","0h","광고수익률 기여도가 16.6%p 하락. 평균 주문 금액이 8.1% 감소(30,000원→30,000원)했으며 적격 이슈는 감지되지 않음. 가격 하락이 주요 원인으로 추정됩니다."],["4","VID_0018","공급업체1 기능성 칫솔 이중초미세모, 12개입","CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS)","광고수익률 하락","200,000원","100,000원","−100,000원","14.1%","4.8%","−9.3%","22.1%","품절: 47h","분석 기간 내 근거 있는 이슈 47시간","광고수익률 기여도가 9.3%p 하락했으며, 품절 47시간이 식별된 제약 요인입니다. 서빙 시간 회복을 위해 재고를 보충하세요."],["5","VID_0019","공급업체1 기능성 칫솔 이중초미세모, 6개입","104444587 — 공급업체1 기능성 칫솔 (MPS) | CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS)","광고수익률 하락","80,000원","20,000원","−50,000원","4.6%","1.2%","−3.5%","8.2%","품절: 137h","분석 기간 내 근거 있는 이슈 137시간","광고수익률 기여도가 3.5%p 하락했으며, 품절 137시간은 광고주 포트폴리오 내 가장 심각한 적격 이슈입니다. 긴급 재고 보충을 권장합니다."]]},{"section":"섹션 7B — 광고 적격성 검토가 필요한 주요 벤더 VID","columns":["순위","VID","상품명","광고 매출","광고 매출 기여도","적격 상태 / 이슈","이슈 근거 / 시간","연결된 매출 성장 캠페인","최근 2주 광고 매출 영향 / 위험","최근 2주 광고수익률 영향 / 위험","핵심 영향 요약 및 간략 권장 사항"],"rows":[["1","VID_0018","공급업체1 기능성 칫솔 이중초미세모, 12개입","4,000,000원","20.6%","품절: 47h","최근 2주간 47h","104444587 — 공급업체1 기능성 칫솔 (MPS) | CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS)","500,000원","확인 불가","광고주 광고 매출의 20.6%를 차지하는 VID에서 품절 시간이 감지됨. 광고 매출 위험이 지속되지 않도록 신속히 재고를 보충하세요."],["2","VID_0019","공급업체1 기능성 칫솔 이중초미세모, 6개입","3,000,000원","17.4%","품절: 137h","최근 2주간 137h","104444587 — 공급업체1 기능성 칫솔 (MPS) | CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS)","2,000,000원","확인 불가","포트폴리오 내 가장 심각한 품절(137h). 2주간 추정 광고 매출 위험 2,000,000원. 긴급 재고 보충이 필요합니다."],["3","VID_0022","공급업체1 치약코팅칫솔, 50개입, 1박스","3,000,000원","13.8%","품절: 115h","최근 2주간 115h","CAMP_003 — 치약코팅칫솔 (MPS)","1,000,000원","확인 불가","광고주 광고 매출의 13.8%를 기여하는 VID에서 품절 115h 발생; 추정 위험 1,000,000원. 캠페인 정상 게재 및 광고수익률 기여도 회복을 위해 재고를 보충하세요."],["4","VID_0013","공급업체1 치간칫솔 I형 SSS 핑크, 100개입","3,000,000원","13.3%","품절: 92h","최근 2주간 92h","CAMP_004 — 치간칫솔 (MPS)","500,000원","확인 불가","광고주 광고 매출의 13.3%를 기여하는 VID에서 품절 92h 발생; 추정 위험 500,000원. W2에서 관찰된 매출 회복 흐름을 유지하기 위해 재고를 보충하세요."],["5","VID_0021","공급업체1 치약코팅칫솔, 10개입, 1개","2,000,000원","9.9%","품절: 35시간","최근 2주간 35시간 품절","CAMP_003 — 치약코팅칫솔 (MPS)","200,000원","이용 불가","품절 35시간; 예상 손실 200,000원. 이 상품은 품절 해소 이후 치약코팅칫솔 캠페인의 광고 매출 상승을 이끌었으며, 이 성과를 유지하기 위해서는 지속적인 재고 관리가 중요합니다."]]}]
kpis = Grid(@Each(metrics, "m", Card([Caption(m.label), Title(m.w2, "md"), Row([Badge("W1 " + m.w1), Badge("기재 변화 " + m.delta, "info")], 1, null, null, true)])), 3, 175, 3)
moneyChart = Card([Title("기간별 광고 매출 · 광고비", "md"), Chart("bar", periods, "period", ["revenue", "spend"], "currency", "KRW"), Caption("섹션 1의 기간별 원문 값 · 일별 추이 아님")])
efficiencyChart = Card([Title("광고수익률 비교", "md"), Chart("bar", ratios, "period", ["roas"], "percent"), Caption("섹션 1 · 단위 %")])
conversionChart = Card([Title("전환율 비교", "md"), Chart("bar", ratios, "period", ["cvr"], "percent"), Caption("섹션 1 · ROAS와 별도 축으로 비교")])
overview = Col([Text("주요 지표를 비교하고, 캠페인 진단과 재고 위험을 탐색한 뒤 실행할 조치를 확인하세요.", "sm", "muted"), kpis, moneyChart, Grid([efficiencyChart, conversionChart], 2, 280, 4), stockChart])
visible = $campaign == "전체" ? campaigns : @Filter(campaigns, "id", "==", $campaign)
campaignOptions = @Concat([{value: "전체", label: "전체 캠페인"}], @Each(campaigns, "c", {value: c.id, label: c.name + " · " + c.id}))
campaignView = Col([Title("캠페인 탐색", "lg"), Select($campaign, campaignOptions, "캠페인 선택"), Grid([Card([Title("광고 매출", "md"), Chart("bar", visible, "name", ["revenue"], "currency", "KRW"), Caption("섹션 3A · 이후 매출")]), Card([Title("실제 ROAS와 목표", "md"), Chart("bar", visible, "name", ["roas", "target"], "percent"), Caption("섹션 3A의 원문 값 · 다른 섹션 수치와 혼합하지 않음")])], 2, 280, 4), Col(@Each(visible, "c", Card([Row([Title(c.name, "md"), Badge(c.id, "info")], 2), Text(c.diagnosis, "sm"), Popover("추천 조치와 근거", [Text(c.action, "sm"), Caption("섹션 3B 원문")])]))])
filteredRisks = @Filter(knownHourRisks, "hours", ">=", $minHours)
filteredAmounts = @Filter(knownAmountRisks, "hours", ">=", $minHours)
stockChart = Card([Title("VID별 품절 시간", "md"), Chart("bar", knownHourRisks, "id", ["hours"]), Caption("섹션 7B · 시간 · 미기재 값은 0으로 보정하지 않음")])
inventoryView = Col([Title("재고 위험 탐색", "lg"), Slider($minHours, 0, 3, 1, "최소 품절 시간", "시간"), Caption(@Count(filteredRisks) + "개 VID 표시"), SegmentedControl($riskView, ["품절 시간", "매출 위험"]), $riskView == "품절 시간" ? Card([Chart("bar", filteredRisks, "id", ["hours"]), Caption("섹션 7B · 단위: 시간")]) : Card([Chart("bar", filteredAmounts, "id", ["amount"], "currency", "KRW"), Caption("섹션 7B의 추정 위험액 · 확정 손실이 아니며 중복 위험을 합산하지 않음")]), Grid(@Each(filteredRisks, "r", Card([Title(r.id, "md"), Text(r.name, "sm"), Badge(r.issue, "warning"), Text(r.summary, "sm")])), 2, 260, 3), Popover("재고 원문 전체", [Table(["VID", "시간 원문 여부", "근거"], @Each(risks, "r", [r.id, r.hours == null ? "확인 불가" : r.hours + "시간", r.summary]))])])
actionView = Col([Title("실행 체크리스트", "lg"), Text("원문 권고와 실행 가능 여부를 함께 확인하세요. 체크는 개인 진행 상태이며 실제 예산이나 재고를 변경하지 않습니다.", "sm", "muted"), Caption(@Count($done) + " / " + @Count(actions) + " 완료"), Col(@Each(actions, "a", Pressable([Row([Icon(@Includes($done, a.id) ? "check-circle" : "circle", "sm"), Title(a.title, "md")], 2), Text(a.evidence, "sm"), Badge("원문 예상 효과: " + a.impact, "info")], @Set($done, @Toggle($done, a.id)), @Includes($done, a.id), 4))), Button("조치 요약 복사", @CopyToClipboard(@Join(@Each(actions, "a", a.title + " · " + a.evidence), "\n")), "outline", null, "sm", "copy")])
evidenceOptions = @Concat([{value: "전체", label: "전체 섹션"}], @Each(evidence, "e", {value: e.section, label: e.section}))
visibleEvidence = $evidence == "전체" ? evidence : @Filter(evidence, "section", "==", $evidence)
evidenceView = Col([Title("원문 근거", "lg"), Select($evidence, evidenceOptions, "근거 섹션 선택"), Col(@Each(visibleEvidence, "e", Col([Title(e.section, "md"), Table(e.columns, e.rows)]))), Popover("전체 원문 보기", [Markdown("다음은 **공급업체1 (V_공급업체1)**의 전체 V1 벤더 수준 분석 결과입니다. 분석 기간: **2026년 10월 1일 – 10월 14일** (W1: 10월 1일–7일 / W2: 10월 8일–14일).\n\n---\n\n## 1페이지 — 주요 지표 및 경영진 요약\n\n### 섹션 1 — 벤더 핵심 / 주요 지표\n\n| 지표 | W1 (10월 1일–7일) | W2 (10월 8일–14일) | 변화 |\n|---|---:|---:|---:|\n| 광고 매출 | 8,000,000원 | 9,000,000원 | +800,000원 (+10.1%) |\n| 광고수익률 | 169% | 177% | +8%p (+4.7%) |\n| 광고비 | 5,000,000원 | 5,000,000원 | +200,000원 (+5.1%) |\n| 노출수 | 900,000 | 1,000,000 | +100,000 (+19.4%) |\n| 클릭률 | 0.6% | 0.8% | +0.2%p (+47.9%) |\n| 전환율 | 5.2% | 3.5% | −2.0%p (−32.4%) |\n| 평균 주문 금액 | 30,000원 | 20,000원 | −2,000원 (−7.8%) |\n| 캠페인 수 | 6 | 6 | 0 |\n| 예산 소진 캠페인 수 | 2 | 1 | −1 |\n\n**벤더 요약:** 광고 매출이 전주 대비 +800,000원 (+10.1%) 상승하였으며, 주요 성장 동인은 치간칫솔 및 치약코팅칫솔 캠페인입니다. 광고비는 더 낮은 증가율(+5.1%)을 보여 광고수익률이 순 +8%p 개선되었습니다. 전환율은 32.4% 하락하고 평균 주문 금액은 7.8% 감소하여 노출수 및 클릭률 증가 효과를 일부 상쇄하였습니다. 치약 캠페인(CAMP_010)은 W2에 신규 활성화되었습니다. 예산 소진 캠페인은 치약코팅칫솔 1개가 남아 있습니다.\n\n---\n\n### 섹션 2 — 경영진 요약\n\n| 요약 영역 | 요약 |\n|---|---|\n| 주요 VID 변동 및 광고 자격 요약 | **광고수익률 하락 VID 주요 원인 (섹션 7A):**<br>- VID VID_0022 (공급업체1 치약코팅칫솔 50개입 1박스): 광고수익률 기여 −53.4%; 광고 매출 −600,000원; 재고 소진 115시간<br>- VID VID_0016 (공급업체1 논슬립 그립 치과 칫솔 이중슬림모 12개입): 광고수익률 기여 −27.3%; 광고 매출 −200,000원; 소스 기반 광고 자격 이슈 없음<br>- VID VID_0015 (공급업체1 치간칫솔 I형 SS 오렌지 100개입): 광고수익률 기여 −16.6%; 광고 매출 −90,000원; 소스 기반 광고 자격 이슈 없음<br><br>**광고 자격 검토 (섹션 7B):**<br>- VID VID_0018 (공급업체1 기능성 칫솔 이중초미세모 12개입): 벤더 광고 매출의 20.6%; 재고 소진 47시간; 광고 매출 위험 추정액 500,000원<br>- VID VID_0019 (공급업체1 기능성 칫솔 이중초미세모 6개입): 벤더 광고 매출의 17.4%; 재고 소진 137시간; 광고 매출 위험 추정액 2,000,000원<br>- VID VID_0022 (공급업체1 치약코팅칫솔 50개입 1박스): 벤더 광고 매출의 13.8%; 재고 소진 115시간; 광고 매출 위험 추정액 1,000,000원 |\n| 광고 매출 하락 또는 상승 진단 요약 | **벤더 광고 매출이 W1→W2 +800,000원 (+10.1%) 상승하였습니다.**<br>- 치간칫솔 (CAMP_004): 광고 매출 +1,000,000원 상승 — 주력 상품(VID VID_0013)이 10월 1일 재고 소진 해소 후 활성 노출 시간이 2배(76→168시간)로 늘어나며 노출수가 +89.9% 급증; 트래픽 급증에 따른 전환율 하락(−22.5%) 및 보조 VID 2개의 가격 하락으로 인한 평균 주문 금액 감소(−5.8%)로 광고수익률은 18.3% 하락<br>- 치약코팅칫솔 (CAMP_003): 광고 매출 +300,000원 상승 — 주력 상품(VID VID_0021)의 재고 소진 완전 해소(35→0시간)로 트래픽이 고성과 상품에 집중; 클릭률 +56.9% 급등; 클릭당 비용 감소(−22.3%)에 힘입어 광고수익률 +15.7% 개선; 보조 상품(VID VID_0022)은 재고 소진 악화(27→88시간)로 상승 폭 일부 제한<br>- 치약 (CAMP_010): 광고 매출 +90,000원 상승 — W2에 캠페인 신규 활성화; 이전 기간 광고 매출 0원으로 전체 진단을 위한 이력 부족 |\n| 광고 매출 성장을 위한 핵심 인사이트 및 조치 요약 | **섹션 4 — 예산 소진 예산 조치:**<br>- 치약코팅칫솔 (CAMP_003): 현재 일예산 100,000원 → 권장 일예산 100,000원; 지난주 7일 전일 예산 소진(8시간 제한); 광고수익률 410% vs. 목표 광고수익률 294% — 예산이 핵심 제약 요인<br><br>**섹션 5 — 예산 저활용 모니터링 대상 (지원 가능한 권장 사항 없음):**<br>- 261001 공급업체1 기능성 칫솔 (CAMP_047): 일예산 500,000원; 예산 활용률 2.5%; 판매자가 실행 가능한 권장 사항 없음<br>- 공급업체1 기존 칫솔 (CAMP_009): 일예산 100,000원; 예산 활용률 45.5%; 판매자가 실행 가능한 권장 사항 없음<br>- 치약 (CAMP_010): 일예산 100,000원; 예산 활용률 8.6%; 판매자가 실행 가능한 권장 사항 없음<br><br>**재고 (섹션 7A & 7B):** 여러 캠페인의 다수 VID에서 재고 소진 시간이 발생하고 있습니다 — VID VID_0019 (재고 소진 137시간, 위험 추정액 2,000,000원), VID VID_0022 (재고 소진 115시간, 위험 추정액 1,000,000원), VID VID_0018 (재고 소진 47시간, 위험 추정액 500,000원) 재고 보충이 광고 매출 보호 및 성장을 위한 최우선 재고 조치입니다 |\n\n---\n\n## 2페이지 — 주요 지표 변동 진단 (광고 매출 하락 또는 상승)\n\n### 섹션 3A — 벤더 광고 매출 변동을 주도한 주요 캠페인\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 이전 광고 매출 | 이후 광고 매출 | 광고 매출 증감 | 기여도 | 광고비 | 광고수익률 | 목표 광고수익률 | 광고수익률 달성률 |\n|---|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|\n| 치간칫솔 | CAMP_004 | MPS | 1,000,000원 | 2,000,000원 | +1,000,000원 | 98.7% | 2,000,000원 | 200% | 254% | 78.6% |\n| 치약코팅칫솔 | CAMP_003 | MPS | 2,000,000원 | 2,000,000원 | +300,000원 | 35.2% | 1,000,000원 | 383% | 294% | 130.0% |\n| 치약 | CAMP_010 | MPS | 0원 | 90,000원 | +90,000원 | 9.0% | 60,000원 | 165% | 300% | 54.9% |\n\n---\n\n### 섹션 3B — 섹션 3a 캠페인 진단 및 추천 사항\n\n| # | 캠페인 ID | 캠페인명 | 진단 | 추천 액션 및 근거 |\n|---:|---:|---|---|---|\n| 1 | CAMP_004 | 치간칫솔 | **광고 매출 증가 원인:** 광고 매출이 +70.5% 상승했습니다 (1,000,000원→2,000,000원). 상위 상품 VID VID_0013가 10월 1일 품절(OOS) 제약을 해소하면서 활성 노출 시간이 2배로 늘어났고(76→168시간), 노출수가 +89.9% 급증하며 광고 매출 기여도가 +120.2% 증가했습니다. 클릭률(CTR)도 +22.9% 개선되어 기여도 +38.7%를 기록했습니다. 다만 트래픽 급증이 전환 역량을 초과하면서 전환율(CVR)이 22.5% 하락(기여도 −47.7%)했고, VID VID_0014(−15.8%) 및 VID_0015(−8.1%)의 가격 하락으로 평균 주문 금액(AOV)이 5.8% 감소(기여도 −11.2%)하며 일부 상쇄됐습니다. 광고수익률 달성률은 78.6%로 90% 기준치를 하회합니다.<br><br>1) **광고 매출 증가 원인:** 상위 VID의 품절 해소로 노출수가 회복되고, 클릭률 상승이 성과를 뒷받침하며 노출 주도의 회복세를 보였습니다.<br>2) **광고수익률 하락 원인:** 갑작스러운 트래픽 급증이 주문 전환 역량을 초과하면서 전환율(CVR)이 22.5% 하락했고, 2개 보조 VID의 가격 하락으로 평균 주문 금액(AOV)이 5.8% 감소했습니다. 클릭당 비용(CPC)은 10.6% 하락하여 광고수익률 하락을 일부 완충했습니다. | **VID VID_0014 재입고를 권장합니다** (W2 품절 34시간, W1 22시간 대비 증가). 재고 부족으로 인한 전환율 희석을 방지하고 전체 노출 시간을 회복하기 위함입니다. 현재 광고수익률 부진은 입찰가나 예산 설정이 아닌 재고 문제에 기인한 전환율·평균 주문 금액 구조적 이슈이므로, 목표 광고수익률 또는 예산 조정은 권장하지 않습니다. |\n| 2 | CAMP_003 | 치약코팅칫솔 | **광고 매출 증가 원인:** 광고 매출이 +15.6% 상승했습니다 (2,000,000원→2,000,000원). 주력 상품 VID VID_0021의 품절이 완전히 해소되어(35→0시간) 성과가 높은 상품에 노출이 집중됐고, 클릭률(CTR)이 +56.9% 급등하며 기여도 +310.2%를 기록했습니다. 클릭당 비용(CPC)은 22.3% 하락하여 광고수익률이 +15.7% 개선된 410.4%를 달성했습니다(광고수익률 달성률 130.0%, 90% 기준치를 크게 상회). 광고비는 보합세(−0%)를 유지했습니다. 보조 상품 VID VID_0022는 품절이 급격히 악화되어(27→88시간) 해당 VID의 광고 매출이 32.3% 감소하고 주문수가 55.2% 하락하면서 전체 캠페인 성장의 상단을 일부 제한했습니다. 캠페인은 W2 7일 내내 일예산 소진(OOB) 상태였으며(8시간 제한), 일예산 소진율은 98.8%로 일예산이 추가 성장의 핵심 제약 요인임을 나타냅니다. | **1. 일예산 증액**을 권장합니다: 100,000원 → 100,000원 (Sales Engine 추천, 2026-10-15). 광고수익률이 294% 목표 대비 410%로 효율이 우수하며, 일예산이 유일한 제약 요인입니다. 기대 광고 매출 증가분은 아직 정량화되지 않았으나 근거 데이터가 뒷받침됩니다.<br>**2. VID VID_0022 재입고를 권장합니다** (W2 품절 88시간; 2주 기간 기준 광고 매출 위험 추정액 1,000,000원). 해당 VID의 재고를 회복하면 캠페인의 노출 기반이 넓어지고 광고 매출 회복세가 가속될 것입니다. |\n| 3 | CAMP_010 | 치약 | **광고 매출 증가 원인:** 캠페인이 W2에 신규 시작되었습니다 (0원→90,000원). W1 기준값이 없어 표준 전주 대비 퍼널 분해 분석은 적용되지 않습니다. W2 광고수익률은 300% 목표 광고수익률 대비 164.7%로 달성률은 54.9%입니다. 2개 VID가 기여했습니다: VID VID_0023 (80,000원, 82.9%) 및 VID VID_0028 (10,000원, 17.1%). | 충분한 진단 데이터가 없습니다 — 해당 캠페인은 최소 자격 기준을 충족하지 못합니다 (30일 내 광고 전환 주문수 30건 미만; 이전 기간 광고 매출 = 0원). 결론 도출 또는 입찰가·예산 조정 전에 충분한 데이터를 축적할 수 있도록 2~3주 더 모니터링하시기 바랍니다. |\n\n---\n\n## 3페이지 — 광고 매출 극대화 방안 — 핵심 인사이트 및 추천 조치 요약\n\n> AE 다음 단계는 실행 가능한 Section 4 OOB 행(예산 추천이 제공되는 경우) 및 Section 5 낮은 활용률 행에서만 도출됩니다. Section 4 맥락 전용 OOB 행은 제외됩니다.\n\n| 순위 | 출처 | 우선 조치 | 예상 광고 매출 증가 | 근거 |\n|---:|---|---|---|---|\n| 1 | Section 4 — OOB, 예산 조치 가능 | **치약코팅칫솔 (CAMP_003):** 일예산을 100,000원에서 100,000원으로 증액 | 미정량화 (출처 기반 추천 제공됨) | W2 기간 7일 전일 OOB 발생 (8시간 상한 도달; 활용률 98.8%). 광고수익률(ROAS) 410% vs. 목표 광고수익률(T.ROAS) 294% — 효율이 우수하며 예산이 핵심 제약 요인입니다. Sales Engine 추천 일자: 2026-10-15. |\n| 2 | Section 5 — 낮은 활용률, 지원 추천 없음 | **261001 공급업체1 기능성 칫솔 (CAMP_047):** 캠페인이 의도적으로 낮은 게재량을 보이는지 검토 | 정량화 불가 | 일예산 500,000원; 최근 7일 활용률 2.5%에 불과. 현재 판매자가 직접 조치할 수 있는 추천이 없습니다. 예산 또는 입찰가 조치를 검토하기 전, AE는 낮은 게재량이 적격성 제약으로 인한 것인지 확인해야 합니다 (참고: VID VID_0018 및 VID_0019에 활성 품절(OOS) 시간이 존재). |\n| 3 | Section 5 — 낮은 활용률, 지원 추천 없음 | **공급업체1 기존 칫솔 (CAMP_009):** 활용률 추세 모니터링 | 정량화 불가 | 일예산 100,000원; 활용률 45.5% — 보통 수준이나 완전 게재에는 미치지 못함. 현재 판매자가 직접 조치할 수 있는 추천이 없습니다. |\n\n---\n\n### 섹션 4 — OOB 시간이 있는 캠페인\n\n> W1 또는 W2 중 OOB 시간이 0 초과인 캠페인. 예산 추천이 제공되는 행을 우선 순위로 정렬(W2 광고 매출 내림차순)하고, 맥락 전용 OOB 행을 이후에 배치(W2 광고 매출 내림차순).\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 광고 매출 | 광고비 | ROAS | T.ROAS | ROAS 달성률 | OOB 시간 | 현재 예산 | 추천 예산 | 예상 GMV 증가분 | AE 조치 / 맥락 |\n|---|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|\n| 치약코팅칫솔 | CAMP_003 | MPS | 5,000,000원 | 1,000,000원 | 383% | 294% | 130.0% | 13 | 100,000원 | 100,000원 | — | **조치 필요.** Sales Engine 예산 추천 제공됨 (100,000원 → 100,000원, 일자: 2026-10-15). W2 기간 7일 전일 OOB 발생 (8시간 상한 도달); 광고수익률(ROAS) 410% vs. 목표 광고수익률(T.ROAS) 294% — 예산이 핵심 제약 요인입니다. 광고주에게 예산 증액을 제안하시기 바랍니다. |\n| 치간칫솔 | CAMP_004 | MPS | 4,000,000원 | 2,000,000원 | 200% | 254% | 78.6% | 7 | — | — | — | **맥락 참고 전용 — 예산 증액 불필요.** OOB 시간은 W1(이전 기간)에 기록됨. 광고수익률(ROAS) 달성률 78.6%로 목표 광고수익률(T.ROAS) 미달. 광고 매출 급등의 주요 원인은 예산 가용성이 아닌 상위 VID의 품절(OOS) 해소입니다. 현재 Sales Engine에서 제공되는 예산 추천이 없습니다. AE는 예산 증액을 제안하지 않아야 하며, 제약 요인은 전환 효율 및 재고 문제입니다. |\n\n---\n\n### 섹션 5 — 예산 사용률이 낮은 캠페인\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 광고 매출 | 광고비 | ROAS | 현재 일예산 | 최근 7일 예산 사용률 | 사용 가능한 추천 |\n|---|---:|---|---:|---:|---:|---:|---:|---|\n| 261001 공급업체1 기능성 칫솔 | CAMP_047 | MPS | 400,000원 | 100,000원 | 236% | 500,000원 | 2.5% | — |\n| 공급업체1 기존 칫솔 | CAMP_009 | MPS | 1,000,000원 | 600,000원 | 278% | 100,000원 | 45.5% | — |\n| 치약 | CAMP_010 | MPS | 90,000원 | 60,000원 | 165% | 100,000원 | 8.6% | — |\n\n---\n\n## 4페이지 — 주요 VID 변동 및 광고 적격성 검토\n\n### 섹션 7A — 벤더 광고 매출 또는 ROAS 하락에 기여한 주요 VID\n\n> 이번 기간 광고주의 광고 매출이 상승하였습니다. 따라서 Section 7A는 광고 매출 급등 요인이 아닌 광고수익률(ROAS) 하락 요인을 제시합니다.\n\n| 순위 | VID | VID 옵션명 | 연결된 매출 성장 캠페인 | 선택된 하락 초점 | W1 광고 매출 | W2 광고 매출 | 광고 매출 변화 | W1 광고수익률 기여도 | W2 광고수익률 기여도 | 하락 기여도 | 변동 기여도 | 적격 상태 / 이슈 | 이슈 근거 / 시간 | 핵심 요약 |\n|---:|---:|---|---|---|---:|---:|---:|---:|---:|---:|---:|---|---:|---|\n| 1 | VID_0022 | 공급업체1 치약코팅칫솔, 50개입, 1박스 | CAMP_003 — 치약코팅칫솔 (MPS) | 광고수익률 하락 | 1,000,000원 | 1,000,000원 | −600,000원 | 103.2% | 49.8% | −53.4% | 126.9% | 품절: 115h | 분석 기간 내 근거 있는 이슈 115시간 | 광고수익률 하락의 주요 원인. VID 광고수익률 기여도가 53.4%p 하락했으며, 품절 시간이 W1 27시간에서 W2 88시간으로 악화됨. 재고 보충이 광고수익률 기여도 회복을 위한 핵심 조치입니다. |\n| 2 | VID_0016 | 공급업체1 논슬립 그립 치과 칫솔 이중슬림모, 12개입 | CAMP_009 — 공급업체1 기존 칫솔 (MPS) | 광고수익률 하락 | 1,000,000원 | 700,000원 | −200,000원 | 56.9% | 29.5% | −27.3% | 64.9% | 근거 있는 적격 이슈 없음 | 0h | 광고수익률 기여도가 27.3%p 하락했으나 식별된 적격 제약 없음. 자연 수요 약화 또는 경쟁 심화에 의한 가능성이 높음. 지속 여부를 모니터링하세요. |\n| 3 | VID_0015 | 공급업체1 치간칫솔 I형 SS 오렌지, 100개입 | CAMP_004 — 치간칫솔 (MPS) | 광고수익률 하락 | 800,000원 | 700,000원 | −90,000원 | 44.4% | 27.8% | −16.6% | 39.4% | 근거 있는 적격 이슈 없음 | 0h | 광고수익률 기여도가 16.6%p 하락. 평균 주문 금액이 8.1% 감소(30,000원→30,000원)했으며 적격 이슈는 감지되지 않음. 가격 하락이 주요 원인으로 추정됩니다. |\n| 4 | VID_0018 | 공급업체1 기능성 칫솔 이중초미세모, 12개입 | CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS) | 광고수익률 하락 | 200,000원 | 100,000원 | −100,000원 | 14.1% | 4.8% | −9.3% | 22.1% | 품절: 47h | 분석 기간 내 근거 있는 이슈 47시간 | 광고수익률 기여도가 9.3%p 하락했으며, 품절 47시간이 식별된 제약 요인입니다. 서빙 시간 회복을 위해 재고를 보충하세요. |\n| 5 | VID_0019 | 공급업체1 기능성 칫솔 이중초미세모, 6개입 | 104444587 — 공급업체1 기능성 칫솔 (MPS) \\| CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS) | 광고수익률 하락 | 80,000원 | 20,000원 | −50,000원 | 4.6% | 1.2% | −3.5% | 8.2% | 품절: 137h | 분석 기간 내 근거 있는 이슈 137시간 | 광고수익률 기여도가 3.5%p 하락했으며, 품절 137시간은 광고주 포트폴리오 내 가장 심각한 적격 이슈입니다. 긴급 재고 보충을 권장합니다. |\n\n---\n\n### 섹션 7B — 광고 적격성 검토가 필요한 주요 벤더 VID\n\n| 순위 | VID | 상품명 | 광고 매출 | 광고 매출 기여도 | 적격 상태 / 이슈 | 이슈 근거 / 시간 | 연결된 매출 성장 캠페인 | 최근 2주 광고 매출 영향 / 위험 | 최근 2주 광고수익률 영향 / 위험 | 핵심 영향 요약 및 간략 권장 사항 |\n|---:|---:|---|---:|---:|---|---:|---|---:|---|---|\n| 1 | VID_0018 | 공급업체1 기능성 칫솔 이중초미세모, 12개입 | 4,000,000원 | 20.6% | 품절: 47h | 최근 2주간 47h | 104444587 — 공급업체1 기능성 칫솔 (MPS) \\| CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS) | 500,000원 | 확인 불가 | 광고주 광고 매출의 20.6%를 차지하는 VID에서 품절 시간이 감지됨. 광고 매출 위험이 지속되지 않도록 신속히 재고를 보충하세요. |\n| 2 | VID_0019 | 공급업체1 기능성 칫솔 이중초미세모, 6개입 | 3,000,000원 | 17.4% | 품절: 137h | 최근 2주간 137h | 104444587 — 공급업체1 기능성 칫솔 (MPS) \\| CAMP_047 — 261001 공급업체1 기능성 칫솔 (MPS) | 2,000,000원 | 확인 불가 | 포트폴리오 내 가장 심각한 품절(137h). 2주간 추정 광고 매출 위험 2,000,000원. 긴급 재고 보충이 필요합니다. |\n| 3 | VID_0022 | 공급업체1 치약코팅칫솔, 50개입, 1박스 | 3,000,000원 | 13.8% | 품절: 115h | 최근 2주간 115h | CAMP_003 — 치약코팅칫솔 (MPS) | 1,000,000원 | 확인 불가 | 광고주 광고 매출의 13.8%를 기여하는 VID에서 품절 115h 발생; 추정 위험 1,000,000원. 캠페인 정상 게재 및 광고수익률 기여도 회복을 위해 재고를 보충하세요. |\n| 4 | VID_0013 | 공급업체1 치간칫솔 I형 SSS 핑크, 100개입 | 3,000,000원 | 13.3% | 품절: 92h | 최근 2주간 92h | CAMP_004 — 치간칫솔 (MPS) | 500,000원 | 확인 불가 | 광고주 광고 매출의 13.3%를 기여하는 VID에서 품절 92h 발생; 추정 위험 500,000원. W2에서 관찰된 매출 회복 흐름을 유지하기 위해 재고를 보충하세요. |\n| 5 | VID_0021 | 공급업체1 치약코팅칫솔, 10개입, 1개 | 2,000,000원 | 9.9% | 품절: 35시간 | 최근 2주간 35시간 품절 | CAMP_003 — 치약코팅칫솔 (MPS) | 200,000원 | 이용 불가 | 품절 35시간; 예상 손실 200,000원. 이 상품은 품절 해소 이후 치약코팅칫솔 캠페인의 광고 매출 상승을 이끌었으며, 이 성과를 유지하기 위해서는 지속적인 재고 관리가 중요합니다. |\n")])])