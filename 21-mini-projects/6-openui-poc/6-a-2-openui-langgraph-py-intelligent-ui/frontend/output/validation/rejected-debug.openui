root = Col([heading, quality, navigation, body])
$section = "개요"
$campaign = "전체"
$done = []

heading = Col([
  Title("공급업체1 성과 보고서", "xl"),
  Text("분석 기간 · 2026년 10월 1일 – 10월 14일 (W1: 10월 1일–7일 / W2: 10월 8일–14일)", "sm", "muted"),
  Row([Badge("원문 기반", "info"), Badge("광고 매출 회복 · 재고 위험", "warning")], 2)
], 2)

quality = Card([
  Row([Icon("triangle-alert", "sm", "warning"), Title("원문 수치 확인 필요", "md")], 2),
  Text("표의 기간별 수치와 기재된 변화량이 일치하지 않습니다. 아래 비교는 기간별 원문 값이며 변화량을 보정하지 않았습니다.", "sm"),
  Popover("확인 근거", [
    Text("섹션 1: 매출 8,000,000→9,000,000원, 원문 변화 +800,000원. 두 표현을 모두 보존합니다.", "sm")
  ])
], "soft")

navigation = SegmentedControl($section, ["개요", "캠페인", "재고", "조치", "근거"])

periods = [
  {기간: "W1", 광고매출: 8000000, 광고비: 5000000},
  {기간: "W2", 광고매출: 9000000, 광고비: 5000000}
]

campaigns = [
  {id: "CAMP_004", name: "치간칫솔", 매출: 2000000, 증감: 1000000, 광고비: 2000000, ROAS: 200, 목표: 254, summary: "주력 VID_0013 재고 해소 후 성과 상승", action: "VID_0014 재입고 권장"},
  {id: "CAMP_003", name: "치약코팅칫솔", 매출: 2000000, 증감: 300000, 광고비: 1000000, ROAS: 383, 목표: 294, summary: "VID_0021 재고 해소, CTR 급등 및 예산 소진", action: "일예산 증액 및 VID_0022 재입고 권장"},
  {id: "CAMP_010", name: "치약", 매출: 90000, 증감: 90000, 광고비: 60000, ROAS: 165, 목표: 300, summary: "W2 신규 캠페인, 충분한 진단 데이터 부족", action: "추가 모니터링 권장"},
  {id: "CAMP_047", name: "261001 기능성 칫솔", 매출: 400000, 증감: null, 광고비: 100000, ROAS: 236, 목표: null, summary: "예산 활용률 매우 낮음", action: "모니터링 필요"},
  {id: "CAMP_009", name: "기존 칫솔", 매출: 1000000, 증감: null, 광고비: 600000, ROAS: 278, 목표: null, summary: "예산 활용률 보통 수준", action: "지속 모니터링 필요"}
]

risks = [
  {VID: "VID_0018", 품절시간: 47, 위험추정액: 500000},
  {VID: "VID_0019", 품절시간: 137, 위험추정액: 2000000},
  {VID: "VID_0022", 품절시간: 115, 위험추정액: 1000000},
  {VID: "VID_0013", 품절시간: 92, 위험추정액: 500000},
  {VID: "VID_0021", 품절시간: 35, 위험추정액: 200000},
  {VID: "VID_0023", 품절시간: 0, 위험추정액: 0},
  {VID: "VID_0028", 품절시간: 0, 위험추정액: 0}
]

visible = $campaign == "전체" ? campaigns : @Filter(campaigns, "id", "==", $campaign)

overview = Col([
  Text("매출 회복과 광고수익률 개선이 있으나 전환율과 평균 주문 금액 하락 일부 상쇄 작용, 주요 성장 캠페인은 치간칫솔과 치약코팅칫솔입니다.", "sm"),
  Card([
    Title("기간별 광고 매출 및 광고비 (원문 기준)", "md"),
    Chart("bar", periods, "기간", ["광고매출", "광고비"], "currency", "KRW"),
    Caption("단위: 원 · 일별 추이 아님")
  ]),
  Grid([
    Card([
      Title("캠페인별 광고수익률 및 목표 대비 달성률", "md"),
      Chart("bar", visible, "name", ["ROAS", "목표"], "percent"),
      Caption("섹션 3A 기준")
    ]),
    Card([
      Title("VID별 품절 시간 (시간 단위)", "md"),
      Chart("bar", risks, "VID", ["품절시간"]),
      Caption("섹션 7B 기준")
    ])
  ], 2, 280, 4)
])

campaignView = Col([
  Title("캠페인 성과 분석", "lg"),
  Select($campaign, [{value:"전체", label:"전체 캠페인"}] + @Each(campaigns, "c", {value: c.id, label: c.name}), "캠페인 선택"),
  Card([
    Chart("bar", visible, "name", ["매출"], "currency", "KRW"),
    Caption("선택된 캠페인 광고 매출")
  ]),
  Grid(@Each(visible, "c",
    Card([
      Title(c.name, "md"),
      Badge(c.id, "info"),
      Text(c.summary, "sm"),
      Text(c.action, "sm", "warning")
    ])
  ), 2, 260, 3)
])

inventoryView = Col([
  Title("재고 위험 모니터링", "lg"),
  Card([
    Title("VID별 품절 시간", "md"),
    Chart("bar", risks, "VID", ["품절시간"]),
    Caption("단위: 시간 · 섹션 7B")
  ]),
  Card([
    Title("VID별 광고 매출 위험 추정액", "md"),
    Chart("bar", risks, "VID", ["위험추정액"], "currency", "KRW"),
    Caption("섹션 7B 기준")
  ]),
  Text("품절 시간은 분석 기간 내의 실측 데이터입니다. 기간 외 품절 시간은 포함하지 않습니다.", "sm")
])

actions = [
  {id: "stock_VID_0022", title: "VID_0022 재입고 확인", reason: "품절 115시간 · 광고 매출 위험 1,000,000원", status: "권장"},
  {id: "stock_VID_0019", title: "VID_0019 재고 긴급 보충", reason: "품절 137시간 · 광고 매출 위험 2,000,000원", status: "긴급"},
  {id: "stock_VID_0018", title: "VID_0018 재고 보충 필요", reason: "품절 47시간 · 광고 매출 위험 500,000원", status: "권장"},
  {id: "budget_CAMP_003", title: "치약코팅칫솔(CAMP_003) 예산 증액 검토", reason: "일예산 100,000원, OOB 8시간 제한", status: "권장"}
]

actionView = Col([
  Title("실행 체크리스트", "lg"),
  Caption(@Count($done) + " / " + @Count(actions) + " 완료"),
  Col(@Each(actions, "a",
    Pressable([
      Row([Icon(@Includes($done, a.id) ? "check-circle" : "circle", "sm"), Title(a.title, "md"), Badge(a.status, "warning")], 2, "start", "between", true),
      Text(a.reason, "sm")
    ], @Set($done, @Toggle($done, a.id)), @Includes($done, a.id), 4)
  )),
  Button("조치 요약 복사", @CopyToClipboard(@Join(@Each(actions, "a", a.title + " · " + a.reason), "\n")), "outline", null, "sm", "copy")
])

evidenceView = Col([
  Title("원문 근거 상세", "lg"),
  Text("아래 표들은 원문 분석 기반이며, 숫자와 권고 모두 원문 자료를 보존합니다.", "sm"),

  Title("섹션 1 — 벤더 핵심 주요 지표", "md"),
  Table(
    ["지표", "W1 (10월 1일–7일)", "W2 (10월 8일–14일)", "변화"],
    [
      ["광고 매출", "8,000,000원", "9,000,000원", "+800,000원 (+10.1%)"],
      ["광고수익률", "169%", "177%", "+8%p (+4.7%)"],
      ["광고비", "5,000,000원", "5,000,000원", "+200,000원 (+5.1%)"],
      ["노출수", "900,000", "1,000,000", "+100,000 (+19.4%)"],
      ["클릭률", "0.6%", "0.8%", "+0.2%p (+47.9%)"],
