      ["치약코팅칫솔", "CAMP_003", "2,000,000원", "2,000,000원", "+300,000원", "35.2%", "1,000,000원", "383%", "294%", "130.0%"],
      ["치약", "CAMP_010", "0원", "90,000원", "+90,000원", "9.0%", "60,000원", "165%", "300%", "54.9%"]
    ]
  ),

  Title("섹션 7A — ROAS 하락에 기여한 주요 VID", "md"),
  Table(
    ["VID", "상품명", "연결 캠페인", "광고 매출 W1", "광고 매출 W2", "광고 매출 변화", "광고수익률 기여 하락", "품절 시간", "핵심 요약"],
    [
      ["VID_0022", "치약코팅칫솔 50개입 1박스", "CAMP_003", "1,000,000원", "1,000,000원", "−600,000원", "−53.4%", "115시간", "광고수익률 하락 주요 원인, 재고 보충 필요"],
      ["VID_0016", "논슬립 그립 칫솔 12개입", "CAMP_009", "1,000,000원", "700,000원", "−200,000원", "−27.3%", "0시간", "적격 이슈 없음, 모니터링 권장"],
      ["VID_0015", "치간칫솔 I형 SS 오렌지 100개입", "CAMP_004", "800,000원", "700,000원", "−90,000원", "−16.6%", "0시간", "가격 하락 영향 추정"],
      ["VID_0018", "기능성 칫솔 이중초미세모 12개입", "CAMP_047", "200,000원", "100,000원", "−100,000원", "−9.3%", "47시간", "품절 이슈 존재, 재고 보충 권장"],
      ["VID_0019", "기능성 칫솔 이중초미세모 6개입", "CAMP_047", "80,000원", "20,000원", "−50,000원", "−3.5%", "137시간", "가장 심각한 품절, 긴급 재고 보충 필요"]
    ]
