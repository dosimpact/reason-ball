  Title("섹션 3A — 벤더 광고 매출 변동 주요 캠페인", "md"),
  Table(
    ["캠페인명", "캠페인 ID", "이전 광고 매출", "이후 광고 매출", "증감", "기여도", "광고비", "광고수익률", "목표 광고수익률", "달성률"],
    [
