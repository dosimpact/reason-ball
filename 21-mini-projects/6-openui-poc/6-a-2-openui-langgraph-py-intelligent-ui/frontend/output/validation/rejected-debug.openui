  Title("섹션 7B — 광고 적격성 검토 필요 VID", "md"),
  Table(
    ["VID", "상품명", "광고 매출", "품절 시간", "광고 매출 위험 추정액", "권장 조치"],
    [
      ["VID_0018", "기능성 칫솔 이중초미세모 12개입", "4,000,000원", "47시간", "500,000원", "신속 재고 보충"],
      ["VID_0019", "기능성 칫솔 이중초미세모 6개입", "3,000,000원", "137시간", "2,000,000원", "긴급 재고 보충"],
      ["VID_0022", "치약코팅칫솔 50개입 1박스", "3,000,000원", "115시간", "1,000,000원", "재고 보충 필요"],
      ["VID_0013", "치간칫솔 I형 SSS 핑크 100개입", "3,000,000원", "92시간", "500,000원", "재고 보충 권장"],
      ["VID_0021", "치약코팅칫솔 10개입 1개", "2,000,000원", "35시간", "200,000원", "지속적인 재고 관리 필요"],
