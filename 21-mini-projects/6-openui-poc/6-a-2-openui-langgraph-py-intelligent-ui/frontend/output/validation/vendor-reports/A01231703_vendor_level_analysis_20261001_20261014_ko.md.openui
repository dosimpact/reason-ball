quality = Card([Row([Title("원문 수치 확인 필요", "md"), Badge("2개 확인 사항", "warning")], 2), Text("광고 매출: 20,000,000원 → 20,000,000원, 원문 변화 -400,000원 (-2.1%). 기간별 값과 변화량 확인 필요.", "sm", "warning"), Popover("확인 사항 전체", [Col(@Each(["광고 매출: 20,000,000원 → 20,000,000원, 원문 변화 -400,000원 (-2.1%). 기간별 값과 변화량 확인 필요.","평균 주문 금액: 20,000원 → 20,000원, 원문 변화 +369원 (+1.8%). 기간별 값과 변화량 확인 필요."], "w", Text(w, "sm")), 2)]), Caption("원문 기재 값 유지 · 다른 기간과 단위를 합산하지 않음")], "soft")
metrics = [{"label":"광고 매출","w1":"20,000,000원","w2":"20,000,000원","delta":"-400,000원 (-2.1%)"},{"label":"광고수익률","w1":"413%","w2":"322%","delta":"-91%p (-22.1%)"},{"label":"광고비","w1":"5,000,000원","w2":"6,000,000원","delta":"+1,000,000원 (+25.8%)"},{"label":"광고 노출수","w1":"10,000,000","w2":"10,000,000","delta":"+1,000,000 (+15.1%)"},{"label":"클릭률","w1":"0.4%","w2":"0.4%","delta":"+0%p (+7.0%)"},{"label":"전환율","w1":"2.3%","w2":"1.8%","delta":"-1%p (-21.9%)"},{"label":"평균 주문 금액","w1":"20,000원","w2":"20,000원","delta":"+369원 (+1.8%)"},{"label":"캠페인 수","w1":"51","w2":"54","delta":"+3"},{"label":"예산 소진 캠페인","w1":"36","w2":"33","delta":"-3"}]
