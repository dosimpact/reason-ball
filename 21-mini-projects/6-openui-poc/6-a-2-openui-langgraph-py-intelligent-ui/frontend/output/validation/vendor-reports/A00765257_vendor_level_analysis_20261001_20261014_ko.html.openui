heading = Col([Title("공급업체5 · 인터랙티브 보고서", "xl"), Text("원문에 기재된 분석 기간 · W1 / W2", "sm", "muted"), Row([Badge("원문 기반", "info"), Badge("W1 / W2 비교", "purple"), Badge("로컬 필터 · 상태 저장", "success")], 2)])
quality = Card([Row([Title("원문 수치 확인 필요", "md"), Badge("2개 확인 사항", "warning")], 2), Text("광고 매출: 7,000,000원 → 8,000,000원, 원문 변화 900,000원 (+12.0%). 기간별 값과 변화량 확인 필요.", "sm", "warning"), Popover("확인 사항 전체", [Col(@Each(["광고 매출: 7,000,000원 → 8,000,000원, 원문 변화 900,000원 (+12.0%). 기간별 값과 변화량 확인 필요.","AOV: 60,000원 → 50,000원, 원문 변화 -827원 (-1.4%). 기간별 값과 변화량 확인 필요."], "w", Text(w, "sm")), 2)]), Caption("원문 기재 값 유지 · 다른 기간과 단위를 합산하지 않음")], "soft")
metrics = [{"label":"광고 매출","w1":"7,000,000원","w2":"8,000,000원","delta":"900,000원 (+12.0%)"},{"label":"광고수익률","w1":"400%","w2":"284%","delta":"-116%p (-29.0%)"},{"label":"광고비","w1":"1,000,000원","w2":"2,000,000원","delta":"1,000,000원 (+57.9%)"},{"label":"노출수","w1":"700,000","w2":"1,000,000","delta":"500,000 (+69.6%)"},{"label":"클릭률","w1":"0.6%","w2":"0.5%","delta":"-0%p (-19.6%)"},{"label":"전환율","w1":"2.7%","w2":"2.3%","delta":"-0%p (-16.6%)"},{"label":"AOV","w1":"60,000원","w2":"50,000원","delta":"-827원 (-1.4%)"},{"label":"캠페인 수","w1":"7","w2":"8","delta":"+1"},{"label":"예산 소진 캠페인","w1":"5","w2":"5","delta":"0"}]
periods = [{"기간":"W1","광고매출":7000000,"광고비":1000000},{"기간":"W2","광고매출":8000000,"광고비":2000000}]
ratios = [{"기간":"W1","광고수익률":400,"전환율":2.7},{"기간":"W2","광고수익률":284,"전환율":2.3}]
campaigns = [{"id":"CAMP_054","name":"[그로스] 찜질기(2)_261008","revenue":1000000,"roas":425,"target":420,"diagnosis":"광고 매출 급등 이유: 캠페인이 기간 중반(W2)에 론칭되어, 1,000,000원의 광고 매출 전액이 사후 기간에 VIID 94062245884를 통해 발생하였습니다(기여율 100%). 사전 기간 기준값이 존재하지 않으므로, 이 급등은 전주 대비 개선이 아닌 신규 캠페인 활성화에 따른 결과입니다. 광고수익률(ROAS) 달성률은 101.2%(90% 기준 초과)로, 목표 광고수익률(T.ROAS) 420% 이상을 달성하고 있습니다. 심층 진단 불가 — 캠페인이 적격 기준 미충족(30일 내 광고 적격 주문수 0건; W1 광고 매출 없음).","action":"추천 및 근거: 해당 없음 — 신규 론칭 캠페인으로 심층 분석을 위한 최소 적격 기준 미충족. VIID 94062245884의 성과를 단독 매출 동인으로 모니터링하고, 기록된 23시간의 예산 소진(OOB) 시간을 감안하여 일예산(현재 40,000원, 추천 100,000원)이 광고 게재를 지속하기에 충분한지 확인하세요."},{"id":"CAMP_053","name":"[그로스] 공급업체5탄소매트_베이지슈퍼싱글_20261007","revenue":800000,"roas":321,"target":429,"diagnosis":"광고 매출 급등 이유: 캠페인이 기간 중반(W2)에 론칭되어, 800,000원의 광고 매출 전액이 사후 기간에 VIID 93526835597을 통해 발생하였습니다(기여율 100%). 사전 기간 기준값이 존재하지 않습니다. 광고수익률(ROAS) 달성률은 74.9%(90% 기준 미달)로, 목표 광고수익률(T.ROAS) 429%를 아직 달성하지 못하고 있습니다.1) 광고 매출 급등 이유: W2 신규 캠페인 활성화 — VIID 93526835597 단독으로 0원에서 800,000원 발생. 광고비가 30,000원(W1, 론칭 전 집행 광고비)에서 200,000원으로 증가(+627.5%).2) 광고수익률(ROAS) 하락 이유: ROAS 달성률이 목표 광고수익률(T.ROAS) 429% 대비 0%에서 74.9%로 변화. 캠페인이 신규 활성화 상태로, 효율적인 최적화를 위한 전환 이력이 아직 충분히 누적되지 않았습니다. 심층 진단 불가 — 캠페인이 적격 기준 미충족(30일 내 광고 적격 주문수 0건; W1 광고 매출 없음).","action":"1) 광고 매출 급등 이유: 별도 조치 불필요 — 광고 매출 급등은 신규 캠페인 론칭에 기인합니다. VIID 93526835597을 단독 매출 동인으로 지속 모니터링하세요.2) 광고수익률(ROAS) 하락 이유: 전환 이력이 제한적인 신규 론칭 캠페인에 목표 광고수익률(T.ROAS) 429%가 적절한지 검토해 보세요. 초기 목표 광고수익률(T.ROAS)을 낮게 설정하면 알고리즘이 제약을 강화하기 전에 데이터를 보다 효율적으로 수집할 수 있습니다. 게재를 제약하는 16시간의 예산 소진(OOB) 시간을 줄이기 위해 일예산을 50,000원에서 추천 금액인 100,000원으로 늘려보세요."},{"id":"CAMP_035","name":"ai광고 추천운영(일예산1만/수익률1천%)","revenue":1000000,"roas":869,"target":1000,"diagnosis":"광고 매출 급등 이유: 광고 매출이 +400,000원(+76.8%) 상승하였으며, 이는 평균 주문 금액(AOV)의 급격한 증가(+76.8%, 광고 매출 성장 기여율 100%)와 노출수 확대(+59.5%, 기여율 +81.9%)에 의해 견인되었습니다. 클릭률(CTR)은 -48.2% 하락하여(-115.5% 기여) 일부 상쇄 요인으로 작용하였습니다. 전환율(CVR)은 +21.1% 개선(+33.5% 기여)되었습니다. 평균 주문 금액(AOV)이 70,000원에서 100,000원으로 급등한 것은 APS 캠페인 내에서 고가 상품 구매로의 전환을 시사합니다. 광고수익률(ROAS) 달성률은 66.6%에서 104.9%로 개선되어 W2에서 목표 광고수익률(T.ROAS) 1,000%를 초과 달성하였습니다. 심층 진단 불가 — 캠페인이 MPS 적격 기준 미충족(광고 적격 주문수 16건, 기준 30건 필요; W1 광고 매출 600,000원, 기준 1,000,000원 미달).","action":"평균 주문 금액(AOV) 추세를 면밀히 모니터링하세요 — W2의 AOV 급등(100,000원)은 지속적인 변화가 아닌 일회성 고가 주문을 반영한 것일 수 있습니다. AOV가 정상화될 경우, 광고수익률(ROAS) 달성률이 목표 광고수익률(T.ROAS) 1,000% 아래로 다시 하락할 수 있습니다. 현재 캠페인이 APS 유형으로 목표를 달성하고 있는 만큼, 이 단계에서는 일예산 또는 목표 광고수익률(T.ROAS) 변경을 추천하지 않습니다."},{"id":"CAMP_013","name":"[로켓그로스/공급업체5] 푸드워머_250807 매출최적화","revenue":1000000,"roas":366,"target":400,"diagnosis":"광고 매출 증가 이유: 광고 매출이 +300,000원 (+24.1%) 증가하였으며, 이는 노출수 확대(+44.5%, 기여도 +170.8%)와 클릭률 개선(+16.5%, 기여도 +70.9%)에 의해 견인되었습니다. 전환율은 -28.7% 하락(-157.1% 기여)하여 성장의 주요 저해 요인으로 작용하였습니다. 전환율 하락은 두 가지 요인과 연관됩니다: (1) 신규 출시된 VIID VID_0011가 10월 1일 캠페인에 진입하였으나 광고 전환율이 1.42%로 낮고(기존 VIID VID_0012의 3.4% 대비), 현재 캠페인 광고비의 약 1/3을 차지하면서 광고수익률(ROAS) 204%에 그쳐 목표 광고수익률(T.ROAS) 400% 대비 크게 미달; (2) 10월 1일 목표 광고수익률(T.ROAS)이 300% → 400%로 상향되어 달성 기준이 33% 높아졌고, 광고수익률 달성률이 129.3%에서 87.7%로 하락하였습니다. 광고수익률 달성률은 91.6%로 90% 기준을 상회합니다.","action":"일예산을 60,000원에서 권장 금액인 70,000원으로 증액하세요 — 최근 7일 중 6일 동안 일예산 소진(OOB)이 발생하였으며(11시간 상한 도달, 소진율 98.7%), 일예산 한도가 광고 게재의 실질적 제약임이 확인되었습니다. 참고: 실현 광고수익률 351%는 목표 광고수익률(T.ROAS) 400% 미만입니다; 예산 증액은 현재 효율 수준에서 광고비를 확대하는 방향입니다. VIID VID_0011 성과를 모니터링하세요 — 전환 이력이 쌓여도 전환율이 개선되지 않는다면, 지속적인 광고수익률 희석을 방지하기 위해 해당 상품을 이 캠페인에 유지할지 또는 별도로 관리할지 검토가 필요합니다."}]
knownTargetCampaigns = [{"id":"CAMP_054","name":"[그로스] 찜질기(2)_261008","revenue":1000000,"roas":425,"target":420,"diagnosis":"광고 매출 급등 이유: 캠페인이 기간 중반(W2)에 론칭되어, 1,000,000원의 광고 매출 전액이 사후 기간에 VIID 94062245884를 통해 발생하였습니다(기여율 100%). 사전 기간 기준값이 존재하지 않으므로, 이 급등은 전주 대비 개선이 아닌 신규 캠페인 활성화에 따른 결과입니다. 광고수익률(ROAS) 달성률은 101.2%(90% 기준 초과)로, 목표 광고수익률(T.ROAS) 420% 이상을 달성하고 있습니다. 심층 진단 불가 — 캠페인이 적격 기준 미충족(30일 내 광고 적격 주문수 0건; W1 광고 매출 없음).","action":"추천 및 근거: 해당 없음 — 신규 론칭 캠페인으로 심층 분석을 위한 최소 적격 기준 미충족. VIID 94062245884의 성과를 단독 매출 동인으로 모니터링하고, 기록된 23시간의 예산 소진(OOB) 시간을 감안하여 일예산(현재 40,000원, 추천 100,000원)이 광고 게재를 지속하기에 충분한지 확인하세요."},{"id":"CAMP_053","name":"[그로스] 공급업체5탄소매트_베이지슈퍼싱글_20261007","revenue":800000,"roas":321,"target":429,"diagnosis":"광고 매출 급등 이유: 캠페인이 기간 중반(W2)에 론칭되어, 800,000원의 광고 매출 전액이 사후 기간에 VIID 93526835597을 통해 발생하였습니다(기여율 100%). 사전 기간 기준값이 존재하지 않습니다. 광고수익률(ROAS) 달성률은 74.9%(90% 기준 미달)로, 목표 광고수익률(T.ROAS) 429%를 아직 달성하지 못하고 있습니다.1) 광고 매출 급등 이유: W2 신규 캠페인 활성화 — VIID 93526835597 단독으로 0원에서 800,000원 발생. 광고비가 30,000원(W1, 론칭 전 집행 광고비)에서 200,000원으로 증가(+627.5%).2) 광고수익률(ROAS) 하락 이유: ROAS 달성률이 목표 광고수익률(T.ROAS) 429% 대비 0%에서 74.9%로 변화. 캠페인이 신규 활성화 상태로, 효율적인 최적화를 위한 전환 이력이 아직 충분히 누적되지 않았습니다. 심층 진단 불가 — 캠페인이 적격 기준 미충족(30일 내 광고 적격 주문수 0건; W1 광고 매출 없음).","action":"1) 광고 매출 급등 이유: 별도 조치 불필요 — 광고 매출 급등은 신규 캠페인 론칭에 기인합니다. VIID 93526835597을 단독 매출 동인으로 지속 모니터링하세요.2) 광고수익률(ROAS) 하락 이유: 전환 이력이 제한적인 신규 론칭 캠페인에 목표 광고수익률(T.ROAS) 429%가 적절한지 검토해 보세요. 초기 목표 광고수익률(T.ROAS)을 낮게 설정하면 알고리즘이 제약을 강화하기 전에 데이터를 보다 효율적으로 수집할 수 있습니다. 게재를 제약하는 16시간의 예산 소진(OOB) 시간을 줄이기 위해 일예산을 50,000원에서 추천 금액인 100,000원으로 늘려보세요."},{"id":"CAMP_035","name":"ai광고 추천운영(일예산1만/수익률1천%)","revenue":1000000,"roas":869,"target":1000,"diagnosis":"광고 매출 급등 이유: 광고 매출이 +400,000원(+76.8%) 상승하였으며, 이는 평균 주문 금액(AOV)의 급격한 증가(+76.8%, 광고 매출 성장 기여율 100%)와 노출수 확대(+59.5%, 기여율 +81.9%)에 의해 견인되었습니다. 클릭률(CTR)은 -48.2% 하락하여(-115.5% 기여) 일부 상쇄 요인으로 작용하였습니다. 전환율(CVR)은 +21.1% 개선(+33.5% 기여)되었습니다. 평균 주문 금액(AOV)이 70,000원에서 100,000원으로 급등한 것은 APS 캠페인 내에서 고가 상품 구매로의 전환을 시사합니다. 광고수익률(ROAS) 달성률은 66.6%에서 104.9%로 개선되어 W2에서 목표 광고수익률(T.ROAS) 1,000%를 초과 달성하였습니다. 심층 진단 불가 — 캠페인이 MPS 적격 기준 미충족(광고 적격 주문수 16건, 기준 30건 필요; W1 광고 매출 600,000원, 기준 1,000,000원 미달).","action":"평균 주문 금액(AOV) 추세를 면밀히 모니터링하세요 — W2의 AOV 급등(100,000원)은 지속적인 변화가 아닌 일회성 고가 주문을 반영한 것일 수 있습니다. AOV가 정상화될 경우, 광고수익률(ROAS) 달성률이 목표 광고수익률(T.ROAS) 1,000% 아래로 다시 하락할 수 있습니다. 현재 캠페인이 APS 유형으로 목표를 달성하고 있는 만큼, 이 단계에서는 일예산 또는 목표 광고수익률(T.ROAS) 변경을 추천하지 않습니다."},{"id":"CAMP_013","name":"[로켓그로스/공급업체5] 푸드워머_250807 매출최적화","revenue":1000000,"roas":366,"target":400,"diagnosis":"광고 매출 증가 이유: 광고 매출이 +300,000원 (+24.1%) 증가하였으며, 이는 노출수 확대(+44.5%, 기여도 +170.8%)와 클릭률 개선(+16.5%, 기여도 +70.9%)에 의해 견인되었습니다. 전환율은 -28.7% 하락(-157.1% 기여)하여 성장의 주요 저해 요인으로 작용하였습니다. 전환율 하락은 두 가지 요인과 연관됩니다: (1) 신규 출시된 VIID VID_0011가 10월 1일 캠페인에 진입하였으나 광고 전환율이 1.42%로 낮고(기존 VIID VID_0012의 3.4% 대비), 현재 캠페인 광고비의 약 1/3을 차지하면서 광고수익률(ROAS) 204%에 그쳐 목표 광고수익률(T.ROAS) 400% 대비 크게 미달; (2) 10월 1일 목표 광고수익률(T.ROAS)이 300% → 400%로 상향되어 달성 기준이 33% 높아졌고, 광고수익률 달성률이 129.3%에서 87.7%로 하락하였습니다. 광고수익률 달성률은 91.6%로 90% 기준을 상회합니다.","action":"일예산을 60,000원에서 권장 금액인 70,000원으로 증액하세요 — 최근 7일 중 6일 동안 일예산 소진(OOB)이 발생하였으며(11시간 상한 도달, 소진율 98.7%), 일예산 한도가 광고 게재의 실질적 제약임이 확인되었습니다. 참고: 실현 광고수익률 351%는 목표 광고수익률(T.ROAS) 400% 미만입니다; 예산 증액은 현재 효율 수준에서 광고비를 확대하는 방향입니다. VIID VID_0011 성과를 모니터링하세요 — 전환 이력이 쌓여도 전환율이 개선되지 않는다면, 지속적인 광고수익률 희석을 방지하기 위해 해당 상품을 이 캠페인에 유지할지 또는 별도로 관리할지 검토가 필요합니다."}]
risks = [{"id":"VID_0012","name":"27년형 공급업체5 2세대 푸드워머 파인다이닝 접이식 음식 보온 매트 전기 집들이선물 홈파티,공급업체5 푸드워머,공급업체5 푸드워머","hours":49,"amount":400000,"share":17.7,"issue":"OOS: 49h | BBL: 49h","summary":"OOS 시간 감지됨 — 예상 광고 매출 위험 400,000원을 방지하기 위해 재고 보충/해소 필요."},{"id":"93526835597","name":"27년형 공급업체5 탄소매트 전자파없는 EMF인증 카본 전기매트 전기장판 전기요 캠핑 침대 세탁가능 온열매트,크림베이지,크림베이지,슈퍼싱글(110*180cm),슈퍼싱글(110*180cm)","hours":2,"amount":10000,"share":9.3,"issue":"OOS: 2h | BBL: 2h","summary":"소폭 OOS 시간 감지됨 — 재고 수준 모니터링 필요; 예상 광고 매출 위험은 10,000원으로 낮으나 악화 방지를 위해 해소 권고."},{"id":"VID_0011","name":"27년형 공급업체5 2세대 푸드워머 파인다이닝 접이식 음식 보온 매트 전기 집들이선물 홈파티,공급업체5 푸드워머,공급업체5 푸드워머","hours":135,"amount":800000,"share":1.5,"issue":"BBL: 135h","summary":"구매 박스 이탈 시간 감지됨(135시간) — 광고로 이 VID를 확장하기 전에 구매 박스 경쟁력(가격, 배송) 검토 필요. 예상 광고 매출 위험은 800,000원."},{"id":"94062245884","name":"27년형 공급업체5 원적외선 온열찜질기 카본찜질매트 생리통 복부 허리 배 수족냉증 온열찜질팩,뜨수미,뜨수미,DWR-301,DWR-301","hours":null,"amount":null,"share":27,"issue":"근거 있는 문제 없음","summary":"광고 매출 상위 기여 상품 (점유율 27.0%), 근거 있는 노출 자격 문제 없음 — 성과를 모니터링하고 캠페인 커버리지를 유지하세요."},{"id":"VID_0017","name":"27년형 공급업체5 탄소매트 전자파없는 EMF인증 카본 전기매트 전기장판 전기요 캠핑 침대 세탁가능 온열매트,크림베이지,크림베이지,더블(140*180cm),더블(140*180cm)","hours":null,"amount":null,"share":17.7,"issue":"근거 있는 문제 없음","summary":"광고 매출 상위 기여 상품 (점유율 17.7%), 근거 있는 노출 자격 문제 없음 — 성과를 모니터링하고 캠페인 커버리지를 유지하세요."}]
