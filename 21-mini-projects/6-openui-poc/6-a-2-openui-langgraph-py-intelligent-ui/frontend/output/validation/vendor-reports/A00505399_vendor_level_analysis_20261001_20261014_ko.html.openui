risks = [{"id":"VID_0020","name":"[본사 직영] 샤이샤이샤이 리페어 밀키 우레아 글로우 화잘먹 버블 세럼, 1개, 110ml","hours":5,"amount":20000,"share":5.5,"issue":"BBL: 5h","summary":"구매 박스 이탈 시간 감지됨 — 광고를 통해 이 VID를 확장하기 전에 구매 박스 경쟁력(가격, 배송)을 먼저 점검하세요."},{"id":"VID_0026","name":"[본사 직영] 샤이샤이샤이 알로에 PDRN 쿨링 리페어 크림, 1개, 50ml","hours":3,"amount":2000,"share":2.5,"issue":"OOS: 3h","summary":"품절 시간 감지됨 — 최근 2주간 2,000원으로 추정되는 광고 매출 위험이 지속되지 않도록 재고를 보충하거나 문제를 해결하세요."},{"id":"VID_0003","name":"샤이샤이샤이 리포좀 리페어 밀키 크림, 50ml","hours":null,"amount":null,"share":28.4,"issue":"근거 있는 문제 없음","summary":"광고 매출 최상위 기여 상품 (기여도 28.4%), 근거 있는 노출 자격 문제 없음 — 성과를 모니터링하고 캠페인 커버리지를 유지하세요."},{"id":"95206223687","name":"샤이샤이샤이 바나나 PDRN 컨실 아이크림 크림, 1개, 15g","hours":null,"amount":null,"share":12.9,"issue":"근거 있는 문제 없음","summary":"광고 매출 상위 기여 상품 (점유율 12.9%)으로 근거 있는 노출 자격 문제 없음 — 성과를 모니터링하고 캠페인 커버리지를 유지하세요."},{"id":"86408642852","name":"[본사 직영] 샤이샤이샤이 파지티브 선 워터리 태닝 크림 SPF22, 180g, 1개","hours":null,"amount":null,"share":5.9,"issue":"근거 있는 문제 없음","summary":"광고 매출 상위 기여 상품 (점유율 5.9%)으로 근거 있는 노출 자격 문제 없음 — 성과를 모니터링하고 캠페인 커버리지를 유지하세요."}]
knownHourRisks = [{"id":"VID_0020","name":"[본사 직영] 샤이샤이샤이 리페어 밀키 우레아 글로우 화잘먹 버블 세럼, 1개, 110ml","hours":5,"amount":20000,"share":5.5,"issue":"BBL: 5h","summary":"구매 박스 이탈 시간 감지됨 — 광고를 통해 이 VID를 확장하기 전에 구매 박스 경쟁력(가격, 배송)을 먼저 점검하세요."},{"id":"VID_0026","name":"[본사 직영] 샤이샤이샤이 알로에 PDRN 쿨링 리페어 크림, 1개, 50ml","hours":3,"amount":2000,"share":2.5,"issue":"OOS: 3h","summary":"품절 시간 감지됨 — 최근 2주간 2,000원으로 추정되는 광고 매출 위험이 지속되지 않도록 재고를 보충하거나 문제를 해결하세요."}]
knownAmountRisks = [{"id":"VID_0020","name":"[본사 직영] 샤이샤이샤이 리페어 밀키 우레아 글로우 화잘먹 버블 세럼, 1개, 110ml","hours":5,"amount":20000,"share":5.5,"issue":"BBL: 5h","summary":"구매 박스 이탈 시간 감지됨 — 광고를 통해 이 VID를 확장하기 전에 구매 박스 경쟁력(가격, 배송)을 먼저 점검하세요."},{"id":"VID_0026","name":"[본사 직영] 샤이샤이샤이 알로에 PDRN 쿨링 리페어 크림, 1개, 50ml","hours":3,"amount":2000,"share":2.5,"issue":"OOS: 3h","summary":"품절 시간 감지됨 — 최근 2주간 2,000원으로 추정되는 광고 매출 위험이 지속되지 않도록 재고를 보충하거나 문제를 해결하세요."}]
actions = [{"id":"action0","title":"260921_매출최적화_자동_리포좀 리페어 밀키 크림 · 원문 조치 검토","evidence":"캠페인 고유 노출수 감소(전체 감소분의 약 67%)는 입찰 경쟁력 또는 경매 역학의 변화 여부를 점검할 필요가 있습니다. 본 캠페인은 MPS 자동 입찰 캠페인으로, 목표 광고수익률(T.ROAS) 설정이 입찰 적극성을 결정하나, 본 분석에서는 목표 광고수익률 조정 추천을 제공하지 않습니다. 노출수 추세를 모니터링하고 카테고리 수준의 감소세가 안정화되는지 확인하시기 바랍니다. 현재 근거 기반의 예산 또는 상품 관련 판매자 조치 사항은 없습니다.","impact":"원문 기준 · 추가 추정 없음"},{"id":"action1","title":"260805_매출성장_수동_태닝오일_메인키워드 · 원문 조치 검토","evidence":"진단 불가 — 캠페인 규모가 심층 분석 최소 기준 미달입니다(최근 30일 광고 전환 주문수 21건; W1 광고 매출 50,000원). 추천 및 근거: 해당 없음.","impact":"원문 기준 · 추가 추정 없음"},{"id":"action2","title":"260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드 · 원문 조치 검토","evidence":"진단 불가 — 캠페인 규모가 심층 분석 최소 기준 미달입니다(최근 7일 광고 전환 주문수 3건; W1 광고 매출 50,000원). 전환율 하락이 핵심 모니터링 지표이며, 잠재적 원인으로는 상품 페이지 품질, 가격 경쟁력, 또는 해당 키워드 세트의 계절적 수요 변화 등이 있으나 근거 기반의 추천 사항은 없습니다. 추천 및 근거: 해당 없음.","impact":"원문 기준 · 추가 추정 없음"},{"id":"action3","title":"260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드 · 원문 조치 검토","evidence":"진단 불가 — 캠페인 볼륨이 심층 분석 최소 기준 미달(최근 7일 광고 전환 주문수: 1건; W1 광고 매출 10,000원). W2에서 노출수가 거의 전량 소실된 것이 주요 신호이며, 연관 키워드의 입찰가 경쟁력 또는 경매 수준의 변화를 반영할 수 있으나, 근거 기반 추천을 제공할 수 없습니다. 추천 및 근거: 해당 없음.","impact":"원문 기준 · 추가 추정 없음"}]
evidence = [{"section":"섹션 1 — 벤더 핵심 / 주요 지표","columns":["지표","이전 주","이후 주","변화"],"rows":[["광고 매출","6,000,000원","5,000,000원","-800,000원 (-14.0%)"],["광고수익률","229%","248%","+18%p (+8.0%)"],["광고비","2,000,000원","2,000,000원","-500,000원 (-20.4%)"],["노출수","2,000,000","1,000,000","-200,000 (-13.1%)"],["클릭률","0.3%","0.3%","-0%p (-3.4%)"],["전환율","4.3%","4.9%","+1%p (+15.4%)"],["평균 주문 금액","20,000원","10,000원","-2,000원 (-11.3%)"],["캠페인 수","6","3","-3"],["예산 소진 캠페인","0","0","0"]]},{"section":"섹션 2 — 경영진 요약","columns":["요약 영역","요약"],"rows":[["주요 VID 변동 및 광고 적격성 요약","VID 광고 매출 감소 주요 요인 (Section 7A):- 순위 1: VID VID_0020 ([본사 직영] 샤이샤이샤이 리페어 밀키 우레아 글로우 화잘먹 버블 세럼, 110ml) — 광고 매출 변화 -300,000원; 변동 기여도 1,000.2%; 광고 자격 이슈: BBL 5h 감지- 순위 2: VID VID_0003 (샤이샤이샤이 리포좀 리페어 밀키 크림, 50ml) — 광고 매출 변화 -200,000원; 변동 기여도 1,000.5%; 소스 기반 광고 자격 이슈 없음- 순위 3: VID VID_0027 ([본사 직영] 샤이샤이샤이 카페인 샷 비타 씨 버블 세럼, 110ml) — 광고 매출 변화 -100,000원; 변동 기여도 820.3%; 소스 기반 광고 자격 이슈 없음Section 7B 광고 자격 검토:- VID VID_0020: BBL 5h 감지; 최근 2주 광고 매출 위험 20,000원 — 바이박스 경쟁력 검토 필요- VID VID_0026 ([본사 직영] 샤이샤이샤이 알로에 PDRN 쿨링 리페어 크림, 50ml): OOS 3h 감지; 최근 2주 광고 매출 위험 2,000원 — 재고 보충 필요"],["광고 매출 하락/상승 진단 요약","광고주 광고 매출이 이전 주 대비 이후 주 800,000원 (-14.0%) 감소하였습니다. Section 3a의 4개 캠페인이 이 감소를 주도하였습니다:- 260921_매출최적화_자동_리포좀 리페어 밀키 크림 (CAMP_038): -200,000원 기여. 노출수가 36.8% 감소 — 동일 기간 카테고리 감소폭 12.1%의 약 3배 수준. 노출 감소분의 약 33%는 시장 흐름에 따른 것이며, 나머지 약 67%는 캠페인 고유 요인입니다. 광고비 효율 개선으로 광고수익률 달성률이 79.6%에서 92.0%로 상승하였으나, 노출 감소가 광고 매출 하락을 이끌었습니다. 광고 자격 이슈 없음.- 260805_매출성장_수동_태닝오일_메인키워드 (CAMP_023): -50,000원 기여. W2에서 캠페인이 완전히 중단됨 (노출수 0, 광고비 0, 광고 매출 0). 단일 상품 (VIID 95665206796)의 W2 활동 없음. 심층 진단을 위한 데이터 부족 (30일 내 광고 적격 주문 21건; W1 광고 매출 50,000원).- 260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드 (CAMP_031): -10,000원 기여. 전환율이 45.4% 하락 (2.75% → 1.50%)하여 광고 매출 및 광고수익률 하락의 주요 원인이 되었습니다. 노출수는 비교적 안정적이었습니다 (-3.9%). 심층 진단을 위한 데이터 부족.- 260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드 (CAMP_037): -10,000원 기여. 노출수가 94.3% 급감 (8,000 → 468)하였으며, W2 광고 매출은 0으로 떨어졌습니다. W2 전환율도 0%로 하락하였습니다. 심층 진단을 위한 데이터 부족."],["광고 매출 성장을 위한 핵심 인사이트 및 조치 요약","Section 4 — 조치가 필요한 예산 소진 캠페인: 이 기간 내 예산 소진 시간이 0을 초과하는 PA-MPS 캠페인이 확인되지 않았습니다. Section 4 조치 사항 없음.Section 5 — 예산 활용률이 낮은 캠페인:- 260921_매출최적화_자동_리포좀 리페어 밀키 크림 (CAMP_038): 일예산 500,000원, 활용률 17.9%; 소스 기반 판매자 조치 가능 추천 없음 — 모니터링 대상- 260921_매출최적화_자동_바나나 컨실 아이크림 (CAMP_039): 일예산 500,000원, 활용률 17.4%; 소스 기반 판매자 조치 가능 추천 없음 — 모니터링 대상"]]},{"section":"섹션 3A — 벤더 광고 매출 변동을 주도한 주요 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","이전 광고 매출","이후 광고 매출","광고 매출 증감","기여도","광고비","광고수익률","목표 광고수익률","광고수익률 달성률"],"rows":[["260921_매출최적화_자동_리포좀 리페어 밀키 크림","CAMP_038","MPS","1,000,000원","1,000,000원","-200,000원","1,000.8%","1,000,000원","212%","250%","84.8%"],["260805_매출성장_수동_태닝오일_메인키워드","CAMP_023","Manual","50,000원","0원","-50,000원","303.2%","20,000원","208%","—","—"],["260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드","CAMP_031","Manual","50,000원","30,000원","-10,000원","86.3%","40,000원","199%","—","—"],["260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드","CAMP_037","Manual","10,000원","0원","-10,000원","63.8%","30,000원","32%","—","—"]]},{"section":"섹션 3B — 섹션 3a 캠페인 진단 및 추천 사항","columns":["#","캠페인 ID","캠페인명","진단","추천"],"rows":[["1","CAMP_038","260921_매출최적화_자동_리포좀 리페어 밀키 크림","광고 매출 감소 원인: 광고 매출이 15.3% 감소(-200,000원)하였습니다. 퍼널 분해 분석 결과, 광고 노출수가 36.8% 급감(600,000 → 400,000)하여 주요 원인으로 확인되었으며, 이는 동일 기간 카테고리 평균 노출수 감소율 12.1%보다 약 3배 가파른 수치입니다. 노출수 감소분의 약 33%는 시장 전반의 위축에 기인하며, 나머지 약 67%는 캠페인 고유 요인으로 카테고리 추세로는 설명되지 않습니다. 클릭률(+12.1%)과 전환율(+23.0%)은 모두 개선되어 노출수 감소를 일부 상쇄하였으나, 광고 매출 감소를 막기에는 충분하지 않았습니다. 평균 주문금액(AOV)은 비교적 안정적(-2.7%)이었습니다. 주력 상품 VIID VID_0003이 광고 매출 증감분의 93.5%(-200,000원)를 차지하였으며, VIID 95983984638이 나머지 6.5%(-10,000원)를 기여하였습니다. 광고 노출 자격 이슈는 감지되지 않았습니다. 광고수익률 달성률은 노출수 감소와 함께 광고비 효율이 상승하면서 79.6%에서 92.0%로 개선되었습니다.","캠페인 고유 노출수 감소(전체 감소분의 약 67%)는 입찰 경쟁력 또는 경매 역학의 변화 여부를 점검할 필요가 있습니다. 본 캠페인은 MPS 자동 입찰 캠페인으로, 목표 광고수익률(T.ROAS) 설정이 입찰 적극성을 결정하나, 본 분석에서는 목표 광고수익률 조정 추천을 제공하지 않습니다. 노출수 추세를 모니터링하고 카테고리 수준의 감소세가 안정화되는지 확인하시기 바랍니다. 현재 근거 기반의 예산 또는 상품 관련 판매자 조치 사항은 없습니다."],["2","CAMP_023","260805_매출성장_수동_태닝오일_메인키워드","광고 매출 감소 원인: 광고 매출이 100% 감소(-50,000원)하였습니다. W2에서 캠페인이 완전히 중단되어 노출수, 광고비, 광고 매출 모두 0으로 떨어졌습니다. 유일한 상품(VIID 95665206796)은 W1에서 50,000원의 광고 매출을 기록하였으나 W2에서는 0원이었습니다. 심층 진단은 제공되지 않습니다: 해당 캠페인이 최소 기준을 충족하지 못합니다(자동 입찰 필요; 최근 30일 광고 전환 주문수: 21건 vs. 최소 30건; W1 광고 매출: 50,000원 vs. 최소 1,000,000원).","진단 불가 — 캠페인 규모가 심층 분석 최소 기준 미달입니다(최근 30일 광고 전환 주문수 21건; W1 광고 매출 50,000원). 추천 및 근거: 해당 없음."],["3","CAMP_031","260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드","광고 매출 감소 원인: 광고 매출이 33.3% 감소(-10,000원)하였습니다. 노출수는 비교적 안정적(-3.9%)이었으나, 전환율이 45.4% 급락(2.75% → 1.50%)하여 광고 매출 감소 및 광고수익률 하락(258% → 148%)의 주요 원인이 되었습니다. 클릭률은 +26.9% 개선되어 전환율 하락을 일부 상쇄하였습니다. 평균 주문금액(AOV)은 변동이 없었습니다. 유일한 상품(VIID VID_0003)이 광고 매출 증감분의 100%를 차지하였습니다. 심층 진단은 제공되지 않습니다: 해당 캠페인이 최소 기준을 충족하지 못합니다(자동 입찰 필요; 최근 7일 광고 전환 주문수: 3건 vs. 최소 7건; W1 광고 매출: 50,000원 vs. 최소 1,000,000원).","진단 불가 — 캠페인 규모가 심층 분석 최소 기준 미달입니다(최근 7일 광고 전환 주문수 3건; W1 광고 매출 50,000원). 전환율 하락이 핵심 모니터링 지표이며, 잠재적 원인으로는 상품 페이지 품질, 가격 경쟁력, 또는 해당 키워드 세트의 계절적 수요 변화 등이 있으나 근거 기반의 추천 사항은 없습니다. 추천 및 근거: 해당 없음."],["4","CAMP_037","260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드","광고 매출 감소 원인: 광고 매출이 100% 감소(-10,000원)하였습니다. 노출수가 94.3% 급감(8,000 → 468)하고 W2 전환율이 0%로 떨어져 광고 매출이 0원이 되었습니다. 광고비 역시 95.2% 감소하였습니다. 단일 상품(VIID VID_0003)이 변화분의 100%를 차지하였습니다. 심층 진단을 수행할 수 없습니다: 해당 캠페인이 최소 기준을 충족하지 못합니다(자동 입찰 필요; 최근 7일 광고 전환 주문수: 1건, 최소 기준 7건; W1 광고 매출: 10,000원, 최소 기준 1,000,000원).","진단 불가 — 캠페인 볼륨이 심층 분석 최소 기준 미달(최근 7일 광고 전환 주문수: 1건; W1 광고 매출 10,000원). W2에서 노출수가 거의 전량 소실된 것이 주요 신호이며, 연관 키워드의 입찰가 경쟁력 또는 경매 수준의 변화를 반영할 수 있으나, 근거 기반 추천을 제공할 수 없습니다. 추천 및 근거: 해당 없음."]]},{"section":"섹션 5 — 예산 사용률이 낮은 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","광고 매출","광고비","광고수익률","현재 일예산","최근 7일 예산 활용률","추천 가능 여부"],"rows":[["260921_매출최적화_자동_리포좀 리페어 밀키 크림","CAMP_038","MPS","3,000,000원","1,000,000원","212%","500,000원","17.9%","—"],["260921_매출최적화_자동_바나나 컨실 아이크림","CAMP_039","MPS","2,000,000원","1,000,000원","232%","500,000원","17.4%","—"]]},{"section":"섹션 7A — 벤더 광고 매출 또는 ROAS 하락에 기여한 주요 VID","columns":["순위","VID","VID 옵션","연결된 매출 성장(PA) 캠페인","