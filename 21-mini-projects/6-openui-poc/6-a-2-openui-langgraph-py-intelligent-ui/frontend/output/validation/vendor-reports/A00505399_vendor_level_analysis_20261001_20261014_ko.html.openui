kpis = Grid(@Each(metrics, "m", Card([Caption(m.label), Title(m.w2, "md"), Row([Badge("W1 " + m.w1), Badge("기재 변화 " + m.delta, "info")], 1, null, null, true)])), 3, 175, 3)
moneyChart = Card([Title("기간별 광고 매출 · 광고비", "md"), Chart("bar", periods, "기간", ["광고매출", "광고비"], "currency", "KRW"), Caption("섹션 1의 기간별 원문 값 · 일별 추이 아님")])
efficiencyChart = Card([Title("광고수익률 비교", "md"), Chart("bar", ratios, "기간", ["광고수익률"], "percent"), Caption("섹션 1 · 단위 %")])
conversionChart = Card([Title("전환율 비교", "md"), Chart("bar", ratios, "기간", ["전환율"], "percent"), Caption("섹션 1 · ROAS와 별도 축으로 비교")])
overview = Col([Title("성과 개요", "lg"), Text("주요 지표를 비교하고, 캠페인 진단과 재고 위험을 탐색한 뒤 실행할 조치를 확인하세요.", "sm", "muted"), kpis, moneyChart, Grid([efficiencyChart, conversionChart], 2, 280, 4), stockChart, aiInsights])
visible = $campaign == "전체" ? campaigns : @Filter(campaigns, "id", "==", $campaign)
visibleTargets = $campaign == "전체" ? knownTargetCampaigns : @Filter(knownTargetCampaigns, "id", "==", $campaign)
campaignOptions = @Concat([{value: "전체", label: "전체 캠페인"}], @Each(campaigns, "c", {value: c.id, label: c.name + " · " + c.id}))
campaignView = Col([Title("캠페인 탐색", "lg"), Select($campaign, campaignOptions, "캠페인 선택"), Grid([Card([Title("광고 매출", "md"), Chart("bar", @Each(visible, "c", {"캠페인": c.name, "광고매출": c.revenue}), "캠페인", ["광고매출"], "currency", "KRW"), Caption("섹션 3A · 이후 매출")]), Card([Title("캠페인 ROAS", "md"), Chart("bar", @Each(visible, "c", {"캠페인": c.name, "광고수익률": c.roas}), "캠페인", ["광고수익률"], "percent"), Caption("섹션 3A의 원문 값 · 다른 섹션 수치와 혼합하지 않음")])], 2, 280, 4), @Count(visibleTargets) > 0 ? Card([Title("목표 대비 ROAS", "md"), Chart("bar", @Each(visibleTargets, "c", {"캠페인": c.name, "광고수익률": c.roas, "목표": c.target}), "캠페인", ["광고수익률", "목표"], "percent"), Caption("목표가 수치로 제공된 캠페인만 표시 · 미기재 목표는 0으로 보정하지 않음")]) : Text("선택 캠페인의 목표 ROAS 수치가 없습니다.", "sm", "muted"), Col(@Each(visible, "c", Card([Row([Title(c.name, "md"), Badge(c.id, "info")], 2), Text(c.diagnosis, "sm"), Popover("추천 조치와 근거", [Text(c.action, "sm"), Caption("섹션 3B 원문")])])))])
filteredRisks = @Filter(knownHourRisks, "hours", ">=", $minHours)
filteredAmounts = @Filter(knownAmountRisks, "hours", ">=", $minHours)
stockChart = Card([Title("VID별 광고 적격성 제약 시간", "md"), @Count(knownHourRisks) > 0 ? Chart("bar", @Each(knownHourRisks, "r", {VID: r.id, "제약시간": r.hours}), "VID", ["제약시간"]) : Text("수치로 제공된 제약 시간이 없습니다. 원문 근거에서 상태를 확인하세요.", "sm", "muted"), Caption("섹션 7B · 원문 이슈 시간 · 품절/노출 제한 등 유형을 구분하며 중복 시간은 합산하지 않음")])
inventoryView = Col([Title("재고 위험 탐색", "lg"), Slider($minHours, 0, 6, 1, "최소 제약 시간", "시간"), Caption(@Count(filteredRisks) + "개 VID 표시"), Card([Title("광고 적격성 제약 시간", "md"), @Count(filteredRisks) > 0 ? Chart("bar", @Each(filteredRisks, "r", {VID: r.id, "제약시간": r.hours}), "VID", ["제약시간"]) : Text("표시할 제약 시간 데이터가 없습니다.", "sm", "muted"), Caption("섹션 7B · 단위: 시간")]), Card([Title("매출 위험 추정액", "md"), @Count(filteredAmounts) > 0 ? Chart("bar", @Each(filteredAmounts, "r", {VID: r.id, "위험추정액": r.amount}), "VID", ["위험추정액"], "currency", "KRW") : Text("수치로 제공된 매출 위험 추정액이 없습니다.", "sm", "muted"), Caption("섹션 7B의 추정 위험액 · 확정 손실이 아니며 중복 위험을 합산하지 않음")]), Grid(@Each(filteredRisks, "r", Card([Title(r.id, "md"), Text(r.name, "sm"), Badge(r.issue, "warning"), Text(r.summary, "sm")])), 2, 260, 3), Popover("재고 원문 전체", [Table(["VID", "시간 원문 여부", "근거"], @Each(risks, "r", [r.id, r.hours == null ? "확인 불가" : r.hours + "시간", r.summary]))])])
actionView = Col([Title("실행 체크리스트", "lg"), Text("원문 권고와 실행 가능 여부를 함께 확인하세요. 체크는 개인 진행 상태이며 실제 예산이나 재고를 변경하지 않습니다.", "sm", "muted"), Caption(@Count($done) + " / " + @Count(actions) + " 완료"), Col(@Each(actions, "a", Pressable([Row([Icon(@Includes($done, a.id) ? "check-circle" : "circle", "sm"), Title(a.title, "md")], 2), Text(a.evidence, "sm"), Badge("원문 예상 효과: " + a.impact, "info")], @Set($done, @Toggle($done, a.id)), @Includes($done, a.id), 4))), Button("조치 요약 복사", @CopyToClipboard(@Join(@Each(actions, "a", a.title + " · " + a.evidence), "\n")), "outline", null, "sm", "copy")])
evidenceOptions = @Concat([{value: "전체", label: "전체 섹션"}], @Each(evidence, "e", {value: e.section, label: e.section}))
visibleEvidence = $evidence == "전체" ? evidence : @Filter(evidence, "section", "==", $evidence)
evidenceView = Col([Title("원문 근거", "lg"), Select($evidence, evidenceOptions, "근거 섹션 선택"), Col(@Each(visibleEvidence, "e", Col([Title(e.section, "md"), Table(e.columns, e.rows)]))), Popover("전체 원문 보기", [Markdown("다음은 공급업체4 (V_공급업체4)의 완전한 V1 광고주 수준 분석으로, 2026년 10월 1일~14일을 다룹니다.\n\n## 1페이지 — 주요 지표 및 경영진 요약\n\n### 섹션 1 — 벤더 핵심 / 주요 지표\n\n분석 기간: 2026년 10월 1일 ~ 10월 14일 | 전주 대비 구간: 이전 주 10.01–10.07 / 이후 주 10.08–10.14\n\n| 지표 | 이전 주 | 이후 주 | 변화 |\n| --- | --- | --- | --- |\n| 광고 매출 | 6,000,000원 | 5,000,000원 | -800,000원 (-14.0%) |\n| 광고수익률 | 229% | 248% | +18%p (+8.0%) |\n| 광고비 | 2,000,000원 | 2,000,000원 | -500,000원 (-20.4%) |\n| 노출수 | 2,000,000 | 1,000,000 | -200,000 (-13.1%) |\n| 클릭률 | 0.3% | 0.3% | -0%p (-3.4%) |\n| 전환율 | 4.3% | 4.9% | +1%p (+15.4%) |\n| 평균 주문 금액 | 20,000원 | 10,000원 | -2,000원 (-11.3%) |\n| 캠페인 수 | 6 | 3 | -3 |\n| 예산 소진 캠페인 | 0 | 0 | 0 |\n\n요약: 광고주 광고 매출이 800,000원 (-14.0%) 감소하였으며, 광고비는 -500,000원 (-20.4%) 변동하였습니다.\n\n### 섹션 2 — 경영진 요약\n\n| 요약 영역 | 요약 |\n| --- | --- |\n| 주요 VID 변동 및 광고 적격성 요약 | VID 광고 매출 감소 주요 요인 (Section 7A):- 순위 1: VID VID_0020 ([본사 직영] 샤이샤이샤이 리페어 밀키 우레아 글로우 화잘먹 버블 세럼, 110ml) — 광고 매출 변화 -300,000원; 변동 기여도 1,000.2%; 광고 자격 이슈: BBL 5h 감지- 순위 2: VID VID_0003 (샤이샤이샤이 리포좀 리페어 밀키 크림, 50ml) — 광고 매출 변화 -200,000원; 변동 기여도 1,000.5%; 소스 기반 광고 자격 이슈 없음- 순위 3: VID VID_0027 ([본사 직영] 샤이샤이샤이 카페인 샷 비타 씨 버블 세럼, 110ml) — 광고 매출 변화 -100,000원; 변동 기여도 820.3%; 소스 기반 광고 자격 이슈 없음Section 7B 광고 자격 검토:- VID VID_0020: BBL 5h 감지; 최근 2주 광고 매출 위험 20,000원 — 바이박스 경쟁력 검토 필요- VID VID_0026 ([본사 직영] 샤이샤이샤이 알로에 PDRN 쿨링 리페어 크림, 50ml): OOS 3h 감지; 최근 2주 광고 매출 위험 2,000원 — 재고 보충 필요 |\n| 광고 매출 하락/상승 진단 요약 | 광고주 광고 매출이 이전 주 대비 이후 주 800,000원 (-14.0%) 감소하였습니다. Section 3a의 4개 캠페인이 이 감소를 주도하였습니다:- 260921_매출최적화_자동_리포좀 리페어 밀키 크림 (CAMP_038): -200,000원 기여. 노출수가 36.8% 감소 — 동일 기간 카테고리 감소폭 12.1%의 약 3배 수준. 노출 감소분의 약 33%는 시장 흐름에 따른 것이며, 나머지 약 67%는 캠페인 고유 요인입니다. 광고비 효율 개선으로 광고수익률 달성률이 79.6%에서 92.0%로 상승하였으나, 노출 감소가 광고 매출 하락을 이끌었습니다. 광고 자격 이슈 없음.- 260805_매출성장_수동_태닝오일_메인키워드 (CAMP_023): -50,000원 기여. W2에서 캠페인이 완전히 중단됨 (노출수 0, 광고비 0, 광고 매출 0). 단일 상품 (VIID 95665206796)의 W2 활동 없음. 심층 진단을 위한 데이터 부족 (30일 내 광고 적격 주문 21건; W1 광고 매출 50,000원).- 260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드 (CAMP_031): -10,000원 기여. 전환율이 45.4% 하락 (2.75% → 1.50%)하여 광고 매출 및 광고수익률 하락의 주요 원인이 되었습니다. 노출수는 비교적 안정적이었습니다 (-3.9%). 심층 진단을 위한 데이터 부족.- 260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드 (CAMP_037): -10,000원 기여. 노출수가 94.3% 급감 (8,000 → 468)하였으며, W2 광고 매출은 0으로 떨어졌습니다. W2 전환율도 0%로 하락하였습니다. 심층 진단을 위한 데이터 부족. |\n| 광고 매출 성장을 위한 핵심 인사이트 및 조치 요약 | Section 4 — 조치가 필요한 예산 소진 캠페인: 이 기간 내 예산 소진 시간이 0을 초과하는 PA-MPS 캠페인이 확인되지 않았습니다. Section 4 조치 사항 없음.Section 5 — 예산 활용률이 낮은 캠페인:- 260921_매출최적화_자동_리포좀 리페어 밀키 크림 (CAMP_038): 일예산 500,000원, 활용률 17.9%; 소스 기반 판매자 조치 가능 추천 없음 — 모니터링 대상- 260921_매출최적화_자동_바나나 컨실 아이크림 (CAMP_039): 일예산 500,000원, 활용률 17.4%; 소스 기반 판매자 조치 가능 추천 없음 — 모니터링 대상 |\n\n## 2페이지 — 주요 지표 변동 진단 (광고 매출 하락 또는 상승)\n\n### 섹션 3A — 벤더 광고 매출 변동을 주도한 주요 캠페인\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 이전 광고 매출 | 이후 광고 매출 | 광고 매출 증감 | 기여도 | 광고비 | 광고수익률 | 목표 광고수익률 | 광고수익률 달성률 |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| 260921_매출최적화_자동_리포좀 리페어 밀키 크림 | CAMP_038 | MPS | 1,000,000원 | 1,000,000원 | -200,000원 | 1,000.8% | 1,000,000원 | 212% | 250% | 84.8% |\n| 260805_매출성장_수동_태닝오일_메인키워드 | CAMP_023 | Manual | 50,000원 | 0원 | -50,000원 | 303.2% | 20,000원 | 208% | — | — |\n| 260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드 | CAMP_031 | Manual | 50,000원 | 30,000원 | -10,000원 | 86.3% | 40,000원 | 199% | — | — |\n| 260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드 | CAMP_037 | Manual | 10,000원 | 0원 | -10,000원 | 63.8% | 30,000원 | 32% | — | — |\n\n### 섹션 3B — 섹션 3a 캠페인 진단 및 추천 사항\n\n| # | 캠페인 ID | 캠페인명 | 진단 | 추천 |\n| --- | --- | --- | --- | --- |\n| 1 | CAMP_038 | 260921_매출최적화_자동_리포좀 리페어 밀키 크림 | 광고 매출 감소 원인: 광고 매출이 15.3% 감소(-200,000원)하였습니다. 퍼널 분해 분석 결과, 광고 노출수가 36.8% 급감(600,000 → 400,000)하여 주요 원인으로 확인되었으며, 이는 동일 기간 카테고리 평균 노출수 감소율 12.1%보다 약 3배 가파른 수치입니다. 노출수 감소분의 약 33%는 시장 전반의 위축에 기인하며, 나머지 약 67%는 캠페인 고유 요인으로 카테고리 추세로는 설명되지 않습니다. 클릭률(+12.1%)과 전환율(+23.0%)은 모두 개선되어 노출수 감소를 일부 상쇄하였으나, 광고 매출 감소를 막기에는 충분하지 않았습니다. 평균 주문금액(AOV)은 비교적 안정적(-2.7%)이었습니다. 주력 상품 VIID VID_0003이 광고 매출 증감분의 93.5%(-200,000원)를 차지하였으며, VIID 95983984638이 나머지 6.5%(-10,000원)를 기여하였습니다. 광고 노출 자격 이슈는 감지되지 않았습니다. 광고수익률 달성률은 노출수 감소와 함께 광고비 효율이 상승하면서 79.6%에서 92.0%로 개선되었습니다. | 캠페인 고유 노출수 감소(전체 감소분의 약 67%)는 입찰 경쟁력 또는 경매 역학의 변화 여부를 점검할 필요가 있습니다. 본 캠페인은 MPS 자동 입찰 캠페인으로, 목표 광고수익률(T.ROAS) 설정이 입찰 적극성을 결정하나, 본 분석에서는 목표 광고수익률 조정 추천을 제공하지 않습니다. 노출수 추세를 모니터링하고 카테고리 수준의 감소세가 안정화되는지 확인하시기 바랍니다. 현재 근거 기반의 예산 또는 상품 관련 판매자 조치 사항은 없습니다. |\n| 2 | CAMP_023 | 260805_매출성장_수동_태닝오일_메인키워드 | 광고 매출 감소 원인: 광고 매출이 100% 감소(-50,000원)하였습니다. W2에서 캠페인이 완전히 중단되어 노출수, 광고비, 광고 매출 모두 0으로 떨어졌습니다. 유일한 상품(VIID 95665206796)은 W1에서 50,000원의 광고 매출을 기록하였으나 W2에서는 0원이었습니다. 심층 진단은 제공되지 않습니다: 해당 캠페인이 최소 기준을 충족하지 못합니다(자동 입찰 필요; 최근 30일 광고 전환 주문수: 21건 vs. 최소 30건; W1 광고 매출: 50,000원 vs. 최소 1,000,000원). | 진단 불가 — 캠페인 규모가 심층 분석 최소 기준 미달입니다(최근 30일 광고 전환 주문수 21건; W1 광고 매출 50,000원). 추천 및 근거: 해당 없음. |\n| 3 | CAMP_031 | 260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드 | 광고 매출 감소 원인: 광고 매출이 33.3% 감소(-10,000원)하였습니다. 노출수는 비교적 안정적(-3.9%)이었으나, 전환율이 45.4% 급락(2.75% → 1.50%)하여 광고 매출 감소 및 광고수익률 하락(258% → 148%)의 주요 원인이 되었습니다. 클릭률은 +26.9% 개선되어 전환율 하락을 일부 상쇄하였습니다. 평균 주문금액(AOV)은 변동이 없었습니다. 유일한 상품(VIID VID_0003)이 광고 매출 증감분의 100%를 차지하였습니다. 심층 진단은 제공되지 않습니다: 해당 캠페인이 최소 기준을 충족하지 못합니다(자동 입찰 필요; 최근 7일 광고 전환 주문수: 3건 vs. 최소 7건; W1 광고 매출: 50,000원 vs. 최소 1,000,000원). | 진단 불가 — 캠페인 규모가 심층 분석 최소 기준 미달입니다(최근 7일 광고 전환 주문수 3건; W1 광고 매출 50,000원). 전환율 하락이 핵심 모니터링 지표이며, 잠재적 원인으로는 상품 페이지 품질, 가격 경쟁력, 또는 해당 키워드 세트의 계절적 수요 변화 등이 있으나 근거 기반의 추천 사항은 없습니다. 추천 및 근거: 해당 없음. |\n| 4 | CAMP_037 | 260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드 | 광고 매출 감소 원인: 광고 매출이 100% 감소(-10,000원)하였습니다. 노출수가 94.3% 급감(8,000 → 468)하고 W2 전환율이 0%로 떨어져 광고 매출이 0원이 되었습니다. 광고비 역시 95.2% 감소하였습니다. 단일 상품(VIID VID_0003)이 변화분의 100%를 차지하였습니다. 심층 진단을 수행할 수 없습니다: 해당 캠페인이 최소 기준을 충족하지 못합니다(자동 입찰 필요; 최근 7일 광고 전환 주문수: 1건, 최소 기준 7건; W1 광고 매출: 10,000원, 최소 기준 1,000,000원). | 진단 불가 — 캠페인 볼륨이 심층 분석 최소 기준 미달(최근 7일 광고 전환 주문수: 1건; W1 광고 매출 10,000원). W2에서 노출수가 거의 전량 소실된 것이 주요 신호이며, 연관 키워드의 입찰가 경쟁력 또는 경매 수준의 변화를 반영할 수 있으나, 근거 기반 추천을 제공할 수 없습니다. 추천 및 근거: 해당 없음. |\n\n## 3페이지 — 광고 매출 극대화 방안 — 핵심 인사이트 및 추천 조치 요약\n\n### 섹션 4 — OOB 시간이 있는 캠페인\n\n이 광고주의 사전·사후 기간 모두에서 총 예산 소진(OOB) 시간이 0을 초과하는 매출 성장(PA-MPS) 캠페인이 확인되지 않았습니다. 섹션 4에 표시할 행이 없습니다.\n\n### 섹션 5 — 예산 사용률이 낮은 캠페인\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 광고 매출 | 광고비 | 광고수익률 | 현재 일예산 | 최근 7일 예산 활용률 | 추천 가능 여부 |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| 260921_매출최적화_자동_리포좀 리페어 밀키 크림 | CAMP_038 | MPS | 3,000,000원 | 1,000,000원 | 212% | 500,000원 | 17.9% | — |\n| 260921_매출최적화_자동_바나나 컨실 아이크림 | CAMP_039 | MPS | 2,000,000원 | 1,000,000원 | 232% | 500,000원 | 17.4% | — |\n\nAE 다음 조치 — 3페이지 요약 (최대 3개 액션):\n\n참고: 이 광고주의 해당 기간에 실행 가능한 예산 추천이 있는 섹션 4 예산 소진(OOB) 캠페인이 존재하지 않습니다. 3페이지의 모든 다음 조치는 섹션 5에서 도출되었습니다.\n\n1. [섹션 5 — 관찰 대상] 260921_매출최적화_자동_리포좀 리페어 밀키 크림 (CAMP_038) — 현재 일예산: 500,000원; 활용률: 17.9%. 근거 기반 상품 또는 목표 광고수익률(T.ROAS) 추천을 제공할 수 없습니다. 낮은 활용률은 캠페인이 일예산 한도에 근접하게 소진되지 않고 있음을 나타내며, 예산이 제약 요인이 아닙니다. 노출수 추세를 모니터링하고(섹션 3b에서 캠페인별 노출수 약 67% 감소 확인), 예산 조치를 검토하기 전에 입찰가 또는 상품 수준의 요인이 게재를 제한하고 있는지 평가하세요.\n\n2. [섹션 5 — 관찰 대상] 260921_매출최적화_자동_바나나 컨실 아이크림 (CAMP_039) — 현재 일예산: 500,000원; 활용률: 17.4%. 근거 기반 상품 또는 목표 광고수익률(T.ROAS) 추천을 제공할 수 없습니다. 낮은 활용률은 마찬가지로 예산이 구속 제약 요인이 아님을 나타냅니다. 현재 시점에서 별도 조치를 추천하지 않으며, 지속적인 모니터링을 권장합니다.\n\n## 4페이지 — 주요 VID 변동 및 광고 적격성 검토\n\n### 섹션 7A — 벤더 광고 매출 또는 ROAS 하락에 기여한 주요 VID\n\n| 순위 | VID | VID 옵션 | 연결된 매출 성장(PA) 캠페인 | 선택된 감소 초점 | W1 광고 매출 | W2 광고 매출 | 광고 매출 변화 | W1 광고수익률 기여도 | W2 광고수익률 기여도 | 감소 기여도 | 변동 기여도 | 자격 상태 / 이슈 | 이슈 근거 / 시간 | 핵심 요약 |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| 1 | VID_0020 | [본사 직영] 샤이샤이샤이 리페어 밀키 우레아 글로우 화잘먹 버블 세럼, 1개, 110ml | 102908904 — 20240624_매출성장_AI스마트_전체_ROAS250_v1.0 (APS) | 광고 매출 감소 | 300,000원 | 0원 | -300,000원 | 13.9% | 0.0% | -300,000원 | 1,000.2% | BBL: 5h | 보고 기간 내 근거 기반 이슈 5시간 확인 | 광고 매출 감소 기여 요인: VID 광고 매출 -300,000원 변동; 자격 맥락: BBL 5h 감지 — 구매 박스 점유 손실 시간이 광고 게재를 억제했을 수 있습니다. |\n| 2 | VID_0003 | 샤이샤이샤이 리포좀 리페어 밀키 크림, 50ml | CAMP_031 — 260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드 (Manual) \\| CAMP_037 — 260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드 (Manual) \\| CAMP_038 — 260921_매출최적화_자동_리포좀 리페어 밀키 크림 (MPS) | 광고 매출 감소 | 1,000,000원 | 1,000,000원 | -200,000원 | 72.2% | 67.4% | -200,000원 | 1,000.5% | 근거 있는 노출 자격 문제 없음 | 보고 기간 내 근거 있는 문제 시간 없음 | 광고 매출 감소 기여 요인: VID 광고 매출 -200,000원 변동; 노출 자격 문제 미감지 — 감소는 노출 수준 또는 입찰 역학에 의해 발생했을 가능성이 높습니다. |\n| 3 | VID_0027 | [본사 직영] 샤이샤이샤이 카페인 샷 비타 씨 버블 세럼, 1개, 110ml | 102908904 — 20240624_매출성장_AI스마트_전체_ROAS250_v1.0 (APS) | 광고 매출 감소 | 100,000원 | 20,000원 | -100,000원 | 7.8% | 1.3% | -100,000원 | 820.3% | 근거 있는 노출 자격 문제 없음 | 보고 기간 내 근거 있는 문제 시간 없음 | 광고 매출 감소 기여 요인: VID 광고 매출 -100,000원 변동; 노출 자격 문제 미감지. |\n| 4 | 95665370250 | 선-키스드 플럼프 립밤, 피치 크러쉬, 4g, 1개 | 102908904 — 20240624_매출성장_AI스마트_전체_ROAS250_v1.0 (APS) | 광고 매출 감소 | 100,000원 | 10,000원 | -100,000원 | 4.7% | 0.5% | -100,000원 | 522.9% | 근거 있는 노출 자격 문제 없음 | 보고 기간 내 근거 있는 문제 시간 없음 | 광고 매출 감소 기여 요인: VID 광고 매출 -100,000원 변동; 노출 자격 문제 미감지. |\n| 5 | 95282029605 | [본사 직영] 샤이샤이샤이 바나나 PDRN 컨실 아이크림 03라떼, 1개, 15g | CAMP_039 — 260921_매출최적화_자동_바나나 컨실 아이크림 (MPS) | 광고 매출 감소 | 300,000원 | 300,000원 | -60,000원 | 15.7% | 14.5% | -60,000원 | 312.4% | 근거 있는 노출 자격 문제 없음 | 보고 기간 내 근거 있는 문제 시간 없음 | 광고 매출 감소 기여 요인: VID 광고 매출 -60,000원 변동; 노출 자격 문제 미감지. |\n\n### 섹션 7B — 광고 적격성 검토가 필요한 주요 벤더 VID\n\n| 순위 | VID | 상품명 | 광고 매출 | 광고 매출 기여도 | 노출 자격 상태 / 문제 | 문제 근거 / 시간 | 연결된 매출 성장 캠페인 | 최근 2주 광고 매출 영향 / 위험 | 최근 2주 광고수익률 영향 / 위험 | 핵심 영향 요약 및 간략 권고 |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| 1 | VID_0020 | [본사 직영] 샤이샤이샤이 리페어 밀키 우레아 글로우 화잘먹 버블 세럼, 1개, 110ml | 1,000,000원 | 5.5% | BBL: 5h | 최근 2주간 5시간의 우선순위 문제 발생 | 102908904 — 20240624_매출성장_AI스마트_전체_ROAS250_v1.0 (APS) | 20,000원 | 광고수익률 영향/위험 정보 없음 | 구매 박스 이탈 시간 감지됨 — 광고를 통해 이 VID를 확장하기 전에 구매 박스 경쟁력(가격, 배송)을 먼저 점검하세요. |\n| 2 | VID_0026 | [본사 직영] 샤이샤이샤이 알로에 PDRN 쿨링 리페어 크림, 1개, 50ml | 500,000원 | 2.5% | OOS: 3h | 최근 2주간 3시간의 우선순위 문제 발생 | 102908904 — 20240624_매출성장_AI스마트_전체_ROAS250_v1.0 (APS) | 2,000원 | 광고수익률 영향/위험 정보 없음 | 품절 시간 감지됨 — 최근 2주간 2,000원으로 추정되는 광고 매출 위험이 지속되지 않도록 재고를 보충하거나 문제를 해결하세요. |\n| 3 | VID_0003 | 샤이샤이샤이 리포좀 리페어 밀키 크림, 50ml | 6,000,000원 | 28.4% | 근거 있는 문제 없음 | 최근 2주간 근거 있는 문제 시간 없음 | 102908904 — 20240624_매출성장_AI스마트_전체_ROAS250_v1.0 (APS) \\| 105199706 — 260811_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드 (Manual) \\| 105199735 — 260811_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드 (Manual) \\| 105199759 — 260811_매출성장_수동_리포좀 리페어 밀키 크림_타사키워드 (Manual) \\| CAMP_031 — 260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드 (Manual) \\| CAMP_037 — 260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드 (Manual) \\| CAMP_038 — 260921_매출최적화_자동_리포좀 리페어 밀키 크림 (MPS) | 영향/위험 정보 없음 | 광고수익률 영향/위험 정보 없음 | 광고 매출 최상위 기여 상품 (기여도 28.4%), 근거 있는 노출 자격 문제 없음 — 성과를 모니터링하고 캠페인 커버리지를 유지하세요. |\n| 4 | 95206223687 | 샤이샤이샤이 바나나 PDRN 컨실 아이크림 크림, 1개, 15g | 2,000,000원 | 12.9% | 근거 있는 문제 없음 | 최근 2주간 근거 있는 문제 시간 없음 | 102908904 — 20240624_매출성장_AI스마트_전체_ROAS250_v1.0 (APS) \\| 105185933 — 260806_매출성장_수동_바나나아이크림_메인키워드 (Manual) \\| 105185947 — 260806_매출성장_수동_바나나아이크림_연관키워드 (Manual) \\| 105185959 — 260806_매출성장_수동_바나나아이크림_타사키워드 (Manual) \\| CAMP_039 — 260921_매출최적화_자동_바나나 컨실 아이크림 (MPS) | 임팩트/리스크 정보 없음 | 광고수익률 임팩트/리스크 정보 없음 | 광고 매출 상위 기여 상품 (점유율 12.9%)으로 근거 있는 노출 자격 문제 없음 — 성과를 모니터링하고 캠페인 커버리지를 유지하세요. |\n| 5 | 86408642852 | [본사 직영] 샤이샤이샤이 파지티브 선 워터리 태닝 크림 SPF22, 180g, 1개 | 1,000,000원 | 5.9% | 근거 있는 문제 없음 | 최근 2주간 근거 있는 문제 시간 없음 | 102908904 — 20240624_매출성장_AI스마트_전체_ROAS250_v1.0 (APS) \\| 105181387 — 260805_매출성장_수동_태닝크림_메인키워드 (Manual) \\| 105181434 — 260805_매출성장_수동_태닝크림_연관키워드 (Manual) \\| 105181480 — 260805_매출성장_수동_태닝크림_타사키워드 (Manual) | 임팩트/리스크 정보 없음 | 광고수익률 임팩트/리스크 정보 없음 | 광고 매출 상위 기여 상품 (점유율 5.9%)으로 근거 있는 노출 자격 문제 없음 — 성과를 모니터링하고 캠페인 커버리지를 유지하세요. |")])])
aiInsights = Col([Title("AI 해설", "lg"), Caption("아래 해석은 모델 생성 · 수치와 차트는 원문 구조에서 추출"), Col([Card([Title("핵심 해석", "md"), Text("주요 광고 매출 감소는 `VID_0020`과 `VID_0003` 상품에서 발생하였으며, `VID_0020`은 BBL 5시간 감지로 인한 구매 박스 점유 손실 가능성이 확인되었습니다. 캠페인 `CAMP_038`은 노출수 급감으로 광고 매출에 큰 영향을 미쳤으며, 광고 수익률은 노출 감소와 광고비 효율 개선의 영향으로 상승했습니다.", "sm"), Caption("출처: `VID_0020`, `VID_0003`, `CAMP_038`, 섹션 1, 3B, 7A")]), Card([Title("우선 확인", "md"), Text("`CAMP_023`, `CAMP_031`, `CAMP_037` 캠페인은 광고 전환 주문수 및 매출 규모가 심층 분석 최소 기준 미달로 진단이 어려우며, 이들 캠페인의 전환율 하락 및 노출 급감은 주의가 필요합니다. `VID_0026` 상품은 최근 3시간 품절 문제가 탐지되어 재고 보충이 필요합니다.", "sm"), Caption("출처: `CAMP_023`, `CAMP_031`, `CAMP_037`, `VID_0026`, 섹션 3B, 7B")]), Card([Title("다음 조치", "md"), Text("예산 소진 시간이 없는 상태에서 `CAMP_038`과 `CAMP_039`의 낮은 예산 활용률이 관찰되었습니다. 입찰가 또는 상품 수준에서 노출 제한 요인 점검과 노출수 추세 모니터링을 권장하며, 별도의 근거 기반 상품 또는 목표 로아스 조정 권고는 없습니다.", "sm"), Caption("출처: 섹션 4, 5, 3B")])])])