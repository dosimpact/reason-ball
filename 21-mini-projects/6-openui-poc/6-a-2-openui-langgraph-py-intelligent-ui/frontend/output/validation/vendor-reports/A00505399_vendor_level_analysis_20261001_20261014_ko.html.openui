heading = Col([Title("공급업체4 · 인터랙티브 보고서", "xl"), Text("2026년 10월 1일~14일", "sm", "muted"), Row([Badge("원문 기반", "info"), Badge("W1 / W2 비교", "purple"), Badge("로컬 필터 · 상태 저장", "success")], 2)])
quality = Card([Row([Title("원문 수치 확인 필요", "md"), Badge("3개 확인 사항", "warning")], 2), Text("광고 매출: 6,000,000원 → 5,000,000원, 원문 변화 -800,000원 (-14.0%). 기간별 값과 변화량 확인 필요.", "sm", "warning"), Popover("확인 사항 전체", [Col(@Each(["광고 매출: 6,000,000원 → 5,000,000원, 원문 변화 -800,000원 (-14.0%). 기간별 값과 변화량 확인 필요.","광고비: 2,000,000원 → 2,000,000원, 원문 변화 -500,000원 (-20.4%). 기간별 값과 변화량 확인 필요.","평균 주문 금액: 20,000원 → 10,000원, 원문 변화 -2,000원 (-11.3%). 기간별 값과 변화량 확인 필요."], "w", Text(w, "sm")), 2)]), Caption("원문 기재 값 유지 · 다른 기간과 단위를 합산하지 않음")], "soft")
metrics = [{"label":"광고 매출","w1":"6,000,000원","w2":"5,000,000원","delta":"-800,000원 (-14.0%)"},{"label":"광고수익률","w1":"229%","w2":"248%","delta":"+18%p (+8.0%)"},{"label":"광고비","w1":"2,000,000원","w2":"2,000,000원","delta":"-500,000원 (-20.4%)"},{"label":"노출수","w1":"2,000,000","w2":"1,000,000","delta":"-200,000 (-13.1%)"},{"label":"클릭률","w1":"0.3%","w2":"0.3%","delta":"-0%p (-3.4%)"},{"label":"전환율","w1":"4.3%","w2":"4.9%","delta":"+1%p (+15.4%)"},{"label":"평균 주문 금액","w1":"20,000원","w2":"10,000원","delta":"-2,000원 (-11.3%)"},{"label":"캠페인 수","w1":"6","w2":"3","delta":"-3"},{"label":"예산 소진 캠페인","w1":"0","w2":"0","delta":"0"}]
periods = [{"기간":"W1","광고매출":6000000,"광고비":2000000},{"기간":"W2","광고매출":5000000,"광고비":2000000}]
ratios = [{"기간":"W1","광고수익률":229,"전환율":4.3},{"기간":"W2","광고수익률":248,"전환율":4.9}]
campaigns = [{"id":"CAMP_038","name":"260921_매출최적화_자동_리포좀 리페어 밀키 크림","revenue":1000000,"roas":212,"target":250,"diagnosis":"광고 매출 감소 원인: 광고 매출이 15.3% 감소(-200,000원)하였습니다. 퍼널 분해 분석 결과, 광고 노출수가 36.8% 급감(600,000 → 400,000)하여 주요 원인으로 확인되었으며, 이는 동일 기간 카테고리 평균 노출수 감소율 12.1%보다 약 3배 가파른 수치입니다. 노출수 감소분의 약 33%는 시장 전반의 위축에 기인하며, 나머지 약 67%는 캠페인 고유 요인으로 카테고리 추세로는 설명되지 않습니다. 클릭률(+12.1%)과 전환율(+23.0%)은 모두 개선되어 노출수 감소를 일부 상쇄하였으나, 광고 매출 감소를 막기에는 충분하지 않았습니다. 평균 주문금액(AOV)은 비교적 안정적(-2.7%)이었습니다. 주력 상품 VIID VID_0003이 광고 매출 증감분의 93.5%(-200,000원)를 차지하였으며, VIID 95983984638이 나머지 6.5%(-10,000원)를 기여하였습니다. 광고 노출 자격 이슈는 감지되지 않았습니다. 광고수익률 달성률은 노출수 감소와 함께 광고비 효율이 상승하면서 79.6%에서 92.0%로 개선되었습니다.","action":"캠페인 고유 노출수 감소(전체 감소분의 약 67%)는 입찰 경쟁력 또는 경매 역학의 변화 여부를 점검할 필요가 있습니다. 본 캠페인은 MPS 자동 입찰 캠페인으로, 목표 광고수익률(T.ROAS) 설정이 입찰 적극성을 결정하나, 본 분석에서는 목표 광고수익률 조정 추천을 제공하지 않습니다. 노출수 추세를 모니터링하고 카테고리 수준의 감소세가 안정화되는지 확인하시기 바랍니다. 현재 근거 기반의 예산 또는 상품 관련 판매자 조치 사항은 없습니다."},{"id":"CAMP_023","name":"260805_매출성장_수동_태닝오일_메인키워드","revenue":0,"roas":208,"target":null,"diagnosis":"광고 매출 감소 원인: 광고 매출이 100% 감소(-50,000원)하였습니다. W2에서 캠페인이 완전히 중단되어 노출수, 광고비, 광고 매출 모두 0으로 떨어졌습니다. 유일한 상품(VIID 95665206796)은 W1에서 50,000원의 광고 매출을 기록하였으나 W2에서는 0원이었습니다. 심층 진단은 제공되지 않습니다: 해당 캠페인이 최소 기준을 충족하지 못합니다(자동 입찰 필요; 최근 30일 광고 전환 주문수: 21건 vs. 최소 30건; W1 광고 매출: 50,000원 vs. 최소 1,000,000원).","action":"진단 불가 — 캠페인 규모가 심층 분석 최소 기준 미달입니다(최근 30일 광고 전환 주문수 21건; W1 광고 매출 50,000원). 추천 및 근거: 해당 없음."},{"id":"CAMP_031","name":"260908_매출성장_수동_리포좀 리페어 밀키 크림_메인키워드","revenue":30000,"roas":199,"target":null,"diagnosis":"광고 매출 감소 원인: 광고 매출이 33.3% 감소(-10,000원)하였습니다. 노출수는 비교적 안정적(-3.9%)이었으나, 전환율이 45.4% 급락(2.75% → 1.50%)하여 광고 매출 감소 및 광고수익률 하락(258% → 148%)의 주요 원인이 되었습니다. 클릭률은 +26.9% 개선되어 전환율 하락을 일부 상쇄하였습니다. 평균 주문금액(AOV)은 변동이 없었습니다. 유일한 상품(VIID VID_0003)이 광고 매출 증감분의 100%를 차지하였습니다. 심층 진단은 제공되지 않습니다: 해당 캠페인이 최소 기준을 충족하지 못합니다(자동 입찰 필요; 최근 7일 광고 전환 주문수: 3건 vs. 최소 7건; W1 광고 매출: 50,000원 vs. 최소 1,000,000원).","action":"진단 불가 — 캠페인 규모가 심층 분석 최소 기준 미달입니다(최근 7일 광고 전환 주문수 3건; W1 광고 매출 50,000원). 전환율 하락이 핵심 모니터링 지표이며, 잠재적 원인으로는 상품 페이지 품질, 가격 경쟁력, 또는 해당 키워드 세트의 계절적 수요 변화 등이 있으나 근거 기반의 추천 사항은 없습니다. 추천 및 근거: 해당 없음."},{"id":"CAMP_037","name":"260917_매출성장_수동_리포좀 리페어 밀키 크림_연관키워드","revenue":0,"roas":32,"target":null,"diagnosis":"광고 매출 감소 원인: 광고 매출이 100% 감소(-10,000원)하였습니다. 노출수가 94.3% 급감(8,000 → 468)하고 W2 전환율이 0%로 떨어져 광고 매출이 0원이 되었습니다. 광고비 역시 95.2% 감소하였습니다. 단일 상품(VIID VID_0003)이 변화분의 100%를 차지하였습니다. 심층 진단을 수행할 수 없습니다: 해당 캠페인이 최소 기준을 충족하지 못합니다(자동 입찰 필요; 최근 7일 광고 전환 주문수: 1건, 최소 기준 7건; W1 광고 매출: 10,000원, 최소 기준 1,000,000원).","action":"진단 불가 — 캠페인 볼륨이 심층 분석 최소 기준 미달(최근 7일 광고 전환 주문수: 1건; W1 광고 매출 10,000원). W2에서 노출수가 거의 전량 소실된 것이 주요 신호이며, 연관 키워드의 입찰가 경쟁력 또는 경매 수준의 변화를 반영할 수 있으나, 근거 기반 추천을 제공할 수 없습니다. 추천 및 근거: 해당 없음."}]
