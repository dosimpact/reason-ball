kpis = Grid(@Each(metrics, "m", Card([Caption(m.label), Title(m.w2, "md"), Row([Badge("W1 " + m.w1), Badge("기재 변화 " + m.delta, "info")], 1, null, null, true)])), 3, 175, 3)
moneyChart = Card([Title("기간별 광고 매출 · 광고비", "md"), Chart("bar", periods, "기간", ["광고매출", "광고비"], "currency", "KRW"), Caption("섹션 1의 기간별 원문 값 · 일별 추이 아님")])
efficiencyChart = Card([Title("광고수익률 비교", "md"), Chart("bar", ratios, "기간", ["광고수익률"], "percent"), Caption("섹션 1 · 단위 %")])
conversionChart = Card([Title("전환율 비교", "md"), Chart("bar", ratios, "기간", ["전환율"], "percent"), Caption("섹션 1 · ROAS와 별도 축으로 비교")])
overview = Col([Title("성과 개요", "lg"), Text("주요 지표를 비교하고, 캠페인 진단과 재고 위험을 탐색한 뒤 실행할 조치를 확인하세요.", "sm", "muted"), kpis, moneyChart, Grid([efficiencyChart, conversionChart], 2, 280, 4), stockChart, aiInsights])
visible = $campaign == "전체" ? campaigns : @Filter(campaigns, "id", "==", $campaign)
visibleTargets = $campaign == "전체" ? knownTargetCampaigns : @Filter(knownTargetCampaigns, "id", "==", $campaign)
campaignOptions = @Concat([{value: "전체", label: "전체 캠페인"}], @Each(campaigns, "c", {value: c.id, label: c.name + " · " + c.id}))
campaignView = Col([Title("캠페인 탐색", "lg"), Select($campaign, campaignOptions, "캠페인 선택"), Grid([Card([Title("광고 매출", "md"), Chart("bar", @Each(visible, "c", {"캠페인": c.name, "광고매출": c.revenue}), "캠페인", ["광고매출"], "currency", "KRW"), Caption("섹션 3A · 이후 매출")]), Card([Title("캠페인 ROAS", "md"), Chart("bar", @Each(visible, "c", {"캠페인": c.name, "광고수익률": c.roas}), "캠페인", ["광고수익률"], "percent"), Caption("섹션 3A의 원문 값 · 다른 섹션 수치와 혼합하지 않음")])], 2, 280, 4), @Count(visibleTargets) > 0 ? Card([Title("목표 대비 ROAS", "md"), Chart("bar", @Each(visibleTargets, "c", {"캠페인": c.name, "광고수익률": c.roas, "목표": c.target}), "캠페인", ["광고수익률", "목표"], "percent"), Caption("목표가 수치로 제공된 캠페인만 표시 · 미기재 목표는 0으로 보정하지 않음")]) : Text("선택 캠페인의 목표 ROAS 수치가 없습니다.", "sm", "muted"), Col(@Each(visible, "c", Card([Row([Title(c.name, "md"), Badge(c.id, "info")], 2), Text(c.diagnosis, "sm"), Popover("추천 조치와 근거", [Text(c.action, "sm"), Caption("섹션 3B 원문")])])))])
filteredRisks = @Filter(knownHourRisks, "hours", ">=", $minHours)
filteredAmounts = @Filter(knownAmountRisks, "hours", ">=", $minHours)
stockChart = Card([Title("VID별 광고 적격성 제약 시간", "md"), @Count(knownHourRisks) > 0 ? Chart("bar", @Each(knownHourRisks, "r", {VID: r.id, "제약시간": r.hours}), "VID", ["제약시간"]) : Text("수치로 제공된 제약 시간이 없습니다. 원문 근거에서 상태를 확인하세요.", "sm", "muted"), Caption("섹션 7B · 원문 이슈 시간 · 품절/노출 제한 등 유형을 구분하며 중복 시간은 합산하지 않음")])
inventoryView = Col([Title("재고 위험 탐색", "lg"), Slider($minHours, 0, 2, 1, "최소 제약 시간", "시간"), Caption(@Count(filteredRisks) + "개 VID 표시"), Card([Title("광고 적격성 제약 시간", "md"), @Count(filteredRisks) > 0 ? Chart("bar", @Each(filteredRisks, "r", {VID: r.id, "제약시간": r.hours}), "VID", ["제약시간"]) : Text("표시할 제약 시간 데이터가 없습니다.", "sm", "muted"), Caption("섹션 7B · 단위: 시간")]), Card([Title("매출 위험 추정액", "md"), @Count(filteredAmounts) > 0 ? Chart("bar", @Each(filteredAmounts, "r", {VID: r.id, "위험추정액": r.amount}), "VID", ["위험추정액"], "currency", "KRW") : Text("수치로 제공된 매출 위험 추정액이 없습니다.", "sm", "muted"), Caption("섹션 7B의 추정 위험액 · 확정 손실이 아니며 중복 위험을 합산하지 않음")]), Grid(@Each(filteredRisks, "r", Card([Title(r.id, "md"), Text(r.name, "sm"), Badge(r.issue, "warning"), Text(r.summary, "sm")])), 2, 260, 3), Popover("재고 원문 전체", [Table(["VID", "시간 원문 여부", "근거"], @Each(risks, "r", [r.id, r.hours == null ? "확인 불가" : r.hours + "시간", r.summary]))])])
actionView = Col([Title("실행 체크리스트", "lg"), Text("원문 권고와 실행 가능 여부를 함께 확인하세요. 체크는 개인 진행 상태이며 실제 예산이나 재고를 변경하지 않습니다.", "sm", "muted"), Caption(@Count($done) + " / " + @Count(actions) + " 완료"), Col(@Each(actions, "a", Pressable([Row([Icon(@Includes($done, a.id) ? "check-circle" : "circle", "sm"), Title(a.title, "md")], 2), Text(a.evidence, "sm"), Badge("원문 예상 효과: " + a.impact, "info")], @Set($done, @Toggle($done, a.id)), @Includes($done, a.id), 4))), Button("조치 요약 복사", @CopyToClipboard(@Join(@Each(actions, "a", a.title + " · " + a.evidence), "\n")), "outline", null, "sm", "copy")])
evidenceOptions = @Concat([{value: "전체", label: "전체 섹션"}], @Each(evidence, "e", {value: e.section, label: e.section}))
visibleEvidence = $evidence == "전체" ? evidence : @Filter(evidence, "section", "==", $evidence)
evidenceView = Col([Title("원문 근거", "lg"), Select($evidence, evidenceOptions, "근거 섹션 선택"), Col(@Each(visibleEvidence, "e", Col([Title(e.section, "md"), Table(e.columns, e.rows)]))), Popover("전체 원문 보기", [Markdown("다음은 공급업체8 (V_공급업체8)의 전체 V1 광고주 수준 분석 보고서로, 2026년 10월 1일~14일(W1: 10월 1일~7일 / W2: 10월 8일~14일)을 분석 기간으로 합니다.\n\n---\n\n## 1페이지 — 주요 지표 및 경영진 요약\n\n### 섹션 1 — 벤더 핵심 / 주요 지표\n\n| 지표 | 이전 (W1) | 이후 (W2) | 변화 |\n|---|---:|---:|---:|\n| 광고 매출 | 7,000,000원 | 7,000,000원 | +400,000원 (+5.6%) |\n| 광고수익률 | 379% | 339% | -39%p (-10.4%) |\n| 광고비 | 1,000,000원 | 2,000,000원 | +300,000원 (+17.9%) |\n| 광고 노출수 | 2,000,000 | 3,000,000 | +800,000 (+27.3%) |\n| 클릭률 | 0.2% | 0.2% | +0%p (+1.2%) |\n| 전환율 | 11.5% | 9.5% | -2%p (-17.5%) |\n| 평균 주문 금액 | 10,000원 | 10,000원 | -55원 (-0.5%) |\n| 캠페인 수 | 10 | 10 | 0 |\n| 예산 소진 캠페인 수 | 4 | 5 | +1 |\n\n**요약:** 광고주의 광고 매출이 전주 대비 400,000원 (+5.6%) 증가하였으며, 주된 기여 캠페인은 013콩나물국밥육수_260115입니다. 다만, 광고비가 광고 매출 증가율의 3배 이상 속도로 증가하면서 광고수익률은 10.4% 하락하였습니다. 이는 상위 매출이 성장하는 가운데서도 지출 효율이 약화되었음을 나타냅니다. 전환율 하락(-17.5%)이 포트폴리오 전반의 주요 효율 저하 요인으로 작용하였습니다.\n\n---\n\n### 섹션 2 — 경영진 요약\n\n| 요약 영역 | 요약 |\n|---|---|\n| 주요 VID 변동 및 광고 적격성 요약 | **광고수익률 하락 중심** (광고주 광고 매출은 증가했으나 광고수익률 -10.4% 하락):<br>- **#1 광고수익률 하락 요인 — VID VID_0024** (테이스튠 14배 고농축 샤브샤브 육수, 2개×480g), 010샤브육수_251209 (CAMP_011) 캠페인에 매핑: 광고 매출 -200,000원, 광고수익률 기여 변화 -16.6%, 변동 기여도 41.9%; 소스 기반 광고 자격 이슈 없음.<br>- **#2 — VID VID_0037** (테이스튠 프리미엄 저당 계란간장, 1개×470g), 017프리미엄저당계란간장_260813 (CAMP_024) 캠페인에 매핑: 광고 매출 -100,000원, 광고수익률 기여 변화 -13.3%, 변동 기여도 33.6%; 소스 기반 광고 자격 이슈 없음.<br>- **#3 — VID VID_0029** (테이스튠 시그니처 계란간장 소스, 1개×480g), 002RN계란간장_250727 (CAMP_008) 캠페인에 매핑: 광고 매출 -100,000원, 광고수익률 기여 변화 -9.9%, 변동 기여도 24.9%; 소스 기반 광고 자격 이슈 없음.<br>- **광고 자격 검토 최우선 VID — 94464366333** (테이스튠 2스푼 콩나물국밥 육수, 1개×480g): 최근 2주 광고 매출의 19.2% 차지; 소스 기반 광고 자격 이슈 없음; 임팩트/리스크 데이터 확인 불가. |\n| 광고 매출 하락/상승 진단 요약 | **광고주 광고 매출 +400,000원 (+5.6%) 증가.** 증가분은 두 캠페인에 집중되었습니다:<br>- **013콩나물국밥육수_260115 (CAMP_012):** 광고 매출 +1,000,000원 증가 (+70.9%). 기간 중반 예산 증액 이후 노출수가 +357% 급증하였으나 트래픽 품질이 급격히 저하되었습니다 — 검색 클릭률 -60.9% 하락, 비검색 전환율 -33.0% 하락으로 광고수익률이 52.6% 하락(1,000% → 592%)하였습니다. 10월 8일 목표 광고수익률(T.ROAS)이 568%에서 700%로 상향 조정되면서 광고수익률 달성률이 220%에서 85%로 추가 하락하였습니다. 광고 매출 증가는 효율이 아닌 물량 증가에 의한 것입니다.<br>- **005RN냉면육수_260401 (CAMP_007):** 광고 매출 +30,000원 증가 (+14.2%). 10월 8일 목표 광고수익률(T.ROAS)이 371%에서 343%로 하향 조정되어 입찰이 보다 공격적으로 변경되었습니다 — 노출수 +26% 증가, 광고비 +44.9% 급증하였으나, 카테고리 수준의 전반적인 수요 약화(카테고리 전환율 -10.4%) 속에서 전환율이 16.6% 하락하여 광고 매출 상승폭이 제한되었습니다. |\n| 광고 매출 성장을 위한 핵심 인사이트 및 조치 요약 | **예산 조치 (Section 4):**<br>- **013콩나물국밥육수_260115 (CAMP_012):** 일예산 100,000원 → 권장 200,000원; 7일 중 6일 예산 소진 발생(예산 소진 30시간, 예산 소진율 142%) — 예산이 광고 게재의 핵심 제약 요인; 기대 광고 매출 증가분 확인 불가.<br><br>**예산 저활용 조치 (Section 5):**<br>- **005RN냉면육수_260401 (CAMP_007):** 일예산 30,000원, 예산 소진율 53.8%; Sales Engine 상품 추천 이용 가능 (예측 광고 매출 +60,000원).<br>- **004RN비빔면소스_260331 (CAMP_006):** 일예산 30,000원, 예산 소진율 30.7%; 소스 기반 추천 없음 — 모니터링 대상으로만 분류. |\n\n---\n\n## 2페이지 — 주요 지표 변동 진단 (광고 매출 하락 또는 상승)\n\n### 섹션 3A — 벤더 광고 매출 변동을 주도한 주요 캠페인\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 이전 광고 매출 | 이후 광고 매출 | 광고 매출 증감 | 기여도 | 광고비 | 광고수익률 | 목표 광고수익률 | 광고수익률 달성률 |\n|---|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|\n| 013콩나물국밥육수_260115 | CAMP_012 | MPS | 1,000,000원 | 2,000,000원 | +1,000,000원 | 297.3% | 600,000원 | 735% | 700% | 105.0% |\n| 005RN냉면육수_260401 | CAMP_007 | MPS | 200,000원 | 200,000원 | +30,000원 | 7.8% | 100,000원 | 253% | 343% | 73.7% |\n\n---\n\n### 섹션 3B — 섹션 3a 캠페인 진단 및 추천 사항\n\n| # | 캠페인 ID | 캠페인명 | 진단 | 추천 및 근거 |\n|---:|---:|---|---|---|\n| 1 | CAMP_012 | 013콩나물국밥육수_260115 | **광고 매출 급등 원인:** 광고 매출이 +1,000,000원(+70.9%) 상승하였으며, 이는 기간 중반 일예산 증액 이후 노출수가 357% 급증한 것이 거의 전적인 원인입니다. 성장은 물량 중심으로 이루어졌으며, 검색 클릭률은 60.9% 하락(10.08% → 3.94%)하고 비검색 전환율은 33.0% 하락(8.02% → 5.37%)하여, 증가한 노출이 품질이 낮은 트래픽에서 비롯되었음을 확인할 수 있습니다. 클릭당 과금(CPC)은 경매 인플레이션이 아닌 트래픽 구성 변화의 효과로 39.9% 상승하였습니다. 모든 광고 매출은 단일 VID — 94464366333 (테이스튠 2스푼 콩나물국밥 육수)에 귀속됩니다. 적격성 확인: 통과. | **일예산을 100,000원에서 200,000원으로 증액하세요.** W2 7일 중 6일 동안 예산이 소진되었으며(예산 초과 30시간, 예산 소진율 142%), 예산 한도가 광고 게재의 실질적인 제약 조건임이 확인되었습니다. Sales Engine 추천은 데이터에 근거합니다. 참고: 현재 광고수익률(592%)이 목표 광고수익률(700%) 대비 미달 상태이므로, 예산 증액은 현재 효율 수준에서 지출을 확대하는 것이며 광고수익률 미달 문제를 해소하지는 않습니다 — 증액 후 광고수익률 달성 여부를 모니터링하세요. |\n| 2 | CAMP_007 | 005RN냉면육수_260401 | **광고 매출 급등 원인:** 광고 매출이 +30,000원(+14.2%) 상승하였습니다. 10월 8일 목표 광고수익률(T.ROAS)이 371%에서 343%로 낮아지면서 입찰이 완화되어 노출수가 26.0% 증가하고 광고비가 44.9% 급증하였으나, 전환율이 16.6% 하락(7.33% → 6.12%)하면서 광고 매출 상승폭이 제한되었습니다. 전환율 하락은 카테고리 전반의 수요 약세(카테고리 전환율 -10.4%; 경쟁사 전환율 -20.5%)와 일치하며, 이는 캠페인 고유의 문제가 아님을 나타냅니다. 평균 주문 금액(AOV)은 9.2% 상승(10,000원 → 10,000원)하여 전환율 하락의 영향을 일부 상쇄하였습니다. CPC는 15.6% 상승(260원 → 301원)하여 광고수익률 하락의 60.9%에 기여하였습니다. 광고수익률 달성률은 73.7%로 90% 기준에 미달합니다. 적격성 확인: 통과. **1) 광고 매출 급등 원인:** 목표 광고수익률 완화 및 노출수 증가에 따른 물량 중심 성장이나, 카테고리 수요 압박으로 인한 전환율 약세로 일부 상쇄되었습니다. **2) 광고수익률 하락 원인:** 전환율 하락(-16.6%)이 광고수익률 하락의 76.1%를 견인하였으며, CPC 상승(+15.6%)이 60.9%에 기여하였고, 평균 주문 금액 개선이 일부 상쇄(-37.1%)하였습니다. | **이용 가능한 Sales Engine 상품 추천을 적용하세요.** Sales Engine은 광고 매출 300,000원(전주 대비 +60,000원)을 예측합니다. 참고: 기반 분석에서 추천 조치와 전환율 하락 간의 데이터 기반 인과관계는 확인되지 않으며, 전환율 약세는 카테고리 요인에 의한 것으로 보여 추천 조치와 무관하게 지속될 수 있습니다. 적용 후 전환율 및 광고수익률 달성 여부를 모니터링하세요. |\n\n---\n\n## 3페이지 — 광고 매출 극대화 방안 — 핵심 인사이트 및 추천 조치 요약\n\n**AE 다음 조치 (최대 3개, 우선순위 순):**\n\n| 순위 | 출처 | 우선 조치 | 예상 광고 매출 증가 | 근거 |\n|---:|---|---|---:|---|\n| 1 | Section 4 — 예산 소진, 조치 필요 | **013콩나물국밥육수_260115 (CAMP_012) 일예산 증액:** 100,000원 → 200,000원 | — | W2 7일 중 6일 동안 예산이 소진되었습니다(예산 초과 30시간, 예산 소진율 142%). 예산이 실질적인 게재 제약 조건임이 확인되었습니다. Sales Engine 추천은 데이터에 근거합니다. 참고: 현재 광고수익률(592%)이 목표 광고수익률(700%) 대비 미달 상태이므로, 현재 효율 수준에서 지출을 확대하고 증액 후 달성 여부를 모니터링하세요. |\n| 2 | Section 5 — 낮은 예산 소진율, 상품 추천 이용 가능 | **005RN냉면육수_260401 (CAMP_007) Sales Engine 상품 추천 적용:** 현재 일예산 30,000원, 예산 소진율 53.8% | +60,000원 (예측) | Sales Engine은 광고 매출 300,000원(+60,000원)을 예측합니다. 전환율 약세는 카테고리 요인에 의한 것이므로 적용 후 모니터링하세요. |\n| 3 | Section 5 — 낮은 예산 활용도, 관찰 대상 (지원되는 추천 없음) | **004RN비빔면소스_260331 (CAMP_006) 모니터링:** 현재 일예산 30,000원, 활용도 30.7% | — | 데이터 기반 추천을 제공할 수 없습니다. 낮은 활용도는 예산이 제약 요인이 아님을 시사합니다. 광고 매출이 계속 정체된다면 상품 경쟁력 또는 타겟팅을 검토해 보세요. |\n\n---\n\n### 섹션 4 — OOB 시간이 있는 캠페인\n\n> **순위 기준:** 조치가 필요하거나 예산 추천이 가능한 캠페인을 우선 순위에 두고 (기간 후 광고 매출 내림차순), 이후 참고용 OOB 행(조치 불필요 / 추천 없음)을 광고 매출 내림차순으로 나열합니다.\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 광고 매출 | 광고비 | ROAS | T.ROAS | ROAS 달성률 | OOB 시간 | 현재 예산 | 추천 예산 | 예상 GMV 증가분 | AE 조치 / 맥락 |\n|---|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|\n| 013콩나물국밥육수_260115 | CAMP_012 | MPS | 4,000,000원 | 600,000원 | 735% | 700% | 105.0% | 36 | 100,000원 | 200,000원 | — | **조치 필요.** 예산이 노출 제약의 확인된 원인입니다 (7일 중 6일 OOB 발생, 활용도 142%). Sales Engine 예산 추천이 가능하며 데이터 기반으로 뒷받침됩니다 — 예산을 200,000원으로 증액할 것을 추천드려요. 참고: 기간 중 예산이 이미 100,000원으로 인상되었으나 OOB가 지속되어 현재 한도가 여전히 제약임을 확인했습니다. 추가 증액이 필요합니다. |\n\n> *이 기간 동안 해당 광고주에서 추가적인 참고용 OOB 행(OOB > 0, 조치 불필요)은 확인되지 않았습니다.*\n\n---\n\n### 섹션 5 — 예산 사용률이 낮은 캠페인\n\n| 캠페인명 | 캠페인 ID | 캠페인 유형 | 광고 매출 | 광고비 | ROAS | 현재 일예산 | 최근 7일 예산 사용률 | 사용 가능한 추천 |\n|---|---:|---|---:|---:|---:|---:|---:|---|\n| 004RN비빔면소스_260331 | CAMP_006 | MPS | 300,000원 | 100,000원 | 231% | 30,000원 | 30.7% | — |\n| 005RN냉면육수_260401 | CAMP_007 | MPS | 400,000원 | 100,000원 | 253% | 30,000원 | 53.8% | Product recommendation |\n\n---\n\n## 4페이지 — 주요 VID 변동 및 광고 적격성 검토\n\n### 섹션 7A — 벤더 광고 매출 또는 ROAS 하락에 기여한 주요 VID\n\n> *광고주 광고 매출 상승 (+5.6%); 광고수익률(ROAS) -10.4% 하락 (379% → 339%). Section 7A는 광고수익률 하락 원인에 집중합니다.*\n\n| 순위 | VID | VID 옵션명 | 연결된 PA 캠페인 | 선택된 하락 초점 | W1 광고 매출 | W2 광고 매출 | 광고 매출 변화 | W1 ROAS Contribution | W2 ROAS Contribution | Drop Contribution | Movement Contribution | 광고 적격성 상태 / 이슈 | 이슈 근거 / 시간 | 핵심 요약 |\n|---:|---:|---|---|---|---:|---:|---:|---:|---:|---:|---:|---|---|---|\n| 1 | VID_0024 | 테이스튠 14배 고농축 샤브샤브 육수, 2개×480g | CAMP_011 — 010샤브육수_251209 (MPS) | ROAS drop | 600,000원 | 400,000원 | -200,000원 | 35.7% | 19.2% | -16.6% | 41.9% | 데이터 기반 자격 문제 없음 | 보고 기간 내 데이터 기반 문제 시간 없음 | 광고수익률 하락 최대 기여 VID: ROAS 기여도 -16.6% 하락; 광고 매출 -200,000원 감소. 자격 문제 미확인 — 지속적인 부진 여부를 모니터링하세요. |\n| 2 | VID_0037 | 테이스튠 프리미엄 저당 계란간장, 1개×470g | CAMP_02