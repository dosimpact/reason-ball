knownAmountRisks = []
actions = [{"id":"action0","title":"013콩나물국밥육수_260115 (CAMP_012) 일예산 증액: 100,000원 → 200,000원","evidence":"W2 7일 중 6일 동안 예산이 소진되었습니다(예산 초과 30시간, 예산 소진율 142%). 예산이 실질적인 게재 제약 조건임이 확인되었습니다. Sales Engine 추천은 데이터에 근거합니다. 참고: 현재 광고수익률(592%)이 목표 광고수익률(700%) 대비 미달 상태이므로, 현재 효율 수준에서 지출을 확대하고 증액 후 달성 여부를 모니터링하세요.","impact":"—"},{"id":"action1","title":"005RN냉면육수_260401 (CAMP_007) Sales Engine 상품 추천 적용: 현재 일예산 30,000원, 예산 소진율 53.8%","evidence":"Sales Engine은 광고 매출 300,000원(+60,000원)을 예측합니다. 전환율 약세는 카테고리 요인에 의한 것이므로 적용 후 모니터링하세요.","impact":"+60,000원 (예측)"},{"id":"action2","title":"004RN비빔면소스_260331 (CAMP_006) 모니터링: 현재 일예산 30,000원, 활용도 30.7%","evidence":"데이터 기반 추천을 제공할 수 없습니다. 낮은 활용도는 예산이 제약 요인이 아님을 시사합니다. 광고 매출이 계속 정체된다면 상품 경쟁력 또는 타겟팅을 검토해 보세요.","impact":"—"}]
evidence = [{"section":"섹션 1 — 벤더 핵심 / 주요 지표","columns":["지표","이전 (W1)","이후 (W2)","변화"],"rows":[["광고 매출","7,000,000원","7,000,000원","+400,000원 (+5.6%)"],["광고수익률","379%","339%","-39%p (-10.4%)"],["광고비","1,000,000원","2,000,000원","+300,000원 (+17.9%)"],["광고 노출수","2,000,000","3,000,000","+800,000 (+27.3%)"],["클릭률","0.2%","0.2%","+0%p (+1.2%)"],["전환율","11.5%","9.5%","-2%p (-17.5%)"],["평균 주문 금액","10,000원","10,000원","-55원 (-0.5%)"],["캠페인 수","10","10","0"],["예산 소진 캠페인 수","4","5","+1"]]},{"section":"섹션 2 — 경영진 요약","columns":["요약 영역","요약"],"rows":[["주요 VID 변동 및 광고 적격성 요약","광고수익률 하락 중심 (광고주 광고 매출은 증가했으나 광고수익률 -10.4% 하락): · - #1 광고수익률 하락 요인 — VID VID_0024 (테이스튠 14배 고농축 샤브샤브 육수, 2개×480g), 010샤브육수_251209 (CAMP_011) 캠페인에 매핑: 광고 매출 -200,000원, 광고수익률 기여 변화 -16.6%, 변동 기여도 41.9%; 소스 기반 광고 자격 이슈 없음. · - #2 — VID VID_0037 (테이스튠 프리미엄 저당 계란간장, 1개×470g), 017프리미엄저당계란간장_260813 (CAMP_024) 캠페인에 매핑: 광고 매출 -100,000원, 광고수익률 기여 변화 -13.3%, 변동 기여도 33.6%; 소스 기반 광고 자격 이슈 없음. · - #3 — VID VID_0029 (테이스튠 시그니처 계란간장 소스, 1개×480g), 002RN계란간장_250727 (CAMP_008) 캠페인에 매핑: 광고 매출 -100,000원, 광고수익률 기여 변화 -9.9%, 변동 기여도 24.9%; 소스 기반 광고 자격 이슈 없음. · - 광고 자격 검토 최우선 VID — 94464366333 (테이스튠 2스푼 콩나물국밥 육수, 1개×480g): 최근 2주 광고 매출의 19.2% 차지; 소스 기반 광고 자격 이슈 없음; 임팩트/리스크 데이터 확인 불가."],["광고 매출 하락/상승 진단 요약","광고주 광고 매출 +400,000원 (+5.6%) 증가. 증가분은 두 캠페인에 집중되었습니다: · - 013콩나물국밥육수_260115 (CAMP_012): 광고 매출 +1,000,000원 증가 (+70.9%). 기간 중반 예산 증액 이후 노출수가 +357% 급증하였으나 트래픽 품질이 급격히 저하되었습니다 — 검색 클릭률 -60.9% 하락, 비검색 전환율 -33.0% 하락으로 광고수익률이 52.6% 하락(1,000% → 592%)하였습니다. 10월 8일 목표 광고수익률(T.ROAS)이 568%에서 700%로 상향 조정되면서 광고수익률 달성률이 220%에서 85%로 추가 하락하였습니다. 광고 매출 증가는 효율이 아닌 물량 증가에 의한 것입니다. · - 005RN냉면육수_260401 (CAMP_007): 광고 매출 +30,000원 증가 (+14.2%). 10월 8일 목표 광고수익률(T.ROAS)이 371%에서 343%로 하향 조정되어 입찰이 보다 공격적으로 변경되었습니다 — 노출수 +26% 증가, 광고비 +44.9% 급증하였으나, 카테고리 수준의 전반적인 수요 약화(카테고리 전환율 -10.4%) 속에서 전환율이 16.6% 하락하여 광고 매출 상승폭이 제한되었습니다."],["광고 매출 성장을 위한 핵심 인사이트 및 조치 요약","예산 조치 (Section 4): · - 013콩나물국밥육수_260115 (CAMP_012): 일예산 100,000원 → 권장 200,000원; 7일 중 6일 예산 소진 발생(예산 소진 30시간, 예산 소진율 142%) — 예산이 광고 게재의 핵심 제약 요인; 기대 광고 매출 증가분 확인 불가. ·  · 예산 저활용 조치 (Section 5): · - 005RN냉면육수_260401 (CAMP_007): 일예산 30,000원, 예산 소진율 53.8%; Sales Engine 상품 추천 이용 가능 (예측 광고 매출 +60,000원). · - 004RN비빔면소스_260331 (CAMP_006): 일예산 30,000원, 예산 소진율 30.7%; 소스 기반 추천 없음 — 모니터링 대상으로만 분류."]]},{"section":"섹션 3A — 벤더 광고 매출 변동을 주도한 주요 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","이전 광고 매출","이후 광고 매출","광고 매출 증감","기여도","광고비","광고수익률","목표 광고수익률","광고수익률 달성률"],"rows":[["013콩나물국밥육수_260115","CAMP_012","MPS","1,000,000원","2,000,000원","+1,000,000원","297.3%","600,000원","735%","700%","105.0%"],["005RN냉면육수_260401","CAMP_007","MPS","200,000원","200,000원","+30,000원","7.8%","100,000원","253%","343%","73.7%"]]},{"section":"섹션 3B — 섹션 3a 캠페인 진단 및 추천 사항","columns":["#","캠페인 ID","캠페인명","진단","추천 및 근거"],"rows":[["1","CAMP_012","013콩나물국밥육수_260115","광고 매출 급등 원인: 광고 매출이 +1,000,000원(+70.9%) 상승하였으며, 이는 기간 중반 일예산 증액 이후 노출수가 357% 급증한 것이 거의 전적인 원인입니다. 성장은 물량 중심으로 이루어졌으며, 검색 클릭률은 60.9% 하락(10.08% → 3.94%)하고 비검색 전환율은 33.0% 하락(8.02% → 5.37%)하여, 증가한 노출이 품질이 낮은 트래픽에서 비롯되었음을 확인할 수 있습니다. 클릭당 과금(CPC)은 경매 인플레이션이 아닌 트래픽 구성 변화의 효과로 39.9% 상승하였습니다. 모든 광고 매출은 단일 VID — 94464366333 (테이스튠 2스푼 콩나물국밥 육수)에 귀속됩니다. 적격성 확인: 통과.","일예산을 100,000원에서 200,000원으로 증액하세요. W2 7일 중 6일 동안 예산이 소진되었으며(예산 초과 30시간, 예산 소진율 142%), 예산 한도가 광고 게재의 실질적인 제약 조건임이 확인되었습니다. Sales Engine 추천은 데이터에 근거합니다. 참고: 현재 광고수익률(592%)이 목표 광고수익률(700%) 대비 미달 상태이므로, 예산 증액은 현재 효율 수준에서 지출을 확대하는 것이며 광고수익률 미달 문제를 해소하지는 않습니다 — 증액 후 광고수익률 달성 여부를 모니터링하세요."],["2","CAMP_007","005RN냉면육수_260401","광고 매출 급등 원인: 광고 매출이 +30,000원(+14.2%) 상승하였습니다. 10월 8일 목표 광고수익률(T.ROAS)이 371%에서 343%로 낮아지면서 입찰이 완화되어 노출수가 26.0% 증가하고 광고비가 44.9% 급증하였으나, 전환율이 16.6% 하락(7.33% → 6.12%)하면서 광고 매출 상승폭이 제한되었습니다. 전환율 하락은 카테고리 전반의 수요 약세(카테고리 전환율 -10.4%; 경쟁사 전환율 -20.5%)와 일치하며, 이는 캠페인 고유의 문제가 아님을 나타냅니다. 평균 주문 금액(AOV)은 9.2% 상승(10,000원 → 10,000원)하여 전환율 하락의 영향을 일부 상쇄하였습니다. CPC는 15.6% 상승(260원 → 301원)하여 광고수익률 하락의 60.9%에 기여하였습니다. 광고수익률 달성률은 73.7%로 90% 기준에 미달합니다. 적격성 확인: 통과. 1) 광고 매출 급등 원인: 목표 광고수익률 완화 및 노출수 증가에 따른 물량 중심 성장이나, 카테고리 수요 압박으로 인한 전환율 약세로 일부 상쇄되었습니다. 2) 광고수익률 하락 원인: 전환율 하락(-16.6%)이 광고수익률 하락의 76.1%를 견인하였으며, CPC 상승(+15.6%)이 60.9%에 기여하였고, 평균 주문 금액 개선이 일부 상쇄(-37.1%)하였습니다.","이용 가능한 Sales Engine 상품 추천을 적용하세요. Sales Engine은 광고 매출 300,000원(전주 대비 +60,000원)을 예측합니다. 참고: 기반 분석에서 추천 조치와 전환율 하락 간의 데이터 기반 인과관계는 확인되지 않으며, 전환율 약세는 카테고리 요인에 의한 것으로 보여 추천 조치와 무관하게 지속될 수 있습니다. 적용 후 전환율 및 광고수익률 달성 여부를 모니터링하세요."]]},{"section":"3페이지 — 광고 매출 극대화 방안 — 핵심 인사이트 및 추천 조치 요약","columns":["순위","출처","우선 조치","예상 광고 매출 증가","근거"],"rows":[["1","Section 4 — 예산 소진, 조치 필요","013콩나물국밥육수_260115 (CAMP_012) 일예산 증액: 100,000원 → 200,000원","—","W2 7일 중 6일 동안 예산이 소진되었습니다(예산 초과 30시간, 예산 소진율 142%). 예산이 실질적인 게재 제약 조건임이 확인되었습니다. Sales Engine 추천은 데이터에 근거합니다. 참고: 현재 광고수익률(592%)이 목표 광고수익률(700%) 대비 미달 상태이므로, 현재 효율 수준에서 지출을 확대하고 증액 후 달성 여부를 모니터링하세요."],["2","Section 5 — 낮은 예산 소진율, 상품 추천 이용 가능","005RN냉면육수_260401 (CAMP_007) Sales Engine 상품 추천 적용: 현재 일예산 30,000원, 예산 소진율 53.8%","+60,000원 (예측)","Sales Engine은 광고 매출 300,000원(+60,000원)을 예측합니다. 전환율 약세는 카테고리 요인에 의한 것이므로 적용 후 모니터링하세요."],["3","Section 5 — 낮은 예산 활용도, 관찰 대상 (지원되는 추천 없음)","004RN비빔면소스_260331 (CAMP_006) 모니터링: 현재 일예산 30,000원, 활용도 30.7%","—","데이터 기반 추천을 제공할 수 없습니다. 낮은 활용도는 예산이 제약 요인이 아님을 시사합니다. 광고 매출이 계속 정체된다면 상품 경쟁력 또는 타겟팅을 검토해 보세요."]]},{"section":"섹션 4 — OOB 시간이 있는 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","광고 매출","광고비","ROAS","T.ROAS","ROAS 달성률","OOB 시간","현재 예산","추천 예산","예상 GMV 증가분","AE 조치 / 맥락"],"rows":[["013콩나물국밥육수_260115","CAMP_012","MPS","4,000,000원","600,000원","735%","700%","105.0%","36","100,000원","200,000원","—","조치 필요. 예산이 노출 제약의 확인된 원인입니다 (7일 중 6일 OOB 발생, 활용도 142%). Sales Engine 예산 추천이 가능하며 데이터 기반으로 뒷받침됩니다 — 예산을 200,000원으로 증액할 것을 추천드려요. 참고: 기간 중 예산이 이미 100,000원으로 인상되었으나 OOB가 지속되어 현재 한도가 여전히 제약임을 확인했습니다. 추가 증액이 필요합니다."]]},{"section":"섹션 5 — 예산 사용률이 낮은 캠페인","columns":["캠페인명","캠페인 ID","캠페인 유형","광고 매출","광고비","ROAS","현재 일예산","최근 7일 예산 사용률","사용 가능한 추천"],"rows":[["004RN비빔면소스_260331","CAMP_006","MPS","300,000원","100,000원","231%","30,000원","30.7%","—"],["005RN냉면육수_260401","CAMP_007","MPS","400,000원","100,000원","253%","30,000원","53.8%","Product recommendation"]]},{"section":"섹션 7A — 벤더 광고 매출 또는 ROAS 하락에 기여한 주요 VID","columns":["순위","VID","VID 옵션명","연결된 PA 캠페인","선택된 하락 초점","W1 광고 매출","W2 광고 매출","광고 매출 변화","W1 ROAS Contribution","W2 ROAS Contribution","Drop Contribution","Movement Contribution","광고 적격성 상태 / 이슈","이슈 근거 / 시간","핵심 요약"],"rows":[["1","VID_0024","테이스튠 14배 고농축 샤브샤브 육수, 2개×480g","CAMP_011 — 010샤브육수_251209 (MPS)","ROAS drop","600,000원","400,000원","-200,000원","35.7%","19.2%","-16.6%","41.9%","데이터 기반 자격 문제 없음","보고 기간 내 데이터 기반 문제 시간 없음","광고수익률 하락 최대 기여 VID: ROAS 기여도 -16.6% 하락; 광고 매출 -200,000원 감소. 자격 문제 미확인 — 지속적인 부진 여부를 모니터링하세요."],["2","VID_0037","테이스튠 프리미엄 저당 계란간장, 1개×470g","CAMP_024 — 017프리미엄저당계란간장_260813 (MPS)","ROAS drop","800,000원","700,000원","-100,000원","46.1%","32.9%","-13.3%","33.6%","데이터 기반 자격 문제 없음","보고 기간 내 데이터 기반 문제 시간 없음","광고수익률 하락 2위 기여 VID: ROAS 기여도 -13.3% 하락; 광고 매출 -100,000원 감소. 자격 문제 미확인 — 모니터링하세요."],["3","VID_0029","테이스튠 시그니처 계란간장 소스, 1개×480g","CAMP_008 — 002RN계란간장_250727 (MPS)","ROAS drop","500,000원","400,000원","-100,000원","29.9%","20.1%","-9.9%","24.9%","데이터 기반 자격 문제 없음","보고 기간 내 데이터 기반 문제 시간 없음","광고수익률 하락 3위 기여 VID: ROAS 기여도 -9.9% 하락; 광고 매출 -100,000원 감소. 자격 문제 미확인 — 모니터링하세요."],["4","95877302452","테이스튠 돼지고기 찍먹 새우젓소스, 1개×340g","104045947 — 007RN찍먹새우젓_260905 (MPS)","광고수익률 하락","900,000원","900,000원","-40,000원","50.0%","40.3%","-9.6%","24.4%","근거 있는 노출 적격성 문제 없음","보고 기간 내 근거 있는 문제 시간 없음","#4 광고수익률 하락 기여 항목: 광고수익률 기여도 -9.6% 감소; 광고 매출 -40,000원 감소. 노출 적격성 문제 미확인 — 모니터링 필요."],["5","94223015743","테이스튠 순한맛 떡볶이소스 분말, 1개×500g","104513132 — 011순한떡볶이분말_251218 (MPS)","광고수익률 하락","300,000원","200,000원","-100,000원","17.9%","9.1%","-8.9%","22.5%","근거 있는 노출 적격성 문제 없음","보고 기간 내 근거 있는 문제 시간 없음","#5 광고수익률 하락 기여 항목: 광고수익률 기여도 -8.9% 감소; 광고 매출 -100,000원 감소. 노출 적격성 문제 미확인 — 모니터링 필요."]]},{"section":"섹션 7B — 광고 적격성 검토가 필요한 주요 벤더 VID","columns":["순위","VID","상품명","광고 매출","광고 매출 기여도","노출 적격성 상태 / 문제","문제 근거 / 시간","연결된 매출 성장 캠페인","최근 2주 광고 매출 영향 / 위험","최근 2주 광고수