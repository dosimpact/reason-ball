heading = Col([Title("공급업체8 (V_공급업체8)의 전체 V1 광고주 수준 분석 보고서 · 인터랙티브 보고서", "xl"), Text("2026년 10월 1일~14일", "sm", "muted"), Row([Badge("원문 기반", "info"), Badge("W1 / W2 비교", "purple"), Badge("로컬 필터 · 상태 저장", "success")], 2)])
quality = Card([Row([Title("원문 수치 확인 필요", "md"), Badge("3개 확인 사항", "warning")], 2), Text("광고 매출: 7,000,000원 → 7,000,000원, 원문 변화 +400,000원 (+5.6%). 기간별 값과 변화량 확인 필요.", "sm", "warning"), Popover("확인 사항 전체", [Col(@Each(["광고 매출: 7,000,000원 → 7,000,000원, 원문 변화 +400,000원 (+5.6%). 기간별 값과 변화량 확인 필요.","광고비: 1,000,000원 → 2,000,000원, 원문 변화 +300,000원 (+17.9%). 기간별 값과 변화량 확인 필요.","평균 주문 금액: 10,000원 → 10,000원, 원문 변화 -55원 (-0.5%). 기간별 값과 변화량 확인 필요."], "w", Text(w, "sm")), 2)]), Caption("원문 기재 값 유지 · 다른 기간과 단위를 합산하지 않음")], "soft")
metrics = [{"label":"광고 매출","w1":"7,000,000원","w2":"7,000,000원","delta":"+400,000원 (+5.6%)"},{"label":"광고수익률","w1":"379%","w2":"339%","delta":"-39%p (-10.4%)"},{"label":"광고비","w1":"1,000,000원","w2":"2,000,000원","delta":"+300,000원 (+17.9%)"},{"label":"광고 노출수","w1":"2,000,000","w2":"3,000,000","delta":"+800,000 (+27.3%)"},{"label":"클릭률","w1":"0.2%","w2":"0.2%","delta":"+0%p (+1.2%)"},{"label":"전환율","w1":"11.5%","w2":"9.5%","delta":"-2%p (-17.5%)"},{"label":"평균 주문 금액","w1":"10,000원","w2":"10,000원","delta":"-55원 (-0.5%)"},{"label":"캠페인 수","w1":"10","w2":"10","delta":"0"},{"label":"예산 소진 캠페인 수","w1":"4","w2":"5","delta":"+1"}]
periods = [{"기간":"W1","광고매출":7000000,"광고비":1000000},{"기간":"W2","광고매출":7000000,"광고비":2000000}]
ratios = [{"기간":"W1","광고수익률":379,"전환율":11.5},{"기간":"W2","광고수익률":339,"전환율":9.5}]
campaigns = [{"id":"CAMP_012","name":"013콩나물국밥육수_260115","revenue":2000000,"roas":735,"target":700,"diagnosis":"광고 매출 급등 원인: 광고 매출이 +1,000,000원(+70.9%) 상승하였으며, 이는 기간 중반 일예산 증액 이후 노출수가 357% 급증한 것이 거의 전적인 원인입니다. 성장은 물량 중심으로 이루어졌으며, 검색 클릭률은 60.9% 하락(10.08% → 3.94%)하고 비검색 전환율은 33.0% 하락(8.02% → 5.37%)하여, 증가한 노출이 품질이 낮은 트래픽에서 비롯되었음을 확인할 수 있습니다. 클릭당 과금(CPC)은 경매 인플레이션이 아닌 트래픽 구성 변화의 효과로 39.9% 상승하였습니다. 모든 광고 매출은 단일 VID — 94464366333 (테이스튠 2스푼 콩나물국밥 육수)에 귀속됩니다. 적격성 확인: 통과.","action":"일예산을 100,000원에서 200,000원으로 증액하세요. W2 7일 중 6일 동안 예산이 소진되었으며(예산 초과 30시간, 예산 소진율 142%), 예산 한도가 광고 게재의 실질적인 제약 조건임이 확인되었습니다. Sales Engine 추천은 데이터에 근거합니다. 참고: 현재 광고수익률(592%)이 목표 광고수익률(700%) 대비 미달 상태이므로, 예산 증액은 현재 효율 수준에서 지출을 확대하는 것이며 광고수익률 미달 문제를 해소하지는 않습니다 — 증액 후 광고수익률 달성 여부를 모니터링하세요."},{"id":"CAMP_007","name":"005RN냉면육수_260401","revenue":200000,"roas":253,"target":343,"diagnosis":"광고 매출 급등 원인: 광고 매출이 +30,000원(+14.2%) 상승하였습니다. 10월 8일 목표 광고수익률(T.ROAS)이 371%에서 343%로 낮아지면서 입찰이 완화되어 노출수가 26.0% 증가하고 광고비가 44.9% 급증하였으나, 전환율이 16.6% 하락(7.33% → 6.12%)하면서 광고 매출 상승폭이 제한되었습니다. 전환율 하락은 카테고리 전반의 수요 약세(카테고리 전환율 -10.4%; 경쟁사 전환율 -20.5%)와 일치하며, 이는 캠페인 고유의 문제가 아님을 나타냅니다. 평균 주문 금액(AOV)은 9.2% 상승(10,000원 → 10,000원)하여 전환율 하락의 영향을 일부 상쇄하였습니다. CPC는 15.6% 상승(260원 → 301원)하여 광고수익률 하락의 60.9%에 기여하였습니다. 광고수익률 달성률은 73.7%로 90% 기준에 미달합니다. 적격성 확인: 통과. 1) 광고 매출 급등 원인: 목표 광고수익률 완화 및 노출수 증가에 따른 물량 중심 성장이나, 카테고리 수요 압박으로 인한 전환율 약세로 일부 상쇄되었습니다. 2) 광고수익률 하락 원인: 전환율 하락(-16.6%)이 광고수익률 하락의 76.1%를 견인하였으며, CPC 상승(+15.6%)이 60.9%에 기여하였고, 평균 주문 금액 개선이 일부 상쇄(-37.1%)하였습니다.","action":"이용 가능한 Sales Engine 상품 추천을 적용하세요. Sales Engine은 광고 매출 300,000원(전주 대비 +60,000원)을 예측합니다. 참고: 기반 분석에서 추천 조치와 전환율 하락 간의 데이터 기반 인과관계는 확인되지 않으며, 전환율 약세는 카테고리 요인에 의한 것으로 보여 추천 조치와 무관하게 지속될 수 있습니다. 적용 후 전환율 및 광고수익률 달성 여부를 모니터링하세요."}]
knownTargetCampaigns = [{"id":"CAMP_012","name":"013콩나물국밥육수_260115","revenue":2000000,"roas":735,"target":700,"diagnosis":"광고 매출 급등 원인: 광고 매출이 +1,000,000원(+70.9%) 상승하였으며, 이는 기간 중반 일예산 증액 이후 노출수가 357% 급증한 것이 거의 전적인 원인입니다. 성장은 물량 중심으로 이루어졌으며, 검색 클릭률은 60.9% 하락(10.08% → 3.94%)하고 비검색 전환율은 33.0% 하락(8.02% → 5.37%)하여, 증가한 노출이 품질이 낮은 트래픽에서 비롯되었음을 확인할 수 있습니다. 클릭당 과금(CPC)은 경매 인플레이션이 아닌 트래픽 구성 변화의 효과로 39.9% 상승하였습니다. 모든 광고 매출은 단일 VID — 94464366333 (테이스튠 2스푼 콩나물국밥 육수)에 귀속됩니다. 적격성 확인: 통과.","action":"일예산을 100,000원에서 200,000원으로 증액하세요. W2 7일 중 6일 동안 예산이 소진되었으며(예산 초과 30시간, 예산 소진율 142%), 예산 한도가 광고 게재의 실질적인 제약 조건임이 확인되었습니다. Sales Engine 추천은 데이터에 근거합니다. 참고: 현재 광고수익률(592%)이 목표 광고수익률(700%) 대비 미달 상태이므로, 예산 증액은 현재 효율 수준에서 지출을 확대하는 것이며 광고수익률 미달 문제를 해소하지는 않습니다 — 증액 후 광고수익률 달성 여부를 모니터링하세요."},{"id":"CAMP_007","name":"005RN냉면육수_260401","revenue":200000,"roas":253,"target":343,"diagnosis":"광고 매출 급등 원인: 광고 매출이 +30,000원(+14.2%) 상승하였습니다. 10월 8일 목표 광고수익률(T.ROAS)이 371%에서 343%로 낮아지면서 입찰이 완화되어 노출수가 26.0% 증가하고 광고비가 44.9% 급증하였으나, 전환율이 16.6% 하락(7.33% → 6.12%)하면서 광고 매출 상승폭이 제한되었습니다. 전환율 하락은 카테고리 전반의 수요 약세(카테고리 전환율 -10.4%; 경쟁사 전환율 -20.5%)와 일치하며, 이는 캠페인 고유의 문제가 아님을 나타냅니다. 평균 주문 금액(AOV)은 9.2% 상승(10,000원 → 10,000원)하여 전환율 하락의 영향을 일부 상쇄하였습니다. CPC는 15.6% 상승(260원 → 301원)하여 광고수익률 하락의 60.9%에 기여하였습니다. 광고수익률 달성률은 73.7%로 90% 기준에 미달합니다. 적격성 확인: 통과. 1) 광고 매출 급등 원인: 목표 광고수익률 완화 및 노출수 증가에 따른 물량 중심 성장이나, 카테고리 수요 압박으로 인한 전환율 약세로 일부 상쇄되었습니다. 2) 광고수익률 하락 원인: 전환율 하락(-16.6%)이 광고수익률 하락의 76.1%를 견인하였으며, CPC 상승(+15.6%)이 60.9%에 기여하였고, 평균 주문 금액 개선이 일부 상쇄(-37.1%)하였습니다.","action":"이용 가능한 Sales Engine 상품 추천을 적용하세요. Sales Engine은 광고 매출 300,000원(전주 대비 +60,000원)을 예측합니다. 참고: 기반 분석에서 추천 조치와 전환율 하락 간의 데이터 기반 인과관계는 확인되지 않으며, 전환율 약세는 카테고리 요인에 의한 것으로 보여 추천 조치와 무관하게 지속될 수 있습니다. 적용 후 전환율 및 광고수익률 달성 여부를 모니터링하세요."}]
risks = [{"id":"94464366333","name":"테이스튠 2스푼 콩나물국밥 육수, 1개×480g","hours":null,"amount":null,"share":19.2,"issue":"근거 있는 문제 없음","summary":"광고 매출 최상위 기여 VID로 근거 있는 노출 적격성 문제 없음. 노출 커버리지를 유지하고 성과를 모니터링하세요 — 이 VID는 Section 3a 광고 매출 급증 캠페인의 단독 핵심 동인입니다."},{"id":"VID_0037","name":"테이스튠 프리미엄 저당 계란간장, 1개×470g","hours":null,"amount":null,"share":13.8,"issue":"근거 있는 문제 없음","summary":"광고 매출 최상위 기여 VID로 근거 있는 노출 적격성 문제 없음. 성과를 모니터링하고 노출 커버리지를 유지하세요."},{"id":"95877302452","name":"테이스튠 돼지고기 찍먹 새우젓소스, 1개×340g","hours":null,"amount":null,"share":13.4,"issue":"근거 있는 문제 없음","summary":"광고 매출 최상위 기여 VID로 근거 있는 노출 적격성 문제 없음. 성과를 모니터링하고 노출 커버리지를 유지하세요."},{"id":"95127707657","name":"테이스튠 간편 수육삶는 농축육수, 1개×510g","hours":null,"amount":null,"share":8.7,"issue":"근거 있는 문제 없음","summary":"광고 매출 최상위 기여 VID로 근거 있는 노출 적격성 문제 없음. 성과를 모니터링하고 노출 커버리지를 유지하세요."},{"id":"VID_0024","name":"테이스튠 14배 고농축 샤브샤브 육수, 2개×480g","hours":null,"amount":null,"share":8.7,"issue":"근거 있는 문제 없음","summary":"광고 매출 최상위 기여 VID이자 Section 7A 광고수익률 하락 1위 동인. 근거 있는 노출 적격성 문제 미확인 — 광고수익률 추이를 모니터링하고 노출 커버리지를 유지하세요."}]
