root = Col([heading, quality, overview, campaignView, inventoryView, actionView, evidenceView])
$campaign = "전체"
$done = []
$minHours = 0
$evidence = "전체"
heading = Col([Title("공급업체6 · 인터랙티브 보고서", "xl"), Text("2026년 10월 1일~14일", "sm", "muted"), Row([Badge("원문 기반", "info"), Badge("W1 / W2 비교", "purple"), Badge("로컬 필터 · 상태 저장", "success")], 2)])
quality = Card([Row([Title("원문 수치 확인 필요", "md"), Badge("3개 확인 사항", "warning")], 2), Text("광고 매출: 40,000,000원 → 40,000,000원, 원문 변화 +3,000,000원 (+8.8%). 기간별 값과 변화량 확인 필요.", "sm", "warning"), Popover("확인 사항 전체", [Col(@Each(["광고 매출: 40,000,000원 → 40,000,000원, 원문 변화 +3,000,000원 (+8.8%). 기간별 값과 변화량 확인 필요.","광고비: 2,000,000원 → 6,000,000원, 원문 변화 +3,000,000원 (+109.1%). 기간별 값과 변화량 확인 필요.","평균 주문 금액: 20,000원 → 20,000원, 원문 변화 +2,000원 (+10.3%). 기간별 값과 변화량 확인 필요."], "w", Text(w, "sm")), 2)]), Caption("원문 기재 값 유지 · 다른 기간과 단위를 합산하지 않음")], "soft")
metrics = [{"label":"광고 매출","w1":"40,000,000원","w2":"40,000,000원","delta":"+3,000,000원 (+8.8%)"},{"label":"광고수익률","w1":"1,000%","w2":"734%","delta":"−676%p (−47.9%)"},{"label":"광고비","w1":"2,000,000원","w2":"6,000,000원","delta":"+3,000,000원 (+109.1%)"},{"label":"광고 노출수","w1":"4,000,000","w2":"9,000,000","delta":"+4,000,000 (+122.8%)"},{"label":"클릭률","w1":"0.5%","w2":"0.5%","delta":"+0%p (+0.3%)"},{"label":"전환율","w1":"10.7%","w2":"4.7%","delta":"−6%p (−55.9%)"},{"label":"평균 주문 금액","w1":"20,000원","w2":"20,000원","delta":"+2,000원 (+10.3%)"},{"label":"캠페인 수","w1":"5","w2":"2","delta":"−3"},{"label":"예산 소진 캠페인 수","w1":"4","w2":"2","delta":"−2"}]
periods = [{"기간":"W1","광고매출":40000000,"광고비":2000000},{"기간":"W2","광고매출":40000000,"광고비":6000000}]
ratios = [{"기간":"W1","광고수익률":1000,"전환율":10.7},{"기간":"W2","광고수익률":734,"전환율":4.7}]
campaigns = [{"id":"CAMP_050","name":"성공기원 햇밤 3k","revenue":10000000,"roas":876,"target":733,"diagnosis":"광고 매출 증가 원인: 광고 매출이 +138.1% 상승했습니다 (4,000,000원→10,000,000원). 주요 원인은 노출수의 대폭 증가 (+184.4%, 502K→1,000K)로, 클릭률 소폭 하락 (−9.8%), 전환율 소폭 하락 (−2.6%), 평균 주문 금액 소폭 하락 (−4.7%)을 상쇄하고도 남았습니다. 유일하게 활성화된 VID (VID_0045, 3kg 옵션)가 광고 매출의 100%를 차지했습니다. 캠페인은 주 중반까지 강하게 확장되었으나, 기간 후반 예산 삭감 (300,000원→100,000원, 10월 13일)으로 인해 OOB 시간이 급증하고 마지막 며칠간 노출수가 급감하여 (10월 13일 −276K) 광고 매출 상승폭이 일부 제한되었습니다. T.ROAS는 W2에서 500%에서 700~780%로 공격적으로 인상되었으며, 목표치가 실제 광고수익률보다 빠르게 상승함에 따라 광고수익률 달성률은 168.8%에서 117.1%로 하락했습니다 (실제 광고수익률은 −6.6% 소폭 하락에 그침). 광고수익률 달성률은 90% 기준을 크게 상회하고 있어 (119.5%), 광고수익률 하락은 주요 우려 사항이 아닙니다.","action":"일예산을 최소 300,000원 (삭감 이전 수준)으로 복구하여, 10월 13일 노출수를 억제했던 기간 후반의 게재 부족 현상을 해소하세요. 예산 삭감 이전까지 캠페인은 강한 광고 매출 성장세를 보이고 있었으며, 예산 여유를 회복하는 것이 해당 성장 궤도를 되찾고 유지하는 가장 직접적인 방법입니다. T.ROAS를 추가로 인상하지 마세요 — 목표치가 이미 크게 높아진 상태이며 달성률이 압축되고 있습니다; 현재 목표를 유지하고 게재가 먼저 안정화되도록 하세요."},{"id":"CAMP_055","name":"감홍사과","revenue":1000000,"roas":367,"target":null,"diagnosis":"광고 매출 증가 원인: W1에는 활동이 없었으며 W2에 캠페인이 시작되어 두 개의 VID에서 1,000,000원의 광고 매출이 발생했습니다 — VID VID_0048 (700,000원, 51%) 및 VID VID_0047 (700,000원, 49%). 해당 캠페인은 전체 인과 진단을 위한 최소 자격 기준을 충족하지 못합니다 (30일 내 광고 기여 주문수 0건, W1 광고 매출 0원).","action":"캠페인 이력이 충분하지 않아 (신규 시작) 전체 진단이 불가합니다. W3 성과를 모니터링하면서 주문 이력이 쌓이기를 기다리세요. 활성화된 두 VID의 자격 요건이 유지되고 있는지, 그리고 캠페인이 확장되는 동안 게재를 지속하기에 일예산이 충분한지 확인하세요."},{"id":"CAMP_048","name":"머루포도","revenue":2000000,"roas":709,"target":720,"diagnosis":"광고 매출 상승 이유: 광고 매출이 +85.2% 상승했습니다 (1,000,000원→2,000,000원). 주요 원인은 노출수 급증(+161.9%, 296K→774K)으로, 2주간 일예산이 두 배로 증가(200,000원→400,000원)한 데 따른 것입니다. VID VID_0042 (3kg 옵션)이 광고 매출 기여의 111.1%를 차지했으며(1,000,000원→2,000,000원), 소규모 VID 2개(96111176779, VID_0043)는 W2에서 게재가 중단되어 상위 VID 성과를 일부 상쇄했습니다. 광고 규모가 확대되면서 의도가 낮은 지면으로 노출이 분산됨에 따라 클릭률은 −15.5%, 전환율은 −25.0% 하락했으나, 평균 주문 금액이 +11.6% 상승하며 일부 보완되었습니다. 캠페인은 기간 내내 예산 제약 상태를 유지했으며(예산 소진 시간 5→9시간), 예산 증액 시마다 노출수와 광고 매출이 직접적으로 증가했습니다. 목표 광고수익률(T.ROAS)은 10월 8일에 633%에서 720%로 상향되었고, 실제 광고수익률(~710%) 대비 목표가 높아지면서 광고수익률 달성률은 112.9%에서 98.0%로 하락했습니다. 광고수익률 달성률은 98.4%로 90% 기준을 상회합니다 — 광고수익률 하락 항목은 해당 없습니다.","action":"캠페인은 현재 예산 제약 상태입니다 (W2 예산 소진 9시간). 추가 예산 증액 시 W1→W2에서 확인된 패턴과 동일하게 노출수 및 광고 매출이 추가로 증가할 가능성이 높습니다. 현재 400,000원 수준을 초과하는 일예산 증액을 우선적으로 검토해 주세요. 목표 광고수익률은 현재 720% 수준을 유지하세요 — 달성률이 98%에 근접해 있으며, 목표를 추가 상향할 경우 게재가 억제될 위험이 있습니다."},{"id":"CAMP_049","name":"머루포도 2k","revenue":1000000,"roas":578,"target":648,"diagnosis":"광고 매출 상승 이유: 광고 매출이 W1 거의 0에 가까운 기저에서 +1,000% 상승했습니다 (60,000원→1,000,000원). 단일 활성 VID(VID_0043, 2kg 옵션)가 광고 매출의 100%를 차지했습니다. 노출수가 대폭 확대되며(+3,000.7%, 10K→333K) 규모 급증을 이끌었습니다. 캠페인이 더 넓은 지면으로 확장되면서 클릭률은 −21.2%, 전환율은 −47.6% 하락했으나, 노출수 증가가 이를 충분히 상쇄했습니다. 광고수익률 달성률은 117.9%에서 89.2%로 하락하여(Section 3a: 89.2%) 90% 미만으로 떨어졌습니다. ·  · 1) 광고 매출 상승 이유: W1 기저가 거의 0에 가까운 상태에서 W2에 노출수가 대폭 확대되었으며, 캠페인이 사실상 W2에 본격 게재를 시작한 것으로 볼 수 있습니다. VID VID_0043이 모든 광고 매출을 창출했습니다. 캠페인은 전체 진단 자격 요건을 충족하지 못합니다 (W1 광고 매출 60,000원 < 1,000,000원 기준; W2 광고 주문수 = 3 < 7 기준). ·  · 2) 광고수익률 하락 이유: 광고수익률 달성률이 117.9%에서 89.2%로 하락했습니다. W2에서 목표 광고수익률(648%)을 달성하지 못했습니다 (실제 광고수익률 577%). 캠페인이 거의 0에서 확장되면서 노출이 전환율이 낮은 지면으로 이동함에 따라 전환율이 급격히 압축(−47.6%)되어 실제 광고수익률이 목표 아래로 하락했습니다.","action":"주문 이력 부족으로 전체 진단이 불가합니다 (W2 광고 주문수 = 3, W1 광고 매출 기준 미달). 캠페인이 성숙해지는 W3 성과를 모니터링해 주세요. 주문량이 증가하는 과정에서도 광고수익률 달성률이 90% 미만으로 유지된다면, 목표 광고수익률(648%)이 해당 상품의 전환 특성에 적합하게 설정되어 있는지 검토해 보세요."},{"id":"CAMP_056","name":"성공기원 햇밤5k","revenue":800000,"roas":470,"target":540,"diagnosis":"광고 매출 상승 이유: 캠페인은 W1 활동이 전혀 없었으며 W2에 런칭하여 VID VID_0044 (5kg 옵션)를 통해 800,000원의 광고 매출을 전액 창출했습니다. 캠페인은 전체 인과 진단을 위한 최소 자격 기준을 충족하지 못합니다 (30일 내 광고 적격 주문 없음, W1 광고 매출 없음, W2 광고 주문수 기준 미달). W2 광고수익률 달성률은 87.0%로 90% 미만입니다. ·  · 1) 광고 매출 상승 이유: W2 신규 캠페인 런칭 — 모든 광고 매출은 W2에서만 발생했으며, 단일 VID(VID_0044)에 의해 창출되었습니다. ·  · 2) 광고수익률 하락 이유: 전통적인 의미에서는 해당 없습니다 (W1 광고수익률 기준값 없음). W2 광고수익률 달성률 87.0%는 캠페인이 목표 광고수익률(540%)을 소폭 하회하여 실제 광고수익률 470%로 운영 중임을 나타냅니다. 신규 런칭 캠페인으로서 이는 정상적인 초기 안정화 범위 내에 있습니다.","action":"캠페인 이력 부족으로 전체 진단이 불가합니다. W3 성과를 모니터링해 주세요. 캠페인이 성숙해지는 과정에서도 광고수익률 달성률이 90% 미만으로 유지된다면, 현재 입찰가 수준에서 해당 상품의 전환 특성에 목표 광고수익률(540%)이 적합한지 검토해 보세요."}]
knownTargetCampaigns = [{"id":"CAMP_050","name":"성공기원 햇밤 3k","revenue":10000000,"roas":876,"target":733,"diagnosis":"광고 매출 증가 원인: 광고 매출이 +138.1% 상승했습니다 (4,000,000원→10,000,000원). 주요 원인은 노출수의 대폭 증가 (+184.4%, 502K→1,000K)로, 클릭률 소폭 하락 (−9.8%), 전환율 소폭 하락 (−2.6%), 평균 주문 금액 소폭 하락 (−4.7%)을 상쇄하고도 남았습니다. 유일하게 활성화된 VID (VID_0045, 3kg 옵션)가 광고 매출의 100%를 차지했습니다. 캠페인은 주 중반까지 강하게 확장되었으나, 기간 후반 예산 삭감 (300,000원→100,000원, 10월 13일)으로 인해 OOB 시간이 급증하고 마지막 며칠간 노출수가 급감하여 (10월 13일 −276K) 광고 매출 상승폭이 일부 제한되었습니다. T.ROAS는 W2에서 500%에서 700~780%로 공격적으로 인상되었으며, 목표치가 실제 광고수익률보다 빠르게 상승함에 따라 광고수익률 달성률은 168.8%에서 117.1%로 하락했습니다 (실제 광고수익률은 −6.6% 소폭 하락에 그침). 광고수익률 달성률은 90% 기준을 크게 상회하고 있어 (119.5%), 광고수익률 하락은 주요 우려 사항이 아닙니다.","action":"일예산을 최소 300,000원 (삭감 이전 수준)으로 복구하여, 10월 13일 노출수를 억제했던 기간 후반의 게재 부족 현상을 해소하세요. 예산 삭감 이전까지 캠페인은 강한 광고 매출 성장세를 보이고 있었으며, 예산 여유를 회복하는 것이 해당 성장 궤도를 되찾고 유지하는 가장 직접적인 방법입니다. T.ROAS를 추가로 인상하지 마세요 — 목표치가 이미 크게 높아진 상태이며 달성률이 압축되고 있습니다; 현재 목표를 유지하고 게재가 먼저 안정화되도록 하세요."},{"id":"CAMP_048","name":"머루포도","revenue":2000000,"roas":709,"target":720,"diagnosis":"광고 매출 상승 이유: 광고 매출이 +85.2% 상승했습니다 (1,000,000원→2,000,000원). 주요 원인은 노출수 급증(+161.9%, 296K→774K)으로, 2주간 일예산이 두 배로 증가(200,000원→400,000원)한 데 따른 것입니다. VID VID_0042 (3kg 옵션)이 광고 매출 기여의 111.1%를 차지했으며(1,000,000원→2,000,000원), 소규모 VID 2개(96111176779, VID_0043)는 W2에서 게재가 중단되어 상위 VID 성과를 일부 상쇄했습니다. 광고 규모가 확대되면서 의도가 낮은 지면으로 노출이 분산됨에 따라 클릭률은 −15.5%, 전환율은 −25.0% 하락했으나, 평균 주문 금액이 +11.6% 상승하며 일부 보완되었습니다. 캠페인은 기간 내내 예산 제약 상태를 유지했으며(예산 소진 시간 5→9시간), 예산 증액 시마다 노출수와 광고 매출이 직접적으로 증가했습니다. 목표 광고수익률(T.ROAS)은 10월 8일에 633%에서 720%로 상향되었고, 실제 광고수익률(~710%) 대비 목표가 높아지면서 광고수익률 달성률은 112.9%에서 98.0%로 하락했습니다. 광고수익률 달성률은 98.4%로 90% 기준을 상회합니다 — 광고수익률 하락 항목은 해당 없습니다.","action":"캠페인은 현재 예산 제약 상태입니다 (W2 예산 소진 9시간). 추가 예산 증액 시 W1→W2에서 확인된 패턴과 동일하게 노출수 및 광고 매출이 추가로 증가할 가능성이 높습니다. 현재 400,000원 수준을 초과하는 일예산 증액을 우선적으로 검토해 주세요. 목표 광고수익률은 현재 720% 수준을 유지하세요 — 달성률이 98%에 근접해 있으며, 목표를 추가 상향할 경우 게재가 억제될 위험이 있습니다."},{"id":"CAMP_049","name":"머루포도 2k","revenue":1000000,"roas":578,"target":648,"diagnosis":"광고 매출 상승 이유: 광고 매출이 W1 거의 0에 가까운 기저에서 +1,000% 상승했습니다 (60,000원→1,000,000원). 단일 활성 VID(VID_0043, 2kg 옵션)가 광고 매출의 100%를 차지했습니다. 노출수가 대폭 확대되며(+3,000.7%, 10K→333K) 규모 급증을 이끌었습니다. 캠페인이 더 넓은 지면으로 확장되면서 클릭률은 −21.2%, 전환율은 −47.6% 하락했으나, 노출수 증가가 이를 충분히 상쇄했습니다. 광고수익률 달성률은 117.9%에서 89.2%로 하락하여(Section 3a: 89.2%) 90% 미만으로 떨어졌습니다. ·  · 1) 광고 매출 상승 이유: W1 기저가 거의 0에 가까운 상태에서 W2에 노출수가 대폭 확대되었으며, 캠페인이 사실상 W2에 본격 게재를 시작한 것으로 볼 수 있습니다. VID VID_0043이 모든 광고 매출을 창출했습니다. 캠페인은 전체 진단 자격 요건을 충족하지 못합니다 (W1 광고 매출 60,000원 < 1,000,000원 기준; W2 광고 주문수 = 3 < 7 기준). ·  · 2) 광고수익률 하락 이유: 광고수익률 달성률이 117.9%에서 89.2%로 하락했습니다. W2에서 목표 광고수익률(648%)을 달성하지 못했습니다 (실제 광고수익률 577%). 캠페인이 거의 0에서 확장되면서 노출이 전환율이 낮은 지면으로 이동함에 따라 전환율이 급격히 압축(−47.6%)되어 실제 광고수익률이 목표 아래로 하락했습니다.","action":"주문 이력 부족으로 전체 진단이 불가합니다 (W2 광고 주문수 = 3, W1 광고 매출 기준 미달). 캠페인이 성숙해지는 W3 성과를 모니터링해 주세요. 주문량이 증가하는 과정에서도 광고수익률 달성률이 90% 미만으로 유지된다면, 목표 광고수익률(648%)이 해당 상품의 전환 특성에 적합하게 설정되어 있는지 검토해 보세요."},{"id":"CAMP_056","name":"성공기원 햇밤5k","revenue":800000,"roas":470,"target":540,"diagnosis":"광고 매출 상승 이유: 캠페인은 W1 활동이 전혀 없었으며 W2에 런칭하여 VID VID_0044 (5kg 옵션)를 통해 800,000원의 광고 매출을 전액 창출했습니다. 캠페인은 전체 인과 진단을 위한 최소 자격 기준을 충족하지 못합니다 (30일 내 광고 적격 주문 없음, W1 광고 매출 없음, W2 광고 주문수 기준 미달). W2 광고수익률 달성률은 87.0%로 90% 미만입니다. ·  · 1) 광고 매출 상승 이유: W2 신규 캠페인 런칭 — 모든 광고 매출은 W2에서만 발생했으며, 단일 VID(VID_0044)에 의해 창출되었습니다. ·  · 2) 광고수익률 하락 이유: 전통적인 의미에서는 해당 없습니다 (W1 광고수익률 기준값 없음). W2 광고수익률 달성률 87.0%는 캠페인이 목표 광고수익률(540%)을 소폭 하회하여 실제 광고수익률 470%로 운영 중임을 나타냅니다. 신규 런칭 캠페인으로서 이는 정상적인 초기 안정화 범위 내에 있습니다.","action":"캠페인 이력 부족으로 전체 진단이 불가합니다. W3 성과를 모니터링해 주세요. 캠페인이 성숙해지는 과정에서도 광고수익률 달성률이 90% 미만으로 유지된다면, 현재 입찰가 수준에서 해당 상품의 전환 특성에 목표 광고수익률(540%)이 적합한지 검토해 보세요."}]
risks = [{"id":"VID_0044","name":"[타임특가]100% 국산 밤 햇밤 대사이즈,1개,1개,5kg,5kg","hours":null,"amount":null,"share":26.7,"issue":"근거 있는 이슈 없음","summary":"광고 매출 최상위 기여 VID로 근거 있는 광고 적격성 이슈가 발견되지 않았습니다; 성과를 지속 모니터링하고 노출을 유지하세요."},{"id":"VID_0045","name":"[타임특가]100% 국산 밤 햇밤 대사이즈,1개,1개,3kg,3kg","hours":null,"amount":null,"share":21.1,"issue":"근거 있는 문제 없음","summary":"광고 매출 상위 기여 상품으로 근거 있는 노출 자격 문제가 발견되지 않았습니다. 성과를 모니터링하고 노출을 유지하세요."},{"id":"VID_0046","name":"[타임특가]100% 국산 밤 햇밤 대사이즈,1개,1개,2kg,2kg","hours":null,"amount":null,"share":11.3,"issue":"근거 있는 문제 없음","summary":"광고 매출 상위 기여 상품으로 근거 있는 노출 자격 문제가 발견되지 않았습니다. 성과를 모니터링하고 노출을 유지하세요."},{"id":"96142858305","name":"[타임특가]15Brix 국내산 감홍사과 대과,1개,1개,2kg (특품),2kg (특품)","hours":null,"amount":null,"share":6,"issue":"근거 있는 문제 없음","summary":"광고 매출 상위 기여 상품으로 근거 있는 노출 자격 문제가 발견되지 않았습니다. 성과를 모니터링하고 노출을 유지하세요."},{"id":"VID_0042","name":"[타임특가]18Brix 국내산 머루포도,1개,1개,3kg (특품),3kg (특품)","hours":null,"amount":null,"share":5.7,"issue":"근거 있는 문제 없음","summary":"광고 매출 상위 기여 상품으로 근거 있는 노출 자격 문제가 발견되지 않았습니다. 성과를 모니터링하고 노출을 유지하세요."}]
