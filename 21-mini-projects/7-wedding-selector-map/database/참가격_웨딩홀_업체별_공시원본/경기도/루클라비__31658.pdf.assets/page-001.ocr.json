      "y": 0.7125256673614873
    },
    {
      "confidence": 1,
      "height": 0.010738255033556965,
      "text": "② 행사일 기준 180일 전부터는 계약금 반환되지 않습니다.",
      "width": 0.11337209268626096,
      "x": 0.06395348665105562,
      "y": 0.7020134226740659
    },
    {
      "confidence": 0.5,
      "height": 0.010352383363967044,
