{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wedding-atlas:disclosure-superset:0.1.0",
  "title": "Wedding disclosure superset draft",
  "description": "Source-preserving domain envelope. Structural validity does not imply extraction correctness or quotation validity.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "disclosures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disclosure"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "priceTerms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/priceTerm"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivation"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.:/-]+$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "datasetId",
    "entities",
    "sources",
    "disclosures",
    "evidence",
    "conditions",
    "facts",
    "priceTerms",
    "relations",
    "policies",
    "derivations"
  ],
  "additionalProperties": false,
  "$defs": {
