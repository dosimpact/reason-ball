et1","cellRange":"C5"},"method":"xml","verification":"unreviewed","rawText":"뷔페\n95,000원"},{"id":"venue-31417-e-1","sourceId":"s-0523b05de4b763","locator":{"kind":"spreadsheet","sheet":"Sheet1","cellRange":"E5"},"method":"xml","verification":"unreviewed","rawText":"14,000,000원"},{"id":"venue-31417-e-2","sourceId":"s-0523b05de4b763","locator":{"kind":"spreadsheet","sheet":"Sheet1","cellRange":"C11"},"method":"xml","verification":"unreviewed","rawText":"뷔페\n95,000원"},{"id":"venue-31417-e-3","sourceId":"s-0523b05de4b763","locator":{"kind":"spreadsheet","sheet":"Sheet1","cellRange":"E11"},"method":"xml","verification":"unreviewed","rawText":"13,000,000원"},{"id":"venue-31417-e-4","sourceId":"s-0523b05de4b763","locator":{"kind":"spreadsheet","sheet":"Sheet1","cellRange":"C15"},"method":"xml","verification":"unreviewed","rawText":"양식코스\n98,000원~130,000원"},{"id":"venue-31417-e-5","sourceId":"s-0523b05de4b763","locator":{"kind":"spreadsheet","sheet":"Sheet1","cellRange":"E15"},"method":"xml","verification":"unreviewed","rawText":"13,000,000원"},{"id":"venue-31417-metadata","sourceId":"s-569e7069632368","locator":{"kind":"whole_source"},"method":"native_text","verification":"source_checked","rawText":"더 리버사이드 호텔 / 서울특별시 서초구 강남대로107길 6 / 02-6710-1188"},{"id":"venue-31417-policy-0-evidence","sourceId":"s-0523b05de4b763","locator":{"kind":"whole_source"},"method":"native_text","verification":"unreviewed","rawText":"② 계약해지에 따른 위약금 및 환급에 관한 산정기준\n1. 계약시 300만원을 계약금으로 지불하고 시설/연출/상품 비용 등의 사용료와\n식/음료 비용은 식 종료 후 당일 지불 완료되어야 합니다.\n2. 계약의 해지\n계약 체결 후 해지시 예식일로부터 180일 이상 남아 있을시 계약금의 10%를 컨설팅 비용으로 차감하고 환불되며\n180일 미만 취소시 계약금은 일절 반환되지 않습니다.\n또한 아래와 같이 행사일로 부터 취소한 날을 기준으로 하여 계약금외 별도의 위약금을 배상하셔야 합니다.\n① 행사 60일 이하 계약 해제시, 약정 행사 총금액의 30%를 지불하셔야 합니다.\n② 행사 30일 이하 계약 해제시,약정 행사 총금액의 40%를 지불하셔야 합니다.\n③ 행사 10일 이하 계약 해제시,약정 행사 총금액의 50%를 지불하셔야 합니다\n④ 행사 5일 이하 계약 해제시,약정 행사 총금액의 70%를 지불하셔야 합니다\n⑤ 행사 당일 계약 해제시,약정 행사 총금액의 100%를 지불하셔야 합니다.\n3. 계약의 변경\n예식 일정 연기는 불가능합니다.\n단, 예식 일정을 앞당기는 경우 예식 150일 이상이 남아 있어야 1회에 한해서 가능합니다.\n일정 변경 시 식대 및 대관료가 달라질 수 있습니다.\n※ 위약금 산정 기준은 소비자 및 사업자 귀책사유 모두 동일하게 적용"}],"conditions":[{"id":"venue-31417-p-0-condition","evidenceIds":["venue-31417-e-0"],"disclosureId":"d-venue-31417","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본200명~350명","expression":{"op":"raw","text":"기본200명~350명"}},{"id":"venue-31417-p-1-condition","evidenceIds":["venue-31417-e-1"],"disclosureId":"d-venue-31417","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본200명~350명","expression":{"op":"raw","text":"기본200명~350명"}},{"id":"venue-31417-p-2-condition","evidenceIds":["venue-31417-e-2"],"disclosureId":"d-venue-31417","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본 200명~300명","expression":{"op":"raw","text":"기본 200명~300명"}},{"id":"venue-31417-p-3-condition","evidenceIds":["venue-31417-e-3"],"disclosureId":"d-venue-31417","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본 200명~300명","expression":{"op":"raw","text":"기본 200명~300명"}},{"id":"venue-31417-p-4-condition","evidenceIds":["venue-31417-e-4"],"disclosureId":"d-venue-31417","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본 100명 ~ 130명","expression":{"op":"raw","text":"기본 100명 ~ 130명"}},{"id":"venue-31417-p-5-condition","evidenceIds":["venue-31417-e-5"],"disclosureId":"d-venue-31417","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본 100명 ~ 130명","expression":{"op":"raw","text":"기본 100명 ~ 130명"}}],"facts":[{"id":"venue-31417-fact-address","evidenceIds":["venue-31417-metadata"],"disclosureId":"d-venue-31417","interpretation":"unreviewed","subjectId":"venue-31417","predicate":"location:address","valueState":"known","value":"서울특별시 서초구 강남대로107길 6","rawText":"서울특별시 서초구 강남대로107길 6"},{"id":"venue-31417-fact-phone","evidenceIds":["venue-31417-metadata"],"disclosureId":"d-venue-31417","interpretation":"unreviewed","subjectId":"venue-31417","predicate":"contact:phone","valueState":"known","value":"02-6710-1188","rawText":"02-6710-1188"}],"priceTerms":[{"id":"