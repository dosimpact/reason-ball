변경 시: 계약상 예상 총액의 25% 배상\n- 30일 이전까지(59일~30일) 계약해지. 변경 시: 계약상 예상 총액의 30% 배상\n- 29일 이후(29일~10일) 계약해지, 변경 시: 계약상 예상 총액의 40% 배상\n- 9일 이후(9일~1일) 계약해지, 변경 시: 계약상 예상 총액의 50% 배상\n행사 당일 계약 해지, 변경 시: 계약상 예상총액의 70% 배상\n계약상 예상 총액 = 예식비(기본사항+선택사항)+식사금액\n사업자의 사유로 인한 계약해지 시, 기납부된 계약금 전액을 반환해 드리며 \n본 계약은 종료되는 것으로 합니다."}],"conditions":[{"id":"venue-31501-p-0-condition","evidenceIds":["venue-31501-e-0"],"disclosureId":"d-venue-31501","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본300명","expression":{"op":"raw","text":"기본300명"}},{"id":"venue-31501-p-1-condition","evidenceIds":["venue-31501-e-1"],"disclosureId":"d-venue-31501","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본300명","expression":{"op":"raw","text":"기본300명"}},{"id":"venue-31501-p-2-condition","evidenceIds":["venue-31501-e-2"],"disclosureId":"d-venue-31501","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본250명","expression":{"op":"raw","text":"기본250명"}},{"id":"venue-31501-p-3-condition","evidenceIds":["venue-31501-e-3"],"disclosureId":"d-venue-31501","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본250명","expression":{"op":"raw","text":"기본250명"}},{"id":"venue-31501-p-4-condition","evidenceIds":["venue-31501-e-4"],"disclosureId":"d-venue-31501","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본300명","expression":{"op":"raw","text":"기본300명"}},{"id":"venue-31501-p-5-condition","evidenceIds":["venue-31501-e-5"],"disclosureId":"d-venue-31501","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본300명","expression":{"op":"raw","text":"기본300명"}},{"id":"venue-31501-p-6-condition","evidenceIds":["venue-31501-e-6"],"disclosureId":"d-venue-31501","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본250명","expression":{"op":"raw","text":"기본250명"}},{"id":"venue-31501-p-7-condition","evidenceIds":["venue-31501-e-7"],"disclosureId":"d-venue-31501","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"기본250명","expression":{"op":"raw","text":"기본250명"}}