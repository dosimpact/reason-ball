~50) · 계약 총액의 70%\n예식 7일전까지(49~7) · 계약 총액의 90%\n예식 당일 취소까지(6~예식일) · 계약 총액의 100%\n※ 위약금 산정 기준은 소비자 및 사업자 귀책사유 모두 동일하게 적용"}],"conditions":[],"facts":[{"id":"planning-38642-fact-address","evidenceIds":["planning-38642-metadata"],"disclosureId":"d-planning-38642","interpretation":"unreviewed","subjectId":"planning-38642","predicate":"location:address","valueState":"known","value":"울산광역시 남구 왕생로 98","rawText":"울산광역시 남구 왕생로 98"},{"id":"planning-38642-fact-phone","evidenceIds":["planning-38642-metadata"],"disclosureId":"d-planning-38642","interpretation":"unreviewed","subjectId":"planning-38642","predicate":"contact:phone","valueState":"known","value":"052-260-1009","rawText":"052-260-1009"}],"priceTerms":[{"id":"planning-38642-p-0","evidenceIds":["planning-38642-e-0"],"disclosureId":"d-planning-38642","interpretation":"unreviewed","subjectId":"planning-38642-subject-3374cc2800","itemId":"service-studio","role":"payable","state":"known","basis":{"quantity":"1","unit":"unit:event"},"rawText":"1,440,000원","requirement":"unknown","taxTreatment":"not_disclosed","serviceChargeTreatment":"not_disclosed","currency":"KRW","amount":{"kind":"exact","value":"1440000"}},{"id":"planning-38642-p-1","evidenceIds":["planning-38642-e-1"],"disclosureId":"d-planning-38642","interpretation":"unreviewed","subjectId":"planning-38642-subject-57ef0e32e4","itemId":"service-studio","role":"payable","state":"known","basis":{"quantity":"1","unit":"unit:event"},"rawText":"1,430,000원","requirement":"unknown","taxTreatment":"not_disclosed","serviceChargeTreatment":"not_disclosed","currency":"KRW","amount":{"kind":"exact","value":"1430000"}},{"id":"planning-38642-p-2","evidenceIds":["planning-38642-e-2"],"disclosureId":"d-planning-38642","interpretation":"unreviewed","subjectId":"planning-38642-subject-57ef0e32e4","itemId":"service-studio","role":"payable","state":"known","basis":{"quantity":"1","unit":"unit:event"},"rawText":"1,870,000원","requirement":"unknown","taxTreatment":"not_disclosed","serviceChar