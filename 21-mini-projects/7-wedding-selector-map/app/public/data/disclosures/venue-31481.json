":"spreadsheet","sheet":"Sheet1","cellRange":"E5"},"method":"xml","verification":"unreviewed","rawText":"6,600,000원"},{"id":"venue-31481-e-2","sourceId":"s-047516f5510253","locator":{"kind":"spreadsheet","sheet":"Sheet1","cellRange":"C6"},"method":"xml","verification":"unreviewed","rawText":"66,000원"},{"id":"venue-31481-e-3","sourceId":"s-047516f5510253","locator":{"kind":"spreadsheet","sheet":"Sheet1","cellRange":"E5"},"method":"xml","verification":"unreviewed","rawText":"6,600,000원"},{"id":"venue-31481-metadata","sourceId":"s-569e7069632368","locator":{"kind":"whole_source"},"method":"native_text","verification":"source_checked","rawText":"(주)봄날앤 / 서울특별시 구로구 구로중앙로26가길 14, 1층 101호 / 02-6344-3300"},{"id":"venue-31481-policy-0-evidence","sourceId":"s-047516f5510253","locator":{"kind":"whole_source"},"method":"native_text","verification":"unreviewed","rawText":"② 계약해지에 따른 위약금 및 환급에 관한 산정기준\n행사일 기준 180일 전까지 해지 시 계약금 환불, 180일 미만 해지 시 계약금은 반환되지 않습니다.\n계약취소시 취소수수료(계약금의 10%)가 발생 합니다.(예식날짜 Holding cost.)\n① 사업자 또는 이용자는 계약에서 정한 행사일 전까지 상대방에게 서면통지로 계약을 해지할 수 있습니다.\n② 이용자가 행사일 150일 이하 해지 시 행사 잔여 일수에 따라 위약금을 추가로 지불하셔야 합니다.\n· 행사일 150일~90일 : 계약금+총 행사비(예식비+식대) 10% 배상\n· 행사일 89일~60일 : 계약금+총 행사비(예식비+식대) 20% 배상\n· 행사일 59일~30일 : 계약금+총 행사비(예식비+식대) 30% 배상\n· 행사일 29일~10일 : 계약금+총 행사비(예식비+식대) 50% 배상\n· 행사일 09일~02일 : 계약금+총 행사비(예식비+식대) 70% 배상\n· 행사일 전날~당일 : 계약금+총 행사비(예식비+식대) 90% 배상\n · 시식이 진행이 되었다면 시식금액이 부과 됩니다.(시식인원 x 식사금액)\n③ 완성된 또는 위약금 발생 진행품목(스튜디오, 드레스, 미용, 시식 등)이 있을 경우 진행비용 및 위약금을 별도로 지불합니다.\n④ 사업자가 자신의 책임 있는 사유로 행사 일로부터 90일 미만에 계약을 해지한 경우에는 계약금의 배액을 그 이후에 해지한 경우 에는\n②번 항목을 적용 손해 배상액으로 이용자에게 지급합니다. 다만, 사업자가 계약에서 정한 동일한 내용 및 조건으로\n타 웨딩홀에서 예식이 진행될 수 있게 한 경우에는 손해배상액을 지급하지 않는다."}],"conditions":[{"id":"venue-31481-p-0-condition","evidenceIds":["venue-31481-e-0"],"disclosureId":"d-venue-31481","interpretation":"unreviewed","label":"공시 적용 조건","rawText":"한정식 코스 1명당","expression":{"op":"raw","text":"한정식 코스 1명당"}},{"id":"venue-31481-p-1-condition","evidenceIds":["venue-31481-e-1"],"disclosureId"